{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fx-jam",
  "main": "workers/site/index.js",
  "compatibility_date": "2026-05-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Le 24/09, VPS_TOKEN manquait et l'atelier echouait a l'usage sans que rien
  // ne le signale au deploiement. Declare requis, son absence fait echouer le
  // deploiement au lieu de laisser decouvrir la panne en ligne.
  "secrets": { "required": ["VPS_TOKEN"] },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Client ID de l'app SoundCloud (non secret — visible dans le dashboard SC Developer)
    "SC_CLIENT_ID": "X1d2YEhZ7BzT6ybpYARvrEHHWYpAD7FL",
    // Cloudflare Access — ni l'un ni l'autre n'est un secret : l'AUD voyage
    // dans chaque jeton, le nom d'equipe est dans l'URL de connexion. Ce qui
    // protege, c'est la signature verifiee contre les cles publiques.
    // Le verrou d'identite optionnel (ATELIER_EMAIL) reste un secret Cloudflare,
    // pose a la main, pour ne pas versionner une adresse personnelle.
    "ACCESS_TEAM": "felix-jambon20",
    // Une seule application Access couvre desormais la page /atelier ET
    // /api/atelier : deux applications = deux AUD = deux connexions, et un
    // fetch() vers une API non ouverte part en redirection cross-origin, que
    // le navigateur rend indistinguable d'une panne reseau.
    // Plusieurs tags separes par une virgule restent acceptes.
    "ACCESS_AUD": "deca0f63839416a0a17aab7dcd8181a1fbe0648fc7511ddae9599385c557c0f7"
  }
}
