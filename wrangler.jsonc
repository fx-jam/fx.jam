{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fx-jam",
  "main": "workers/site/index.js",
  "compatibility_date": "2026-05-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Client ID de l'app SoundCloud (non secret — visible dans le dashboard SC Developer)
    "SC_CLIENT_ID": "X1d2YEhZ7BzT6ybpYARvrEHHWYpAD7FL",
    // Cloudflare Access — ni l'un ni l'autre n'est un secret : l'AUD voyage
    // dans chaque jeton, le nom d'equipe est dans l'URL de connexion. Ce qui
    // protege, c'est la signature verifiee contre les cles publiques.
    // Le verrou d'identite optionnel (ATELIER_EMAIL) reste un secret Cloudflare,
    // pose a la main, pour ne pas versionner une adresse personnelle.
    "ACCESS_TEAM": "felix-jambon20",
    // Le tag de l'application qui protege /api/atelier — PAS celle de la page.
    // Chaque application Access a son propre AUD ; accepter celui de la page
    // laisserait un jeton emis pour la lecture servir a ecrire.
    // Plusieurs tags separes par une virgule sont acceptes, si les applications
    // sont un jour reunies ou redecoupees.
    "ACCESS_AUD": "45ba3dd89e0976d6c681636462078ca714de58c5c7939ce6fd04b4b3d46f4fb5"
  }
}
