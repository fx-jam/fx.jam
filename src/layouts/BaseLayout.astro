  <script>
  // ── Player audio persistant · fx_jam_v2.02 ─────────────────────────
  // SC : v1.13 __scWidget preservé sur re-run IIFE (View Transitions, transition:persist)
  // AbortController : chaque IIFE abort les listeners précédents → pas d'accumulation.
  console.log('🐱 fx_jam_v2.02');
  import { swapFunctions } from 'astro:transitions/client';

  // v1.20 — SWAP CUSTOM : l'iframe SC ne quitte JAMAIS le document.
  // Astro stock : oldBody.replaceWith(newBody) detache #hamcat-player → l'iframe SC
  // recharge integralement (spec HTML : iframe detachee = browsing context detruit).
  // Ici : on garde document.body, on retire les enfants non persistants, on insere le
  // nouveau contenu AUTOUR des noeuds persistants sans jamais les deplacer.
  if (!(window as any).__hamcatSwapInstalled) {
    (window as any).__hamcatSwapInstalled = true;
    const PERSIST = 'data-astro-transition-persist';
    document.addEventListener('astro:before-swap', (e: any) => {
      const doc: Document = e.newDocument;
      e.swap = () => {
        swapFunctions.deselectScripts(doc);
        swapFunctions.swapRootAttributes(doc);
        swapFunctions.swapHeadElements(doc);
        const restoreFocus = swapFunctions.saveFocus();
        const body = document.body, nbody = doc.body;
        for (const a of [...body.attributes]) body.removeAttribute(a.name);
        for (const a of [...nbody.attributes]) body.setAttribute(a.name, a.value);
        // Persistants enfants directs de body ayant un homologue dans la nouvelle page
        const kept: Element[] = [];
        const keptById = new Map<string, Element>();
        for (const el of [...body.children]) {
          const id = el.getAttribute(PERSIST);
          const keepFlag = el.hasAttribute('data-hmc-keep'); // v1.20b: ex. console Eruda
          if (keepFlag || (id !== null && nbody.querySelector(`[${PERSIST}="${id}"]`))) { kept.push(el); if (id !== null) keptById.set(id, el); }
        }
        // Persistants imbriques (non enfants directs) : comportement Astro stock (deplacement)
        for (const el of [...body.querySelectorAll(`[${PERSIST}]`)]) {
          if (el.parentElement === body) continue;
          const id = el.getAttribute(PERSIST);
          const newEl = id !== null ? nbody.querySelector(`[${PERSIST}="${id}"]`) : null;
          if (newEl) newEl.replaceWith(el);
        }
        for (const n of [...body.childNodes]) if (!kept.includes(n as Element)) n.remove();
        let i = 0;
        for (const n of [...nbody.childNodes]) {
          const id = n.nodeType === 1 ? (n as Element).getAttribute(PERSIST) : null;
          if (id !== null && keptById.has(id)) {
            const idx = kept.indexOf(keptById.get(id)!);
            if (idx >= i) i = idx + 1;
            continue; // homologue deja en place, on ne le touche pas
          }
          if (i < kept.length) body.insertBefore(n, kept[i]); else body.appendChild(n);
        }
        (window as any).__hmcLog?.('[HMC] custom swap ok, kept=' + kept.length);
        restoreFocus();
      };
    });
  }

  (function() {
    // Abort previous IIFE's listeners (évite accumulation sur re-exec Astro)
    const w = window as any;

    // v1.21 — MODE EMBARQUE (page ouverte dans la modale iframe de la platine, ?modal=1).
    // Le player vit UNIQUEMENT dans la page parente. Avant : ce script re-instanciait un 2e widget
    // SoundCloud (auto_play) dans l'iframe modale → conflit de session audio iOS → PAUSE du parent.
    const _embedded = (() => {
      const q = new URLSearchParams(location.search).has('modal');
      try { return q || (window.top !== window && !!window.parent.document); } catch (_) { return q; }
    })();
    if (_embedded) {
      console.log('[HMC] embedded mode → player délégué au parent');
      // Les commandes montent vers le player du parent...
      ['hamcat:play', 'hamcat:toggle', 'hamcat:media'].forEach(evt => {
        document.addEventListener(evt, (e: any) => {
          try { window.parent.document.dispatchEvent(new CustomEvent(evt, { detail: e.detail })); } catch (_) {}
        });
      });
      // ...et la progression redescend, sans quoi les waveforms de la page ne
      // sauraient jamais ou en est la lecture.
      window.addEventListener('message', (e: MessageEvent) => {
        if (e.origin !== location.origin) return;
        const d = e.data as any;
        if (d && d.__hamcat === 'progress') {
          document.dispatchEvent(new CustomEvent('hamcat:progress', { detail: d.detail }));
        }
      });
      return;
    }
    const _isRerun = !!w.__hamcatAbort; // v1.13 : true si View Transitions re-exec l'IIFE
    // v1.20b: journal persistant (sessionStorage) — survit aux navigations ET aux reloads
    const hmcLog = (...a: any[]) => {
      const m = a.map(x => typeof x === 'string' ? x : JSON.stringify(x)).join(' ');
      console.log(m);
      try {
        const L = JSON.parse(sessionStorage.getItem('hmc-log') || '[]');
        L.push({ t: Date.now(), p: location.pathname, m });
        while (L.length > 80) L.shift();
        sessionStorage.setItem('hmc-log', JSON.stringify(L));
      } catch (_) {}
    };
    w.__hmcLog = hmcLog;
    try {
      const navType = (performance.getEntriesByType('navigation')[0] as any)?.type || '?';
      const H = JSON.parse(sessionStorage.getItem('hmc-log') || '[]');
      if (H.length) { const t0 = H[0].t; console.log('[HMC] HISTORY (' + H.length + ')\n' + H.map((e: any) => ((e.t - t0) / 1000).toFixed(1) + 's ' + e.p + ' ' + e.m).join('\n')); }
      hmcLog('[HMC] ══ INIT v1.20b navType=' + navType + ' rerun=' + _isRerun + ' vt=' + ('startViewTransition' in document) + ' ua=' + navigator.userAgent.slice(-70));
    } catch (_) {}
    if (w.__hamcatAbort) w.__hamcatAbort.abort();
    const _abort = new AbortController();
    w.__hamcatAbort = _abort;
    const signal = _abort.signal;
    // v1.13 : ne reset __scWidget que sur 1er chargement (View Transitions maintient le widget)
    if (!_isRerun) w.__scWidget = null;
      if (!_isRerun) (w as any).__hamcatPlaySeq = 0; // v1.15: compteur PLAY anti-race
    const _isMobile = /iP(hone|ad|od)|Android/.test(navigator.userAgent); // v1.22: autoplay bloque sur mobile
    w.__scMuted = false;

    const audioEl   = document.getElementById('hamcat-audio')      as HTMLAudioElement;
    const playerDiv = document.getElementById('hamcat-player')!;
    const embedZone = document.getElementById('player-embed-zone') as HTMLDivElement;

    interface HamcatState {
      scIframe:      HTMLIFrameElement | null;
      spIframe:      HTMLIFrameElement | null;
      currentSource: 'audio' | 'soundcloud' | 'spotify' | null;
      currentLbl:    string;
      spExpanded:    boolean;
    }
    w.__hamcat = w.__hamcat || { scIframe: null, spIframe: null, currentSource: null, currentLbl: '', spExpanded: false };
    const state: HamcatState = w.__hamcat;

    const toggleBtn    = playerDiv.querySelector('.player-embed-toggle') as HTMLButtonElement;
    const toggleBar    = document.getElementById('embed-toggle-bar') as HTMLDivElement;
    const playlistEl   = document.getElementById('sc-playlist') as HTMLDivElement;
    const scrubFill    = document.getElementById('scrubber-fill') as HTMLElement;
    const playerTimeEl = document.getElementById('player-time') as HTMLSpanElement;
    const miniTimeEl   = document.getElementById('mini-time') as HTMLSpanElement;
    const scrubberEl   = document.getElementById('player-scrubber') as HTMLElement;
    if (scrubberEl) {
      scrubberEl.addEventListener('click', (e: MouseEvent) => {
        const rect  = scrubberEl.getBoundingClientRect();
        const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        if (state.currentSource === 'soundcloud' && (w as any).__scWidget && (w as any).__scDuration) {
          (w as any).__scWidget.seekTo(ratio * (w as any).__scDuration);
        } else if (state.currentSource === 'spotify' && (w as any).__spWebPlayer && (w as any).__spDeviceId) {
          (w as any).__spWebPlayer.getCurrentState().then((st: any) => {
            if (st && st.duration) { try { (w as any).__spWebPlayer.seek(Math.round(ratio * st.duration)); } catch (_) {} }
          });
        } else if (state.currentSource === 'spotify' && (w as any).__spController && (w as any).__spDurationMs) {
          try { (w as any).__spController.seek(Math.round((ratio * (w as any).__spDurationMs) / 1000)); } catch (_) {}
        } else if (state.currentSource === 'audio' && audioEl) {
          audioEl.currentTime = ratio * audioEl.duration;
        }
      });
    }

    function fmtMs(ms: number): string {
      const s = Math.floor(ms / 1000);
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    }

    // ===== v1.36: volume (3 sources) + selecteur de sortie audio (source "audio" uniquement) =====
    const VOL_KEY = 'hamcat-player-volume';
    const volumeSlider = document.getElementById('player-volume') as HTMLInputElement | null;
    const outputSelect = document.getElementById('player-output') as HTMLSelectElement | null;

    function getSavedVolume(): number {
      try {
        const v = parseInt(localStorage.getItem(VOL_KEY) || '100', 10);
        return isNaN(v) ? 100 : Math.max(0, Math.min(100, v));
      } catch (_) { return 100; }
    }

    // Applique le volume (0-100) a la source actuellement active. N'ecrit PAS dans localStorage
    // (fait par le listener 'input' du slider) — permet de reappliquer au (re)demarrage d'une source
    // sans re-declencher une sauvegarde inutile.
    function applyVolume(vol: number) {
      const v = Math.max(0, Math.min(100, vol));
      if (state.currentSource === 'audio' && audioEl) {
        audioEl.volume = v / 100;
      } else if (state.currentSource === 'soundcloud' && w.__scWidget) {
        try { w.__scWidget.setVolume(v); } catch (_) {}
      } else if (state.currentSource === 'spotify' && w.__spWebPlayer && w.__spDeviceId) {
        try { w.__spWebPlayer.setVolume(v / 100); } catch (_) {}
      }
      // Spotify en mode preview (IFrameAPI/__spController) n'expose pas de controle de volume —
      // meme limitation que le bouton mute existant (cf. updateUI spotifyMuteUnavailable).
      if (volumeSlider && volumeSlider.value !== String(v)) volumeSlider.value = String(v);
      const muteBtnEl = playerDiv.querySelector('.player-mute-btn') as HTMLButtonElement;
      if (muteBtnEl && !muteBtnEl.disabled) muteBtnEl.textContent = v === 0 ? '🔇' : '🔊';
    }

    if (volumeSlider) {
      volumeSlider.addEventListener('input', () => {
        const v = parseInt(volumeSlider.value, 10) || 0;
        try { localStorage.setItem(VOL_KEY, String(v)); } catch (_) {}
        applyVolume(v);
      }, { signal });
    }

    // setSinkId ne fonctionne que sur notre propre <audio> — l'audio SC/Spotify joue dans des
    // iframes cross-origin qu'on ne peut pas rerouter. On ne montre donc le selecteur que pour
    // la source "audio" brute, et seulement si l'API est supportee (absente sur Safari/iOS).
    const _sinkIdSupported = typeof (audioEl as any)?.setSinkId === 'function' && !!navigator.mediaDevices;

    async function populateOutputSelect() {
      if (!outputSelect || !_sinkIdSupported) return;
      try {
        const devices = await navigator.mediaDevices.enumerateDevices();
        const outputs = devices.filter(d => d.kind === 'audiooutput');
        outputSelect.innerHTML = '';
        outputs.forEach((d, i) => {
          const opt = document.createElement('option');
          opt.value = d.deviceId;
          opt.textContent = d.label || `Sortie ${i + 1}`;
          outputSelect.appendChild(opt);
        });
      } catch (_) {}
    }

    if (_sinkIdSupported && outputSelect) {
      populateOutputSelect();
      try { navigator.mediaDevices.addEventListener('devicechange', populateOutputSelect, { signal }); } catch (_) {}
      outputSelect.addEventListener('change', () => {
        try { (audioEl as any).setSinkId(outputSelect.value); } catch (_) {}
      }, { signal });
    }
    // ===== fin v1.36 =====

    function updateSCInfo(sound: any) {
      if (!sound) return;
      const title   = sound.title || state.currentLbl || 'SoundCloud';
      const artist  = sound.user?.username || '';
      const artwork = (sound.artwork_url || '').replace('-large', '-t300x300');
      const titleEl  = playerDiv.querySelector('#player-title')  as HTMLElement;
      const artistEl = playerDiv.querySelector('#player-artist') as HTMLElement;
      const artEl    = playerDiv.querySelector('#player-artwork') as HTMLImageElement;
      if (titleEl) titleEl.textContent = title;
      if (artistEl) artistEl.textContent = artist;
      if (artwork && artEl) { artEl.src = artwork; artEl.style.display = 'block'; artEl.style.filter = 'none'; }
      const overlayEl = document.getElementById('sc-art-overlay') as HTMLImageElement;
      if (artwork && overlayEl) { overlayEl.src = artwork; overlayEl.style.display = 'block'; overlayEl.style.filter = 'none'; }
      state.currentLbl = title;
      // Media Session API — lock screen / transport bar
      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title,
          artist,
          album: 'hamcat.live',
          artwork: artwork ? [{ src: artwork, sizes: '300x300', type: 'image/jpeg' }] : []
        });
      }
      // v1.35: ID de la piste pour le like SC — check uniquement au changement effectif
      if (sound.id && sound.id !== (w as any).__scCurrentTrackId) {
        (w as any).__scCurrentTrackId = sound.id;
        scCheckLiked(sound.id);
      }
    }

    function saveState(data: object) {
      try { localStorage.setItem('hamcat-player', JSON.stringify(data)); } catch (_) {}
    }

    function initSCWidget(startAtMs = 0, trackIndex = 0, shouldPlay = true) {
      const iframe = state.scIframe;
      if (!iframe || !iframe.src || !(window as any).SC) return;
      // Annuler tout debounce-PAUSE en vol d'une ancienne instance
      if (w.__scPauseTimer) { clearTimeout(w.__scPauseTimer); w.__scPauseTimer = null; }
      const widget = (window as any).SC.Widget(iframe);
      w.__scWidget = widget;
      try {
        widget.unbind((window as any).SC.Widget.Events.READY);
        widget.unbind((window as any).SC.Widget.Events.PLAY_PROGRESS);
        widget.unbind((window as any).SC.Widget.Events.PLAY);
        widget.unbind((window as any).SC.Widget.Events.PAUSE);
      } catch (_) {}
      if (!playlistEl) return;
      widget.bind((window as any).SC.Widget.Events.READY, () => {
        w.__scReloading = false;
        // PLAY_PROGRESS → scrubber + position save
        widget.bind((window as any).SC.Widget.Events.PLAY_PROGRESS, (prog: any) => {
          const pos = prog.currentPosition || 0;
          const rel = prog.relativePosition || 0;
          if (scrubFill) scrubFill.style.width = (rel * 100) + '%';
          setPlayerWaveProgress(rel);
          if (rel > 0) {
            const dur = pos / rel;
            (w as any).__scDuration = dur;
            if (playerTimeEl) playerTimeEl.textContent = `${fmtMs(pos)} / ${fmtMs(dur)}`;
            if (miniTimeEl) miniTimeEl.textContent = fmtMs(pos);
            // Sans ca, les waveforms SoundCloud des pages restaient figees a zero.
            emitProgress((w as any).__scUrl || '', pos / 1000, dur / 1000);
          }
          try {
            const s = JSON.parse(localStorage.getItem('hamcat-player') || '{}');
            if (s.type === 'soundcloud') {
              s.scPosition = pos;
              localStorage.setItem('hamcat-player', JSON.stringify(s));
            }
          } catch (_) {}
        });
        // PLAY → annule debounce-PAUSE + track index + visual state
        widget.bind((window as any).SC.Widget.Events.PLAY, () => {
          hmcLog('[HMC] PLAY fired');
          if (w.__scPauseTimer) { clearTimeout(w.__scPauseTimer); w.__scPauseTimer = null; }
          (w as any).__hamcatPlaySeq = ((w as any).__hamcatPlaySeq || 0) + 1; // v1.15: anti-race debounce PAUSE
          if ('mediaSession' in navigator) navigator.mediaSession.playbackState = 'playing';
          playerDiv.classList.add('playing');
          setPlayIcon('⏸');
          // Sauvegarde de l'index du track en cours
          widget.getSounds((sounds: any[]) => {
            widget.getCurrentSound((cur: any) => {
              if (!cur || !sounds) return;
              updateSCInfo(cur);
              const idx = sounds.findIndex((s: any) => s.id === cur.id);
              try {
                const sv = JSON.parse(localStorage.getItem('hamcat-player') || '{}');
                if (sv.type === 'soundcloud') {
                  sv.scTrackIndex = idx >= 0 ? idx : 0;
                  sv.scPlaying = true;
                  localStorage.setItem('hamcat-player', JSON.stringify(sv));
                }
              } catch (_) {}
            });
          });
        });
        // PAUSE → debounce 400ms + isPaused() doublement sécurisé
        // Stratégie : si PLAY arrive dans les 400ms (auto-résume adoptNode)
        //   → timer annulé dans le handler PLAY ci-dessus → UI intacte ✓
        // Sinon → isPaused() confirme l'état après la fenêtre de cut (~250ms)
        widget.bind((window as any).SC.Widget.Events.PAUSE, () => {
          if (w.__scReloading) return;
          // v1.20: plus de guard nav — l'iframe n'est plus rechargee, un PAUSE est un vrai PAUSE
          hmcLog('[HMC] PAUSE fired, debouncing...');
          if (w.__scPauseTimer) clearTimeout(w.__scPauseTimer);
          const _seqAtPause = (w as any).__hamcatPlaySeq || 0; // v1.15
          w.__scPauseTimer = setTimeout(() => {
            w.__scPauseTimer = null;
            // v1.15: PLAY arrivé pendant debounce ? → oscillation SC, skip
            if (((w as any).__hamcatPlaySeq || 0) > _seqAtPause) {
              hmcLog('[HMC] PAUSE skip: PLAY pendant debounce seq', _seqAtPause, '→', (w as any).__hamcatPlaySeq);
              return;
            }
            widget.isPaused((actuallyPaused: boolean) => {
              if (!actuallyPaused) return;
              // v1.15: vérifier encore après roundtrip isPaused()
              if (((w as any).__hamcatPlaySeq || 0) > _seqAtPause) {
                hmcLog('[HMC] isPaused cb skip: PLAY pendant roundtrip');
                return;
              }
              if ('mediaSession' in navigator) navigator.mediaSession.playbackState = 'paused';
              playerDiv.classList.remove('playing');
              setPlayIcon('▶');
              try {
                const sv = JSON.parse(localStorage.getItem('hamcat-player') || '{}');
                if (sv.type === 'soundcloud') {
                  sv.scPlaying = false;
                  localStorage.setItem('hamcat-player', JSON.stringify(sv));
                }
              } catch (_) {}
            });
          }, 400);
        });
        // v1.36: applique le volume sauvegarde (echelle 0-100 pour le Widget SC)
        try { widget.setVolume(w.__scMuted ? 0 : getSavedVolume()); } catch (_) {}
        // Titre + pochette du track courant
        widget.getCurrentSound((sound: any) => updateSCInfo(sound));
        // v1.33: le widget est maintenant pret -- reevalue prev/next (caches jusque-la, cf. playSC())
        updateSpotifyConnectBtn('soundcloud');
        // Media Session transport controls (lock screen, notification bar)
        if ('mediaSession' in navigator) {
          navigator.mediaSession.setActionHandler('play',  () => { try { widget.play();  } catch (_) {} });
          navigator.mediaSession.setActionHandler('pause', () => { try { widget.pause(); } catch (_) {} });
          navigator.mediaSession.setActionHandler('stop',  () => { try { widget.pause(); } catch (_) {} });
          // v1.32: prev/next depuis l'ecran de veille / la notification, comme pour Spotify (v1.29)
          navigator.mediaSession.setActionHandler('previoustrack', () => { try { widget.prev(); } catch (_) {} });
          navigator.mediaSession.setActionHandler('nexttrack',     () => { try { widget.next(); } catch (_) {} });
          navigator.mediaSession.playbackState = 'playing';
        }
        // Restore: skip vers le bon track puis seek + play
        if (trackIndex > 0 || startAtMs > 100) {
          widget.skip(trackIndex);
          setTimeout(() => {
            if (startAtMs > 0) widget.seekTo(startAtMs);
            if (shouldPlay) widget.play();
          }, 600);
        }
        // Playlist tracks — v1.37: extrait dans renderSCPlaylist() (cf. plus bas), premier pas
        // de la decorrelation browse/player : le rendu de la liste ne depend plus que d'un
        // tableau de sons + d'un callback "skip vers cet index", pas de l'objet widget lui-meme.
        widget.getSounds((sounds: any[]) => renderSCPlaylist(sounds, (idx: number) => { widget.skip(idx); widget.play(); }));
      });
    }

    // v1.37: rendu de la liste de lecture SC — DECOUPLE du widget (ne prend qu'un tableau de
    // sons + un callback de selection). Objectif a terme : alimenter cette meme fonction depuis
    // l'API publique SoundCloud (deja relayee par le Worker pour l'OAuth, v1.35) plutot que
    // depuis le widget embarque, pour que le "browse" existe independamment du player.
    function renderSCPlaylist(sounds: any[], onSelect: (idx: number) => void) {
      if (!playlistEl) return;
      if (!sounds || sounds.length <= 1) { playlistEl.style.display = 'none'; return; }
      playlistEl.innerHTML = '';
      sounds.forEach((track: any, idx: number) => {
        const btn = document.createElement('button');
        btn.textContent = track.title || `Track ${idx + 1}`;
        btn.dataset.idx = String(idx);
        btn.style.cssText = 'display:block;width:100%;text-align:left;background:none;border:none;border-bottom:1px solid rgba(255,255,255,0.06);color:var(--text-primary);padding:6px 10px;cursor:pointer;font-size:12px;font-family:inherit;opacity:0.65;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;box-sizing:border-box;';
        btn.addEventListener('mouseenter', () => { btn.style.opacity = '1'; });
        btn.addEventListener('mouseleave', () => { btn.style.opacity = '0.7'; });
        btn.addEventListener('click', () => onSelect(idx));
        playlistEl.appendChild(btn);
      });
      playlistEl.style.display = 'block';
    }

    function updateUI(uiState: 'playing' | 'paused' | 'loading', lbl: string, src?: string) {
      state.currentLbl = lbl;
      const lblEl    = playerDiv.querySelector('.player-label')        as HTMLElement;
      const srcBadge = playerDiv.querySelector('#player-source-badge') as HTMLElement;
      const miniSrc  = playerDiv.querySelector('#mini-source')         as HTMLElement;
      if (lblEl) lblEl.textContent = lbl;
      const miniLbl = document.getElementById('mini-title');
      if (miniLbl) miniLbl.textContent = lbl || '—';
      playerDiv.querySelectorAll('.player-play-btn')
               .forEach(b => b.setAttribute('data-state', uiState));
      setPlayIcon(uiState === 'playing' ? '⏸' : '▶');
      if (src) {
        const badge = src === 'spotify' ? 'SP' : src === 'audio' ? '♪' : 'SC';
        const cls   = src === 'spotify' ? 'source-badge sp' : 'source-badge';
        if (srcBadge) { srcBadge.textContent = badge; srcBadge.className = cls; }
        if (miniSrc)  { miniSrc.textContent  = badge; miniSrc.className  = cls; }
      }
      // v1.24: mute non supporte par l'API embed Spotify (pas de setVolume expose) -> bouton desactive
      // v1.26: sauf en full playback (Web Playback SDK), ou le mute redevient possible
      const muteBtnEl = playerDiv.querySelector('.player-mute-btn') as HTMLButtonElement;
      const spotifyVolUnavailable = src === 'spotify' && !(w.__spWebPlayer && w.__spDeviceId);
      if (muteBtnEl) {
        muteBtnEl.disabled = spotifyVolUnavailable;
        muteBtnEl.title = spotifyVolUnavailable ? 'Spotify ne permet pas de couper le son via son player embarque' : '';
        muteBtnEl.style.opacity = spotifyVolUnavailable ? '0.35' : '';
        muteBtnEl.style.cursor = spotifyVolUnavailable ? 'not-allowed' : '';
      }
      // v1.36: le slider suit la meme disponibilite que le mute (aucun controle volume expose
      // par Spotify hors full playback SDK)
      if (volumeSlider) {
        volumeSlider.disabled = spotifyVolUnavailable;
        volumeSlider.style.opacity = spotifyVolUnavailable ? '0.35' : '';
        if (!spotifyVolUnavailable) applyVolume(getSavedVolume());
      }
      // v1.36: selecteur de sortie — uniquement pertinent pour la source "audio" (fichier brut),
      // setSinkId n'ayant aucune prise sur l'audio joue dans les iframes SC/Spotify
      if (outputSelect) outputSelect.hidden = !_sinkIdSupported || src !== 'audio';
      updateSpotifyConnectBtn(src); // v1.26
      // Toggle embed visible seulement pour SC/Spotify — pas en full playback SDK (aucun iframe a montrer)
      const spFullMode = src === 'spotify' && !!(w.__spWebPlayer && w.__spDeviceId);
      const hideEmbedToggle = src === 'audio' || src == null || spFullMode;
      if (toggleBtn) toggleBtn.hidden = hideEmbedToggle;
      if (toggleBar) toggleBar.style.display = hideEmbedToggle ? 'none' : 'block';
      if (spFullMode) embedZone.style.display = 'none';
      // v1.37: ne fixer l'etat expanded/collapsed qu'a la toute premiere activation du player.
      // Avant : recalcule a CHAQUE appel d'updateUI (play/pause, changement de piste, restore...)
      // -> sur la home, le player se re-reduisait en mini-pill des le moindre clic sur l'interface.
      const wasActive = playerDiv.dataset.active === 'true';
      playerDiv.dataset.active = 'true';
      if (!wasActive) {
        playerDiv.dataset.expanded = window.location.pathname !== '/' ? 'true' : 'false';
      }
      syncPlayerPad();
      playerDiv.classList.toggle('playing', uiState === 'playing');
    }

    function showEmbed() {
      embedZone.style.display = 'block';
      if (toggleBtn) toggleBtn.textContent = '▼';
      if (toggleBar) toggleBar.style.display = 'block';
    }

    function hideEmbedZone() {
      embedZone.style.display = 'none';
      if (toggleBtn) toggleBtn.textContent = '▲';
    }

    function pauseAll() {
      audioEl.pause();
      // SC : widget.pause() direct + postMessage fallback
      if (w.__scWidget) { try { w.__scWidget.pause(); } catch (_) {} }
      if (state.scIframe && state.scIframe.src) {
        try { state.scIframe.contentWindow?.postMessage(JSON.stringify({ method: 'pause' }), '*'); } catch (_) {}
      }
      // v1.23: Spotify pilote via IFrame API — pause reelle plutot que detruire l'iframe
      if (w.__spController) { try { w.__spController.pause(); } catch (_) {} }
      // v1.26: idem pour le Web Playback SDK (full playback)
      if (w.__spWebPlayer) { try { w.__spWebPlayer.pause(); } catch (_) {} }
      // v1.37: display:none forcé sur les DEUX embeds à chaque pauseAll() — l'ancien code ne
      // remettait que l'iframe qu'on quittait a 'none', ce qui pouvait laisser trainer l'embed
      // preview Spotify visible si son display n'avait jamais ete reset ailleurs (ex: apres un
      // enchainement rapide de sources). pauseAll() est le point de passage systematique de tout
      // changement de source : c'est ici, et seulement ici, qu'on garantit l'exclusion mutuelle.
      if (state.scIframe) state.scIframe.style.display = 'none';
      if (state.spIframe) state.spIframe.style.display = 'none';
      const artOvl = document.getElementById('sc-art-overlay') as HTMLImageElement;
      if (artOvl) artOvl.style.display = 'none';
      embedZone.style.display = 'none';
      if (playlistEl) playlistEl.style.display = 'none';
      if (toggleBar) toggleBar.style.display = 'none';
      if (toggleBtn) toggleBtn.textContent = '▲';
      // v1.37: reset des metadonnees (pochette/artiste/lien) — avant, en changeant de source,
      // l'ancienne pochette/artiste restaient affiches jusqu'a ce que la nouvelle source pousse
      // ses propres donnees (async, ~500ms+ pour SC), pendant que le label affichait deja la
      // nouvelle source generique ("SoundCloud"). Idem pour le scrubber, qui gardait la position
      // de l'ancienne source affichee jusqu'au premier evenement de progression de la nouvelle.
      const artEl    = document.getElementById('player-artwork') as HTMLImageElement;
      const artistEl = document.getElementById('player-artist')  as HTMLElement;
      const titleEl  = document.getElementById('player-title')   as HTMLAnchorElement;
      if (artEl)    { artEl.removeAttribute('src'); artEl.style.display = 'none'; }
      if (artistEl) artistEl.textContent = '';
      if (titleEl)  titleEl.removeAttribute('href'); // n'etait pertinent que pour Spotify
      if (scrubFill)    scrubFill.style.width = '0%';
      setPlayerWaveProgress(0);
      if (playerTimeEl) playerTimeEl.textContent = '0:00 / 0:00';
      if (miniTimeEl)   miniTimeEl.textContent = '—';
    }

    /** Pochette de la source "audio" : celle du set si fournie, sinon le logo du site. */
    function setAudioArtwork(art = '') {
      ['player-artwork', 'mini-art'].forEach(id => {
        const el = document.getElementById(id) as HTMLImageElement | null;
        if (!el) return;
        const src = art || el.dataset.fallback || '';
        if (!src) return;
        el.src = src;
        el.style.display = '';
      });
    }

    /** Rampe de volume — sert aux fondus entre deux sets. Resout quand la cible est atteinte. */
    function rampVolume(el: HTMLAudioElement, to: number, ms: number): Promise<void> {
      return new Promise(resolve => {
        const from = el.volume;
        const t0 = performance.now();
        if (Math.abs(to - from) < 0.01 || ms <= 0) { el.volume = to; return resolve(); }
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / ms);
          el.volume = Math.max(0, Math.min(1, from + (to - from) * k));
          if (k < 1) requestAnimationFrame(tick); else resolve();
        };
        requestAnimationFrame(tick);
      });
    }

    const FADE_OUT_MS = 280;
    const FADE_IN_MS  = 420;

    async function playAudio(url: string, lbl: string, startAt = 0, art = '', toggle = false) {
      const vol = getSavedVolume() / 100; // v1.36
      const sameTrack = state.currentSource === 'audio'
        && !!audioEl.currentSrc && audioEl.currentSrc === url;

      // Rejouer le set deja charge depuis son bouton : pause / reprise, pas un retour a zero.
      // C'est le player qui tranche, parce qu'une page ouverte en iframe ne peut pas
      // savoir ce qui joue chez le parent.
      if (sameTrack && toggle) { togglePlayback(); return; }

      // Deplacement dans le set en cours : simple seek, surtout pas un rechargement.
      if (sameTrack) {
        audioEl.currentTime = startAt;
        if (audioEl.paused) { audioEl.play().catch(console.error); updateUI('playing', lbl, 'audio'); }
        saveState({ type: 'audio', url, lbl, art, position: startAt, playing: true });
        return;
      }

      // Fondu de sortie avant de couper : un changement de set sec est desagreable.
      if (state.currentSource === 'audio' && !audioEl.paused) {
        await rampVolume(audioEl, 0, FADE_OUT_MS);
      }

      pauseAll();
      if (audioEl.src !== url) audioEl.src = url;
      audioEl.currentTime = startAt;
      audioEl.volume = 0;
      audioEl.play().catch(console.error);
      rampVolume(audioEl, vol, FADE_IN_MS);
      state.currentSource = 'audio';
      updateUI('playing', lbl, 'audio');

      //  Les sets heberges etaient le seul chemin de lecture a ne poser aucune
      //  metadonnee. Sans elle, la notification du systeme se rabat sur le
      //  titre de la page — d'ou « Hamcat · DJ, ingenieur son & prof MAO » sur
      //  l'ecran verrouille, qui est une accroche de referencement, pas le nom
      //  d'un set. Ce titre reste utile la ou il sert (l'onglet, Google) ; ici
      //  on nomme ce qui joue vraiment.
      if ('mediaSession' in navigator) {
        try {
          navigator.mediaSession.metadata = new MediaMetadata({
            title: lbl || 'Set',
            artist: 'Hamcat',
            album: 'hamcat.live',
            artwork: art ? [{ src: art, sizes: '512x512', type: 'image/jpeg' }] : [],
          });
          navigator.mediaSession.playbackState = 'playing';
        } catch (_) { /* navigateur sans Media Session : sans consequence */ }
      }
      setAudioArtwork(art); // pauseAll() vide la pochette : on la repose apres updateUI
      setPlayerWave(url);
      saveState({ type: 'audio', url, lbl, art, position: startAt, playing: true });
    }

    function playSC(url: string, lbl: string, startAtMs = 0, trackIndex = 0, shouldPlay = true, isRestore = false) {
      if (isRestore && _isMobile) shouldPlay = false; // v1.22: pas d'autoplay mobile — iOS le bloquerait de toute facon
      // Meme set deja charge : on deplace la tete de lecture au lieu de
      // recharger l'iframe, sans quoi cliquer la waveform repartait de zero.
      if (state.currentSource === 'soundcloud' && (w as any).__scUrl === url && w.__scWidget) {
        try {
          w.__scWidget.seekTo(startAtMs);
          if (shouldPlay) w.__scWidget.play();
        } catch (_) {}
        return;
      }
      (w as any).__scUrl = url;
      setPlayerWave(url);
      pauseAll();
      if (!state.scIframe) state.scIframe = document.getElementById('sc-embed') as HTMLIFrameElement;
      if (!state.scIframe) return;
      // auto_play=false quand on doit seeker : Widget READY gérera skip+seek+play
      const needsSeek = startAtMs > 100 || trackIndex > 0;
      const autoPlay  = (!needsSeek) && shouldPlay;
      const embedUrl = `https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&auto_play=${autoPlay}&color=%23ff5500&hide_related=true&show_comments=false`;
      // Marque rechargement pour supprimer faux PAUSE sur l'ancien widget
      w.__scReloading = true;
      if (w.__scWidget) {
        try { w.__scWidget.unbind((window as any).SC.Widget.Events.PAUSE); } catch (_) {}
        try { w.__scWidget.unbind((window as any).SC.Widget.Events.PLAY); } catch (_) {}
        w.__scWidget = null;
      }
      // onload + 500ms buffer — plus rapide que timeout fixe 1500ms
      state.scIframe.onload = () => setTimeout(() => initSCWidget(startAtMs, trackIndex, shouldPlay), 500);
      state.scIframe.src = embedUrl;
      state.scIframe.style.height = '166px';
      state.scIframe.style.display = 'block';
      // v1.37: garantie miroir de celle ajoutee dans pauseAll()
      if (state.spIframe) state.spIframe.style.display = 'none';
      embedZone.style.height = '166px';
      showEmbed();
      if (playlistEl) playlistEl.style.display = 'none';
      if (state.scIframe) state.scIframe.style.filter = 'invert(0.88) hue-rotate(195deg) saturate(0.55)';
      hideEmbedZone();
      // Fallback si onload ne fire pas (ex: same-origin cache)
      setTimeout(() => { if (!w.__scWidget) initSCWidget(startAtMs, trackIndex, shouldPlay); }, 3000);
      state.currentSource = 'soundcloud';
      updateUI(shouldPlay ? 'playing' : 'paused', lbl, 'soundcloud');
      saveState({ type: 'soundcloud', url, lbl, scPosition: startAtMs, scTrackIndex: trackIndex, scPlaying: shouldPlay });
    }

    // v1.23: IFrame API Spotify — controller reutilise entre lectures (comme __scWidget pour SC)
    function getSpotifyIframeAPI(): Promise<any> {
      if (w.__spotifyAPI) return Promise.resolve(w.__spotifyAPI);
      if (!w.__spotifyAPIPromise) {
        w.__spotifyAPIPromise = new Promise((resolve) => {
          w.onSpotifyIframeApiReady = (IFrameAPI: any) => { w.__spotifyAPI = IFrameAPI; resolve(IFrameAPI); };
        });
      }
      return w.__spotifyAPIPromise;
    }

    function ensureSpController(initialUri: string): Promise<any> {
      if (w.__spController) return Promise.resolve(w.__spController);
      if (!w.__spControllerPromise) {
        w.__spControllerPromise = getSpotifyIframeAPI().then((IFrameAPI: any) => new Promise((resolve) => {
          const el = document.getElementById('sp-embed');
          IFrameAPI.createController(el, { uri: initialUri, width: '100%', height: '166' }, (EmbedController: any) => {
            w.__spController = EmbedController;
            (w as any).__spDurationMs = 0;
            EmbedController.addListener('playback_update', (e: any) => {
              if (state.currentSource !== 'spotify') return;
              const d = e.data || {};
              (w as any).__spDurationMs = d.duration || 0;
              playerDiv.classList.toggle('playing', !d.isPaused);
              if ('mediaSession' in navigator) navigator.mediaSession.playbackState = d.isPaused ? 'paused' : 'playing';
              setPlayIcon(d.isPaused ? '▶' : '⏸');
              if (scrubFill && d.duration) scrubFill.style.width = ((d.position / d.duration) * 100) + '%';
              if (d.duration) setPlayerWaveProgress(d.position / d.duration);
              if (playerTimeEl) playerTimeEl.textContent = `${fmtMs(d.position || 0)} / ${fmtMs(d.duration || 0)}`;
              if (miniTimeEl) miniTimeEl.textContent = fmtMs(d.position || 0);
            });
            resolve(EmbedController);
          });
        }));
      }
      return w.__spControllerPromise;
    }

    // ===== v1.26: Spotify OAuth (PKCE) + Web Playback SDK — full playback pour comptes Premium connectes =====
    const SP_CLIENT_ID    = 'f10100812b4146f199243927da29d982';
    const SP_REDIRECT_URI = 'https://hamcat.live';
    const SP_SCOPES       = 'streaming user-read-email user-read-private user-modify-playback-state user-library-read user-library-modify';

    function spRandomString(len: number): string {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
      const rnd = crypto.getRandomValues(new Uint8Array(len));
      let s = '';
      for (let i = 0; i < len; i++) s += chars[rnd[i] % chars.length];
      return s;
    }

    function spBase64UrlEncode(buf: ArrayBuffer): string {
      const bytes = new Uint8Array(buf);
      let str = '';
      for (let i = 0; i < bytes.length; i++) str += String.fromCharCode(bytes[i]);
      return btoa(str).split('+').join('-').split('/').join('_').replace(/=+$/, '');
    }

    async function spPkceChallenge(verifier: string): Promise<string> {
      const data = new TextEncoder().encode(verifier);
      const digest = await crypto.subtle.digest('SHA-256', data);
      return spBase64UrlEncode(digest);
    }

    async function spStartAuth() {
      const verifier = spRandomString(64);
      try { sessionStorage.setItem('sp_pkce_verifier', verifier); } catch (_) {}
      const challenge = await spPkceChallenge(verifier);
      const params = new URLSearchParams({
        client_id: SP_CLIENT_ID,
        response_type: 'code',
        redirect_uri: SP_REDIRECT_URI,
        code_challenge_method: 'S256',
        code_challenge: challenge,
        scope: SP_SCOPES,
      });
      location.href = 'https://accounts.spotify.com/authorize?' + params.toString();
    }

    function spGetTokens(): any {
      try { return JSON.parse(localStorage.getItem('hamcat-spotify-auth') || 'null'); } catch (_) { return null; }
    }

    function spSaveTokens(tok: any): any {
      const prev = spGetTokens();
      const data = {
        access_token: tok.access_token,
        refresh_token: tok.refresh_token || prev?.refresh_token,
        expires_at: Date.now() + ((tok.expires_in || 3600) * 1000) - 30000,
      };
      try { localStorage.setItem('hamcat-spotify-auth', JSON.stringify(data)); } catch (_) {}
      return data;
    }

    async function spExchangeCode(code: string): Promise<any> {
      let verifier = '';
      try { verifier = sessionStorage.getItem('sp_pkce_verifier') || ''; } catch (_) {}
      if (!verifier) return null;
      try {
        const res = await fetch('https://accounts.spotify.com/api/token', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            grant_type: 'authorization_code',
            code,
            redirect_uri: SP_REDIRECT_URI,
            client_id: SP_CLIENT_ID,
            code_verifier: verifier,
          }),
        });
        try { sessionStorage.removeItem('sp_pkce_verifier'); } catch (_) {}
        if (!res.ok) return null;
        return spSaveTokens(await res.json());
      } catch (_) { return null; }
    }

    async function spRefreshToken(): Promise<any> {
      const cur = spGetTokens();
      if (!cur?.refresh_token) return null;
      try {
        const res = await fetch('https://accounts.spotify.com/api/token', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            grant_type: 'refresh_token',
            refresh_token: cur.refresh_token,
            client_id: SP_CLIENT_ID,
          }),
        });
        if (!res.ok) return null;
        return spSaveTokens(await res.json());
      } catch (_) { return null; }
    }

    async function spGetValidToken(): Promise<string | null> {
      let t = spGetTokens();
      if (!t) return null;
      if (Date.now() >= t.expires_at) t = await spRefreshToken();
      return t?.access_token || null;
    }

    function spDisconnect() {
      try { localStorage.removeItem('hamcat-spotify-auth'); } catch (_) {}
      if (w.__spWebPlayer) { try { w.__spWebPlayer.disconnect(); } catch (_) {} }
      w.__spWebPlayer = null; w.__spDeviceId = null; w.__spWebPlayerPromise = null;
      updateSpotifyConnectBtn(state.currentSource);
    }

    // ===== v1.35: SoundCloud OAuth (Authorization Code) + like/unlike =====
    // SC ne supporte pas PKCE : le client_secret reste côté Worker (/api/sc/token, /api/sc/refresh)
    const SC_CLIENT_ID    = 'X1d2YEhZ7BzT6ybpYARvrEHHWYpAD7FL';
    const SC_REDIRECT_URI = 'https://hamcat.live';
    const SC_AUTH_URL     = 'https://soundcloud.com/connect';

    function scRandomStr(len: number): string {
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
      const rnd = crypto.getRandomValues(new Uint8Array(len));
      let s = '';
      for (let i = 0; i < len; i++) s += chars[rnd[i] % chars.length];
      return s;
    }

    async function scStartAuth() {
      const state2 = 'sc_' + scRandomStr(16);
      try { sessionStorage.setItem('sc_oauth_state', state2); } catch (_) {}
      const params = new URLSearchParams({
        client_id:     SC_CLIENT_ID,
        redirect_uri:  SC_REDIRECT_URI,
        response_type: 'code',
        scope:         'non-expiring',
        state:         state2,
      });
      location.href = SC_AUTH_URL + '?' + params.toString();
    }

    function scGetTokens(): any {
      try { return JSON.parse(localStorage.getItem('hamcat-sc-auth') || 'null'); } catch (_) { return null; }
    }

    function scSaveTokens(tok: any): any {
      const prev = scGetTokens();
      const data = {
        access_token:  tok.access_token,
        refresh_token: tok.refresh_token || prev?.refresh_token,
        // SC avec scope=non-expiring : pas d'expires_in, on met 1 an par défaut
        expires_at: Date.now() + ((tok.expires_in || 31536000) * 1000) - 30000,
      };
      try { localStorage.setItem('hamcat-sc-auth', JSON.stringify(data)); } catch (_) {}
      return data;
    }

    async function scExchangeCode(code: string): Promise<any> {
      try {
        const res = await fetch('/api/sc/token', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ code, redirect_uri: SC_REDIRECT_URI }),
        });
        if (!res.ok) return null;
        return scSaveTokens(await res.json());
      } catch (_) { return null; }
    }

    async function scRefreshToken(): Promise<any> {
      const cur = scGetTokens();
      if (!cur?.refresh_token) return null;
      try {
        const res = await fetch('/api/sc/refresh', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ refresh_token: cur.refresh_token }),
        });
        if (!res.ok) return null;
        return scSaveTokens(await res.json());
      } catch (_) { return null; }
    }

    async function scGetValidToken(): Promise<string | null> {
      let t = scGetTokens();
      if (!t) return null;
      if (Date.now() >= t.expires_at) t = await scRefreshToken();
      return t?.access_token || null;
    }

    function scDisconnect() {
      try { localStorage.removeItem('hamcat-sc-auth'); } catch (_) {}
      updateSCConnectBtn(state.currentSource);
    }

    function updateSCConnectBtn(src?: string | null) {
      const connectBtn = playerDiv.querySelector('#btn-sc-connect') as HTMLButtonElement;
      const likeBtn    = playerDiv.querySelector('#btn-sc-like')    as HTMLButtonElement;
      const authed = !!scGetTokens();
      const isSC   = src === 'soundcloud';
      if (connectBtn) connectBtn.hidden = !isSC || authed;
      if (likeBtn)    likeBtn.hidden    = !isSC || !authed;
    }

    async function scCheckLiked(trackId: string | number) {
      const token  = await scGetValidToken();
      const likeBtn = playerDiv.querySelector('#btn-sc-like') as HTMLButtonElement;
      if (!token || !trackId || !likeBtn) return;
      try {
        const res = await fetch(`/api/sc/liked-ids?ids=${trackId}`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) return;
        const data = await res.json();
        const liked = (data.liked || []).includes(String(trackId));
        likeBtn.textContent = liked ? '♥' : '♡';
        likeBtn.dataset.liked = liked ? '1' : '0';
      } catch (_) {}
    }

    async function scToggleLike() {
      const trackId = (w as any).__scCurrentTrackId;
      const token   = await scGetValidToken();
      const likeBtn = playerDiv.querySelector('#btn-sc-like') as HTMLButtonElement;
      if (!trackId || !token || !likeBtn) return;
      const liked = likeBtn.dataset.liked === '1';
      try {
        await fetch('/api/sc/like', {
          method:  'POST',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
          body:    JSON.stringify({ track_id: trackId, liked: !liked }),
        });
        likeBtn.textContent   = liked ? '♡' : '♥';
        likeBtn.dataset.liked = liked ? '0' : '1';
      } catch (_) {}
    }
    // ===== fin v1.35 SC OAuth =====

    function updateSpotifyConnectBtn(src?: string | null) {
      const btn = playerDiv.querySelector('#btn-spotify-connect') as HTMLButtonElement;
      const authed = !!spGetTokens();
      if (btn) btn.hidden = src !== 'spotify' || authed;
      // v1.27: like uniquement disponible en full playback Spotify (Web Playback SDK)
      const fullMode = src === 'spotify' && !!(w.__spWebPlayer && w.__spDeviceId);
      // v1.32: prev/next disponibles en full playback Spotify ET en SoundCloud (widget pret) —
      // le Widget JS API de SC expose next()/prev() nativement, pas besoin d'OAuth pour ca.
      const navMode = fullMode || (src === 'soundcloud' && !!w.__scWidget);
      const prevBtn = playerDiv.querySelector('#btn-sp-prev') as HTMLButtonElement;
      const nextBtn = playerDiv.querySelector('#btn-sp-next') as HTMLButtonElement;
      const likeBtn = playerDiv.querySelector('#btn-sp-like') as HTMLButtonElement;
      if (prevBtn) prevBtn.hidden = !navMode;
      if (nextBtn) nextBtn.hidden = !navMode;
      if (likeBtn) likeBtn.hidden = !fullMode;
      // v1.34: shuffle/repeat — full playback Spotify uniquement (pas d'equivalent SC widget)
      const shuffleBtn = playerDiv.querySelector('#btn-sp-shuffle') as HTMLButtonElement;
      const repeatBtn = playerDiv.querySelector('#btn-sp-repeat') as HTMLButtonElement;
      if (shuffleBtn) shuffleBtn.hidden = !fullMode;
      if (repeatBtn) repeatBtn.hidden = !fullMode;
      // v1.35: met a jour les boutons SC en meme temps
      updateSCConnectBtn(src);
