---
import { ViewTransitions } from 'astro:transitions';
import { visibleFacets } from '../data/facets';
import siteData from '../data/site.json';

const seo = {
  title:       "Hamcat — DJ · Son · MAO · Événements",
  description: "Fx Jam alias Hamcat : DJ psytrance/hi-tech/goa, ingénieur son FOH, formateur MAO Ableton, co-organisateur ADN Festival. Basé à Grenoble.",
  url:         "https://hamcat.live",
  image:       "https://media.hamcat.live/logos/logo.jpg",
  twitter:     "@hamcat_fx",
};

interface Props {
  title?: string;
  description?: string;
}
const { title = seo.title, description = seo.description } = Astro.props;
const facetHrefs = visibleFacets().map(f => f.href);
---
<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <link rel="canonical" href={seo.url} />
  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={seo.url} />
  <meta property="og:title"       content={seo.title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:image"       content={seo.image} />
  <meta property="og:site_name"   content={siteData.displayName} />
  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={seo.title} />
  <meta name="twitter:description" content={seo.description} />
  <meta name="twitter:image"       content={seo.image} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <ViewTransitions />
  <script src="https://w.soundcloud.com/player/api.js" is:inline></script>

  <style is:global>
    /* ============================================================
       DESIGN TOKENS — hamcat.live
       Source de vérité unique pour palette + typographie.
       Modifier ici se répercute partout dans le site.
       ============================================================ */
    :root {
      /* Couleurs des facettes (arc-en-ciel saturé, ordre = spectre) */
      --facet-son:     oklch(0.65 0.22 25);   /* rouge-orange   ~0 deg spectre  */
      --facet-regie:   oklch(0.75 0.18 80);   /* jaune-or       ~60 deg spectre */
      --facet-cours:   oklch(0.70 0.17 145);  /* vert           ~120 deg spectre */
      --facet-blog:    oklch(0.72 0.14 195);  /* cyan           ~180 deg spectre */
      --facet-outils:  oklch(0.65 0.18 260);  /* bleu           ~240 deg spectre */
      --facet-contact: oklch(0.68 0.20 320);  /* violet-rose    ~300 deg spectre */

      /* Neutres (dark theme) */
      --bg-app: #0b0b10;       /* fond global */
      --bg-surface: #15151c;   /* surfaces / cartes */
      --bg-elevated: #1f1f28;  /* surfaces élevées */
      --border: #2a2a33;       /* bordures discrètes */

      /* Texte */
      --text-primary: #f0f0f5;
      --text-secondary: #9a9aac;
      --text-tertiary: #55555f;

      /* Typographie */
      --font-display: 'Barlow Condensed', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, monospace;

      /* Rayon */
      --radius-lg: 16px;

      /* Panneaux état 2 */
      --panel-max-w: 300px;

      /* Platine — logo central atténué en état actif */
      --logo-dim: 0.15;

      /* Modal état 3 — flou de fond */
      --modal-blur: 10px;

      /* Fond des panels état 2 */
      --panel-bg: color-mix(in srgb, var(--bg-app) 92%, white);
      /* Flip animation */
      --flip-duration: 600ms;
      /* Flip arrows état 1 */
      --flip-arrow-size: 1.4rem;
    }

    /* ============================================================
       RESET & LAYOUT GLOBAL
       Viewport fixe hors modal ; scroll activé avec ?modal=1.
       ============================================================ */
    html, body {
      height: 100%;
      overflow: hidden;
      margin: 0;
      padding: 0;
      background-color: var(--bg-app);
      color: var(--text-primary);
      font-family: var(--font-display);
      -webkit-font-smoothing: antialiased;
    }

    body {
      position: fixed;
      width: 100%;
      overscroll-behavior: none;
    }

    /* Fond de page (image avec opacité réduite) */
    .bg-fond {
      position: fixed;
      inset: 0;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: 0.22;
      pointer-events: none;
      z-index: 0;
    }

    /* Scrollbar discrète, neutre */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-surface); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--text-tertiary); }

    /* ============================================================
       VIEW TRANSITIONS
       Iris depuis le centre (130 px = rayon du disque en état 1).
       Forward : iris s'ouvre. Back : iris se referme.
       ============================================================ */
    @keyframes vt-iris-in {
      from { clip-path: circle(130px at 50% 50%); }
      to   { clip-path: circle(150% at 50% 50%); }
    }
    @keyframes vt-iris-out {
      from { clip-path: circle(150% at 50% 50%); }
      to   { clip-path: circle(130px at 50% 50%); }
    }
    @keyframes vt-fade-out { to   { opacity: 0; } }
    @keyframes vt-fade-in  { from { opacity: 0; } }

    @keyframes needle-bounce {
      0%   { transform: translateX(-50%) scaleY(1); }
      30%  { transform: translateX(-50%) scaleY(1.5) translateY(-3px); }
      65%  { transform: translateX(-50%) scaleY(0.85) translateY(2px); }
      100% { transform: translateX(-50%) scaleY(1); }
    }
    @keyframes facet-snap-pulse {
      0%   { scale: 1;    filter: none; }
      35%  { scale: 1.18; filter: drop-shadow(0 0 10px var(--highlight-c, white)); }
      100% { scale: 1;    filter: none; }
    }
    @keyframes arrow-pulse {
      0%, 100% { opacity: 0.4; transform: translateY(0); }
      50%       { opacity: 1;   transform: translateY(var(--arrow-drift, -4px)); }
    }
    @keyframes modal-enter {
      from { opacity: 0; transform: scale(0.94) translateY(12px); }
      to   { opacity: 1; transform: scale(1)    translateY(0); }
    }
    @keyframes flip-out {
      0%   { transform: perspective(900px) rotateX(0deg); opacity: 1; }
      50%  { transform: perspective(900px) rotateX(calc(var(--flip-dir, 1) * 90deg)); opacity: 0; }
      51%  { transform: perspective(900px) rotateX(calc(var(--flip-dir, 1) * -90deg)); opacity: 0; }
      100% { transform: perspective(900px) rotateX(0deg); opacity: 1; }
    }
    .scene.flipping {
      animation: flip-out var(--flip-duration) cubic-bezier(0.4, 0, 0.2, 1) forwards;
      pointer-events: none;
    }

    /* Aller : nouveau contenu émerge de l'iris, ancien s'efface */
    ::view-transition-old(root) {
      animation: 220ms ease-in both vt-fade-out;
    }
    ::view-transition-new(root) {
      animation: 460ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both vt-iris-in;
    }

    /* Retour : iris se referme, ancien reparaît */
    html[data-astro-transition="back"] ::view-transition-old(root) {
      animation: 460ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both vt-iris-out;
    }
    html[data-astro-transition="back"] ::view-transition-new(root) {
      animation: 220ms ease-out both vt-fade-in;
    }

    /* Respecte la préférence de réduction de mouvement */
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-old(root),
      ::view-transition-new(root) { animation: none; }
    }

    /* ── Player audio persistant ──────────────────────────────── */
    @keyframes play-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: 0.5; transform: scale(0.85); }
    }

    #hamcat-player { position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000; pointer-events: none; }
    #hamcat-player[data-active="true"] { pointer-events: auto; }

    /* Pill — centré, toujours par-dessus */
    .player-mini {
      display: none;
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
    }
    #hamcat-player[data-active="true"] .player-mini { display: block; }
    #hamcat-player[data-expanded="true"] .player-mini { display: none; }

    .player-mini button {
      display: flex; align-items: center; gap: 0.5rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.55rem 1.2rem;
      min-height: 44px;
      cursor: pointer;
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      backdrop-filter: blur(8px);
      white-space: nowrap;
      box-shadow: 0 2px 12px rgba(0,0,0,0.4);
      transition: background 0.15s;
    }
    .player-mini button:hover { background: var(--bg-surface); }

    .play-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--facet-son);
    }
    #hamcat-player.playing .play-dot {
      animation: play-pulse 1.8s ease-in-out infinite;
    }

    /* Transport bar — cachée par défaut */
    .player-full {
      display: none;
      align-items: center;
      gap: 0.75rem;
      height: 56px;
      padding: 0 1.25rem;
      background: var(--bg-elevated);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(8px);
    }
    #hamcat-player[data-active="true"][data-expanded="true"] .player-full { display: flex; }

    #player-artwork {
      width: 40px; height: 40px;
      border-radius: 4px;
      object-fit: cover;
      flex-shrink: 0;
      background: var(--bg-surface);
    }
    .player-meta {
      display: flex; flex-direction: column; justify-content: center;
      min-width: 0; flex: 1;
      gap: 0.1rem;
    }
    #player-title {
      font-family: var(--font-display);
      font-size: 0.88rem;
      color: var(--text-primary);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .source-badge {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      background: var(--facet-son);
      color: #fff;
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      align-self: flex-start;
    }
    .source-badge.sp { background: oklch(0.55 0.22 145); }

    .player-scrubber {
      flex: 1; height: 20px;
      background: transparent;
      cursor: pointer;
      position: relative;
      min-width: 80px;
    }
    .player-scrubber::before {
      content: '';
      position: absolute;
      left: 0; right: 0;
      top: 50%; transform: translateY(-50%);
      height: 3px;
      background: var(--border);
      border-radius: 2px;
    }
    #scrubber-fill {
      position: absolute;
      left: 0; top: 50%; transform: translateY(-50%);
      height: 3px; width: 0%;
      background: var(--facet-son);
      border-radius: 2px;
      pointer-events: none;
    }
    #player-time {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-secondary);
      white-space: nowrap;
      flex-shrink: 0;
    }
    .player-full button {
      background: none; border: none; cursor: pointer;
      font-size: 1rem; color: var(--text-secondary); padding: 0.25rem 0.4rem;
      border-radius: 4px; transition: color 0.15s, background 0.15s;
      flex-shrink: 0;
    }
    .player-full button:hover { color: var(--text-primary); background: var(--bg-surface); }
    #btn-playpause { color: var(--facet-son); font-size: 1.15rem; }
    /* Barre de toggle embed — sous transport, indépendante */
    #embed-toggle-bar {
      display: none;
      text-align: center;
      border-top: 1px solid var(--border);
      background: var(--bg-elevated);
    }
    #embed-toggle-bar .player-embed-toggle {
      width: 100%; background: none; border: none; cursor: pointer;
      padding: 5px 0; color: var(--text-secondary);
      font-family: var(--font-mono); font-size: 0.72rem;
      transition: color 0.15s;
    }
    #embed-toggle-bar .player-embed-toggle:hover { color: var(--text-primary); }
    /* Toujours cacher en mode mini (sur-clasé par !important) */
    #hamcat-player:not([data-expanded='true']) #embed-toggle-bar,
    #hamcat-player:not([data-expanded='true']) #player-embed-zone,
    #hamcat-player:not([data-expanded='true']) #sc-playlist { display: none !important; }
  </style>

  <!-- Mode modal (?modal=1) : scroll activé pour affichage dans iframe -->
  <script is:inline>
    if (new URLSearchParams(location.search).has('modal')) {
      var s = document.createElement('style');
      s.textContent = 'html,body{height:auto!important;overflow:auto!important}body{position:static!important;overscroll-behavior:auto!important}#hamcat-player{display:none!important}';
      document.head.appendChild(s);
    }
  </script>

  <script>
    // ── Navigation clavier inter-facettes ────────────────────
    // ← → : cycle entre facettes (toutes pages sauf accueil)
    // Échap : retour accueil
    // ↑ ↓  : libre (scroll de page)
    import { navigate } from 'astro:transitions/client';

    let ctrl: AbortController | null = null;

    document.addEventListener('astro:page-load', () => {
      ctrl?.abort();

      if (window.location.pathname === '/') return; // turntable gère lui-même

      const el = document.getElementById('facet-nav');
      if (!el) return;
      const hrefs: string[] = JSON.parse(el.dataset.hrefs ?? '[]');

      const path = window.location.pathname;
      const idx  = hrefs.findIndex(h => path === h || path.startsWith(h + '/'));
      if (idx === -1) return; // page hors-facette (/404, etc.)

      const prevHref = hrefs[(idx - 1 + hrefs.length) % hrefs.length];
      const nextHref = hrefs[(idx + 1) % hrefs.length];

      ctrl = new AbortController();
      window.addEventListener('keydown', (e) => {
        if ((e.target as Element).closest('input, textarea, [contenteditable]')) return;
        if      (e.key === 'ArrowLeft')  { e.preventDefault(); navigate(prevHref); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); navigate(nextHref); }
        else if (e.key === 'Escape')     { navigate('/'); }
      }, { signal: ctrl.signal });
    });
  </script>
</head>
<body>
  <!-- Fond de page (si fond_url rempli dans site.json) -->
  {siteData.fond_url && (
    <div
      class="bg-fond"
      style={`background-image: url('${siteData.fond_url}')`}
      aria-hidden="true"
    ></div>
  )}
  <!-- Hrefs des facettes pour la navigation clavier globale -->
  <div id="facet-nav" data-hrefs={JSON.stringify(facetHrefs)} style="display:none" aria-hidden="true"></div>
  <slot />

  <!-- Player UI — 2 états -->
  <div id="hamcat-player" data-active="false" data-expanded="false" transition:persist>

    <!-- État 1 : pill discret (centré bas) -->
    <div class="player-mini">
      <button id="btn-expand" aria-label="Ouvrir le lecteur">
        <span class="play-dot"></span>
        <span id="mini-time">—</span>
        <span id="mini-source" class="source-badge">SC</span>
        <span class="expand-icon">⌃</span>
      </button>
    </div>

    <!-- État 2 : transport bar (pleine largeur) -->
    <div class="player-full">
      <img id="player-artwork" src="" alt="" width="40" height="40" />
      <div class="player-meta">
        <span id="player-title" class="player-label">—</span>
        <span id="player-source-badge" class="source-badge">SC</span>
      </div>
      <button id="btn-playpause" class="player-play-btn" aria-label="Play/Pause">▶</button>
      <div class="player-scrubber" id="player-scrubber" role="progressbar">
        <div id="scrubber-fill"></div>
      </div>
      <span id="player-time">0:00 / 0:00</span>
      <button id="btn-volume" class="player-mute-btn" aria-label="Volume">🔊</button>
      <button id="btn-collapse" aria-label="Réduire">⌄</button>
      <button id="btn-close" aria-label="Fermer">✕</button>
    </div>

    <!-- Barre de toggle embed — indépendante du transport -->
    <div id="embed-toggle-bar">
      <button class="player-embed-toggle" aria-label="Afficher/masquer l'embed">▼</button>
    </div>

    <!-- Zone embed SC / Spotify — iframes pré-créées pour persist garanti -->
    <div id="player-embed-zone" style="position:relative;width:100%;height:166px;display:none;">
      <iframe id="sc-embed" src="" allow="autoplay; encrypted-media" frameborder="no" scrolling="no" style="display:none;width:100%;height:166px;"></iframe>
      <img id="sc-art-overlay" src="" alt="" style="display:none;position:absolute;top:8px;left:8px;width:72px;height:72px;border-radius:2px;object-fit:cover;z-index:2;pointer-events:none;" />
      <iframe id="sp-embed" src="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" style="display:none;width:100%;height:166px;border-radius:12px;"></iframe>
    </div>
    <!-- Playlist SC (remplie dynamiquement par initSCWidget) -->
    <div id="sc-playlist" style="display:none;width:100%;max-height:130px;overflow-y:auto;background:rgba(0,0,0,0.3);border-top:1px solid var(--border);padding:4px 0;box-sizing:border-box;"></div>
  </div>

  {import.meta.env.DEV && (
    <button id="debug-audio-test" style="position:fixed;bottom:80px;right:8px;z-index:9999;font-size:11px;padding:4px 8px;background:#1f1f28;color:#f0f0f5;border:1px solid #2a2a33;border-radius:4px;cursor:pointer">
      Test audio
    </button>
  )}

  <script>
  // ── Player audio persistant v6 — seamless site-wide ────────────────────
  // SC : iframe reload systématique à chaque navigation + seekTo(savedPosition)
  // AbortController : chaque IIFE abort les listeners précédents → pas d'accumulation.

  (function() {
    // Abort previous IIFE's listeners (évite accumulation sur re-exec Astro)
    const w = window as any;
    if (w.__hamcatAbort) w.__hamcatAbort.abort();
    const _abort = new AbortController();
    w.__hamcatAbort = _abort;
    const signal = _abort.signal;
    w.__scWidget = null; // reset widget ref — sera re-set par initSCWidget
    w.__scMuted = false;
    // __hamcatNavigating reset délayé dans astro:page-load (guard SC adoptNode PAUSE)

    const audioEl   = document.getElementById('hamcat-audio')      as HTMLAudioElement;
    const playerDiv = document.getElementById('hamcat-player')!;
    const embedZone = document.getElementById('player-embed-zone') as HTMLDivElement;

    interface HamcatState {
      scIframe:      HTMLIFrameElement | null;
      spIframe:      HTMLIFrameElement | null;
      currentSource: 'audio' | 'soundcloud' | 'spotify' | null;
      currentLbl:    string;
      spExpanded:    boolean;
    }
    w.__hamcat = w.__hamcat || { scIframe: null, spIframe: null, currentSource: null, currentLbl: '', spExpanded: false };
    const state: HamcatState = w.__hamcat;

    const toggleBtn    = playerDiv.querySelector('.player-embed-toggle') as HTMLButtonElement;
    const toggleBar    = document.getElementById('embed-toggle-bar') as HTMLDivElement;
    const playlistEl   = document.getElementById('sc-playlist') as HTMLDivElement;
    const scrubFill    = document.getElementById('scrubber-fill') as HTMLElement;
    const playerTimeEl = document.getElementById('player-time') as HTMLSpanElement;
    const miniTimeEl   = document.getElementById('mini-time') as HTMLSpanElement;
    const scrubberEl   = document.getElementById('player-scrubber') as HTMLElement;
    if (scrubberEl) {
      scrubberEl.addEventListener('click', (e: MouseEvent) => {
        const rect  = scrubberEl.getBoundingClientRect();
        const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        if (state.currentSource === 'soundcloud' && (w as any).__scWidget && (w as any).__scDuration) {
          (w as any).__scWidget.seekTo(ratio * (w as any).__scDuration);
        } else if (state.currentSource === 'audio' && audioEl) {
          audioEl.currentTime = ratio * audioEl.duration;
        }
      });
    }

    function fmtMs(ms: number): string {
      const s = Math.floor(ms / 1000);
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    }

    function updateSCInfo(sound: any) {
      if (!sound) return;
      const title   = sound.title || state.currentLbl || 'SoundCloud';
      const artist  = sound.user?.username || '';
      const artwork = (sound.artwork_url || '').replace('-large', '-t300x300');
      const titleEl = playerDiv.querySelector('#player-title')   as HTMLElement;
      const artEl   = playerDiv.querySelector('#player-artwork') as HTMLImageElement;
      if (titleEl) titleEl.textContent = title;
      if (artwork && artEl) { artEl.src = artwork; artEl.style.display = 'block'; artEl.style.filter = 'none'; }
      const overlayEl = document.getElementById('sc-art-overlay') as HTMLImageElement;
      if (artwork && overlayEl) { overlayEl.src = artwork; overlayEl.style.display = 'block'; overlayEl.style.filter = 'none'; }
      state.currentLbl = title;
      // Media Session API — lock screen / transport bar
      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title,
          artist,
          album: 'hamcat.live',
          artwork: artwork ? [{ src: artwork, sizes: '300x300', type: 'image/jpeg' }] : []
        });
      }
    }

    function saveState(data: object) {
      try { localStorage.setItem('hamcat-player', JSON.stringify(data)); } catch (_) {}
    }

    function initSCWidget(startAtMs = 0, trackIndex = 0, shouldPlay = true) {
      const iframe = state.scIframe;
      if (!iframe || !iframe.src || !(window as any).SC) return;
      const widget = (window as any).SC.Widget(iframe);
      w.__scWidget = widget;
      try {
        widget.unbind((window as any).SC.Widget.Events.READY);
        widget.unbind((window as any).SC.Widget.Events.PLAY_PROGRESS);
        widget.unbind((window as any).SC.Widget.Events.PLAY);
        widget.unbind((window as any).SC.Widget.Events.PAUSE);
      } catch (_) {}
      if (!playlistEl) return;
      widget.bind((window as any).SC.Widget.Events.READY, () => {
        w.__scReloading = false;
        // PLAY_PROGRESS → scrubber + position save
        widget.bind((window as any).SC.Widget.Events.PLAY_PROGRESS, (prog: any) => {
          const pos = prog.currentPosition || 0;
          const rel = prog.relativePosition || 0;
          if (scrubFill) scrubFill.style.width = (rel * 100) + '%';
          if (rel > 0) {
            const dur = pos / rel;
            (w as any).__scDuration = dur;
            if (playerTimeEl) playerTimeEl.textContent = `${fmtMs(pos)} / ${fmtMs(dur)}`;
            if (miniTimeEl) miniTimeEl.textContent = fmtMs(pos);
          }
          try {
            const s = JSON.parse(localStorage.getItem('hamcat-player') || '{}');
            if (s.type === 'soundcloud') {
              s.scPosition = pos;
              localStorage.setItem('hamcat-player', JSON.stringify(s));
            }
          } catch (_) {}
        });
        // PLAY → track index + visual state
        widget.bind((window as any).SC.Widget.Events.PLAY, () => {
          if ('mediaSession' in navigator) navigator.mediaSession.playbackState = 'playing';
          playerDiv.classList.add('playing');
          const pbtn = playerDiv.querySelector('.player-play-btn') as HTMLButtonElement;
          if (pbtn) pbtn.textContent = '⏸';
          // Sauvegarde de l'index du track en cours
          widget.getSounds((sounds: any[]) => {
            widget.getCurrentSound((cur: any) => {
              if (!cur || !sounds) return;
              updateSCInfo(cur);
              const idx = sounds.findIndex((s: any) => s.id === cur.id);
              try {
                const sv = JSON.parse(localStorage.getItem('hamcat-player') || '{}');
                if (sv.type === 'soundcloud') {
                  sv.scTrackIndex = idx >= 0 ? idx : 0;
                  sv.scPlaying = true;
                  localStorage.setItem('hamcat-player', JSON.stringify(sv));
                }
              } catch (_) {}
            });
          });
        });
        // PAUSE → vérifier l'état réel avant de mettre l'UI en pause
        widget.bind((window as any).SC.Widget.Events.PAUSE, () => {
          if (w.__scReloading) return;
          // SC émet PAUSE spurieux pendant adoptNode (transition:persist) même si l'audio continue.
          // widget.isPaused() vérifie l'état réel via postMessage : si l'audio joue encore → ignore.
          widget.isPaused((actuallyPaused: boolean) => {
            if (!actuallyPaused) return;
            if ('mediaSession' in navigator) navigator.mediaSession.playbackState = 'paused';
            playerDiv.classList.remove('playing');
            const pbtn = playerDiv.querySelector('.player-play-btn') as HTMLButtonElement;
            if (pbtn) pbtn.textContent = '▶';
            try {
              const sv = JSON.parse(localStorage.getItem('hamcat-player') || '{}');
              if (sv.type === 'soundcloud') {
                sv.scPlaying = false;
                localStorage.setItem('hamcat-player', JSON.stringify(sv));
              }
            } catch (_) {}
          });
        });
        // Titre + pochette du track courant
        widget.getCurrentSound((sound: any) => updateSCInfo(sound));
        // Media Session transport controls (lock screen, notification bar)
        if ('mediaSession' in navigator) {
          navigator.mediaSession.setActionHandler('play',  () => { try { widget.play();  } catch (_) {} });
          navigator.mediaSession.setActionHandler('pause', () => { try { widget.pause(); } catch (_) {} });
          navigator.mediaSession.setActionHandler('stop',  () => { try { widget.pause(); } catch (_) {} });
          navigator.mediaSession.playbackState = 'playing';
        }
        // Restore: skip vers le bon track puis seek + play
        if (trackIndex > 0 || startAtMs > 100) {
          widget.skip(trackIndex);
          setTimeout(() => {
            if (startAtMs > 0) widget.seekTo(startAtMs);
            if (shouldPlay) widget.play();
          }, 600);
        }
        // Playlist tracks
        widget.getSounds((sounds: any[]) => {
          if (!sounds || sounds.length <= 1) return;
          playlistEl.innerHTML = '';
          sounds.forEach((track: any, idx: number) => {
            const btn = document.createElement('button');
            btn.textContent = track.title || `Track ${idx + 1}`;
            btn.dataset.idx = String(idx);
            btn.style.cssText = 'display:block;width:100%;text-align:left;background:none;border:none;border-bottom:1px solid rgba(255,255,255,0.06);color:var(--text-primary);padding:6px 10px;cursor:pointer;font-size:12px;font-family:inherit;opacity:0.65;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;box-sizing:border-box;';
            btn.addEventListener('mouseenter', () => { btn.style.opacity = '1'; });
            btn.addEventListener('mouseleave', () => { btn.style.opacity = '0.7'; });
            btn.addEventListener('click', () => { widget.skip(idx); widget.play(); });
            playlistEl.appendChild(btn);
          });
          playlistEl.style.display = 'block';
        });
      });
    }

    function updateUI(uiState: 'playing' | 'paused' | 'loading', lbl: string, src?: string) {
      state.currentLbl = lbl;
      const lblEl    = playerDiv.querySelector('.player-label')        as HTMLElement;
      const btn      = playerDiv.querySelector('.player-play-btn')     as HTMLButtonElement;
      const srcBadge = playerDiv.querySelector('#player-source-badge') as HTMLElement;
      const miniSrc  = playerDiv.querySelector('#mini-source')         as HTMLElement;
      if (lblEl) lblEl.textContent = lbl;
      if (btn) {
        btn.setAttribute('data-state', uiState);
        btn.textContent = uiState === 'playing' ? '⏸' : '▶';
      }
      if (src) {
        const badge = src === 'spotify' ? 'SP' : src === 'audio' ? '♪' : 'SC';
        const cls   = src === 'spotify' ? 'source-badge sp' : 'source-badge';
        if (srcBadge) { srcBadge.textContent = badge; srcBadge.className = cls; }
        if (miniSrc)  { miniSrc.textContent  = badge; miniSrc.className  = cls; }
      }
      // Toggle embed visible seulement pour SC/Spotify
      if (toggleBtn) toggleBtn.hidden = (src === 'audio' || src == null);
      if (toggleBar) toggleBar.style.display = (src === 'audio' || src == null) ? 'none' : 'block';
      playerDiv.dataset.active   = 'true';
      playerDiv.dataset.expanded = window.location.pathname !== '/' ? 'true' : 'false';
      playerDiv.classList.toggle('playing', uiState === 'playing');
    }

    function showEmbed() {
      embedZone.style.display = 'block';
      if (toggleBtn) toggleBtn.textContent = '▼';
      if (toggleBar) toggleBar.style.display = 'block';
    }

    function hideEmbedZone() {
      embedZone.style.display = 'none';
      if (toggleBtn) toggleBtn.textContent = '▲';
    }

    function pauseAll() {
      audioEl.pause();
      // SC : widget.pause() direct + postMessage fallback
      if (w.__scWidget) { try { w.__scWidget.pause(); } catch (_) {} }
      if (state.scIframe && state.scIframe.src) {
        try { state.scIframe.contentWindow?.postMessage(JSON.stringify({ method: 'pause' }), '*'); } catch (_) {}
      }
      // Spotify : pas d'API postMessage officielle — vider src est le seul moyen d'arrêter l'audio
      if (state.spIframe) state.spIframe.src = 'about:blank';
      if (state.scIframe) state.scIframe.style.display = 'none';
      if (state.spIframe) state.spIframe.style.display = 'none';
      const artOvl = document.getElementById('sc-art-overlay') as HTMLImageElement;
      if (artOvl) artOvl.style.display = 'none';
      embedZone.style.display = 'none';
      if (playlistEl) playlistEl.style.display = 'none';
      if (toggleBar) toggleBar.style.display = 'none';
    }

    function playAudio(url: string, lbl: string, startAt = 0) {
      pauseAll();
      if (audioEl.src !== url) audioEl.src = url;
      audioEl.currentTime = startAt;
      audioEl.play().catch(console.error);
      state.currentSource = 'audio';
      updateUI('playing', lbl, 'audio');
      saveState({ type: 'audio', url, lbl, position: startAt, playing: true });
    }

    function playSC(url: string, lbl: string, startAtMs = 0, trackIndex = 0, shouldPlay = true) {
      pauseAll();
      if (!state.scIframe) state.scIframe = document.getElementById('sc-embed') as HTMLIFrameElement;
      if (!state.scIframe) return;
      // auto_play=false quand on doit seeker : Widget READY gérera skip+seek+play
      const needsSeek = startAtMs > 100 || trackIndex > 0;
      const autoPlay  = (!needsSeek) && shouldPlay;
      const embedUrl = `https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&auto_play=${autoPlay}&color=%23ff5500&hide_related=true&show_comments=false`;
      // Marque rechargement pour supprimer faux PAUSE sur l'ancien widget
      w.__scReloading = true;
      if (w.__scWidget) {
        try { w.__scWidget.unbind((window as any).SC.Widget.Events.PAUSE); } catch (_) {}
        try { w.__scWidget.unbind((window as any).SC.Widget.Events.PLAY); } catch (_) {}
        w.__scWidget = null;
      }
      // onload + 500ms buffer — plus rapide que timeout fixe 1500ms
      state.scIframe.onload = () => setTimeout(() => initSCWidget(startAtMs, trackIndex, shouldPlay), 500);
      state.scIframe.src = embedUrl;
      state.scIframe.style.height = '166px';
      state.scIframe.style.display = 'block';
      embedZone.style.height = '166px';
      showEmbed();
      if (playlistEl) playlistEl.style.display = 'none';
      if (state.scIframe) state.scIframe.style.filter = 'invert(0.88) hue-rotate(195deg) saturate(0.55)';
      hideEmbedZone();
      // Fallback si onload ne fire pas (ex: same-origin cache)
      setTimeout(() => { if (!w.__scWidget) initSCWidget(startAtMs, trackIndex, shouldPlay); }, 3000);
      state.currentSource = 'soundcloud';
      updateUI(shouldPlay ? 'playing' : 'paused', lbl, 'soundcloud');
      saveState({ type: 'soundcloud', url, lbl, scPosition: startAtMs, scTrackIndex: trackIndex, scPlaying: shouldPlay });
    }

    function playSpotify(playlistId: string, lbl: string) {
      pauseAll();

      // Iframe pré-créée dans le HTML
      if (!state.spIframe) state.spIframe = document.getElementById('sp-embed') as HTMLIFrameElement;
      if (!state.spIframe) return;

      embedZone.style.height = '166px';
      state.spIframe.style.height = '166px';
      state.spIframe.style.display = 'block';
      state.spIframe.src = `https://open.spotify.com/embed/playlist/${playlistId}?utm_source=generator&theme=0`;
      state.spExpanded = false;
      showEmbed();

      state.currentSource = 'spotify';
      updateUI('playing', lbl, 'spotify');
      saveState({ type: 'spotify', playlistId, lbl });
    }

    // Sauvegarde position audio toutes les 5 s
    audioEl.addEventListener('timeupdate', () => {
      if (state.currentSource !== 'audio') return;
      if (Math.round(audioEl.currentTime) % 5 !== 0) return;
      try {
        const saved = JSON.parse(localStorage.getItem('hamcat-player') || '{}');
        if (saved.type === 'audio') {
          saved.position = audioEl.currentTime;
          saved.playing  = !audioEl.paused;
          localStorage.setItem('hamcat-player', JSON.stringify(saved));
        }
      } catch (_) {}
    }, { signal });

    // Avant navigation : bloquer le faux PAUSE émis par le reset d'iframe
    document.addEventListener('astro:before-preparation', () => {
      w.__hamcatNavigating = true;
    }, { signal });

    // Restaure l'UI et l'audio après chaque navigation Astro
    document.addEventListener('astro:page-load', () => {
      // Resync refs (les iframes se reset sur navigation même si #hamcat-player persist)
      if (!state.scIframe) state.scIframe = document.getElementById('sc-embed') as HTMLIFrameElement | null;
      if (!state.spIframe) state.spIframe = document.getElementById('sp-embed') as HTMLIFrameElement | null;
      // Guard SC adoptNode PAUSE : si iframe SC vivante, délayer la levée du flag
      if (state.scIframe?.src?.startsWith('https://w.soundcloud.com')) {
        setTimeout(() => { w.__hamcatNavigating = false; }, 600);
      } else {
        w.__hamcatNavigating = false;
      }

      try {
        const saved = JSON.parse(localStorage.getItem('hamcat-player') || 'null');

        if (window.location.pathname === '/') {
          playerDiv.dataset.expanded = 'false';
          if (!saved) return;
          playerDiv.dataset.active = 'true';
          if (saved.type === 'soundcloud') {
            // Si l'iframe SC est encore vivante (transition:persist), rebinder sans rechargement
            if (state.scIframe?.src?.startsWith('https://w.soundcloud.com')) {
              state.currentSource = 'soundcloud';
              updateUI(saved.scPlaying !== false ? 'playing' : 'paused', saved.lbl, 'soundcloud');
              initSCWidget(0, saved.scTrackIndex || 0, false);
            } else {
              playSC(saved.url, saved.lbl, saved.scPosition || 0, saved.scTrackIndex || 0, saved.scPlaying !== false);
            }
          } else if (saved.type === 'audio') {
            updateUI(!audioEl.paused ? 'playing' : 'paused', saved.lbl, 'audio');
          } else if (saved.type === 'spotify') {
            if (state.spIframe?.src?.includes('open.spotify.com')) {
              updateUI('playing', saved.lbl, 'spotify');
            } else {
              playSpotify(saved.playlistId, saved.lbl);
            }
          }
          return;
        }

        if (!saved) return;

        if (saved.type === 'audio') {
          state.currentSource = 'audio';
          if (audioEl.src && !audioEl.paused) updateUI('playing', saved.lbl, 'audio');
          else if (audioEl.src)               updateUI('paused',  saved.lbl, 'audio');
        } else if (saved.type === 'soundcloud') {
          // Si l'iframe SC est encore vivante (transition:persist), rebinder sans rechargement
          if (state.scIframe?.src?.startsWith('https://w.soundcloud.com')) {
            state.currentSource = 'soundcloud';
            updateUI(saved.scPlaying !== false ? 'playing' : 'paused', saved.lbl, 'soundcloud');
            initSCWidget(0, saved.scTrackIndex || 0, false);
          } else {
            state.currentSource = 'soundcloud';
            playSC(saved.url, saved.lbl, saved.scPosition || 0, saved.scTrackIndex || 0, saved.scPlaying !== false);
          }
        } else if (saved.type === 'spotify') {
          state.currentSource = 'spotify';
          if (state.spIframe?.src?.includes('open.spotify.com')) {
            updateUI('playing', saved.lbl, 'spotify');
          } else {
            playSpotify(saved.playlistId, saved.lbl);
          }
        }
      } catch (_) {}
    }, { signal });

    // hamcat:play — depuis les boutons du site
    document.addEventListener('hamcat:play', (e: any) => {
      const { type, url, playlistId, lbl, startAt } = e.detail;
      if      (type === 'audio')      playAudio(url, lbl, startAt || 0);
      else if (type === 'soundcloud') playSC(url, lbl);
      else if (type === 'spotify')    playSpotify(playlistId, lbl);
    }, { signal });

    // Délégation unique pour tous les boutons du playerDiv
    playerDiv.addEventListener('click', (e) => {
      const target = e.target as Element;

      if (target.closest('.player-play-btn')) {
        if (state.currentSource === 'audio') {
          if (audioEl.paused) { audioEl.play();  updateUI('playing', state.currentLbl, 'audio'); }
          else                { audioEl.pause();  updateUI('paused',  state.currentLbl, 'audio'); }
        } else if (state.currentSource === 'soundcloud' && w.__scWidget) {
          w.__scWidget.isPaused((paused: boolean) => {
            if (paused) w.__scWidget.play();
            else        w.__scWidget.pause();
          });
        }
        return;
      }

      const muteBtn = target.closest('.player-mute-btn');
      if (muteBtn) {
        if (state.currentSource === 'audio') {
          audioEl.muted = !audioEl.muted;
          (muteBtn as HTMLElement).textContent = audioEl.muted ? '🔇' : '🔊';
        } else if (state.currentSource === 'soundcloud' && w.__scWidget) {
          w.__scMuted = !w.__scMuted;
          w.__scWidget.setVolume(w.__scMuted ? 0 : 100);
          (muteBtn as HTMLElement).textContent = w.__scMuted ? '🔇' : '🔊';
        }
        return;
      }

      if (target.closest('.player-embed-toggle')) {
        if (state.currentSource === 'spotify') {
          // Spotify : toujours visible, toggle hauteur 166 ↔ 352px
          state.spExpanded = !state.spExpanded;
          const h = state.spExpanded ? '352px' : '166px';
          if (state.spIframe) state.spIframe.style.height = h;
          embedZone.style.height = h;
          if (toggleBtn) toggleBtn.textContent = state.spExpanded ? '▼' : '▲';
        } else {
          // SC : show/hide classique (ne pas toucher au src)
          if (embedZone.style.display === 'none') {
            embedZone.style.display = 'block';
            if (toggleBtn) toggleBtn.textContent = '▼';
            if (playlistEl && state.currentSource === 'soundcloud') playlistEl.style.display = 'block';
          } else {
            embedZone.style.display = 'none';
            if (toggleBtn) toggleBtn.textContent = '▲';
            if (playlistEl) playlistEl.style.display = 'none';
          }
        }
        return;
      }

      if (target.closest('#btn-expand'))   { playerDiv.dataset.expanded = 'true';  return; }
      if (target.closest('#btn-collapse')) { playerDiv.dataset.expanded = 'false'; return; }

      if (target.closest('#btn-close')) {
        pauseAll();
        audioEl.src = '';
        state.currentSource = null;
        if (state.scIframe) { state.scIframe.src = ''; state.scIframe = null; }
        w.__scWidget = null;
        state.spIframe = null;
        if (toggleBtn) toggleBtn.hidden = true;
        playerDiv.dataset.active   = 'false';
        playerDiv.dataset.expanded = 'false';
        playerDiv.classList.remove('playing');
        try { localStorage.removeItem('hamcat-player'); } catch (_) {}
      }
    }, { signal });

    // Bouton debug (DEV uniquement) — teste la continuité audio cross-page
    document.getElementById('debug-audio-test')?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('hamcat:play', {
        detail: { type: 'audio', url: 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3', lbl: 'Test continuité' }
      }));
    });

  })();
  </script>

  <!-- Moteur audio persistant — transition:persist empêche le rechargement entre pages -->
  <audio id="hamcat-audio" transition:persist preload="none" style="display:none"></audio>

  <!-- Version toast — V affiche le hash git tant que la touche est enfoncée -->
  <div id="version-toast" style="position:fixed;bottom:12px;left:50%;transform:translateX(-50%);font-size:10px;color:rgba(255,255,255,0.35);letter-spacing:0.08em;pointer-events:none;opacity:0;font-family:monospace;z-index:9999;"></div>
  <script>
    declare const __COMMIT__: string;
    const _vt = document.getElementById('version-toast')!;
    _vt.textContent = __COMMIT__;
    document.addEventListener('keydown', (e) => {
      if (e.key === 'v' || e.key === 'V') {
        _vt.style.transition = 'none';
        _vt.style.opacity = '1';
      }
    });
    document.addEventListener('keyup', (e) => {
      if (e.key === 'v' || e.key === 'V') _vt.style.opacity = '0';
    });
  </script>
</body>
</html>
