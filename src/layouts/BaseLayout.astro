---
import { ViewTransitions } from 'astro:transitions';
import { visibleFacets } from '../data/facets';
import siteData from '../data/site.json';

const seo = {
  title:       "Hamcat — DJ · Son · MAO · Événements",
  description: "Fx Jam alias Hamcat : DJ psytrance/hi-tech/goa, ingénieur son FOH, formateur MAO Ableton, co-organisateur ADN Festival. Basé à Grenoble.",
  url:         "https://hamcat.live",
  image:       "https://media.hamcat.live/logos/logo.jpg",
  twitter:     "@hamcat_fx",
};

interface Props {
  title?: string;
  description?: string;
}
const { title = seo.title, description = seo.description } = Astro.props;
const facetHrefs = visibleFacets().map(f => f.href);
---
<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <link rel="canonical" href={seo.url} />
  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={seo.url} />
  <meta property="og:title"       content={seo.title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:image"       content={seo.image} />
  <meta property="og:site_name"   content={siteData.displayName} />
  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={seo.title} />
  <meta name="twitter:description" content={seo.description} />
  <meta name="twitter:image"       content={seo.image} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <ViewTransitions />

  <style is:global>
    /* ============================================================
       DESIGN TOKENS — hamcat.live
       Source de vérité unique pour palette + typographie.
       Modifier ici se répercute partout dans le site.
       ============================================================ */
    :root {
      /* Couleurs des facettes (arc-en-ciel saturé, ordre = spectre) */
      --facet-son:     oklch(0.65 0.22 25);   /* rouge-orange   ~0 deg spectre  */
      --facet-regie:   oklch(0.75 0.18 80);   /* jaune-or       ~60 deg spectre */
      --facet-cours:   oklch(0.70 0.17 145);  /* vert           ~120 deg spectre */
      --facet-blog:    oklch(0.72 0.14 195);  /* cyan           ~180 deg spectre */
      --facet-outils:  oklch(0.65 0.18 260);  /* bleu           ~240 deg spectre */
      --facet-contact: oklch(0.68 0.20 320);  /* violet-rose    ~300 deg spectre */

      /* Neutres (dark theme) */
      --bg-app: #0b0b10;       /* fond global */
      --bg-surface: #15151c;   /* surfaces / cartes */
      --bg-elevated: #1f1f28;  /* surfaces élevées */
      --border: #2a2a33;       /* bordures discrètes */

      /* Texte */
      --text-primary: #f0f0f5;
      --text-secondary: #9a9aac;
      --text-tertiary: #55555f;

      /* Typographie */
      --font-display: 'Barlow Condensed', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, monospace;

      /* Rayon */
      --radius-lg: 16px;

      /* Panneaux état 2 */
      --panel-max-w: 300px;

      /* Platine — logo central atténué en état actif */
      --logo-dim: 0.15;

      /* Modal état 3 — flou de fond */
      --modal-blur: 10px;

      /* Fond des panels état 2 */
      --panel-bg: color-mix(in srgb, var(--bg-app) 92%, white);
      /* Flip animation */
      --flip-duration: 600ms;
      /* Flip arrows état 1 */
      --flip-arrow-size: 1.4rem;
    }

    /* ============================================================
       RESET & LAYOUT GLOBAL
       Viewport fixe hors modal ; scroll activé avec ?modal=1.
       ============================================================ */
    html, body {
      height: 100%;
      overflow: hidden;
      margin: 0;
      padding: 0;
      background-color: var(--bg-app);
      color: var(--text-primary);
      font-family: var(--font-display);
      -webkit-font-smoothing: antialiased;
    }

    body {
      position: fixed;
      width: 100%;
      overscroll-behavior: none;
    }

    /* Fond de page (image avec opacité réduite) */
    .bg-fond {
      position: fixed;
      inset: 0;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: 0.22;
      pointer-events: none;
      z-index: 0;
    }

    /* Scrollbar discrète, neutre */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-surface); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--text-tertiary); }

    /* ============================================================
       VIEW TRANSITIONS
       Iris depuis le centre (130 px = rayon du disque en état 1).
       Forward : iris s'ouvre. Back : iris se referme.
       ============================================================ */
    @keyframes vt-iris-in {
      from { clip-path: circle(130px at 50% 50%); }
      to   { clip-path: circle(150% at 50% 50%); }
    }
    @keyframes vt-iris-out {
      from { clip-path: circle(150% at 50% 50%); }
      to   { clip-path: circle(130px at 50% 50%); }
    }
    @keyframes vt-fade-out { to   { opacity: 0; } }
    @keyframes vt-fade-in  { from { opacity: 0; } }

    @keyframes needle-bounce {
      0%   { transform: translateX(-50%) scaleY(1); }
      30%  { transform: translateX(-50%) scaleY(1.5) translateY(-3px); }
      65%  { transform: translateX(-50%) scaleY(0.85) translateY(2px); }
      100% { transform: translateX(-50%) scaleY(1); }
    }
    @keyframes facet-snap-pulse {
      0%   { scale: 1;    filter: none; }
      35%  { scale: 1.18; filter: drop-shadow(0 0 10px var(--highlight-c, white)); }
      100% { scale: 1;    filter: none; }
    }
    @keyframes arrow-pulse {
      0%, 100% { opacity: 0.4; transform: translateY(0); }
      50%       { opacity: 1;   transform: translateY(var(--arrow-drift, -4px)); }
    }
    @keyframes modal-enter {
      from { opacity: 0; transform: scale(0.94) translateY(12px); }
      to   { opacity: 1; transform: scale(1)    translateY(0); }
    }
    @keyframes flip-out {
      0%   { transform: perspective(900px) rotateX(0deg); opacity: 1; }
      50%  { transform: perspective(900px) rotateX(calc(var(--flip-dir, 1) * 90deg)); opacity: 0; }
      51%  { transform: perspective(900px) rotateX(calc(var(--flip-dir, 1) * -90deg)); opacity: 0; }
      100% { transform: perspective(900px) rotateX(0deg); opacity: 1; }
    }
    .scene.flipping {
      animation: flip-out var(--flip-duration) cubic-bezier(0.4, 0, 0.2, 1) forwards;
      pointer-events: none;
    }

    /* Aller : nouveau contenu émerge de l'iris, ancien s'efface */
    ::view-transition-old(root) {
      animation: 220ms ease-in both vt-fade-out;
    }
    ::view-transition-new(root) {
      animation: 460ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both vt-iris-in;
    }

    /* Retour : iris se referme, ancien reparaît */
    html[data-astro-transition="back"] ::view-transition-old(root) {
      animation: 460ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both vt-iris-out;
    }
    html[data-astro-transition="back"] ::view-transition-new(root) {
      animation: 220ms ease-out both vt-fade-in;
    }

    /* Respecte la préférence de réduction de mouvement */
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-old(root),
      ::view-transition-new(root) { animation: none; }
    }

    /* ── Player audio persistant ──────────────────────────────── */
    @keyframes play-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: 0.5; transform: scale(0.85); }
    }

    #hamcat-player { position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000; pointer-events: none; }
    #hamcat-player[data-active="true"] { pointer-events: auto; }

    /* Pill — centré, toujours par-dessus */
    .player-mini {
      display: none;
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
    }
    #hamcat-player[data-active="true"] .player-mini { display: block; }
    #hamcat-player[data-expanded="true"] .player-mini { display: none; }

    .player-mini button {
      display: flex; align-items: center; gap: 0.5rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.35rem 0.75rem;
      cursor: pointer;
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      backdrop-filter: blur(8px);
      white-space: nowrap;
      box-shadow: 0 2px 12px rgba(0,0,0,0.4);
      transition: background 0.15s;
    }
    .player-mini button:hover { background: var(--bg-surface); }

    .play-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--facet-son);
    }
    #hamcat-player.playing .play-dot {
      animation: play-pulse 1.8s ease-in-out infinite;
    }

    /* Transport bar — cachée par défaut */
    .player-full {
      display: none;
      align-items: center;
      gap: 0.75rem;
      height: 56px;
      padding: 0 1.25rem;
      background: var(--bg-elevated);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(8px);
    }
    #hamcat-player[data-active="true"][data-expanded="true"] .player-full { display: flex; }

    #player-artwork {
      width: 40px; height: 40px;
      border-radius: 4px;
      object-fit: cover;
      flex-shrink: 0;
      background: var(--bg-surface);
    }
    .player-meta {
      display: flex; flex-direction: column; justify-content: center;
      min-width: 0; flex: 1;
      gap: 0.1rem;
    }
    #player-title {
      font-family: var(--font-display);
      font-size: 0.88rem;
      color: var(--text-primary);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .source-badge {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      background: var(--facet-son);
      color: #fff;
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      align-self: flex-start;
    }
    .source-badge.sp { background: oklch(0.55 0.22 145); }

    .player-scrubber {
      flex: 1; height: 3px;
      background: var(--border);
      border-radius: 2px;
      cursor: pointer;
      position: relative;
      min-width: 80px;
    }
    #scrubber-fill {
      height: 100%; width: 0%;
      background: var(--facet-son);
      border-radius: 2px;
      pointer-events: none;
    }
    #player-time {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-secondary);
      white-space: nowrap;
      flex-shrink: 0;
    }
    .player-full button {
      background: none; border: none; cursor: pointer;
      font-size: 1rem; color: var(--text-secondary); padding: 0.25rem 0.4rem;
      border-radius: 4px; transition: color 0.15s, background 0.15s;
      flex-shrink: 0;
    }
    .player-full button:hover { color: var(--text-primary); background: var(--bg-surface); }
    #btn-playpause { color: var(--facet-son); font-size: 1.15rem; }
  </style>

  <!-- Mode modal (?modal=1) : scroll activé pour affichage dans iframe -->
  <script is:inline>
    if (new URLSearchParams(location.search).has('modal')) {
      var s = document.createElement('style');
      s.textContent = 'html,body{height:auto!important;overflow:auto!important}body{position:static!important;overscroll-behavior:auto!important}';
      document.head.appendChild(s);
    }
  </script>

  <script>
    // ── Navigation clavier inter-facettes ────────────────────
    // ← → : cycle entre facettes (toutes pages sauf accueil)
    // Échap : retour accueil
    // ↑ ↓  : libre (scroll de page)
    import { navigate } from 'astro:transitions/client';

    let ctrl: AbortController | null = null;

    document.addEventListener('astro:page-load', () => {
      ctrl?.abort();

      if (window.location.pathname === '/') return; // turntable gère lui-même

      const el = document.getElementById('facet-nav');
      if (!el) return;
      const hrefs: string[] = JSON.parse(el.dataset.hrefs ?? '[]');

      const path = window.location.pathname;
      const idx  = hrefs.findIndex(h => path === h || path.startsWith(h + '/'));
      if (idx === -1) return; // page hors-facette (/404, etc.)

      const prevHref = hrefs[(idx - 1 + hrefs.length) % hrefs.length];
      const nextHref = hrefs[(idx + 1) % hrefs.length];

      ctrl = new AbortController();
      window.addEventListener('keydown', (e) => {
        if ((e.target as Element).closest('input, textarea, [contenteditable]')) return;
        if      (e.key === 'ArrowLeft')  { e.preventDefault(); navigate(prevHref); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); navigate(nextHref); }
        else if (e.key === 'Escape')     { navigate('/'); }
      }, { signal: ctrl.signal });
    });
  </script>
</head>
<body>
  <!-- Fond de page (si fond_url rempli dans site.json) -->
  {siteData.fond_url && (
    <div
      class="bg-fond"
      style={`background-image: url('${siteData.fond_url}')`}
      aria-hidden="true"
    ></div>
  )}
  <!-- Hrefs des facettes pour la navigation clavier globale -->
  <div id="facet-nav" data-hrefs={JSON.stringify(facetHrefs)} style="display:none" aria-hidden="true"></div>
  <slot />

  <!-- Audio bridge — jamais swappé par Astro -->
  <iframe
    id="audio-worker-frame"
    src="/audio-worker.html"
    transition:persist
    allow="autoplay"
    style="position:fixed;bottom:-2px;left:-2px;width:1px;height:1px;opacity:0;pointer-events:none;border:none"
  ></iframe>

  <!-- Player UI — 2 états -->
  <div id="hamcat-player" data-active="false" data-expanded="false" transition:persist>

    <!-- État 1 : pill discret (centré bas) -->
    <div class="player-mini">
      <button id="btn-expand" aria-label="Ouvrir le lecteur">
        <span class="play-dot"></span>
        <span id="mini-time">—</span>
        <span id="mini-source" class="source-badge">SC</span>
        <span class="expand-icon">⌃</span>
      </button>
    </div>

    <!-- État 2 : transport bar (pleine largeur) -->
    <div class="player-full">
      <img id="player-artwork" src="" alt="" width="40" height="40" />
      <div class="player-meta">
        <span id="player-title">—</span>
        <span id="player-source-badge" class="source-badge">SC</span>
      </div>
      <button id="btn-playpause" aria-label="Play/Pause">▶</button>
      <div class="player-scrubber" id="player-scrubber" role="progressbar">
        <div id="scrubber-fill"></div>
      </div>
      <span id="player-time">0:00 / 0:00</span>
      <button id="btn-volume" aria-label="Volume">🔊</button>
      <button id="btn-collapse" aria-label="Réduire">⌄</button>
      <button id="btn-close" aria-label="Fermer">✕</button>
    </div>

    <!-- Spotify direct embed (dans le player, pas dans le bridge) -->
    <iframe id="sp-iframe" src="" allow="autoplay"
      style="display:none;position:absolute;bottom:56px;left:0;right:0;width:100%;height:80px;border:none"></iframe>
  </div>

  <script>
  // ── Player audio persistant v3 — audio bridge ───────────────────────
  // SC passe par /audio-worker.html (iframe jamais touchée par Astro via transition:persist).
  // Spotify reste en embed direct dans le player UI (pas de continuité cross-page, accepté).

  (function () {
    const player   = document.getElementById('hamcat-player')    as HTMLDivElement;
    if (!player || player.dataset.init === '1') return;
    player.dataset.init = '1';

    const worker   = document.getElementById('audio-worker-frame') as HTMLIFrameElement;
    const spIframe = document.getElementById('sp-iframe')          as HTMLIFrameElement;

    const btnPlay     = document.getElementById('btn-playpause')   as HTMLButtonElement;
    const btnVol      = document.getElementById('btn-volume')       as HTMLButtonElement;
    const btnClose    = document.getElementById('btn-close')        as HTMLButtonElement;
    const btnExpand   = document.getElementById('btn-expand')       as HTMLButtonElement;
    const btnCollapse = document.getElementById('btn-collapse')     as HTMLButtonElement;
    const scrubber    = document.getElementById('player-scrubber')  as HTMLDivElement;
    const scrubFill   = document.getElementById('scrubber-fill')    as HTMLDivElement;
    const artwork     = document.getElementById('player-artwork')   as HTMLImageElement;
    const titleEl     = document.getElementById('player-title')     as HTMLSpanElement;
    const sourceBadge = document.getElementById('player-source-badge') as HTMLSpanElement;
    const miniBadge   = document.getElementById('mini-source')      as HTMLSpanElement;
    const miniTime    = document.getElementById('mini-time')        as HTMLSpanElement;
    const timeEl      = document.getElementById('player-time')      as HTMLSpanElement;

    let source: 'soundcloud' | 'spotify' | null = null;
    let isPlaying = false;
    let isMuted   = false;
    let totalSec  = 0;

    const fallbackArtwork = 'https://media.hamcat.live/logos/logo.jpg';

    function cmd(o: object) { worker.contentWindow?.postMessage(o, '*'); }

    function fmt(s: number) {
      const m = Math.floor(s / 60), sec = Math.floor(s % 60);
      return `${m}:${sec.toString().padStart(2, '0')}`;
    }

    function setActive(v: boolean) { player.dataset.active = String(v); }

    function setExpanded(v: boolean) {
      if (v && window.location.pathname === '/') return;
      player.dataset.expanded = String(v);
    }

    // Messages depuis l'audio-worker (SC)
    window.addEventListener('message', (e) => {
      const d = e.data; if (!d?.evt) return;
      switch (d.evt) {
        case 'state':
          isPlaying = d.playing;
          btnPlay.textContent = isPlaying ? '⏸' : '▶';
          player.classList.toggle('playing', isPlaying);
          break;
        case 'progress':
          totalSec = d.total;
          scrubFill.style.width = `${d.ratio * 100}%`;
          miniTime.textContent  = fmt(d.elapsed);
          timeEl.textContent    = `${fmt(d.elapsed)} / ${fmt(d.total)}`;
          break;
        case 'track-info':
          titleEl.textContent = d.title || '—';
          artwork.src = d.artwork || fallbackArtwork;
          artwork.onerror = () => { artwork.src = fallbackArtwork; };
          break;
      }
    });

    // Scrubber
    scrubber.addEventListener('click', (e) => {
      if (source !== 'soundcloud') return;
      const r = (e.clientX - scrubber.getBoundingClientRect().left) / scrubber.offsetWidth;
      cmd({ cmd: 'seek', posMs: Math.round(r * totalSec * 1000) });
    });

    btnPlay.addEventListener('click', () => {
      if (source === 'soundcloud') cmd(isPlaying ? { cmd: 'pause' } : { cmd: 'resume' });
    });

    btnVol.addEventListener('click', () => {
      isMuted = !isMuted;
      btnVol.textContent = isMuted ? '🔇' : '🔊';
      cmd({ cmd: 'volume', value: isMuted ? 0 : 100 });
    });

    btnExpand.addEventListener('click',   () => setExpanded(true));
    btnCollapse.addEventListener('click', () => setExpanded(false));

    btnClose.addEventListener('click', () => {
      cmd({ cmd: 'close' });
      spIframe.src = ''; spIframe.style.display = 'none';
      source = null; isPlaying = false;
      player.classList.remove('playing');
      setActive(false); setExpanded(false);
      try { localStorage.removeItem('hamcat-player'); } catch (_) {}
    });

    // Événement depuis son.astro (et autres pages)
    document.addEventListener('hamcat:play', (e: Event) => {
      const d = (e as CustomEvent).detail;

      if (d.type === 'soundcloud') {
        cmd({ cmd: 'close' });
        spIframe.src = ''; spIframe.style.display = 'none';
        source = 'soundcloud';
        titleEl.textContent = d.lbl;
        artwork.src = fallbackArtwork;
        sourceBadge.textContent = 'SC'; sourceBadge.className = 'source-badge';
        miniBadge.textContent   = 'SC'; miniBadge.className   = 'source-badge';
        cmd({ cmd: 'play-sc', url: d.url });
        setActive(true);
        try { localStorage.setItem('hamcat-player', JSON.stringify({ type: 'soundcloud', url: d.url, lbl: d.lbl })); } catch (_) {}

      } else if (d.type === 'spotify') {
        cmd({ cmd: 'close' });
        source = 'spotify';
        titleEl.textContent = d.lbl;
        artwork.src = fallbackArtwork;
        sourceBadge.textContent = 'SP'; sourceBadge.className = 'source-badge sp';
        miniBadge.textContent   = 'SP'; miniBadge.className   = 'source-badge sp';
        spIframe.src = `https://open.spotify.com/embed/playlist/${d.playlistId}?autoplay=1&theme=0`;
        spIframe.style.display = 'block';
        isPlaying = true; player.classList.add('playing');
        btnPlay.textContent = '⏸';
        setActive(true);
        try { localStorage.setItem('hamcat-player', JSON.stringify({ type: 'spotify', playlistId: d.playlistId, lbl: d.lbl })); } catch (_) {}
      }
    });

    // Homepage → forcer mini (pill uniquement)
    document.addEventListener('astro:page-load', () => {
      if (window.location.pathname === '/') setExpanded(false);
    });

    // Restore après hard reload (ignoré sur homepage)
    if (window.location.pathname !== '/') {
      try {
        const saved = localStorage.getItem('hamcat-player');
        if (saved) {
          const s = JSON.parse(saved);
          document.dispatchEvent(new CustomEvent('hamcat:play', { detail:
            s.type === 'soundcloud'
              ? { type: 'soundcloud', url: s.url, lbl: s.lbl }
              : { type: 'spotify', playlistId: s.playlistId, lbl: s.lbl }
          }));
        }
      } catch (_) {}
    }
  })();
  </script>
</body>
</html>
