    async function spCheckLiked(trackId: string) {
      const token = await spGetValidToken();
      const likeBtn = playerDiv.querySelector('#btn-sp-like') as HTMLButtonElement;
      if (!token || !trackId || !likeBtn) return;
      try {
        const res = await fetch(`https://api.spotify.com/v1/me/tracks/contains?ids=${trackId}`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) return;
        const data = await res.json();
        const liked = !!data[0];
        likeBtn.textContent = liked ? '♥' : '♡';
        likeBtn.dataset.liked = liked ? '1' : '0';
      } catch (_) {}
    }

    async function spToggleLike() {
      const trackId = w.__spCurrentTrackId;
      const token = await spGetValidToken();
      const likeBtn = playerDiv.querySelector('#btn-sp-like') as HTMLButtonElement;
      if (!trackId || !token || !likeBtn) return;
      const liked = likeBtn.dataset.liked === '1';
      try {
        await fetch(`https://api.spotify.com/v1/me/tracks?ids=${trackId}`, {
          method: liked ? 'DELETE' : 'PUT',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
        });
        likeBtn.textContent = liked ? '♡' : '♥';
        likeBtn.dataset.liked = liked ? '0' : '1';
      } catch (_) {}
    }

    // v1.34: shuffle/repeat — API Web Spotify (le SDK ne les pilote pas directement)
    async function spSetShuffle() {
      const token = await spGetValidToken();
      const btn = playerDiv.querySelector('#btn-sp-shuffle') as HTMLButtonElement;
      if (!token || !w.__spDeviceId || !btn) return;
      const next = btn.dataset.active !== '1';
      try {
        await fetch(`https://api.spotify.com/v1/me/player/shuffle?state=${next}&device_id=${w.__spDeviceId}`, {
          method: 'PUT',
          headers: { Authorization: `Bearer ${token}` },
        });
      } catch (_) {}
    }

    const SP_REPEAT_CYCLE = ['off', 'context', 'track'];
    async function spSetRepeat() {
      const token = await spGetValidToken();
      const btn = playerDiv.querySelector('#btn-sp-repeat') as HTMLButtonElement;
      if (!token || !w.__spDeviceId || !btn) return;
      const cur = parseInt(btn.dataset.mode || '0', 10);
      const next = SP_REPEAT_CYCLE[(cur + 1) % 3];
      try {
        await fetch(`https://api.spotify.com/v1/me/player/repeat?state=${next}&device_id=${w.__spDeviceId}`, {
          method: 'PUT',
          headers: { Authorization: `Bearer ${token}` },
        });
      } catch (_) {}
    }

    // Web Playback SDK — singleton, cree un vrai device Spotify Connect pilotable
    function spEnsureWebPlayer(): Promise<string | null> {
      if (w.__spWebPlayerPromise) return w.__spWebPlayerPromise;
      w.__spWebPlayerPromise = new Promise((resolve) => {
        const init = () => {
          const player = new (window as any).Spotify.Player({
            name: 'hamcat.live',
            getOAuthToken: async (cb: (t: string) => void) => {
              const tok = await spGetValidToken();
              if (tok) cb(tok);
            },
            volume: 1,
          });
          player.addListener('ready', ({ device_id }: any) => {
            w.__spDeviceId = device_id;
            hmcLog('[HMC] Spotify Web Playback ready device_id=' + device_id);
            // v1.29: pilotage depuis l'ecran de veille / la barre de notifications
            if ('mediaSession' in navigator) {
              navigator.mediaSession.setActionHandler('play',  () => { try { player.resume();       } catch (_) {} });
              navigator.mediaSession.setActionHandler('pause', () => { try { player.pause();        } catch (_) {} });
              navigator.mediaSession.setActionHandler('previoustrack', () => { try { player.previousTrack(); } catch (_) {} });
              navigator.mediaSession.setActionHandler('nexttrack',     () => { try { player.nextTrack();     } catch (_) {} });
            }
            // v1.36: applique le volume sauvegarde (echelle 0-1 pour le Web Playback SDK)
            try { player.setVolume(getSavedVolume() / 100); } catch (_) {}
            resolve(device_id);
          });
          player.addListener('not_ready', () => { w.__spDeviceId = null; });
          player.addListener('initialization_error', ({ message }: any) => { hmcLog('[HMC] SP SDK initialization_error ' + message); resolve(null); });
          player.addListener('authentication_error', ({ message }: any) => { hmcLog('[HMC] SP SDK authentication_error ' + message); spDisconnect(); resolve(null); });
          player.addListener('account_error', ({ message }: any) => { hmcLog('[HMC] SP SDK account_error (Premium requis) ' + message); resolve(null); });
          player.addListener('player_state_changed', (st: any) => {
            if (!st || state.currentSource !== 'spotify') return;
            const playing = !st.paused;
            playerDiv.classList.toggle('playing', playing);
            setPlayIcon(playing ? '⏸' : '▶');
            if ('mediaSession' in navigator) navigator.mediaSession.playbackState = playing ? 'playing' : 'paused';
            // v1.34: reflete shuffle/repeat (fournis par le SDK a chaque changement d'etat)
            const shuffleBtn = playerDiv.querySelector('#btn-sp-shuffle') as HTMLButtonElement;
            if (shuffleBtn) shuffleBtn.dataset.active = st.shuffle ? '1' : '0';
            const repeatBtn = playerDiv.querySelector('#btn-sp-repeat') as HTMLButtonElement;
            if (repeatBtn) {
              const rm = typeof st.repeat_mode === 'number' ? st.repeat_mode : 0;
              repeatBtn.dataset.mode = String(rm);
              repeatBtn.textContent = rm === 2 ? '🔂' : '🔁';
            }
            const pos = st.position || 0;
            const dur = st.duration || 0;
            if (dur > 0) {
              if (scrubFill) scrubFill.style.width = ((pos / dur) * 100) + '%';
              setPlayerWaveProgress(pos / dur);
              if (playerTimeEl) playerTimeEl.textContent = `${fmtMs(pos)} / ${fmtMs(dur)}`;
              if (miniTimeEl) miniTimeEl.textContent = fmtMs(pos);
            }
            const tr = st.track_window?.current_track;
            if (tr) {
              const title  = tr.name || state.currentLbl || 'Spotify';
              const artist = (tr.artists || []).map((a: any) => a.name).join(', ');
              const artwork = tr.album?.images?.[0]?.url || '';
              const titleEl  = playerDiv.querySelector('#player-title')  as HTMLAnchorElement;
              const artistEl = playerDiv.querySelector('#player-artist') as HTMLElement;
              if (titleEl) {
                // v1.30: titre et artiste sur 2 lignes distinctes (au lieu d'1 chaine concatenee tronquee)
                titleEl.textContent = title;
                // v1.27: lien vers la fiche du titre sur Spotify (savoir ce qui joue)
                if (tr.id) titleEl.href = `https://open.spotify.com/track/${tr.id}`;
                else titleEl.removeAttribute('href');
              }
              if (artistEl) artistEl.textContent = artist;
              state.currentLbl = title;
              const artEl = playerDiv.querySelector('#player-artwork') as HTMLImageElement;
              if (artwork && artEl) { artEl.src = artwork; artEl.style.display = 'block'; artEl.style.filter = 'none'; }
              if ('mediaSession' in navigator) {
                navigator.mediaSession.metadata = new MediaMetadata({ title, artist, album: 'hamcat.live', artwork: artwork ? [{ src: artwork, sizes: '300x300', type: 'image/jpeg' }] : [] });
              }
              // v1.27: verifie l'etat "aime" seulement au changement effectif de piste
              if (tr.id && tr.id !== w.__spCurrentTrackId) {
                w.__spCurrentTrackId = tr.id;
                spCheckLiked(tr.id);
              }
            }
            updateUI(playing ? 'playing' : 'paused', state.currentLbl, 'spotify');
          });
          player.connect();
          w.__spWebPlayer = player;
        };
        if ((window as any).Spotify) init();
        else (window as any).onSpotifyWebPlaybackSDKReady = init;
      });
      return w.__spWebPlayerPromise;
    }

    async function spPlayFull(playlistId: string, lbl: string): Promise<boolean> {
      const deviceId = await spEnsureWebPlayer();
      if (!deviceId) return false;
      const token = await spGetValidToken();
      if (!token) return false;
      try {
        const res = await fetch(`https://api.spotify.com/v1/me/player/play?device_id=${deviceId}`, {
          method: 'PUT',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ context_uri: `spotify:playlist:${playlistId}` }),
        });
        if (!res.ok && res.status !== 204) return false;
        updateSpotifyConnectBtn('spotify');
        return true;
      } catch (_) { return false; }
    }

    function playSpotify(playlistId: string, lbl: string) {
      setPlayerWave('');   // Spotify n'expose pas de pics : barre pleine
      pauseAll();

      state.currentSource = 'spotify';
      updateUI('loading', lbl, 'spotify'); // v1.23: l'etat reel arrive via playback_update / player_state_changed
      saveState({ type: 'spotify', playlistId, lbl });

      // v1.26: si un compte Spotify (Premium) est connecte, tente le full playback (Web Playback SDK)
      if (spGetTokens()) {
        spPlayFull(playlistId, lbl).then((ok: boolean) => {
          if (!ok) playSpotifyPreview(playlistId, lbl); // fallback si pas Premium / erreur SDK
        });
        return;
      }
      playSpotifyPreview(playlistId, lbl);
    }

    // Fallback / mode par defaut : embed IFrame (preview 30s pour non-Premium ou non-connecte)
    function playSpotifyPreview(playlistId: string, lbl: string) {
      if (!state.spIframe) state.spIframe = document.getElementById('sp-embed') as HTMLIFrameElement;
      if (!state.spIframe) return;

      // v1.37: garantie miroir de celle ajoutee dans pauseAll() — au cas ou cette fonction soit
      // un jour appelee hors du chemin pauseAll() -> playSpotify* standard.
      if (state.scIframe) state.scIframe.style.display = 'none';
      const artOvl = document.getElementById('sc-art-overlay') as HTMLImageElement;
      if (artOvl) artOvl.style.display = 'none';
      embedZone.style.height = '166px';
      state.spIframe.style.height = '166px';
      state.spIframe.style.display = 'block';
      state.spExpanded = false;
      showEmbed();
      hideEmbedZone(); // v1.24: masque le player natif Spotify par defaut (bouton expand dispo), comme pour SC

      const uri = `spotify:playlist:${playlistId}`;
      if (w.__spController) {
        try { w.__spController.loadUri(uri); w.__spController.play(); } catch (_) {}
      } else {
        ensureSpController(uri).then((ctrl: any) => { try { ctrl.play(); } catch (_) {} });
      }
    }

    // Scrubber + compteurs de la source "audio".
    // Les sources SC/Spotify ont leurs propres evenements de progression ; l'element <audio>
    // n'en avait aucun, d'ou une barre figee a 0 pendant toute la lecture d'un set.
    audioEl.addEventListener('timeupdate', () => {
      if (state.currentSource !== 'audio') return;
      const dur = audioEl.duration;
      if (isFinite(dur) && dur > 0) {
        if (scrubFill)    scrubFill.style.width = ((audioEl.currentTime / dur) * 100) + '%';
        setPlayerWaveProgress(audioEl.currentTime / dur);
        if (playerTimeEl) playerTimeEl.textContent = `${fmtMs(audioEl.currentTime * 1000)} / ${fmtMs(dur * 1000)}`;
        if (miniTimeEl)   miniTimeEl.textContent = fmtMs(audioEl.currentTime * 1000);
        // Les waveforms affichees dans les pages ecoutent cet evenement pour suivre la lecture.
        emitProgress(audioEl.currentSrc, audioEl.currentTime, dur);
      }
      // Sauvegarde position toutes les 5 s
      if (Math.round(audioEl.currentTime) % 5 !== 0) return;
      try {
        const saved = JSON.parse(localStorage.getItem('hamcat-player') || '{}');
        if (saved.type === 'audio') {
          saved.position = audioEl.currentTime;
          saved.playing  = !audioEl.paused;
          localStorage.setItem('hamcat-player', JSON.stringify(saved));
        }
      } catch (_) {}
    }, { signal });

    document.addEventListener('astro:after-swap', () => hmcLog('[HMC] after-swap → ' + location.pathname), { signal });
    // Restaure l'UI et l'audio après chaque navigation Astro
    document.addEventListener('astro:page-load', () => {
      // Resync refs (les iframes se reset sur navigation même si #hamcat-player persist)
      if (!state.scIframe) state.scIframe = document.getElementById('sc-embed') as HTMLIFrameElement | null;
      if (!state.spIframe) state.spIframe = document.getElementById('sp-embed') as HTMLIFrameElement | null;
      // v1.20: sonde — ne doit JAMAIS logger apres une navigation (1 seul log legitime au 1er chargement)
      if (state.scIframe && !(state.scIframe as any).__hmcLoadProbe) {
        (state.scIframe as any).__hmcLoadProbe = true;
        state.scIframe.addEventListener('load', () => hmcLog('[HMC] ⚠ SC iframe (re)loaded on', location.pathname));
      }
      try {
        const saved = JSON.parse(localStorage.getItem('hamcat-player') || 'null');

        if (window.location.pathname === '/') {
          playerDiv.dataset.expanded = 'false';
          if (!saved) return;

          // L'accueil repart d'une page blanche sonore. Une lecture EN COURS
          // n'est jamais coupee — on ne va pas arreter la musique parce que le
          // visiteur revient au disque. Mais un chargement a froid sur / ne
          // ressuscite plus la derniere piste : la memoire reste en place
          // (localStorage intact), elle sert quand on repart vers une facette.
          const lectureVivante =
               (state.currentSource === 'audio' && !audioEl.paused)
            || !!w.__scWidget
            || !!(w as any).__spController
            || playerDiv.classList.contains('playing');
          if (!lectureVivante) {
            playerDiv.dataset.active = 'false';
            return;
          }

          playerDiv.dataset.active = 'true';
          if (saved.type === 'soundcloud') {
            // Si l'iframe SC est encore vivante (transition:persist), rebinder sans rechargement
            if (state.scIframe?.src?.startsWith('https://w.soundcloud.com')) {
              state.currentSource = 'soundcloud';
              const _spH = saved.scPlaying !== false;
              hmcLog('[HMC] HOME: shouldPlay=', _spH);
              // v1.22: pas d'autoplay mobile au reload (iOS bloque → PLAY/PAUSE fantome) — tap relance
              updateUI((playerDiv.classList.contains('playing') || (_spH && !_isMobile && !w.__scWidget)) ? 'playing' : 'paused', saved.lbl, 'soundcloud');
              if (w.__scWidget) {
                // v1.20: iframe jamais rechargee → l'audio continue tel quel, rien a faire
              } else {
                initSCWidget(0, saved.scTrackIndex || 0, false);
                if (_spH && !_isMobile) { setTimeout(() => { try { w.__scWidget?.play(); } catch (_ph) {} }, 800); }
              }
            } else {
              playSC(saved.url, saved.lbl, saved.scPosition || 0, saved.scTrackIndex || 0, saved.scPlaying !== false, true); // v1.22: isRestore
            }
          } else if (saved.type === 'audio') {
            updateUI(!audioEl.paused ? 'playing' : 'paused', saved.lbl, 'audio');
            setAudioArtwork(saved.art || '');
          } else if (saved.type === 'spotify') {
            if ((w as any).__spController || ((w as any).__spWebPlayer && (w as any).__spDeviceId)) {
              updateUI('playing', saved.lbl, 'spotify');
            } else {
              playSpotify(saved.playlistId, saved.lbl);
            }
          }
          return;
        }

        if (!saved) return;

        if (saved.type === 'audio') {
          state.currentSource = 'audio';
          if (audioEl.src && !audioEl.paused) updateUI('playing', saved.lbl, 'audio');
          else if (audioEl.src)               updateUI('paused',  saved.lbl, 'audio');
          if (audioEl.src) setAudioArtwork(saved.art || '');
        } else if (saved.type === 'soundcloud') {
          // Si l'iframe SC est encore vivante (transition:persist), rebinder sans rechargement
          if (state.scIframe?.src?.startsWith('https://w.soundcloud.com')) {
            state.currentSource = 'soundcloud';
            const _spP = saved.scPlaying !== false;
            hmcLog('[HMC] PAGE: shouldPlay=', _spP);
            // v1.22: pas d'autoplay mobile au reload (iOS bloque → PLAY/PAUSE fantome) — tap relance
            updateUI((playerDiv.classList.contains('playing') || (_spP && !_isMobile && !w.__scWidget)) ? 'playing' : 'paused', saved.lbl, 'soundcloud');
            if (w.__scWidget) {
              // v1.20: iframe jamais rechargee → l'audio continue tel quel, rien a faire
            } else {
              initSCWidget(0, saved.scTrackIndex || 0, false);
              if (_spP && !_isMobile) { setTimeout(() => { try { w.__scWidget?.play(); } catch (_pp) {} }, 800); }
            }
          } else {
            state.currentSource = 'soundcloud';
            playSC(saved.url, saved.lbl, saved.scPosition || 0, saved.scTrackIndex || 0, saved.scPlaying !== false, true); // v1.22: isRestore
          }
        } else if (saved.type === 'spotify') {
          state.currentSource = 'spotify';
          if ((w as any).__spController || ((w as any).__spWebPlayer && (w as any).__spDeviceId)) {
            updateUI('playing', saved.lbl, 'spotify');
          } else {
            playSpotify(saved.playlistId, saved.lbl);
          }
        }
      } catch (_) {}
    }, { signal });

    // hamcat:play — depuis les boutons du site
    document.addEventListener('hamcat:play', (e: any) => {
      const { type, url, playlistId, lbl, startAt, art, toggle, teinte } = e.detail;
      // La waveform du player reprend la couleur du style du set, comme celle
      // de la ligne d'ou il part : c'est la meme piste, elle garde son identite
      // d'un bout a l'autre du site.
      playerDiv.style.setProperty('--wave-played', teinte || 'var(--facet-son)');
      if      (type === 'audio')      playAudio(url, lbl, startAt || 0, art || '', !!toggle);
      else if (type === 'soundcloud') playSC(url, lbl, Math.round((startAt || 0) * 1000));
      else if (type === 'spotify')    playSpotify(playlistId, lbl);
    }, { signal });

    // ── Projection des medias en fond ──────────────────────────────────────
    //    Une date annonce ses photos par l'evenement `hamcat:media` ; on les
    //    fait defiler lentement derriere le cadre. Deux calques alternent pour
    //    que le fondu reste propre.
    const mediaBg = document.getElementById('media-bg') as HTMLElement | null;
    // Deux bandes symetriques (gauche/droite du cadre), chacune avec deux
    // calques qui se relaient pour que le fondu reste propre. mbSlot dit
    // lequel des deux recoit la prochaine image.
    let mbBands: HTMLElement[][] = [];
    let mbSlot = 0;
    let mbTimer: number | null = null;
    let mbList: string[] = [];
    let mbAt = 0;
    let mbKey = '';

    const MEDIA_BASE = 'https://media.hamcat.live/media';

    function mbEnsure() {
      if (!mediaBg || mbBands.length) return;
      for (const side of ['l', 'r']) {
        const band = document.createElement('div');
        band.className = `mb-band mb-band--${side}`;
        const layers: HTMLElement[] = [];
        for (let i = 0; i < 2; i++) {
          const d = document.createElement('div');
          d.className = 'mb';
          // Decalage de la derive : les deux cotes ne bougent pas au meme
          // rythme, sinon l'ensemble respire comme un seul bloc.
          d.style.animationDelay = side === 'r' ? '-19s' : '0s';
          band.appendChild(d);
          layers.push(d);
        }
        mediaBg.appendChild(band);
        mbBands.push(layers);
      }
    }

    /** Affiche la paire d'images a l'index donne : la bande de gauche montre
     *  mbList[i], celle de droite la suivante. Deux photos differentes a
     *  l'ecran a chaque instant, et le defilement les fait glisser de droite
     *  a gauche. Avec un seul media les deux cotes montrent la meme image,
     *  il n'y a rien d'autre a montrer. */
    function mbShow(i: number) {
      mbEnsure();
      if (!mbBands.length || !mbList.length) return;
      const urls = [mbList[i % mbList.length],
                    mbList[(i + 1) % mbList.length]];
      // Precharger avant d'afficher : sans ca le calque s'allume sur du vide.
      let left = urls.length;
      const paint = () => {
        if (--left) return;                      // on attend les deux
        const cur = mbSlot, prev = 1 - mbSlot;
        mbBands.forEach((layers, b) => {
          layers[cur].style.backgroundImage = `url("${urls[b]}")`;
          layers[cur].classList.add('on');
          layers[prev].classList.remove('on');
        });
        mbSlot = prev;
        if (mediaBg) mediaBg.dataset.on = 'true';
      };
      urls.forEach(u => {
        const img = new Image();
        img.onload = paint;
        img.onerror = paint;                     // un media absent ne bloque pas
        img.src = u;
      });
    }

    function mbStop() {
      if (mbTimer) { clearInterval(mbTimer); mbTimer = null; }
      if (mediaBg) mediaBg.dataset.on = 'false';
      mbBands.forEach(layers => layers.forEach(l => l.classList.remove('on')));
      mbList = []; mbKey = '';
    }

    /** Lance la projection des photos d'une date. */
    function mbPlay(key: string, media: { id: string; kind: string }[], date: string) {
      if (key === mbKey) return;                 // deja a l'ecran
      if (!media || !media.length) { mbStop(); return; }
      mbKey = key;
      // Les videos ont une affiche ; on projette des images fixes uniquement.
      mbList = media.map(m => `${MEDIA_BASE}/${date}/${m.id}${m.kind === 'video' ? '-p' : '-f'}.webp`);
      mbAt = 0;
      mbShow(mbAt);
      if (mbTimer) clearInterval(mbTimer);
      if (mbList.length > 2) {
        mbTimer = window.setInterval(() => {
          // Deux images sont a l'ecran : on avance de deux pour ne pas
          // reafficher a gauche celle qu'on vient de voir a droite.
          mbAt = (mbAt + 2) % mbList.length;
          mbShow(mbAt);
        }, 7000);
      }
    }

    document.addEventListener('hamcat:media', (e: any) => {
      const d = e.detail || {};
      if (!d.media || !d.media.length) mbStop();
      else mbPlay(d.key || d.date, d.media, d.date);
    }, { signal });

    /** Diffuse la position de lecture aux waveforms des pages, quelle que soit
     *  la source. Les facettes ouvertes en modale sont des iframes : elles ont
     *  leur propre document, d'ou le relais par postMessage. */
    function emitProgress(url: string, position: number, duration: number) {
      if (!duration) return;
      const detail = { url, position, duration };
      document.dispatchEvent(new CustomEvent('hamcat:progress', { detail }));
      document.querySelectorAll('iframe').forEach(f => {
        try { f.contentWindow?.postMessage({ __hamcat: 'progress', detail }, location.origin); } catch (_) {}
      });
    }

    /** Icone lecture/pause — il y a deux boutons (transport + pastille reduite). */
    function setPlayIcon(icon: string) {
      playerDiv.querySelectorAll<HTMLButtonElement>('.player-play-btn')
               .forEach(b => { b.textContent = icon; });
    }

    function togglePlayback() {
      if (state.currentSource === 'audio') {
        if (audioEl.paused) {
          audioEl.volume = 0;
          audioEl.play();
          rampVolume(audioEl, getSavedVolume() / 100, FADE_IN_MS);
          updateUI('playing', state.currentLbl, 'audio');
        } else {
          const v = audioEl.volume;
          rampVolume(audioEl, 0, FADE_OUT_MS).then(() => { audioEl.pause(); audioEl.volume = v; });
          updateUI('paused', state.currentLbl, 'audio');
        }
      } else if (state.currentSource === 'soundcloud' && w.__scWidget) {
        w.__scWidget.isPaused((paused: boolean) => {
          if (paused) w.__scWidget.play();
          else        w.__scWidget.pause();
        });
      } else if (state.currentSource === 'spotify' && w.__spWebPlayer && w.__spDeviceId) {
        // v1.26: full playback (Web Playback SDK) — togglePlay pilote le vrai device Spotify Connect
        try { w.__spWebPlayer.togglePlay(); } catch (_) {}
      } else if (state.currentSource === 'spotify' && w.__spController) {
        // v1.23: togglePlay() pilote le vrai etat, playback_update remet l'UI a jour
        try { w.__spController.togglePlay(); } catch (_) {}
      }
    }

    /** Les listes de la page demandent la bascule quand on reclique le set en cours. */
    document.addEventListener('hamcat:toggle', () => togglePlayback(), { signal });

    // ═══ Bibliotheque ════════════════════════════════════════════════════════
    // Le catalogue est genere au build dans /library.json et telecharge a la
    // premiere ouverture seulement. Comme le player survit aux navigations, la
    // liste n'est construite qu'une fois par session.
    const libPanel  = document.getElementById('library-panel') as HTMLElement;
    const libList   = document.getElementById('lib-list') as HTMLElement;
    const libFilters= document.getElementById('lib-filters') as HTMLElement;
    const libSearch = document.getElementById('lib-search') as HTMLInputElement;
    const libCount  = document.getElementById('lib-count') as HTMLElement;

    type LibEntry = {
      id: string; title: string; sub: string; date: string; source: string;
      url: string; playlistId?: string; waveform: string | null;
      download: boolean; tags: Record<string, string[]>;
    };

    let libData: LibEntry[] | null = null;
    let libStyles = new Set<string>();

    const SRC_LABEL: Record<string, string> = {
      audio: '♪', soundcloud: 'SC', mixcloud: 'MC', spotify: 'SP',
    };

    const libDate = (iso: string) => {
      if (!iso) return '—';
      const d = new Date(iso);
      const p = (n: number) => String(n).padStart(2, '0');
      return `${d.getFullYear()}/${p(d.getMonth() + 1)}/${p(d.getDate())}`;
    };

    /** Pastilles de styles : les plus courants d'abord, chacune a sa couleur.
     *  Vingt-deux styles ne tiennent pas sur une ligne — la rangee defile
     *  horizontalement plutot que de manger la hauteur de la liste. */
    function renderLibFilters() {
      if (!libData) return;
      const count = new Map<string, number>();
      libData.forEach(e => (e.tags.style || []).forEach(t =>
        count.set(t, (count.get(t) || 0) + 1)));
      const styles = [...count.entries()]
        .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
      libFilters.innerHTML =
        `<button class="lib-chip${libStyles.size ? '' : ' is-on'}" data-style="">Tout</button>`
        + styles.map(([t, n]) =>
            `<button class="lib-chip${libStyles.has(t) ? ' is-on' : ''}" data-style="${t}"`
            + ` style="--chip: var(--style-${t}, var(--style-default))">`
            + `${t}<em>${n}</em></button>`).join('');
    }

    function renderLibList() {
      if (!libData) return;
      const q = libSearch.value.trim().toLowerCase();
      const rows = libData.filter(e => {
        if (libStyles.size && !(e.tags.style || []).some(t => libStyles.has(t))) return false;
        if (q && !(`${e.title} ${e.sub}`.toLowerCase().includes(q))) return false;
        return true;
      });
      libCount.textContent = `${rows.length} / ${libData.length}`;
      libList.innerHTML = rows.map(e => {
        const styles = (e.tags.style || []).join(' · ');
        const hue = (e.tags.style || [])[0] || 'default';
        // La zone waveform est toujours presente, vide au besoin : toutes les
        // lignes gardent ainsi exactement la meme hauteur.
        const wave = e.waveform
          ? `<div class="lib-wave" data-wave="${e.waveform}" data-url="${e.url}"`
            + ` style="--wave-played: var(--style-${hue}, var(--style-default))"></div>`
          : `<div class="lib-wave lib-wave--none"></div>`;
        return `<div class="lib-row" role="listitem" data-id="${e.id}" data-url="${e.url}"`
             + ` data-src="${e.source}"${e.playlistId ? ` data-pl="${e.playlistId}"` : ''}`
             + `${e.waveform ? ` data-wave="${e.waveform}"` : ''}>`
             + `<button class="lib-play" aria-label="Lire">▶</button>`
             + `<span class="lib-date">${libDate(e.date)}</span>`
             + `<span class="lib-title">${e.title}`
             + (e.sub ? ` <span class="lib-sub">· ${e.sub}</span>` : '') + `</span>`
             + `<span class="lib-styles">${styles}</span>`
             + `<span class="lib-src">${SRC_LABEL[e.source] || ''}</span>`
             + wave
             + `</div>`;
      }).join('');
      markLibCurrent();
      observeLibWaves();
    }

    //  MESURE du 24/09, glissement de 40 pas sur la poignee : mediane 16,6 ms
    //  mais 42 images sur 130 au-dessus de 32 ms, avec des pointes a 438 ms.
    //  Ce n'etait donc pas un cout diffus de mise en page — c'etaient des
    //  bouffees de travail. Origine trouvee : en grandissant, le panneau fait
    //  entrer de nouvelles lignes dans le champ, l'observateur declenche le
    //  chargement de leurs waveforms, et chacune construit un SVG de plusieurs
    //  centaines de rectangles pendant le geste.
    //  On met donc les chargements en attente le temps du glissement, et on les
    //  reprend apres, etales sur plusieurs images.
    let libDrag = false;
    const libEnAttente = new Set<HTMLElement>();

    // Declaration de fonction, et non affectation a un `let` : elle est hissee,
    // donc appelable depuis bindGrip qui est plus bas dans le fichier. La
    // version precedente affectait une variable declaree APRES ce point, ce qui
    // levait une ReferenceError et emportait tout le script du player avec elle.
    function libSetDrag(on: boolean) {
      libDrag = on;
      if (on || !libEnAttente.size) return;
      const file = [...libEnAttente];
      libEnAttente.clear();
      // Deux par image : la reprise ne remplace pas une saccade par une autre.
      const suite = () => {
        for (let i = 0; i < 2 && file.length; i++) loadLibWave(file.shift()!);
        if (file.length) requestAnimationFrame(suite);
      };
      requestAnimationFrame(suite);
    }

    let libIO: IntersectionObserver | null = null;
    function observeLibWaves() {
      if (!libIO) {
        libIO = new IntersectionObserver((ents, obs) => {
          ents.forEach(en => {
            if (!en.isIntersecting) return;
            obs.unobserve(en.target);
            if (libDrag) { libEnAttente.add(en.target as HTMLElement); return; }
            loadLibWave(en.target as HTMLElement);
          });
        }, { root: libList, rootMargin: '250px' });
      }
      libList.querySelectorAll<HTMLElement>('.lib-wave:not([data-seen])')
             .forEach(w => { w.dataset.seen = '1'; libIO!.observe(w); });
    }

    /** Surligne la ligne en cours et lui greffe sa waveform. */
    function markLibCurrent() {
      const cur = state.currentSource === 'audio' ? audioEl.currentSrc : '';
      libList.querySelectorAll<HTMLElement>('.lib-row').forEach(row => {
        const mine = !!cur && !!row.dataset.url && cur.indexOf(row.dataset.url) === 0;
        row.classList.toggle('is-current', mine);
        // Remise a zero du remplissage des lignes qui ne jouent plus.
        if (!mine) {
          const r = row.querySelector('clipPath rect') as SVGRectElement | null;
          if (r) r.setAttribute('width', '0');
        }
      });
    }

    function loadLibWave(el: HTMLElement) {
      fetch(el.dataset.wave!)
        .then(r => (r.ok ? r.json() : Promise.reject(r.status)))
        .then(d => {
          const peaks: number[] = d.peaks || [];
          // Une barre toutes les ~2,2 px de large reelle : la densite reste la
          // meme que la waveform fasse 250 ou 1300 px, et le trace garde l'aspect
          // d'un logiciel audio au lieu d'une palissade etiree.
          const px = el.clientWidth || 300;
          const want = Math.max(40, Math.min(peaks.length, Math.round(px / 2.2)));
          const step = Math.max(1, Math.floor(peaks.length / want));
          const bars: string[] = [];
          for (let i = 0, x = 0; i < peaks.length; i += step, x++) {
            const v = Math.max(...peaks.slice(i, i + step)) / 255;
            const h = Math.max(2, Math.round(v * 100));
            bars.push(`<rect x="${x * 2}" y="${(100 - h) / 2}" width="1.1" height="${h}" rx="0.5"/>`);
          }
          const id = 'libclip' + Math.random().toString(36).slice(2, 8);
          el.dataset.clip = id;
          el.dataset.duration = String(d.duration || 0);
          el.innerHTML =
            `<svg viewBox="0 0 ${bars.length * 2} 100" preserveAspectRatio="none"`
            + ` style="width:100%;height:100%;display:block">`
            + `<g class="wave-bg">${bars.join('')}</g>`
            + `<g class="wave-fg" clip-path="url(#${id})">${bars.join('')}</g>`
            + `<clipPath id="${id}"><rect x="0" y="0" width="0" height="100"/></clipPath></svg>`;
        })
        .catch(() => el.remove());
    }

    // ── Waveform de la barre ───────────────────────────────────────────────
    //    La meme que dans les pages et la bibliotheque : meme source de pics,
    //    meme densite de barres. Elle remplace la barre de progression quand
    //    elle existe ; Spotify, qui n'expose aucun pic, garde la barre pleine.
    const waveEl = document.getElementById('player-wave') as HTMLElement | null;

    /** Adresse des pics pour une source donnee, ou null s'il n'y en a pas. */
    function waveSrc(url: string): string | null {
      const m = url.match(/^(https:\/\/media\.hamcat\.live)\/sets\/(.+)\.[a-z0-9]+$/i);
      if (m) return `${m[1]}/waveforms/${m[2]}.json`;
      if (/^https:\/\/soundcloud\.com\/[\w-]+\/[\w-]+/.test(url)) {
        return `/api/sc/waveform?url=${encodeURIComponent(url.split('?')[0])}`;
      }
      return null;
    }

    let waveToken = 0;

    /** Charge et trace la waveform du set en cours. Passer '' la retire. */
    function setPlayerWave(url: string) {
      if (!waveEl) return;
      const src = url ? waveSrc(url) : null;
      const mine = ++waveToken;
      if (!src) { waveEl.hidden = true; waveEl.innerHTML = ''; return; }
      fetch(src)
        .then(r => (r.ok ? r.json() : Promise.reject(r.status)))
        .then(d => {
          if (mine !== waveToken) return;          // un autre set a pris la main
          const peaks: number[] = d.peaks || [];
          if (!peaks.length) { waveEl.hidden = true; return; }
          const px = waveEl.clientWidth || 300;
          const want = Math.max(40, Math.min(peaks.length, Math.round(px / 2.2)));
          const step = Math.max(1, Math.floor(peaks.length / want));
          const bars: string[] = [];
          for (let i = 0, x = 0; i < peaks.length; i += step, x++) {
            const v = Math.max(...peaks.slice(i, i + step)) / 255;
            const h = Math.max(2, Math.round(v * 100));
            bars.push(`<rect x="${x * 2}" y="${(100 - h) / 2}" width="1.1" height="${h}" rx="0.5"/>`);
          }
          const id = 'pwclip' + Math.random().toString(36).slice(2, 8);
          waveEl.innerHTML =
            `<svg viewBox="0 0 ${bars.length * 2} 100" preserveAspectRatio="none"`
            + ` style="width:100%;height:100%;display:block">`
            + `<g class="wave-bg">${bars.join('')}</g>`
            + `<g class="wave-fg" clip-path="url(#${id})">${bars.join('')}</g>`
            + `<clipPath id="${id}"><rect x="0" y="0" width="0" height="100"/></clipPath></svg>`;
          waveEl.hidden = false;
        })
        .catch(() => { if (mine === waveToken) { waveEl.hidden = true; waveEl.innerHTML = ''; } });
    }

    /** Avance le remplissage de la waveform de la barre. */
    function setPlayerWaveProgress(ratio: number) {
      if (!waveEl || waveEl.hidden) return;
      const r = waveEl.querySelector('clipPath rect') as SVGRectElement | null;
      const svg = waveEl.querySelector('svg') as SVGSVGElement | null;
      if (!r || !svg) return;
      r.setAttribute('width', String(Math.max(0, Math.min(1, ratio)) * svg.viewBox.baseVal.width));
    }

    /** Lit l'entree precedente ou suivante de la bibliotheque.
     *  La bibliotheque est la liste de lecture du site : precedent et suivant
     *  s'y deplacent, quelle que soit la page d'ou la lecture est partie. */
    function stepLibrary(dir: number) {
      if (!libData) {
        // Premiere utilisation : on va chercher le catalogue puis on rejoue.
        fetch('/library.json')
          .then(r => r.json())
          .then(d => { libData = d.entries || []; stepLibrary(dir); })
          .catch(() => {});
        return;
      }
      let cur = '';
      let curPl = '';
      try {
        const sv = JSON.parse(localStorage.getItem('hamcat-player') || '{}');
        cur = sv.url || '';
        curPl = sv.playlistId || '';
      } catch (_) {}
      const list = libData;
      let i = list.findIndex(e => (cur && e.url === cur) || (curPl && e.playlistId === curPl));
      if (i < 0) i = dir > 0 ? -1 : 0;           // rien en cours : on entre par le bord
      const next = list[i + dir];
      if (!next) return;                          // on est deja au bout de la liste
      if (next.source === 'spotify' && next.playlistId) playSpotify(next.playlistId, next.title);
      else if (next.source === 'audio') playAudio(next.url, next.title, 0, '', false);
      else playSC(next.url, next.title);
    }

    /** Tient --player-pad a jour selon l'etat courant du player. */
    function syncPlayerPad() {
      const active = playerDiv.dataset.active === 'true';
      // Mesuree et non codee en dur : sur telephone la barre passe sur deux
      // rangees, et le disque d'accueil doit se reserver la bonne hauteur.
      const bar = playerDiv.querySelector('.player-full') as HTMLElement | null;
      const h = active && bar ? Math.round(bar.getBoundingClientRect().height) : 0;
      //  La bibliotheque ouverte occupe l'ecran au meme titre que la barre, et
      //  elle n'entrait pas dans le compte : la scene gardait sa hauteur pleine
      //  et le disque passait derriere le panneau, tronque par le bas. C'est ce
      //  qui cassait la symetrie a l'accueil des qu'on ouvrait la liste.
      const lib = playerDiv.dataset.library === 'true' && !libPanel.hidden
        ? Math.round(libPanel.getBoundingClientRect().height) : 0;
      const gap = parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue('--player-gap')) || 14;
      document.documentElement.style.setProperty('--player-pad',
        ((active ? (h || 56) : 62) + lib + gap) + 'px');
    }

    function openLibrary(open: boolean) {
      libPanel.hidden = !open;
      playerDiv.dataset.library = String(open);
      // Un seul geste : ouvrir la bibliotheque deplie le player, la fermer le replie.
      playerDiv.dataset.expanded = String(open);
      const b = document.getElementById('btn-library');
      if (b) b.setAttribute('aria-expanded', String(open));
      //  Avant la sortie anticipee : fermer la bibliotheque libere de la place,
      //  et cette place n'etait jamais rendue. Le disque restait a la taille
      //  qu'il avait sous le panneau, panneau refermé.
      syncPlayerPad();
      if (!open) return;
      playerDiv.dataset.active = 'true';
      syncPlayerPad();
      setLibHeight(readLibH() || Math.round(libMax() * 0.5));
      if (libData) { renderLibFilters(); renderLibList(); return; }
      libList.innerHTML = '<p style="padding:1rem;color:var(--text-tertiary);font-size:0.75rem">Chargement…</p>';
      fetch('/library.json')
        .then(r => r.json())
        .then(d => { libData = d.entries || []; renderLibFilters(); renderLibList(); })
        .catch(() => { libList.innerHTML = '<p style="padding:1rem;color:var(--text-tertiary);font-size:0.75rem">Bibliothèque indisponible.</p>'; });
    }

    // ── Hauteur du panneau : glissement libre, sans aimantation. Le panneau
    //    s'arrete exactement ou on le lache ; seul un geste qui descend sous le
    //    seuil bas vaut fermeture. Les deux poignees — celle du panneau et
    //    celle du bord haut du player — partagent le meme code, si bien qu'on
    //    rouvre la bibliotheque en tirant vers le haut sans passer par le menu.
    const LIB_H_KEY = 'hamcat-lib-height';
    //  Le panneau vit dans un element zoome : une hauteur calculee en pixels
    //  de fenetre s'y afficherait multipliee par le zoom. On divise donc par
    //  la meme valeur que celle appliquee en CSS.
    const tac = () => parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue('--tac')) || 1;
    const libMax = () => ((window.visualViewport?.height || window.innerHeight) - 56) / tac();
    const libMin = () => Math.round(libMax() * 0.22);
    const readLibH = () => {
      try { const v = parseInt(localStorage.getItem(LIB_H_KEY) || '', 10);
            return isFinite(v) && v > 100 ? v : 0; } catch (_) { return 0; }
    };
    const saveLibH = (h: number) => { try { localStorage.setItem(LIB_H_KEY, String(h)); } catch (_) {} };

    function setLibHeight(px: number) {
      libPanel.style.setProperty('--lib-h', Math.max(80, Math.min(libMax(), px)) + 'px');
      //  Redimensionner la bibliotheque change la place qui reste au-dessus :
      //  la reserve doit suivre le doigt, sinon elle ne vaut que pour la
      //  hauteur d'ouverture.
      syncPlayerPad();
    }

    /** Branche une poignee. `fromClosed` : le geste ouvre d'abord le panneau. */
    function bindGrip(el: HTMLElement | null, fromClosed: boolean) {
      if (!el) return;
      let startY = 0, startH = 0, dragging = false;
      el.addEventListener('pointerdown', (e: PointerEvent) => {
        if (fromClosed) {
          if (playerDiv.dataset.library === 'true') return;
          openLibrary(true);
          startH = 0;                       // on part de zero : la hauteur suit le doigt
        } else {
          startH = libPanel.getBoundingClientRect().height;
        }
        dragging = true;
        startY = e.clientY;
        el.setAttribute('data-drag', '1');
        // Hauteur figee de la liste pour toute la duree du geste.
        libPanel.style.setProperty('--lib-fix',
          Math.max(80, Math.round(libMax() * 0.9)) + 'px');
        libPanel.dataset.drag = '1';
        libSetDrag(true);
        try { el.setPointerCapture(e.pointerId); } catch (_) {}
        libPanel.style.transition = 'none';
        e.preventDefault();
      });
      // Un pointermove peut arriver a 120 Hz ; l'ecran n'affiche qu'une image a
      // la fois. On garde la derniere position et on n'ecrit qu'une fois par
      // image : le geste reste au doigt, le navigateur travaille deux fois
      // moins.
      let cible = 0, prevu = 0;
      el.addEventListener('pointermove', (e: PointerEvent) => {
        if (!dragging) return;
        cible = startH + (startY - e.clientY);
        if (prevu) return;
        prevu = requestAnimationFrame(() => { prevu = 0; if (dragging) setLibHeight(cible); });
      });
      const end = (e: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        if (prevu) { cancelAnimationFrame(prevu); prevu = 0; }
        el.removeAttribute('data-drag');
        delete libPanel.dataset.drag;
        libSetDrag(false);
        try { el.releasePointerCapture(e.pointerId); } catch (_) {}
        libPanel.style.transition = '';
        const h = libPanel.getBoundingClientRect().height;
        if (h < libMin()) { openLibrary(false); return; }
        saveLibH(Math.round(h));            // on garde la hauteur exacte, pas un repere
      };
      el.addEventListener('pointerup', end);
      el.addEventListener('pointercancel', end);
    }

    bindGrip(document.getElementById('lib-grip'), false);
    bindGrip(document.getElementById('lib-handle'), true);

    libFilters.addEventListener('click', e => {
      const c = (e.target as HTMLElement).closest<HTMLElement>('.lib-chip');
      if (!c) return;
      const t = c.dataset.style || '';
      // "Tout" remet a zero ; les autres s'ajoutent et se retirent librement,
      // et un set ressort des qu'il porte l'un des styles retenus.
      if (!t) libStyles.clear();
      else if (libStyles.has(t)) libStyles.delete(t);
      else libStyles.add(t);
      renderLibFilters(); renderLibList();
    }, { signal });

    libSearch.addEventListener('input', () => renderLibList(), { signal });

    libList.addEventListener('click', e => {
      const t = e.target as HTMLElement;
      const wave = t.closest<HTMLElement>('.lib-wave');
      if (wave) {
        const rect = wave.getBoundingClientRect();
        const ratio = Math.max(0, Math.min(1, ((e as MouseEvent).clientX - rect.left) / rect.width));
        const dur = parseFloat(wave.dataset.duration || '0');
        if (dur) {
          const row = wave.closest<HTMLElement>('.lib-row');
          const lbl = (row?.querySelector('.lib-title') as HTMLElement)?.textContent?.trim()
                      || state.currentLbl;
          // La waveform d'un set SoundCloud doit le lancer comme les autres,
          // a la position cliquee, et non passer par l'element <audio>.
          if (row?.dataset.src === 'soundcloud') playSC(wave.dataset.url!, lbl, Math.round(ratio * dur * 1000));
          else playAudio(wave.dataset.url!, lbl, ratio * dur);
        }
        return;
      }
      const row = t.closest<HTMLElement>('.lib-row');
      if (!row) return;
      const lbl = (row.querySelector('.lib-title') as HTMLElement)?.textContent?.trim() || '';
      if (row.dataset.src === 'spotify') playSpotify(row.dataset.pl!, lbl);
      else if (row.dataset.src === 'audio') playAudio(row.dataset.url!, lbl, 0, '', true);
      else playSC(row.dataset.url!, lbl);
    }, { signal });

    document.getElementById('btn-seed')?.addEventListener('click',
      () => openLibrary(true), { signal });

    ['btn-library', 'btn-mini-library'].forEach(id => {
      document.getElementById(id)?.addEventListener('click',
        () => openLibrary(libPanel.hidden), { signal });
    });
    document.getElementById('btn-lib-close')?.addEventListener('click',
      () => openLibrary(false), { signal });
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && !libPanel.hidden) openLibrary(false);
    }, { signal });

    // La progression repeint la waveform de la ligne en cours.
    document.addEventListener('hamcat:progress', (e: any) => {
      if (libPanel.hidden) return;
      const { url, position, duration } = e.detail;
      if (!duration) return;
      const cur = libList.querySelector<HTMLElement>('.lib-row.is-current');
      if (!cur || !cur.dataset.url || url.indexOf(cur.dataset.url) !== 0) markLibCurrent();
      libList.querySelectorAll<HTMLElement>('.lib-wave').forEach(w => {
        if (!w.dataset.url || url.indexOf(w.dataset.url) !== 0) return;
        const r = w.querySelector('clipPath rect') as SVGRectElement | null;
        const svg = w.querySelector('svg') as SVGSVGElement | null;
        if (r && svg) r.setAttribute('width', String((position / duration) * svg.viewBox.baseVal.width));
      });
    }, { signal });

    // Barre espace = lecture/pause partout sur le site. On laisse la main des que
    // le focus est dans un champ ou sur un bouton, ou il a deja un sens.
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.code !== 'Space' && e.key !== ' ') return;
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const t = e.target as HTMLElement | null;
      if (t) {
        const tag = t.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || tag === 'BUTTON'
            || tag === 'A' || t.isContentEditable) return;
      }
      if (!state.currentSource) return;
      e.preventDefault();
      togglePlayback();
    }, { signal });

    // Délégation unique pour tous les boutons du playerDiv
    playerDiv.addEventListener('click', (e) => {
      const target = e.target as Element;

      if (target.closest('.player-play-btn')) { togglePlayback(); return; }

      const muteBtn = target.closest('.player-mute-btn');
      if (muteBtn) {
        if (state.currentSource === 'audio') {
          audioEl.muted = !audioEl.muted;
          (muteBtn as HTMLElement).textContent = audioEl.muted ? '🔇' : '🔊';
        } else if (state.currentSource === 'soundcloud' && w.__scWidget) {
          w.__scMuted = !w.__scMuted;
          w.__scWidget.setVolume(w.__scMuted ? 0 : 100);
          (muteBtn as HTMLElement).textContent = w.__scMuted ? '🔇' : '🔊';
        } else if (state.currentSource === 'spotify' && w.__spWebPlayer && w.__spDeviceId) {
          // v1.26c: mute reel via Web Playback SDK (getVolume/setVolume, echelle 0..1) — oublie en v1.26
          w.__spWebPlayer.getVolume().then((vol: number) => {
            const muted = vol > 0;
            w.__spWebPlayer.setVolume(muted ? 0 : 1);
            (muteBtn as HTMLElement).textContent = muted ? '🔇' : '🔊';
          });
        }
        // v1.24: pas de mute Spotify en mode preview (IFrame API) - bouton desactive via updateUI() dans ce cas.
        return;
      }

      if (target.closest('#btn-prev')) { stepLibrary(-1); return; }
      if (target.closest('#btn-next')) { stepLibrary(1);  return; }

      if (target.closest('#btn-spotify-connect')) {
        spStartAuth(); // v1.26: lance le flow OAuth PKCE Spotify
        return;
      }

      if (target.closest('#btn-sp-prev')) {
        if (state.currentSource === 'soundcloud' && w.__scWidget) { try { w.__scWidget.prev(); } catch (_) {} }
        else { try { w.__spWebPlayer?.previousTrack(); } catch (_) {} }
        return;
      }

      if (target.closest('#btn-sp-next')) {
        if (state.currentSource === 'soundcloud' && w.__scWidget) { try { w.__scWidget.next(); } catch (_) {} }
        else { try { w.__spWebPlayer?.nextTrack(); } catch (_) {} }
        return;
      }

      if (target.closest('#btn-sp-like')) {
        spToggleLike();
        return;
      }

      if (target.closest('#btn-sc-connect')) {
        scStartAuth(); // v1.35: lance le flow OAuth SoundCloud
        return;
      }

      if (target.closest('#btn-sc-like')) {
        scToggleLike(); // v1.35: like/unlike la piste SC courante
        return;
      }

      if (target.closest('#btn-sp-shuffle')) {
        spSetShuffle();
        return;
      }

      if (target.closest('#btn-sp-repeat')) {
        spSetRepeat();
        return;
      }

      if (target.closest('.player-embed-toggle')) {
        if (state.currentSource === 'spotify') {
          // v1.25: toggle show/hide reel (le panneau est masque par defaut depuis v1.24)
          if (embedZone.style.display === 'none') {
            embedZone.style.height = '166px';
            if (state.spIframe) state.spIframe.style.height = '166px';
            embedZone.style.display = 'block';
            if (toggleBtn) toggleBtn.textContent = '▼';
          } else {
            embedZone.style.display = 'none';
            if (toggleBtn) toggleBtn.textContent = '▲';
          }
        } else {
          // SC : show/hide classique (ne pas toucher au src)
          if (embedZone.style.display === 'none') {
            embedZone.style.display = 'block';
            if (toggleBtn) toggleBtn.textContent = '▼';
            if (playlistEl && state.currentSource === 'soundcloud') playlistEl.style.display = 'block';
          } else {
            embedZone.style.display = 'none';
            if (toggleBtn) toggleBtn.textContent = '▲';
            if (playlistEl) playlistEl.style.display = 'none';
          }
        }
        return;
      }


      if (target.closest('#btn-close')) {
        pauseAll();
        audioEl.src = '';
        state.currentSource = null;
        if (state.scIframe) { state.scIframe.src = ''; state.scIframe = null; }
        w.__scWidget = null;
        state.spIframe = null;
        if (toggleBtn) toggleBtn.hidden = true;
        playerDiv.dataset.active   = 'false';
        playerDiv.dataset.expanded = 'false';
        playerDiv.classList.remove('playing');
        updateSpotifyConnectBtn(null); // v1.27: cache prev/next/like/connexion aussi
        try { localStorage.removeItem('hamcat-player'); } catch (_) {}
      }
    }, { signal });

    // v1.26/v1.35: retour du redirect OAuth (?code=...) — Spotify ou SoundCloud selon state=sc_*
    (async () => {
      const qp = new URLSearchParams(location.search);
      const code       = qp.get('code');
      const err        = qp.get('error');
      const stateParam = qp.get('state') || '';
      if (!code && !err) { updateSpotifyConnectBtn(state.currentSource); return; }
      history.replaceState({}, '', location.pathname); // nettoie l'URL immediatement

      if (stateParam.startsWith('sc_')) {
        // ── Callback SoundCloud OAuth (v1.35) ──────────────────────────────
        const saved2 = sessionStorage.getItem('sc_oauth_state') || '';
        try { sessionStorage.removeItem('sc_oauth_state'); } catch (_) {}
        if (err) { hmcLog('[HMC] SoundCloud OAuth refuse/erreur: ' + err); updateSCConnectBtn(state.currentSource); return; }
        if (stateParam !== saved2) { hmcLog('[HMC] SoundCloud OAuth: state mismatch'); updateSCConnectBtn(state.currentSource); return; }
        const scTok = await scExchangeCode(code!);
        if (!scTok) { hmcLog('[HMC] SoundCloud OAuth: echange du code echoue'); updateSCConnectBtn(state.currentSource); return; }
        hmcLog('[HMC] SoundCloud OAuth OK — connecte');
        updateSCConnectBtn(state.currentSource);
        // Re-check like pour la piste SC deja en lecture
        if (state.currentSource === 'soundcloud' && (w as any).__scCurrentTrackId) {
          scCheckLiked((w as any).__scCurrentTrackId);
        }
        return;
      }

      // ── Callback Spotify OAuth (v1.26) ─────────────────────────────────
      if (err) { hmcLog('[HMC] Spotify OAuth refuse/erreur: ' + err); updateSpotifyConnectBtn(state.currentSource); return; }
      const tok = await spExchangeCode(code!);
      if (!tok) { hmcLog('[HMC] Spotify OAuth: echange du code echoue'); updateSpotifyConnectBtn(state.currentSource); return; }
      hmcLog('[HMC] Spotify OAuth OK — connecte');
      try {
        const saved = JSON.parse(localStorage.getItem('hamcat-player') || 'null');
        if (saved?.type === 'spotify' && saved.playlistId) {
          playSpotify(saved.playlistId, saved.lbl); // relance en full playback
        }
      } catch (_) {}
      updateSpotifyConnectBtn(state.currentSource);
    })();

    // Bouton debug (DEV uniquement) — teste la continuité audio cross-page
    document.getElementById('debug-audio-test')?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('hamcat:play', {
        detail: { type: 'audio', url: 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3', lbl: 'Test continuité' }
      }));
    });

  })();
  </script>

  <!-- Moteur audio persistant — transition:persist empêche le rechargement entre pages -->
  <audio id="hamcat-audio" transition:persist preload="none" style="display:none"></audio>

  <!-- Version toast — V affiche la version lisible (appui touche v) -->
  <div id="version-toast" style="position:fixed;bottom:12px;left:50%;transform:translateX(-50%);font-size:10px;color:rgba(255,255,255,0.35);letter-spacing:0.08em;pointer-events:none;opacity:0;font-family:monospace;z-index:9999;"></div>
  <script>
    const _vt = document.getElementById('version-toast')!;
    _vt.textContent = 'fx_jam_v2.02';
    document.addEventListener('keydown', (e) => {
      if (e.key === 'v' || e.key === 'V') {
        _vt.style.transition = 'none';
        _vt.style.opacity = '1';
      }
    });
    document.addEventListener('keyup', (e) => {
      if (e.key === 'v' || e.key === 'V') _vt.style.opacity = '0';
    });
  </script>
</body>
</html>
