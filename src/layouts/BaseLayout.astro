---
import { ViewTransitions } from 'astro:transitions';
import { visibleFacets } from '../data/facets';
import siteData from '../data/site.json';

const seo = {
  title:       "Hamcat — DJ · Son · MAO · Événements",
  description: "Fx Jam alias Hamcat : DJ psytrance/hi-tech/goa, ingénieur son FOH, formateur MAO Ableton, co-organisateur ADN Festival. Basé à Grenoble.",
  url:         "https://hamcat.live",
  image:       "https://media.hamcat.live/logos/logo.jpg",
  twitter:     "@hamcat_fx",
};

interface Props {
  title?: string;
  description?: string;
}
const { title = seo.title, description = seo.description } = Astro.props;
const facetHrefs = visibleFacets().map(f => f.href);
---
<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <link rel="canonical" href={seo.url} />
  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={seo.url} />
  <meta property="og:title"       content={seo.title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:image"       content={seo.image} />
  <meta property="og:site_name"   content={siteData.displayName} />
  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={seo.title} />
  <meta name="twitter:description" content={seo.description} />
  <meta name="twitter:image"       content={seo.image} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <ViewTransitions />

  <style is:global>
    /* ============================================================
       DESIGN TOKENS — hamcat.live
       Source de vérité unique pour palette + typographie.
       Modifier ici se répercute partout dans le site.
       ============================================================ */
    :root {
      /* Couleurs des facettes (arc-en-ciel saturé, ordre = spectre) */
      --facet-son:     oklch(0.65 0.22 25);   /* rouge-orange   ~0 deg spectre  */
      --facet-regie:   oklch(0.75 0.18 80);   /* jaune-or       ~60 deg spectre */
      --facet-cours:   oklch(0.70 0.17 145);  /* vert           ~120 deg spectre */
      --facet-blog:    oklch(0.72 0.14 195);  /* cyan           ~180 deg spectre */
      --facet-outils:  oklch(0.65 0.18 260);  /* bleu           ~240 deg spectre */
      --facet-contact: oklch(0.68 0.20 320);  /* violet-rose    ~300 deg spectre */

      /* Neutres (dark theme) */
      --bg-app: #0b0b10;       /* fond global */
      --bg-surface: #15151c;   /* surfaces / cartes */
      --bg-elevated: #1f1f28;  /* surfaces élevées */
      --border: #2a2a33;       /* bordures discrètes */

      /* Texte */
      --text-primary: #f0f0f5;
      --text-secondary: #9a9aac;
      --text-tertiary: #55555f;

      /* Typographie */
      --font-display: 'Barlow Condensed', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, monospace;

      /* Rayon */
      --radius-lg: 16px;

      /* Panneaux état 2 */
      --panel-max-w: 300px;

      /* Platine — logo central atténué en état actif */
      --logo-dim: 0.15;

      /* Modal état 3 — flou de fond */
      --modal-blur: 10px;

      /* Fond des panels état 2 */
      --panel-bg: color-mix(in srgb, var(--bg-app) 92%, white);
      /* Flip animation */
      --flip-duration: 600ms;
      /* Flip arrows état 1 */
      --flip-arrow-size: 1.4rem;
    }

    /* ============================================================
       RESET & LAYOUT GLOBAL
       Viewport fixe hors modal ; scroll activé avec ?modal=1.
       ============================================================ */
    html, body {
      height: 100%;
      overflow: hidden;
      margin: 0;
      padding: 0;
      background-color: var(--bg-app);
      color: var(--text-primary);
      font-family: var(--font-display);
      -webkit-font-smoothing: antialiased;
    }

    body {
      position: fixed;
      width: 100%;
      overscroll-behavior: none;
    }

    /* Fond de page (image avec opacité réduite) */
    .bg-fond {
      position: fixed;
      inset: 0;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: 0.22;
      pointer-events: none;
      z-index: 0;
    }

    /* Scrollbar discrète, neutre */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-surface); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--text-tertiary); }

    /* ============================================================
       VIEW TRANSITIONS
       Iris depuis le centre (130 px = rayon du disque en état 1).
       Forward : iris s'ouvre. Back : iris se referme.
       ============================================================ */
    @keyframes vt-iris-in {
      from { clip-path: circle(130px at 50% 50%); }
      to   { clip-path: circle(150% at 50% 50%); }
    }
    @keyframes vt-iris-out {
      from { clip-path: circle(150% at 50% 50%); }
      to   { clip-path: circle(130px at 50% 50%); }
    }
    @keyframes vt-fade-out { to   { opacity: 0; } }
    @keyframes vt-fade-in  { from { opacity: 0; } }

    @keyframes needle-bounce {
      0%   { transform: translateX(-50%) scaleY(1); }
      30%  { transform: translateX(-50%) scaleY(1.5) translateY(-3px); }
      65%  { transform: translateX(-50%) scaleY(0.85) translateY(2px); }
      100% { transform: translateX(-50%) scaleY(1); }
    }
    @keyframes facet-snap-pulse {
      0%   { scale: 1;    filter: none; }
      35%  { scale: 1.18; filter: drop-shadow(0 0 10px var(--highlight-c, white)); }
      100% { scale: 1;    filter: none; }
    }
    @keyframes arrow-pulse {
      0%, 100% { opacity: 0.4; transform: translateY(0); }
      50%       { opacity: 1;   transform: translateY(var(--arrow-drift, -4px)); }
    }
    @keyframes modal-enter {
      from { opacity: 0; transform: scale(0.94) translateY(12px); }
      to   { opacity: 1; transform: scale(1)    translateY(0); }
    }
    @keyframes flip-out {
      0%   { transform: perspective(900px) rotateX(0deg); opacity: 1; }
      50%  { transform: perspective(900px) rotateX(calc(var(--flip-dir, 1) * 90deg)); opacity: 0; }
      51%  { transform: perspective(900px) rotateX(calc(var(--flip-dir, 1) * -90deg)); opacity: 0; }
      100% { transform: perspective(900px) rotateX(0deg); opacity: 1; }
    }
    .scene.flipping {
      animation: flip-out var(--flip-duration) cubic-bezier(0.4, 0, 0.2, 1) forwards;
      pointer-events: none;
    }

    /* Aller : nouveau contenu émerge de l'iris, ancien s'efface */
    ::view-transition-old(root) {
      animation: 220ms ease-in both vt-fade-out;
    }
    ::view-transition-new(root) {
      animation: 460ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both vt-iris-in;
    }

    /* Retour : iris se referme, ancien reparaît */
    html[data-astro-transition="back"] ::view-transition-old(root) {
      animation: 460ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both vt-iris-out;
    }
    html[data-astro-transition="back"] ::view-transition-new(root) {
      animation: 220ms ease-out both vt-fade-in;
    }

    /* Respecte la préférence de réduction de mouvement */
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-old(root),
      ::view-transition-new(root) { animation: none; }
    }

    /* ── Player audio persistant ──────────────────────────────── */
    #hamcat-player {
      position: fixed; bottom: 0; left: 0; right: 0;
      background: var(--bg-elevated);
      border-top: 1px solid var(--border);
      z-index: 1000;
      transform: translateY(100%);
      transition: transform 0.3s ease;
      padding: 0 1.25rem;
      view-transition-name: hamcat-player;
    }
    #hamcat-player[data-active="true"] { transform: translateY(0); }
    ::view-transition-old(hamcat-player),
    ::view-transition-new(hamcat-player) {
      animation: none;
      mix-blend-mode: normal;
    }
    .player-controls {
      display: flex; align-items: center; gap: 0.75rem;
      height: 56px; width: 100%;
    }
    #player-label {
      flex: 1;
      font-family: var(--font-display);
      font-size: 0.88rem;
      color: var(--text-primary);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .player-controls button {
      background: none; border: none; cursor: pointer;
      font-size: 1rem; color: var(--text-secondary); padding: 0.25rem 0.4rem;
      border-radius: 4px; transition: color 0.15s ease, background 0.15s ease;
      line-height: 1;
    }
    .player-controls button:hover { color: var(--text-primary); background: var(--bg-surface); }
    #btn-playpause { color: var(--facet-son); font-size: 1.1rem; }
  </style>

  <!-- Mode modal (?modal=1) : scroll activé pour affichage dans iframe -->
  <script is:inline>
    if (new URLSearchParams(location.search).has('modal')) {
      var s = document.createElement('style');
      s.textContent = 'html,body{height:auto!important;overflow:auto!important}body{position:static!important;overscroll-behavior:auto!important}';
      document.head.appendChild(s);
    }
  </script>

  <script>
    // ── Navigation clavier inter-facettes ────────────────────
    // ← → : cycle entre facettes (toutes pages sauf accueil)
    // Échap : retour accueil
    // ↑ ↓  : libre (scroll de page)
    import { navigate } from 'astro:transitions/client';

    let ctrl: AbortController | null = null;

    document.addEventListener('astro:page-load', () => {
      ctrl?.abort();

      if (window.location.pathname === '/') return; // turntable gère lui-même

      const el = document.getElementById('facet-nav');
      if (!el) return;
      const hrefs: string[] = JSON.parse(el.dataset.hrefs ?? '[]');

      const path = window.location.pathname;
      const idx  = hrefs.findIndex(h => path === h || path.startsWith(h + '/'));
      if (idx === -1) return; // page hors-facette (/404, etc.)

      const prevHref = hrefs[(idx - 1 + hrefs.length) % hrefs.length];
      const nextHref = hrefs[(idx + 1) % hrefs.length];

      ctrl = new AbortController();
      window.addEventListener('keydown', (e) => {
        if ((e.target as Element).closest('input, textarea, [contenteditable]')) return;
        if      (e.key === 'ArrowLeft')  { e.preventDefault(); navigate(prevHref); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); navigate(nextHref); }
        else if (e.key === 'Escape')     { navigate('/'); }
      }, { signal: ctrl.signal });
    });
  </script>
</head>
<body>
  <!-- Fond de page (si fond_url rempli dans site.json) -->
  {siteData.fond_url && (
    <div
      class="bg-fond"
      style={`background-image: url('${siteData.fond_url}')`}
      aria-hidden="true"
    ></div>
  )}
  <!-- Hrefs des facettes pour la navigation clavier globale -->
  <div id="facet-nav" data-hrefs={JSON.stringify(facetHrefs)} style="display:none" aria-hidden="true"></div>
  <slot />

  <script>
  // ── Player audio persistant ──────────────────────────────────────────
  // Exécuté UNE SEULE FOIS par session (déduplication Astro).
  // Le player survit aux ViewTransitions grâce à astro:before-swap.

  (function () {
    if (document.getElementById('hamcat-player')) return;

    const player = document.createElement('div');
    player.id = 'hamcat-player';
    player.dataset.active = 'false';
    player.innerHTML =
      '<iframe id="sc-iframe" src="" style="display:none" allow="autoplay"></iframe>' +
      '<iframe id="sp-iframe" src="" style="display:none;width:100%;height:80px;border:none" allow="autoplay"></iframe>' +
      '<div class="player-controls">' +
        '<button id="btn-playpause" aria-label="Play/Pause">▶</button>' +
        '<span id="player-label">—</span>' +
        '<button id="btn-mute" aria-label="Mute">🔊</button>' +
        '<button id="btn-close" aria-label="Fermer">✕</button>' +
      '</div>';
    document.body.appendChild(player);

    const scIframe = document.getElementById('sc-iframe') as HTMLIFrameElement;
    const spIframe = document.getElementById('sp-iframe') as HTMLIFrameElement;
    const btnPlay  = document.getElementById('btn-playpause') as HTMLButtonElement;
    const btnMute  = document.getElementById('btn-mute') as HTMLButtonElement;
    const btnClose = document.getElementById('btn-close') as HTMLButtonElement;
    const labelEl  = document.getElementById('player-label') as HTMLSpanElement;

    let scWidget: any = null;
    let isMuted = false;
    let source: 'soundcloud' | 'spotify' | null = null;

    // SC API chargée dynamiquement à la demande (pas de script bloquant dans <head>)
    let scApiCallbacks: Array<() => void> = [];
    function whenSCReady(cb: () => void) {
      if ((window as any).SC) { cb(); return; }
      scApiCallbacks.push(cb);
      if (document.getElementById('sc-api-script')) return;
      const s = document.createElement('script');
      s.id  = 'sc-api-script';
      s.src = 'https://w.soundcloud.com/player/api.js';
      s.onload = () => { scApiCallbacks.forEach(fn => fn()); scApiCallbacks = []; };
      document.head.appendChild(s);
    }

    function bindSC() {
      whenSCReady(() => {
        const SC = (window as any).SC;
        if (!SC || !scIframe.src) return;
        scWidget = SC.Widget(scIframe);
        scWidget.bind(SC.Widget.Events.PLAY,   () => { btnPlay.textContent = '⏸'; });
        scWidget.bind(SC.Widget.Events.PAUSE,  () => { btnPlay.textContent = '▶'; });
        scWidget.bind(SC.Widget.Events.FINISH, () => { btnPlay.textContent = '▶'; });
      });
    }

    function loadSoundCloud(url: string, lbl: string) {
      spIframe.src = '';
      spIframe.style.display = 'none';
      source = 'soundcloud';
      scWidget = null;
      btnPlay.textContent = '▶';
      const encoded = encodeURIComponent(url);
      const newSrc  = `https://w.soundcloud.com/player/?url=${encoded}&auto_play=true&visual=false&buying=false&sharing=false&show_artwork=false`;
      // addEventListener AVANT de setter src pour ne jamais rater l'event
      scIframe.addEventListener('load', function onLoad() {
        scIframe.removeEventListener('load', onLoad);
        bindSC();
      }, { once: true });
      scIframe.src = newSrc;
      labelEl.textContent = lbl;
      player.dataset.active = 'true';
      try { localStorage.setItem('hamcat-player', JSON.stringify({ url, lbl, type: 'soundcloud' })); } catch (_) {}
    }

    function loadSpotify(playlistId: string, lbl: string) {
      if (scWidget) { scWidget.pause(); }
      scIframe.src = '';
      source = 'spotify';
      spIframe.src = `https://open.spotify.com/embed/playlist/${playlistId}?autoplay=1&theme=0`;
      spIframe.style.display = 'block';
      labelEl.textContent = lbl;
      player.dataset.active = 'true';
      btnPlay.textContent = '▶';
      try { localStorage.setItem('hamcat-player', JSON.stringify({ playlistId, lbl, type: 'spotify' })); } catch (_) {}
    }

    btnPlay.addEventListener('click', () => {
      if (source === 'soundcloud' && scWidget) {
        scWidget.isPaused((p: boolean) => { p ? scWidget.play() : scWidget.pause(); });
      }
    });

    btnMute.addEventListener('click', () => {
      isMuted = !isMuted;
      btnMute.textContent = isMuted ? '🔇' : '🔊';
      if (source === 'soundcloud' && scWidget) scWidget.setVolume(isMuted ? 0 : 100);
    });

    btnClose.addEventListener('click', () => {
      player.dataset.active = 'false';
      if (scWidget) { scWidget.pause(); scWidget = null; }
      scIframe.src = '';
      spIframe.src = '';
      spIframe.style.display = 'none';
      source = null;
      try { localStorage.removeItem('hamcat-player'); } catch (_) {}
    });

    document.addEventListener('hamcat:play', (e: Event) => {
      const d = (e as CustomEvent).detail;
      if (d.type === 'soundcloud') loadSoundCloud(d.url, d.lbl);
      else if (d.type === 'spotify') loadSpotify(d.playlistId, d.lbl);
    });

    document.addEventListener('astro:after-swap', () => {
      if (window.location.pathname === '/') {
        player.dataset.active = 'false';
        return;
      }
      if (source === 'soundcloud' && scIframe.src) {
        scWidget = null;
        scIframe.addEventListener('load', () => bindSC(), { once: true });
      }
    });

    // FIX PRINCIPAL : déplace le player dans le nouveau document AVANT le swap de body.
    // Sans ça, ViewTransitions détruit l'élément à chaque navigation.
    document.addEventListener('astro:before-swap', (e: Event) => {
      const p = document.getElementById('hamcat-player');
      if (p) (e as any).newDocument.body.appendChild(p);
    });

    // Restauration après hard reload (ignorée sur homepage)
    if (window.location.pathname !== '/') {
      try {
        const saved = localStorage.getItem('hamcat-player');
        if (saved) {
          const s = JSON.parse(saved);
          if (s.type === 'soundcloud' && s.url) loadSoundCloud(s.url, s.lbl);
          else if (s.type === 'spotify' && s.playlistId) loadSpotify(s.playlistId, s.lbl);
        }
      } catch (_) {}
    }
  })();
  </script>
</body>
</html>
