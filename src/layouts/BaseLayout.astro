---
import { ViewTransitions } from 'astro:transitions';
import { visibleFacets } from '../data/facets';
import siteData from '../data/site.json';

const seo = {
  title:       "Hamcat — DJ · Son · MAO · Événements",
  description: "Fx Jam alias Hamcat : DJ psytrance/hi-tech/goa, ingénieur son FOH, formateur MAO Ableton, co-organisateur ADN Festival. Basé à Grenoble.",
  url:         "https://hamcat.live",
  image:       "https://media.hamcat.live/logos/logo.jpg",
  twitter:     "@hamcat_fx",
};

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Donnees structurees schema.org injectees dans un <script type="application/ld+json">. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Pages internes (atelier) : hors index des moteurs. Ce n'est pas une
   *  protection — juste de l'hygiene, elles n'ont rien a faire en resultat. */
  noindex?: boolean;
}
// v1.38 — SEO par page. Avant : les props title/description etaient deconstruites
// mais jamais utilisees, le <head> lisait toujours l'objet seo global. Resultat :
// les 8 pages sortaient le meme titre, la meme description et le meme canonical.
const { title, description, image, jsonLd, noindex } = Astro.props;
const pageTitle       = title       ?? seo.title;
const pageDescription = description ?? seo.description;
const pageImage       = image       ?? seo.image;
const canonicalUrl    = new URL(Astro.url.pathname, seo.url).href;
const facetHrefs = visibleFacets().map(f => f.href);
---
<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <!-- Installable sur l'ecran d'accueil : on ne tape pas une URL dans le tram. -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#0b0b10" />
  {/* La variante Apple reste pour les iOS anciens ; la version standard la
      remplace, Chrome signalait la depreciation en console. */}
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Hamcat" />
  <link rel="apple-touch-icon" href="https://media.hamcat.live/logos/logo.jpg" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:title"       content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image"       content={pageImage} />
  <meta property="og:site_name"   content={siteData.displayName} />
  <meta property="og:locale"      content="fr_FR" />
  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:site"        content={seo.twitter} />
  <meta name="twitter:title"       content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image"       content={pageImage} />
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  )}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <ViewTransitions />
  <script src="https://w.soundcloud.com/player/api.js" is:inline></script>
  <script src="https://open.spotify.com/embed/iframe-api/v1" is:inline></script>
  <script is:inline>window.onSpotifyWebPlaybackSDKReady = function () {};</script>
  <script src="https://sdk.scdn.co/spotify-player.js" is:inline></script>

  <style is:global>
    /* ============================================================
       DESIGN TOKENS — hamcat.live
       Source de vérité unique pour palette + typographie.
       Modifier ici se répercute partout dans le site.
       ============================================================ */
    :root {
      /* Couleurs des facettes (arc-en-ciel saturé, ordre = spectre) */
      --facet-son:     oklch(0.65 0.22 25);   /* rouge-orange   ~0 deg spectre  */
      --facet-regie:   oklch(0.75 0.18 80);   /* jaune-or       ~60 deg spectre */
      --facet-projets:   oklch(0.70 0.17 145);  /* vert           ~120 deg spectre */
      --facet-blog:    oklch(0.72 0.14 195);  /* cyan           ~180 deg spectre */
      --facet-outils:  oklch(0.65 0.18 260);  /* bleu           ~240 deg spectre */
      --facet-contact: oklch(0.68 0.20 320);  /* violet-rose    ~300 deg spectre */

      /* Couleurs de style musical — waveforms et pastilles de genre.
         Meme logique de spectre que les facettes : les styles sont ranges du
         plus calme au plus dur, et leur teinte suit la roue dans cet ordre.
         Ajouter un style = ajouter son jeton ici, en le glissant a sa place
         dans la progression ; le reste du site le prend sans rien changer. */
      --style-dub:               oklch(0.72 0.14 162);
      --style-psybient:          oklch(0.80 0.10 178);
      --style-psychill:          oklch(0.78 0.13 195);
      --style-chillgressive:     oklch(0.75 0.15 215);
      --style-tech-house:        oklch(0.70 0.13 238);
      --style-psydub:            oklch(0.70 0.16 255);
      --style-dark-prog:         oklch(0.58 0.15 272);
      --style-darkpsy:           oklch(0.62 0.20 285);
      --style-psyprog:           oklch(0.70 0.19 295);
      --style-dnb:               oklch(0.68 0.20 315);
      --style-psytrance:         oklch(0.72 0.21 330);
      --style-rock-psyche:       oklch(0.64 0.18 5);
      --style-mentalcore:        oklch(0.66 0.23 20);
      --style-acidcore:          oklch(0.60 0.22 32);
      --style-goa:               oklch(0.74 0.17 45);
      --style-full-on:           oklch(0.78 0.19 60);
      --style-nitzhonot:         oklch(0.80 0.16 78);
      --style-j-core:            oklch(0.82 0.17 86);
      --style-hi-tech:           oklch(0.80 0.18 95);
      --style-ethno-grooves:     oklch(0.76 0.14 112);
      --style-chill-hop:         oklch(0.80 0.11 128);
      --style-electrad:          oklch(0.76 0.19 140);
      /* Deux cas a part : le metal ne tient pas dans la roue psy, et un mashup
         n'a par definition pas de teinte propre — tous deux desatures. */
      --style-metal:             oklch(0.55 0.03 265);
      --style-mashup-multigenre: oklch(0.74 0.05 320);
      /* Teinte par defaut d'une waveform sans style reconnu */
      --style-default:       var(--facet-son);
      /* Partie non encore lue d'une waveform : gris clair, lisible sur le fond sombre */
      --wave-rest: rgba(240, 240, 245, 0.30);

      /* Neutres (dark theme) */
      --bg-app: #0b0b10;       /* fond global */
      --bg-surface: #15151c;   /* surfaces / cartes */
      --bg-elevated: #1f1f28;  /* surfaces élevées */
      --border: #2a2a33;       /* bordures discrètes */

      /* Texte */
      --text-primary: #f0f0f5;
      --text-secondary: #9a9aac;
      --text-tertiary: #55555f;

      /* Typographie */
      --font-display: 'Barlow Condensed', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, monospace;

      /* Rayon */
      --radius-lg: 16px;

      /* Panneaux état 2 */
      --panel-max-w: 300px;

      /* Platine — logo central atténué en état actif */
      --logo-dim: 0.15;

      /* Modal état 3 — flou de fond */
      --modal-blur: 10px;

      /* Fond des panels état 2 */
      --panel-bg: color-mix(in srgb, var(--bg-app) 92%, white);
      /* Flip animation */
      --flip-duration: 600ms;
      /* Flip arrows état 1 */
      --flip-arrow-size: 1.4rem;
    }

    /* ============================================================
       RESET & LAYOUT GLOBAL
       Viewport fixe hors modal ; scroll activé avec ?modal=1.
       ============================================================ */
    html, body {
      height: 100%;
      overflow: hidden;
      margin: 0;
      padding: 0;
      background-color: var(--bg-app);
      color: var(--text-primary);
      font-family: var(--font-display);
      -webkit-font-smoothing: antialiased;
    }

    body {
      position: fixed;
      width: 100%;
      overscroll-behavior: none;
    }

    /* Fond de page (image avec opacité réduite) */
    .bg-fond {
      position: fixed;
      inset: 0;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: 0.22;
      pointer-events: none;
      z-index: 0;
    }

    /* Scrollbar discrète, neutre */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-surface); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--text-tertiary); }

    /* ============================================================
       VIEW TRANSITIONS
       Iris depuis le centre (130 px = rayon du disque en état 1).
       Forward : iris s'ouvre. Back : iris se referme.
       ============================================================ */
    @keyframes vt-iris-in {
      from { clip-path: circle(130px at 50% 50%); }
      to   { clip-path: circle(150% at 50% 50%); }
    }
    @keyframes vt-iris-out {
      from { clip-path: circle(150% at 50% 50%); }
      to   { clip-path: circle(130px at 50% 50%); }
    }
    @keyframes vt-fade-out { to   { opacity: 0; } }
    @keyframes vt-fade-in  { from { opacity: 0; } }

    @keyframes needle-bounce {
      0%   { transform: translateX(-50%) scaleY(1); }
      30%  { transform: translateX(-50%) scaleY(1.5) translateY(-3px); }
      65%  { transform: translateX(-50%) scaleY(0.85) translateY(2px); }
      100% { transform: translateX(-50%) scaleY(1); }
    }
    @keyframes facet-snap-pulse {
      0%   { scale: 1;    filter: none; }
      35%  { scale: 1.18; filter: drop-shadow(0 0 10px var(--highlight-c, white)); }
      100% { scale: 1;    filter: none; }
    }
    @keyframes arrow-pulse {
      0%, 100% { opacity: 0.4; transform: translateY(0); }
      50%       { opacity: 1;   transform: translateY(var(--arrow-drift, -4px)); }
    }
    @keyframes modal-enter {
      from { opacity: 0; transform: scale(0.94) translateY(12px); }
      to   { opacity: 1; transform: scale(1)    translateY(0); }
    }
    @keyframes flip-out {
      0%   { transform: perspective(900px) rotateX(0deg); opacity: 1; }
      50%  { transform: perspective(900px) rotateX(calc(var(--flip-dir, 1) * 90deg)); opacity: 0; }
      51%  { transform: perspective(900px) rotateX(calc(var(--flip-dir, 1) * -90deg)); opacity: 0; }
      100% { transform: perspective(900px) rotateX(0deg); opacity: 1; }
    }
    .scene.flipping {
      animation: flip-out var(--flip-duration) cubic-bezier(0.4, 0, 0.2, 1) forwards;
      pointer-events: none;
    }

    /* Aller : nouveau contenu émerge de l'iris, ancien s'efface */
    ::view-transition-old(root) {
      animation: 220ms ease-in both vt-fade-out;
    }
    ::view-transition-new(root) {
      animation: 460ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both vt-iris-in;
    }

    /* Retour : iris se referme, ancien reparaît */
    html[data-astro-transition="back"] ::view-transition-old(root) {
      animation: 460ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both vt-iris-out;
    }
    html[data-astro-transition="back"] ::view-transition-new(root) {
      animation: 220ms ease-out both vt-fade-in;
    }

    /* Respecte la préférence de réduction de mouvement */
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-old(root),
      ::view-transition-new(root) { animation: none; }
    }

    /* ── Player audio persistant ──────────────────────────────── */
    @keyframes play-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: 0.5; transform: scale(0.85); }
    }

    /* ── Projection des medias ──────────────────────────────────────
       Deux bandes verticales de part et d'autre du cadre de la facette, qui
       fait 820 px de large et reste centre. Une image plein ecran derriere du
       texte oblige a la voiler pour rester lisible : on n'a alors ni une belle
       photo ni un texte net. Les bandes occupent l'espace deja vide, ne
       recouvrent aucun texte, et respectent la symetrie du site — deux moitiees
       identiques autour du cadre.
       Rien n'est peint tant qu'aucune date n'est survolee : sans le garde
       data-on, le degrade assombrissait tout le site des l'accueil. */
    :root { --frame-w: 820px; --band-w: calc((100vw - var(--frame-w)) / 2); }

    #media-bg {
      position: fixed; inset: 0; z-index: 0;
      pointer-events: none;
      opacity: 0; transition: opacity 0.7s ease;
    }
    #media-bg[data-on="true"] { opacity: 1; }
    /* Sous cette largeur les bandes sont trop etroites pour montrer quoi que
       ce soit : on s'abstient plutot que d'entasser. */
    @media (max-width: 1219px) { #media-bg { display: none; } }

    .mb-band {
      position: absolute; top: 0; bottom: 0;
      width: var(--band-w);
      overflow: hidden;
    }
    .mb-band--l { left: 0; }
    .mb-band--r { right: 0; }
    /* Fondu vers le cadre : la bande s'eteint avant de l'atteindre, et
       s'estompe aussi en haut et en bas pour ne pas faire un bloc. */
    .mb-band--l {
      -webkit-mask-image: linear-gradient(to right, #000 0%, #000 45%, transparent 92%),
                          linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
              mask-image: linear-gradient(to right, #000 0%, #000 45%, transparent 92%),
                          linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
      -webkit-mask-composite: source-in; mask-composite: intersect;
    }
    .mb-band--r {
      -webkit-mask-image: linear-gradient(to left, #000 0%, #000 45%, transparent 92%),
                          linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
              mask-image: linear-gradient(to left, #000 0%, #000 45%, transparent 92%),
                          linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
      -webkit-mask-composite: source-in; mask-composite: intersect;
    }

    .mb {
      position: absolute; inset: -6%;
      background-size: cover; background-position: center;
      opacity: 0;
      transition: opacity 1.6s ease;
      will-change: opacity, transform;
      animation: mb-drift 38s ease-in-out infinite alternate;
    }
    /* Assez presente pour se lire, assez discrete pour rester un fond. */
    .mb.on { opacity: 0.55; }
    @keyframes mb-drift {
      from { transform: scale(1.04) translate3d(0, -1.5%, 0); }
      to   { transform: scale(1.12) translate3d(0, 1.5%, 0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .mb { animation: none; transition: opacity 0.4s ease; }
    }

    /* Hauteur occupee par le player, exposee aux pages pour qu'elles se reservent
       la place : sans ca, la barre reduite passe par-dessus le disque d'accueil. */
    :root {
      --player-pad: 0px;
      /* Respiration entre la barre de lecture et le bas des pages pleines.
         Elle entre dans --player-pad, donc les huit pages en heritent sans
         qu'aucune ait a la connaitre. */
      --player-gap: 14px;
    }
    /*  Echelle tactile. Le telephone de Fx declare un viewport d'environ
        950 px CSS alors que la balise `viewport` demande `device-width` : le
        navigateur est en mode « site pour ordinateur ». Consequence, le pixel
        CSS y est physiquement deux fois trop petit, et tout le bloc d'ecoute
        devient difficile a lire et a viser — ce n'est pas une question de
        tailles mal choisies, c'est l'unite elle-meme qui est fausse.
        On compense la ou ca se voit le plus. Un viewport large ET tactile est
        le signal : aucune tablette ne se tient a la distance d'un ecran de
        bureau. `--tac` est la seule source de verite, lue par le CSS pour le
        zoom et par le JS pour la hauteur du panneau — sans quoi la
        bibliotheque se dimensionnerait dans une unite et s'afficherait dans
        une autre. */
    :root { --tac: 1; }
    @media (pointer: coarse) and (min-width: 700px) { :root { --tac: 1.35; } }

    #hamcat-player {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000;
      pointer-events: none;
      zoom: var(--tac);
    }
    #hamcat-player[data-active="true"] { pointer-events: auto; }

    /* ── Bibliotheque ── mi-hauteur, au-dessus du player, repliable */
    #library-panel {
      position: absolute;
      left: 0; right: 0; bottom: 100%;
      height: var(--lib-h, 50vh);
      max-height: calc(100dvh - 56px);
      display: flex;
      flex-direction: column;
      background: color-mix(in srgb, var(--bg-app) 92%, transparent);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      pointer-events: auto;
    }
    #library-panel[hidden] { display: none; }
    #library-panel { transition: height 0.11s cubic-bezier(0.2, 0, 0, 1); }
    /* Pendant le glissement, le flou d'arriere-plan est coupe. Un
       backdrop-filter oblige le compositeur a re-echantillonner et re-flouter
       TOUTE la surface du panneau a chaque changement de hauteur : au-dessus
       d'un fond etoile anime, c'est ce qui rendait le redimensionnement
       saccade. Le fond devient opaque le temps du geste, personne ne le
       remarque, et le glissement redevient fluide. */
    #library-panel[data-drag="1"] {
      backdrop-filter: none;
      background: var(--bg-app);
      transition: none;
      overflow: hidden;
    }
    /* Pendant le geste, la liste garde une hauteur fixe et c'est le panneau qui
       la rogne. Sans ca, chaque pixel parcouru redistribuait la hauteur du
       conteneur flexible et remettait la liste entiere en page. */
    #library-panel[data-drag="1"] .lib-list {
      flex: 0 0 auto;
      height: var(--lib-fix, 50vh);
    }

    /* Poignee : toute la largeur du panneau est saisissable, et la zone deborde
       vers le haut au-dela de sa hauteur visible pour rattraper les pouces. */
    #lib-grip {
      height: 22px;
      flex: 0 0 auto;
      cursor: ns-resize;
      touch-action: none;
      position: relative;
      display: flex; align-items: center; justify-content: center;
    }
    #lib-grip::after {
      content: '';
      position: absolute; left: 0; right: 0; top: -10px; bottom: -6px;
    }
    #lib-grip::before {
      content: '';
      width: 56px; height: 4px; border-radius: 2px;
      background: var(--border);
      transition: background 0.15s;
    }
    #lib-grip:hover::before,
    #lib-grip[data-drag="1"]::before { background: var(--facet-son); }

    /* Poignee de remontee : quand la bibliotheque est fermee, le bord haut du
       player reste saisissable — on tire vers le haut pour la rouvrir, sans
       repasser par le hamburger. */
    #lib-handle {
      position: absolute;
      left: 0; right: 0; top: -12px; height: 26px;
      cursor: ns-resize;
      touch-action: none;
      pointer-events: auto;
      display: flex; align-items: flex-end; justify-content: center;
      padding-bottom: 4px;
    }
    #hamcat-player[data-library="true"] #lib-handle,
    #hamcat-player[data-active="false"] #lib-handle { display: none; }
    #lib-handle::before {
      content: '';
      width: 56px; height: 4px; border-radius: 2px;
      background: color-mix(in srgb, var(--border) 70%, transparent);
      transition: background 0.15s;
    }
    #lib-handle:hover::before { background: var(--facet-son); }

    .lib-head {
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.6rem 1rem 0.5rem;
      flex: 0 0 auto;
    }
    #lib-search {
      flex: 1 1 auto; min-width: 0;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 0.4rem 0.7rem;
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 0.78rem;
    }
    #lib-search:focus { outline: none; border-color: var(--facet-son); }
    .lib-count {
      font-family: var(--font-mono); font-size: 0.62rem;
      color: var(--text-tertiary); white-space: nowrap;
    }
    #btn-lib-close {
      background: none; border: none; color: var(--text-tertiary);
      cursor: pointer; font-size: 0.85rem; padding: 0.2rem 0.4rem;
    }
    #btn-lib-close:hover { color: var(--text-primary); }

    /* Une seule rangee qui defile : a vingt-deux styles, un retour a la ligne
       mangerait la moitie de la hauteur utile de la liste. */
    .lib-filters {
      display: flex; gap: 0.3rem;
      padding: 0 1rem 0.5rem;
      flex: 0 0 auto;
      overflow-x: auto; overflow-y: hidden;
      scrollbar-width: none;
    }
    .lib-filters::-webkit-scrollbar { display: none; }
    .lib-chip {
      flex: 0 0 auto;
      display: inline-flex; align-items: center; gap: 0.3rem;
      font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em;
      padding: 0.24rem 0.55rem; border-radius: 999px;
      border: 1px solid var(--border); background: transparent;
      color: var(--text-tertiary); cursor: pointer; white-space: nowrap;
      transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    /* Chaque pastille porte la couleur de son style : la rangee sert aussi de
       legende pour les waveforms, qui utilisent exactement les memes teintes. */
    .lib-chip[data-style]:not([data-style=""]) {
      border-color: color-mix(in srgb, var(--chip) 40%, transparent);
      color: color-mix(in srgb, var(--chip) 78%, var(--text-tertiary));
    }
    .lib-chip em {
      font-style: normal; font-size: 0.56rem; opacity: 0.6;
      font-variant-numeric: tabular-nums;
    }
    .lib-chip:hover { border-color: var(--facet-son); color: var(--text-secondary); }
    .lib-chip.is-on {
      border-color: var(--facet-son); color: var(--facet-son);
      background: color-mix(in srgb, var(--facet-son) 14%, transparent);
    }
    .lib-chip[data-style]:not([data-style=""]).is-on {
      border-color: var(--chip); color: var(--chip);
      background: color-mix(in srgb, var(--chip) 16%, transparent);
    }

    /* `contain` arrete la propagation du recalcul : changer la hauteur du
       panneau ne doit pas relayouter tout ce qu'il contient. */
    .lib-list {
      flex: 1 1 auto; overflow-y: auto; padding: 0 0.6rem 0.6rem;
      contain: layout paint;
    }
    /* La legende reprend exactement la grille des lignes. */
    .lib-legend {
      display: grid;
      grid-template-columns: 26px 90px minmax(0, 1fr) minmax(0, 0.5fr) 30px;
      column-gap: 0.55rem;
      padding: 0 1rem 0.3rem;
      font-family: var(--font-mono);
      font-size: 0.55rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-tertiary);
      opacity: 0.6;
      flex: 0 0 auto;
    }
    .lib-legend span:last-child { text-align: right; }

    .lib-row {
      display: grid;
      grid-template-columns: 26px 90px minmax(0, 1fr) minmax(0, 0.5fr) 30px;
      align-items: center; column-gap: 0.55rem;
      padding: 0.2rem 0.4rem;
      border-top: 1px solid var(--border);
      cursor: pointer;
      /* `contain` isole chaque ligne : ce qui se passe dedans ne remonte pas.
         J'avais d'abord mis `content-visibility: auto` — mauvaise idee ici :
         pendant un redimensionnement, les lignes traversent sans arret la
         limite du champ visible, et chaque passage relance la mise en page de
         sa waveform SVG. Excellent pour defiler, contre-productif pour
         redimensionner. */
      contain: layout paint style;
    }
    .lib-row:hover { background: color-mix(in srgb, var(--facet-son) 7%, transparent); }
    .lib-row.is-current { background: color-mix(in srgb, var(--facet-son) 12%, transparent); }
    .lib-play {
      background: none; border: 1px solid var(--border); border-radius: 5px;
      color: var(--text-secondary); cursor: pointer;
      font-size: 0.6rem; line-height: 1; padding: 0.24rem 0;
    }
    .lib-row:hover .lib-play { border-color: var(--facet-son); color: var(--facet-son); }
    .lib-date, .lib-styles, .lib-src {
      font-family: var(--font-mono); font-size: 0.6rem; color: var(--text-tertiary);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .lib-src { text-align: right; }
    .lib-title {
      font-family: var(--font-display); font-weight: 600; font-size: 0.82rem;
      color: var(--text-primary);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .lib-title .lib-sub { color: var(--text-tertiary); font-weight: 400; font-size: 0.72rem; }
    /* La waveform n'apparait que sur la ligne en cours de lecture : la liste
       reste compacte et on ne telecharge qu'un seul fichier de pics. */
    .lib-wave { grid-column: 2 / -1; height: 20px; cursor: pointer; margin: 0.15rem 0 0.1rem; }
    .lib-wave--none { cursor: default; }
    .lib-wave svg { width: 100%; height: 100%; display: block; }
    .lib-wave .wave-bg { fill: color-mix(in srgb, var(--wave-played, var(--style-default)) 30%, transparent); }
    .lib-wave .wave-fg { fill: var(--wave-played, var(--style-default)); }

    .player-lib-btn {
      background: none; border: 1px solid var(--border); border-radius: 6px;
      color: var(--text-secondary); cursor: pointer;
      font-size: 0.8rem; line-height: 1; padding: 0.3rem 0.5rem;
    }
    .player-lib-btn:hover { border-color: var(--facet-son); color: var(--facet-son); }
    #hamcat-player[data-library="true"] .player-lib-btn {
      border-color: var(--facet-son); color: var(--facet-son);
      background: color-mix(in srgb, var(--facet-son) 14%, transparent);
    }

    @media (max-width: 720px) {
      .lib-row { grid-template-columns: 26px 72px minmax(0, 1fr) 26px; }
      .lib-styles { display: none; }
    }

    /* Pill — centré, toujours par-dessus */
    .player-seed {
      display: flex;
      position: absolute;
      bottom: 14px; left: 0; right: 0;
      justify-content: center;
      pointer-events: none;
    }
    #hamcat-player[data-active="true"] .player-seed { display: none; }
    #btn-seed {
      pointer-events: auto;
      width: 48px; height: 48px;
      display: flex; align-items: center; justify-content: center; gap: 1px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
      backdrop-filter: blur(8px);
      color: var(--text-secondary);
      font-family: var(--font-mono); font-size: 0.85rem;
      cursor: pointer;
      transition: border-color 0.15s, color 0.15s, background 0.15s;
    }
    #btn-seed span { font-size: 0.7rem; opacity: 0.7; }
    #btn-seed:hover {
      border-color: var(--facet-son); color: var(--facet-son);
      background: color-mix(in srgb, var(--facet-son) 12%, var(--bg-elevated));
    }

    .play-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--facet-son);
    }
    #hamcat-player.playing .play-dot {
      animation: play-pulse 1.8s ease-in-out infinite;
    }

    /* Transport bar — cachée par défaut */
    .player-full {
      display: none;
      align-items: center;
      gap: 0.75rem;
      height: 56px;
      padding: 0 1.25rem;
      background: var(--bg-elevated);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(8px);
    }
    #hamcat-player[data-active="true"] .player-full { display: flex; }

    #player-artwork {
      width: 40px; height: 40px;
      border-radius: 4px;
      object-fit: cover;
      flex-shrink: 0;
      background: var(--bg-surface);
    }
    .player-meta {
      display: flex; flex-direction: column; justify-content: center;
      min-width: 0; flex: 1;
      gap: 0.1rem;
    }
    #player-title {
      font-family: var(--font-display);
      font-size: 0.88rem;
      color: var(--text-primary);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      text-decoration: none;
    }
    #player-title[href]:hover { text-decoration: underline; }
    .player-meta-sub {
      display: flex; align-items: center; gap: 0.35rem;
      min-width: 0;
    }
    #player-artist {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--text-secondary);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      min-width: 0;
    }
    .source-badge {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      background: var(--facet-son);
      color: #fff;
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      align-self: flex-start;
    }
    .source-badge.sp { background: oklch(0.55 0.22 145); }
    .player-spotify-connect {
      font-family: var(--font-mono) !important;
      font-size: 0.62rem !important;
      color: oklch(0.65 0.22 145) !important;
      border: 1px solid oklch(0.55 0.22 145) !important;
      padding: 0.2rem 0.5rem !important;
      white-space: nowrap;
    }
    .player-spotify-connect:hover { background: oklch(0.55 0.22 145 / 0.15) !important; color: oklch(0.65 0.22 145) !important; }
    /* Au bureau les groupes n'existent pas : leurs enfants sont directement
       les elements flex de la barre, exactement comme avant. */
    .pg, .pg-art { display: contents; }

    .player-scrubber {
      flex: 1; height: 30px;
      background: transparent;
      cursor: pointer;
      position: relative;
      min-width: 80px;
    }
    .player-scrubber::before {
      content: '';
      position: absolute;
      left: 0; right: 0;
      top: 50%; transform: translateY(-50%);
      height: 3px;
      background: var(--border);
      border-radius: 2px;
    }
    #scrubber-fill {
      position: absolute;
      left: 0; top: 50%; transform: translateY(-50%);
      height: 3px; width: 0%;
      background: var(--facet-son);
      border-radius: 2px;
      pointer-events: none;
    }
    /* Quand la waveform est la, elle prend toute la place et la barre pleine
       s'efface — y compris son rail, sans quoi un trait la traversait. */
    #player-wave { position: absolute; inset: 0; pointer-events: none; }
    #player-wave svg { width: 100%; height: 100%; display: block; }
    #player-wave .wave-bg { fill: color-mix(in srgb, var(--wave-played, var(--facet-son)) 28%, transparent); }
    #player-wave .wave-fg { fill: var(--wave-played, var(--facet-son)); }
    .player-scrubber:has(#player-wave:not([hidden])) { background: none; }
    .player-scrubber:has(#player-wave:not([hidden]))::before { display: none; }
    .player-scrubber:has(#player-wave:not([hidden])) #scrubber-fill { display: none; }

    /* Precedent / suivant : memes dimensions que les autres boutons du
       transport, pour que la rangee reste reguliere. */
    .player-step {
      background: none; border: none; cursor: pointer;
      color: var(--text-secondary); font-size: 0.85rem;
      padding: 0.3rem 0.45rem; border-radius: 6px;
      transition: color 0.15s, background 0.15s;
    }
    .player-step:hover { color: var(--facet-son); background: var(--bg-surface); }
    #player-time {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-secondary);
      white-space: nowrap;
      flex-shrink: 0;
    }
    .player-full button {
      background: none; border: none; cursor: pointer;
      font-size: 1rem; color: var(--text-secondary); padding: 0.25rem 0.4rem;
      border-radius: 4px; transition: color 0.15s, background 0.15s;
      flex-shrink: 0;
    }
    .player-full button:hover { color: var(--text-primary); background: var(--bg-surface); }
    #btn-sp-shuffle[data-active="1"],
    #btn-sp-repeat[data-mode="1"],
    #btn-sp-repeat[data-mode="2"] { color: var(--facet-son); }

    /* v1.36: slider de volume + selecteur de sortie audio */
    .player-volume-slider {
      width: 64px; flex-shrink: 0; accent-color: var(--facet-son);
      cursor: pointer; height: 20px;
    }
    .player-output-select {
      flex-shrink: 0; max-width: 90px;
      background: var(--bg-surface); color: var(--text-secondary);
      border: 1px solid var(--border); border-radius: 4px;
      font-family: var(--font-mono); font-size: 0.62rem;
      padding: 0.15rem 0.25rem; cursor: pointer;
    }

    /* v1.28: sur mobile, priorite au titre — le reste se degage/retrecit
       24/09 : cette double rangee reste la bonne reponse en dessous de 480 px,
       ou rien ne tient sur une ligne. Elle avait ete etendue au tactile, puis
       ramenee ici : sur un ecran large tenu au doigt elle produisait une barre
       de trois rangees, transport pousse a droite et boutons de connexion
       orphelins en bas. La largeur est le bon critere pour une MISE EN PAGE —
       c'est pour les CIBLES qu'il fallait le pointeur. Voir le bloc tactile
       en fin de feuille. */
    @media (max-width: 480px) {
      /* Trois commandes atteignables au pouce, bien separees : menu a gauche,
         lecture au centre, muet a droite. Le reste se range entre les deux. */
      /* La barre porte desormais tout : sur telephone elle passe sur deux
         rangees plutot que de sacrifier des commandes. La waveform occupe la
         seconde a elle seule, ou elle a enfin la largeur de se lire. */
      .player-full {
        gap: 0.35rem; padding: 0.3rem 0.5rem;
        flex-wrap: wrap; height: auto; min-height: 56px;
        align-content: center;
      }
      .player-full > * { order: 5; }
      #btn-library { order: 0; }
      #btn-prev { order: 1; margin-left: auto; }
      #btn-playpause { order: 2; }
      #btn-next { order: 3; }
      #btn-volume { order: 4; margin-left: auto; }
      .player-meta { order: 0; flex: 1 1 auto; }
      .player-scrubber { order: 6; flex: 1 0 100%; height: 26px; }
      #btn-close { order: 4; }
      .player-full button { min-width: 44px; min-height: 44px; font-size: 1rem; padding: 0; }
      #player-artwork { display: none; }
      #player-source-badge { display: none; }
      .player-meta { min-width: 64px; }

      #player-time { display: none; }
      /* Le transport etait double : precedent/suivant de la bibliotheque, et
         precedent/suivant de la source. Deux paires de chevrons cote a cote ne
         disent pas au doigt laquelle fait quoi. On garde une seule paire, celle
         qui parcourt la bibliotheque — c'est la liste de lecture du site, donc
         celle qu'on veut au pouce. Alea et repetition retournent dans le player
         deplie, ou il y a la place de les nommer. */
      #btn-sp-shuffle, #btn-sp-repeat,
      #btn-sp-prev, #btn-sp-next,
      #btn-sp-like, #btn-sc-like { display: none; }
      /* Les boutons de connexion sortaient du cadre par la droite : tant qu'ils
         restaient sur la premiere rangee, rien ne pouvait les y retenir. Places
         apres la waveform, ils passent a la ligne au lieu de deborder. */
      .player-spotify-connect { order: 7; flex: 0 0 auto; }
      /* v1.56: le volume reste reglable au pouce — slider court, colle au mute. */
      .player-volume-slider { width: 52px; order: 8; margin-left: 0; }
      .player-output-select { display: none; }
      .player-full button { padding: 0.2rem 0.3rem; font-size: 0.9rem; }
      .player-spotify-connect { font-size: 0.55rem !important; padding: 0.15rem 0.35rem !important; }
    }
    #btn-playpause { color: var(--facet-son); font-size: 1.15rem; }
    /* Barre de toggle embed — sous transport, indépendante */
    #embed-toggle-bar {
      display: none;
      text-align: center;
      border-top: 1px solid var(--border);
      background: var(--bg-elevated);
    }
    #embed-toggle-bar .player-embed-toggle {
      width: 100%; background: none; border: none; cursor: pointer;
      padding: 5px 0; color: var(--text-secondary);
      font-family: var(--font-mono); font-size: 0.72rem;
      transition: color 0.15s;
    }
    #embed-toggle-bar .player-embed-toggle:hover { color: var(--text-primary); }
    /* Toujours cacher en mode mini (sur-clasé par !important) */
    #hamcat-player:not([data-expanded='true']) #embed-toggle-bar,
    #hamcat-player:not([data-expanded='true']) #player-embed-zone,
    #hamcat-player:not([data-expanded='true']) #sc-playlist { display: none !important; }

    /* ── Commandes du player au doigt ──
       Deux criteres distincts, c'est la lecon du 24/09.
       La LARGEUR decide de la mise en page : en dessous de 480 px la barre
       passe sur deux rangees, au-dessus elle tient sur une ligne.
       Le POINTEUR decide des cibles : un telephone qui annonce ~950 px CSS
       recevait des commandes de 24 px alors qu'on y vise au pouce.
       Ce bloc ne fait que les cibles — la mise en page en ligne unique est
       traitee juste apres. Place en fin de feuille : meme specificite que les
       regles d'origine, c'est l'ordre qui tranche. */
    @media (pointer: coarse) {
      .player-full button,
      .player-step,
      .player-play-btn,
      .player-lib-btn,
      .player-mute-btn,
      #btn-close, #btn-library, #btn-lib-close {
        min-width: 44px; min-height: 44px;
        display: inline-flex; align-items: center; justify-content: center;
      }
      /* Viser un rail de 3 px au pouce est impossible. La zone monte a 44 px,
         le trait garde son epaisseur : il est centre par `translateY(-50%)`. */
      .player-scrubber { height: 44px; }
      /* Le curseur de volume se manque de la meme facon. */
      .player-volume-slider { height: 44px; }
      /* Les deux boutons du transport les plus utilises meritent d'etre
         distingues du reste au doigt, sans changer leur dessin. */
      #btn-playpause { min-width: 52px; }

      /* La bibliotheque a le meme defaut : une liste dense faite pour la
         souris. La ligne entiere devient la cible — on ne vise plus le petit
         triangle, on tape la ligne — et le triangle garde sa taille. */
      /* La ligne entiere lance deja le set : c'est elle la cible, pas le
         triangle. Sa densite est reglee plus bas, avec la lisibilite. */
      .lib-row { align-items: center; }
      .lib-chip { min-height: 40px; display: inline-flex; align-items: center; }
      #lib-search { min-height: 44px; }
      /* La poignee de redimensionnement se manque au pouce : 26 px de haut
         pour un trait. On elargit la zone, pas le trait. */
      #library-panel .lib-grip, #library-panel [data-grip] { min-height: 44px; }
    }

    /* ── Player reduit au doigt, sur ecran large : deux rangees ──
       Rangee 1 : pochette, puis le texte dans l'espace qui restait vide a sa
       droite, puis le transport, puis le son. Rangee 2 : la waveform, pleine
       largeur. Deux rangees suffisent — donner au texte une troisieme ligne a
       lui seul creusait du vide sur les cotes pour une seule ligne de mots.

       Le texte tient sur UNE ligne : titre, artiste et source se suivent au
       lieu de s'empiler. Deux lignes de trois mots dans une barre de transport,
       c'est de la hauteur depensee sans rien gagner en lecture.

       La grille reste `minmax(0,1fr) auto minmax(0,1fr)`, et c'est elle qui
       resout la tension entre les deux demandes de Fx — texte long et
       transport centre. Le texte vit dans la colonne de gauche : il peut la
       remplir entierement sans jamais deplacer la colonne du milieu, qui est
       au centre par construction. Sans cette grille, chaque titre un peu long
       repousserait les commandes, ce qui etait exactement le defaut signale. */
    @media (pointer: coarse) and (min-width: 481px) {
      /*  Le selecteur porte l'id a dessein. La barre est cachee tant que rien
          ne joue (`.player-full { display: none }`) et revele par
          `#hamcat-player[data-active="true"] .player-full { display: flex }`.
          Une regle en `.player-full` seule fait donc les deux erreurs a la
          fois : elle montre la barre a l'arret, et elle se fait ecraser par la
          regle a id des que la lecture commence. */
      #hamcat-player[data-active="true"] .player-full {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        grid-template-rows: auto auto;
        align-items: center;
        height: auto; min-height: 118px;
        gap: 0.3rem 0.6rem;
        padding: 0.45rem 0.8rem;
      }
      .pg { display: flex; align-items: center; min-width: 0; }

      /* Rangee 1, colonne 1 — pochette puis texte, colles a gauche. */
      .pg-l { grid-area: 1 / 1; justify-content: flex-start; gap: 0.6rem; min-width: 0; }
      .pg-art {
        display: block; position: relative;
        width: 48px; height: 48px; flex: 0 0 auto;
      }
      #player-artwork {
        position: absolute; inset: 0; width: 100%; height: 100%;
        border-radius: 50%; display: block;
      }
      /* Le menu se pose SUR la pochette : meme cercle, meme place, un seul
         encombrement au lieu de deux. */
      .player-lib-btn {
        position: absolute; inset: 0; width: 100%; height: 100%;
        border-radius: 50%; font-size: 1.3rem;
        background: color-mix(in srgb, var(--bg-app) 55%, transparent);
        border: 1px solid color-mix(in srgb, var(--text-secondary) 45%, transparent);
        color: var(--text-primary);
        display: flex; align-items: center; justify-content: center;
      }
      #hamcat-player[data-library="true"] .player-lib-btn {
        background: color-mix(in srgb, var(--facet-son) 35%, var(--bg-app));
        border-color: var(--facet-son);
      }

      /* Le texte sur une seule ligne. Il prend toute la largeur disponible
         jusqu'aux commandes ; il ne se coupe que s'il depasse vraiment, et
         alors par des points de suspension plutot que par un retour a la
         ligne qui ferait grandir la barre. */
      .player-meta {
        flex: 1 1 auto; min-width: 0;
        flex-direction: row; align-items: baseline; gap: 0.45rem;
      }
      /*  Ordre de sacrifice. La colonne de gauche est bornee par la grille, et
          c'est le prix du transport ancre au centre : on ne peut pas elargir
          la place du texte sans decentrer les commandes. On decide donc QUI
          cede en premier. Le nom du set est ce qu'on cherche ; l'artiste est
          toujours le meme sur ce site. L'artiste cede donc cinq fois plus vite
          que le titre, ce qui suffit a faire tenir en entier le plus long
          titre de la bibliotheque. */
      #player-title { font-size: 0.92rem; flex: 0 1 auto; min-width: 0; flex-shrink: 1; }
      .player-meta-sub { flex: 0 1 auto; min-width: 0; flex-shrink: 5; gap: 0.3rem; }
      #player-artist {
        font-size: 0.76rem; min-width: 0;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      /*  La pastille de source disparait au doigt. Elle repete une information
          que la bibliotheque porte deja dans sa colonne SRC, et c'est elle qui
          faisait deborder le plus long titre du site — trente pixels payes
          pour redire ce qu'on sait. */
      #player-source-badge { display: none; }

      /* Rangee 1, colonne 2 — le transport, ancre au centre. */
      .pg-c { grid-area: 1 / 2; justify-content: center; gap: 0.5rem; }
      /* Rangee 1, colonne 3 — le son, colle a droite. */
      .pg-r { grid-area: 1 / 3; justify-content: flex-end; gap: 0.35rem; }
      /* Rangee 2 — la waveform, sur toute la largeur. */
      .pg-w { grid-area: 2 / 1 / 3 / 4; }
      .player-scrubber { flex: 1 1 auto; min-width: 90px; height: 46px; }

      /* Toutes les commandes sont rondes et de meme diametre : une rangee de
         disques identiques se vise sans regarder, et la lecture, qui est
         l'action principale, est seule a depasser. */
      .player-full button {
        border-radius: 50%;
        width: 52px; height: 52px; min-width: 52px; min-height: 52px;
        padding: 0; font-size: 1.25rem;
        display: inline-flex; align-items: center; justify-content: center;
      }
      #btn-playpause {
        width: 62px; height: 62px; min-width: 62px; min-height: 62px;
        font-size: 1.5rem;
        background: color-mix(in srgb, var(--facet-son) 16%, transparent);
        border: 1px solid color-mix(in srgb, var(--facet-son) 55%, transparent);
      }
      .player-volume-slider { width: 72px; height: 44px; flex: 0 0 auto; }

      /* Ni commandes ni information que le titre et la waveform ne portent
         deja. La duree reviendra si elle manque. */
      #player-time, .player-output-select { display: none; }

      /* Le transport etait double : precedent/suivant de la bibliotheque, et
         precedent/suivant de la source. Deux paires de chevrons cote a cote ne
         disent pas au doigt laquelle fait quoi. On garde celle qui parcourt la
         bibliotheque — c'est la liste de lecture du site. Alea, repetition et
         j'aime restent sur le player deplie et au bureau. */
      #btn-sp-shuffle, #btn-sp-repeat,
      #btn-sp-prev, #btn-sp-next,
      #btn-sp-like, #btn-sc-like { display: none; }

      /* Les invitations a connecter disparaissent d'elles-memes une fois le
         compte lie (`updateSCConnectBtn` / `updateSpotifyConnectBtn`) : elles
         n'encombrent que tant qu'elles servent. Ce sont des mots, pas des
         symboles — donc des pastilles, pas des ronds. */
      .player-spotify-connect {
        width: auto !important; min-width: 0 !important;
        height: 40px !important; min-height: 40px !important;
        border-radius: 999px !important;
        font-size: 0.6rem !important; padding: 0 0.6rem !important;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        flex: 0 1 auto;
      }
    }

    /* ── Bibliotheque au doigt : plus lisible SANS perdre de lignes ──
       Demande de Fx : texte et boutons plus gros, mais on veut toujours voir
       autant de sets. Les deux ne s'opposent pas ici, parce que la hauteur
       d'une ligne n'etait pas depensee dans le texte : elle l'etait dans les
       marges et dans une bande de waveform de 20 px. On reprend la sur les
       espaces ce qu'on rend au texte, et le bilan est positif.
       Le bouton de lecture n'a pas besoin de grandir comme cible — la ligne
       entiere lance deja le set — seulement d'etre vu. Il grossit donc en
       dessin, pas en encombrement. */
    @media (pointer: coarse) {
      .lib-row {
        grid-template-columns: 30px 88px minmax(0, 1fr) minmax(0, 0.5fr) 34px;
        padding: 0.16rem 0.5rem;
        row-gap: 0;
      }
      .lib-title  { font-size: 1.08rem; line-height: 1.1; }
      .lib-title .lib-sub { font-size: 0.85rem; }
      .lib-date, .lib-styles, .lib-src { font-size: 0.78rem; }
      /* Le triangle passe de 9,6 a 13,6 px — il se voit enfin — mais sa boite
         reste sous la hauteur du texte : c'est elle qui commandait la hauteur
         de la ligne, et une cible de 30 px ne servait a rien puisque la ligne
         entiere lance le set. */
      .lib-play {
        font-size: 0.95rem; padding: 0.15rem 0; border-radius: 6px;
        min-height: 24px;
      }
      /* Deuxieme reprise sur la bande de waveform : elle sert a reconnaitre un
         set d'un coup d'oeil, pas a le lire en detail — 12 px y suffisent, et
         ces pixels valent mieux dans le titre. */
      .lib-wave { height: 12px; margin: 0.06rem 0 0; }
      .lib-legend { font-size: 0.68rem; }
    }
  </style>

  <!-- Mode modal (?modal=1) : scroll activé pour affichage dans iframe -->
  <script is:inline>
    if (new URLSearchParams(location.search).has('modal')) {
      var s = document.createElement('style');
      s.textContent = 'html,body{height:auto!important;overflow:auto!important}body{position:static!important;overscroll-behavior:auto!important}#hamcat-player{display:none!important}';
      document.head.appendChild(s);
    }
  </script>

  <script>
    // ── Navigation clavier inter-facettes ────────────────────
    // ← → : cycle entre facettes (toutes pages sauf accueil)
    // Échap : retour accueil
    // ↑ ↓  : libre (scroll de page)
    import { navigate } from 'astro:transitions/client';

    let ctrl: AbortController | null = null;

    document.addEventListener('astro:page-load', () => {
      ctrl?.abort();

      if (window.location.pathname === '/') return; // turntable gère lui-même

      const el = document.getElementById('facet-nav');
      if (!el) return;
      const hrefs: string[] = JSON.parse(el.dataset.hrefs ?? '[]');

      const path = window.location.pathname;
      const idx  = hrefs.findIndex(h => path === h || path.startsWith(h + '/'));
      if (idx === -1) return; // page hors-facette (/404, etc.)

      const prevHref = hrefs[(idx - 1 + hrefs.length) % hrefs.length];
      const nextHref = hrefs[(idx + 1) % hrefs.length];

      // Cette page peut etre servie DANS l'iframe de l'accueil (?modal=1).
      // Dans ce cas, « Echap → aller a l'accueil » chargeait l'accueil a
      // l'interieur du cadre : une platine dans une platine, avec sa propre
      // iframe, donc un encadrement qui s'empile a chaque fois. Depuis le
      // cadre, Echap demande au parent de fermer ; il ne navigue pas.
      const dansCadre = window.self !== window.top;
      const garderCadre = (href: string) =>
        dansCadre && !href.includes('?') ? href + '?modal=1' : href;

      ctrl = new AbortController();
      window.addEventListener('keydown', (e) => {
        if ((e.target as Element).closest('input, textarea, [contenteditable]')) return;
        if      (e.key === 'ArrowLeft')  { e.preventDefault(); navigate(garderCadre(prevHref)); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); navigate(garderCadre(nextHref)); }
        else if (e.key === 'Escape')     {
          e.preventDefault();
          if (dansCadre) {
            try { window.parent.postMessage({ hamcat: 'modal-close' }, window.location.origin); }
            catch { /* origine differente : on ne fait rien plutot que de s'imbriquer */ }
          } else {
            navigate('/');
          }
        }
      }, { signal: ctrl.signal });
    });
  </script>
  <!-- ERUDA DEBUG CONSOLE — ?dbg=1 active (collant via sessionStorage), ?dbg=0 desactive -->
  <script>
    (function () {
      const w = window as any;
      const q = new URLSearchParams(location.search).get('dbg');
      try {
        if (q === '1') sessionStorage.setItem('hmc-dbg', '1');
        if (q === '0') { sessionStorage.removeItem('hmc-dbg'); sessionStorage.removeItem('hmc-log'); }
      } catch (_) {}
      let on = false; try { on = sessionStorage.getItem('hmc-dbg') === '1'; } catch (_) {}
      if (!on) return;
      function start() {
        // v1.20b: conteneur marque data-hmc-keep → conserve par le swap custom (survit aux navigations)
        const host = document.createElement('div'); host.id = 'eruda-host'; host.setAttribute('data-hmc-keep', '');
        document.body.appendChild(host);
        const s = document.createElement('script'); s.src = 'https://cdn.jsdelivr.net/npm/eruda@3/eruda.min.js';
        s.onload = function () { w.eruda.init({ container: host }); w.eruda.show(); console.log('[ERUDA] v1.20b console persistante — ?dbg=0 pour couper'); };
        document.head.appendChild(s);
      }
      if (document.body) start(); else document.addEventListener('DOMContentLoaded', start);
    })();
  </script>
