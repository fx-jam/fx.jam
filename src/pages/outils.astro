---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFacet } from '../data/facets.ts';
import outilsJson from '../data/outils.json';
import type { OutilsData } from '../data/types';
const outilsData = outilsJson as unknown as OutilsData;

const f = getFacet('outils');

// Grouper les outils par category
type ToolWithCat = OutilsData['tools'][number] & { category?: string };
const toolsByCat: Record<string, OutilsData['tools']> = {};
for (const tool of outilsData.tools) {
  const cat = (tool as ToolWithCat).category || '';
  if (!toolsByCat[cat]) toolsByCat[cat] = [];
  toolsByCat[cat].push(tool);
}
const toolCats = Object.keys(toolsByCat);
---

<BaseLayout title="Outils — hamcat.live" description={f?.teaser}>
  <main class="outils">

    <!-- ── COVER HERO ──────────────────────────────────────────────── -->
    {outilsData.cover_image && (
      <div class="cover-hero">
        <img src={outilsData.cover_image} alt={outilsData.headline || 'Outils'} class="cover-img" />
      </div>
    )}

    <!-- ── HEADER ─────────────────────────────────────────────────── -->
    <header class="hd">
      <span class="label">{outilsData.label || 'Outils'}</span>
      <h1>{outilsData.headline || 'Outils'}</h1>
      {outilsData.description && <p class="desc">{outilsData.description}</p>}
      {!outilsData.description && <p class="teaser">{outilsData.teaser}</p>}
    </header>

    <!-- ── OUTILS ─────────────────────────────────────────────────── -->
    {outilsData.tools && outilsData.tools.length > 0 && (
      <section class="section tools-section">
        <h2 class="section-title">Outils</h2>
        {toolCats.map(cat => (
          <div class="tool-group">
            {cat && <h3 class="cat-label">{cat}</h3>}
            <ul class="item-list">
              {toolsByCat[cat].map(tool => (
                <li class="item-row">
                  {tool.url ? (
                    <a href={tool.url} target="_blank" rel="noopener" class="item-name item-link">
                      {tool.name}
                    </a>
                  ) : (
                    <span class="item-name">{tool.name}</span>
                  )}
                  {tool.description && <span class="item-detail">{tool.description}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )}

    <a class="home" href="/">← Accueil</a>

  </main>
</BaseLayout>

<style>
  .outils {
    height: 100dvh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 2rem 3rem;
    gap: 3rem;
  }

  .cover-hero {
    width: 100%;
    max-width: 420px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .cover-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .hd {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
  }
  .label {
    color: var(--facet-outils);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--text-primary);
  }
  .desc, .teaser {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 42ch;
    margin: 0.5rem 0 0;
    text-align: center;
    line-height: 1.5;
  }

  .section {
    width: 100%;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0 auto;
  }
  .section-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--facet-outils);
    font-weight: 500;
    margin: 0 0 0.25rem;
  }

  .tool-group { display: flex; flex-direction: column; gap: 0; }
  .cat-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 1rem 0 0.25rem;
  }

  .item-list { list-style: none; padding: 0; margin: 0; width: 100%; }
  .item-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 0.75rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
    align-items: center;
  }
  .item-row:last-child { border-bottom: 1px solid var(--border); }

  .item-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.96rem;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .item-link {
    color: var(--facet-outils);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.15s ease;
  }
  .item-link:hover { opacity: 0.75; }
  .item-detail {
    color: var(--text-tertiary);
    font-size: 0.82rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home {
    align-self: center;
    color: var(--facet-outils);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--facet-outils);
    border-radius: 8px;
    transition: background 0.2s ease;
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }
  .home:hover { background: color-mix(in srgb, var(--facet-outils) 15%, transparent); }

  @media (max-width: 640px) {
    .item-row { grid-template-columns: 1fr; }
    .item-detail { display: none; }
  }
</style>
