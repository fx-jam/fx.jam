  .wave :global(.wave-bg) { fill: color-mix(in srgb, var(--wave-played, var(--style-default)) 30%, transparent); }
  .wave :global(.wave-fg) { fill: var(--wave-played, var(--style-default)); }
  .wave:hover :global(.wave-bg) { fill: color-mix(in srgb, var(--wave-played, var(--style-default)) 50%, transparent); }

  /* ── Bibliotheque : filtrage par tags ── */
  .tag-bar {
    display: flex;
