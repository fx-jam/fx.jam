</style>

<script>
  function attachPlayerButtons() {
    document.querySelectorAll<HTMLButtonElement>('.btn-ecouter').forEach(btn => {
      if (btn.dataset.listenerAttached) return;
      btn.dataset.listenerAttached = '1';
      btn.addEventListener('click', () => {
        const type = btn.dataset.type ?? '';
        const lbl  = btn.dataset.lbl  ?? '';
        if (type === 'audio' || type === 'soundcloud') {
          const url = btn.dataset.url ?? '';
          const art = btn.dataset.art ?? '';
          if (!url) return;
          // `toggle` : si c'est deja ce set qui joue, le player met en pause au lieu
          // de le relancer. La decision lui revient — cette page peut etre en iframe.
          document.dispatchEvent(new CustomEvent('hamcat:play',
            { detail: { type, url, lbl, art, toggle: true } }));
        } else if (type === 'spotify') {
          const playlistId = btn.dataset.playlistId ?? '';
          if (playlistId) document.dispatchEvent(new CustomEvent('hamcat:play', { detail: { type, playlistId, lbl } }));
        }
      });
    });
  }
  // ── Waveforms ─────────────────────────────────────────────────────────────
  // Les pics sont calcules une fois a l'upload (ffmpeg) et servis en JSON de
  // quelques kilo-octets : decoder un MP3 de 300 Mo dans le navigateur juste
  // pour dessiner un trace serait absurde. On ne charge le JSON que lorsque la
  // ligne entre dans le champ de vision.
  /** Une barre toutes les ~2,2 px de large reelle — meme densite partout. */
  const barCount = (el: HTMLElement, peaks: number) =>
    Math.max(40, Math.min(peaks, Math.round((el.clientWidth || 300) / 2.2)));

  const fmtTime = (sec: number) => {
    const s = Math.max(0, Math.floor(sec));
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), r = s % 60;
    return h ? `${h}:${String(m).padStart(2,'0')}:${String(r).padStart(2,'0')}`
             : `${m}:${String(r).padStart(2,'0')}`;
  };

  /** Le libelle de duree vit a cote de sa waveform : on le retrouve par l'URL du set. */
  const timeElFor = (url?: string) =>
    url ? document.querySelector<HTMLElement>(`.wave-time[data-time-for="${CSS.escape(url)}"]`) : null;

  function drawWave(el: HTMLElement, peaks: number[]) {
    const step = Math.max(1, Math.floor(peaks.length / barCount(el, peaks.length)));
    const bars: string[] = [];
    for (let i = 0, x = 0; i < peaks.length; i += step, x++) {
      const v = Math.max(...peaks.slice(i, i + step)) / 255;
      const h = Math.max(2, Math.round(v * 100));
      bars.push(`<rect x="${x * 2}" y="${(100 - h) / 2}" width="1.1" height="${h}" rx="0.5"/>`);
    }
    el.innerHTML =
      `<svg viewBox="0 0 ${bars.length * 2} 100" preserveAspectRatio="none" aria-hidden="true"` +
      ` style="width:100%;height:100%;display:block">` +
      `<g class="wave-bg">${bars.join('')}</g>` +
      `<g class="wave-fg" clip-path="url(#clip-${el.dataset.waveId})">${bars.join('')}</g>` +
      `<clipPath id="clip-${el.dataset.waveId}"><rect x="0" y="0" width="0" height="100"/></clipPath>` +
      `</svg>`;
  }

  function setWaveProgress(el: HTMLElement, ratio: number) {
    const r = el.querySelector('clipPath rect') as SVGRectElement | null;
    const svg = el.querySelector('svg') as SVGSVGElement | null;
    if (!r || !svg) return;
    const w = svg.viewBox.baseVal.width;
    r.setAttribute('width', String(Math.max(0, Math.min(1, ratio)) * w));
  }

  let waveSeq = 0;

  function attachWaveforms() {
    const els = document.querySelectorAll<HTMLElement>('.wave:not([data-wave-ready])');
    if (!els.length) return;

    const load = (el: HTMLElement) => {
      el.dataset.waveReady = '1';
      el.dataset.waveId = String(++waveSeq);
      fetch(el.dataset.wave!)
        .then(r => (r.ok ? r.json() : Promise.reject(r.status)))
        .then(d => {
          el.dataset.duration = String(d.duration || 0);
          drawWave(el, d.peaks || []);
          const t = timeElFor(el.dataset.url);
          if (t && d.duration) t.textContent = fmtTime(d.duration);
        })
        .catch(() => { el.remove(); }); // pas de waveform generee : on n'affiche rien
    };

    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach(e => {
        if (e.isIntersecting) { obs.unobserve(e.target); load(e.target as HTMLElement); }
      });
    }, { rootMargin: '200px' });

    els.forEach(el => {
      io.observe(el);
      el.addEventListener('click', ev => {
        const rect  = el.getBoundingClientRect();
        const ratio = Math.max(0, Math.min(1, (ev.clientX - rect.left) / rect.width));
        const dur   = parseFloat(el.dataset.duration || '0');
        setWaveProgress(el, ratio);
        document.dispatchEvent(new CustomEvent('hamcat:play', {
          detail: { type: el.dataset.type || 'audio', url: el.dataset.url,
                    lbl: el.dataset.lbl, startAt: dur ? ratio * dur : 0 },
        }));
      });
    });
  }

  // Le player emet sa position : on ne met a jour que la waveform du set en cours.
  document.addEventListener('hamcat:progress', (e: any) => {
    const { url, position, duration } = e.detail;
    if (!duration) return;
    document.querySelectorAll<HTMLElement>('.wave[data-wave-ready]').forEach(el => {
      const mine = !!(url && el.dataset.url && url.indexOf(el.dataset.url) === 0);
      setWaveProgress(el, mine ? position / duration : 0);
      el.classList.toggle('is-playing', mine);
      const t = timeElFor(el.dataset.url);
      if (!t) return;
      const total = parseFloat(el.dataset.duration || '0') || duration;
      // Pendant la lecture on affiche position / total, comme la barre du player ;
      // au repos, la duree seule.
      t.textContent = mine ? `${fmtTime(position)}/${fmtTime(total)}` : fmtTime(total);
    });
  });

  // ── Filtrage de la bibliotheque par tags ──────────────────────────────────
  function attachTagFilter() {
    const bar = document.getElementById('tag-bar');
    const list = document.getElementById('library-list');
    const empty = document.getElementById('library-empty');
    if (!bar || !list || bar.dataset.ready) return;
    bar.dataset.ready = '1';

    const applyTag = (tag: string) => {
      bar.querySelectorAll<HTMLElement>('.tag-chip')
         .forEach(c => c.classList.toggle('is-on', (c.dataset.tag || '') === tag));
      let shown = 0;
      list.querySelectorAll<HTMLElement>('.mix-row').forEach(row => {
        const tags = (row.dataset.tags || '').split('|').filter(Boolean);
        const ok = !tag || tags.includes(tag);
        row.hidden = !ok;
        if (ok) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    };

    bar.addEventListener('click', e => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('.tag-chip');
      if (chip) applyTag(chip.dataset.tag || '');
    });

    // Cliquer un style sur une ligne revient a activer la pastille correspondante.
    list.addEventListener('click', e => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('.mix-tag');
      if (t?.dataset.jumpTag) applyTag(t.dataset.jumpTag);
    });
  }

  // ── Projection : la ligne survolee annonce ses photos ─────────────────────
  //    L'evenement remonte au player, seul endroit qui survit aux navigations
  //    et qui vit hors du cadre de la facette.
  function attachMediaHover() {
    const list = document.querySelector('.panel-agenda');
    if (!list || (list as HTMLElement).dataset.mediaReady) return;
    (list as HTMLElement).dataset.mediaReady = '1';

    const emit = (row: HTMLElement | null) => {
      if (!row || !row.dataset.media) {
        document.dispatchEvent(new CustomEvent('hamcat:media', { detail: {} }));
        return;
      }
      let media: unknown = [];
      try { media = JSON.parse(row.dataset.media); } catch (_) { return; }
      document.dispatchEvent(new CustomEvent('hamcat:media', {
        detail: { key: row.dataset.mdate, date: row.dataset.mdate, media },
      }));
    };

    let leaveTimer: number | null = null;
    list.addEventListener('pointerover', e => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.gig-row');
      if (!row) return;
      if (leaveTimer) { clearTimeout(leaveTimer); leaveTimer = null; }
      emit(row);
    });
    // On laisse un instant avant d'eteindre : passer d'une ligne a l'autre ne
    // doit pas faire clignoter le fond.
    list.addEventListener('pointerleave', () => {
      leaveTimer = window.setTimeout(() => emit(null), 900);
    });
  }

  // ── Visionneuse ───────────────────────────────────────────────────────────
  const MEDIA_BASE = 'https://media.hamcat.live/media';
  type Med = { id: string; kind: string };

  let lbMedia: Med[] = [];
  let lbDate = '';
  let lbAt = 0;

  const lbEl    = () => document.getElementById('mlb');
  const lbStage = () => document.getElementById('mlb-stage');

  const lbUrl = (m: Med, size: 'f' | 't' | 'p') =>
    `${MEDIA_BASE}/${lbDate}/${m.id}-${size}.webp`;
  const lbVideo = (m: Med) => `${MEDIA_BASE}/${lbDate}/${m.id}.mp4`;

  function lbRender() {
    const stage = lbStage();
    if (!stage) return;
    const m = lbMedia[lbAt];
    if (!m) return;
    // On remplace le contenu : une video laissee en place continuerait a jouer.
    stage.innerHTML = '';
    if (m.kind === 'video') {
      const v = document.createElement('video');
      v.src = lbVideo(m);
      v.poster = lbUrl(m, 'p');
      v.controls = true;
      v.playsInline = true;
      v.preload = 'metadata';
      stage.appendChild(v);
    } else {
      const img = document.createElement('img');
      img.src = lbUrl(m, 'f');
      img.alt = '';
      stage.appendChild(img);
    }
    const cnt = document.getElementById('mlb-count');
    if (cnt) cnt.textContent = `${lbAt + 1} / ${lbMedia.length}`;
    const solo = lbMedia.length < 2;
    (document.getElementById('mlb-prev') as HTMLButtonElement | null)?.toggleAttribute('disabled', solo);
    (document.getElementById('mlb-next') as HTMLButtonElement | null)?.toggleAttribute('disabled', solo);
    // Precharger les voisins : la navigation doit etre instantanee.
    [lbAt + 1, lbAt - 1].forEach(i => {
      const n = lbMedia[(i + lbMedia.length) % lbMedia.length];
      if (n && n.kind !== 'video') new Image().src = lbUrl(n, 'f');
    });
  }

  function lbStep(dir: number) {
    if (lbMedia.length < 2) return;
    lbAt = (lbAt + dir + lbMedia.length) % lbMedia.length;
    lbRender();
  }

  function lbOpen(media: Med[], date: string, title: string, at: number) {
    const el = lbEl();
    if (!el || !media.length) return;
    lbMedia = media; lbDate = date; lbAt = Math.min(at, media.length - 1);
    const t = document.getElementById('mlb-title');
    if (t) t.textContent = title;
    el.hidden = false;
    lbRender();
    (document.getElementById('mlb-close') as HTMLElement | null)?.focus();
  }

  function lbClose() {
    const el = lbEl();
    if (!el || el.hidden) return;
    el.hidden = true;
    const stage = lbStage();
    if (stage) stage.innerHTML = '';     // coupe la video en cours
    lbMedia = []; lbDate = '';
  }

  function attachLightbox() {
    const el = lbEl();
    if (!el || (el as HTMLElement).dataset.ready) return;
    (el as HTMLElement).dataset.ready = '1';

    document.getElementById('mlb-close')?.addEventListener('click', lbClose);
    document.getElementById('mlb-prev')?.addEventListener('click', () => lbStep(-1));
    document.getElementById('mlb-next')?.addEventListener('click', () => lbStep(1));
    // Cliquer a cote de l'image ferme ; sur l'image, non.
    el.addEventListener('click', e => { if (e.target === el || (e.target as HTMLElement).id === 'mlb-stage') lbClose(); });

    document.addEventListener('keydown', e => {
      if (lbEl()?.hidden) return;
      if (e.key === 'Escape')     { e.preventDefault(); lbClose(); }
      if (e.key === 'ArrowLeft')  { e.preventDefault(); lbStep(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); lbStep(1); }
    });

    // Balayage horizontal, assez franc pour ne pas gener le scroll vertical.
    let sx = 0, sy = 0;
    el.addEventListener('touchstart', (e: TouchEvent) => {
      sx = e.touches[0].clientX; sy = e.touches[0].clientY;
    }, { passive: true });
    el.addEventListener('touchend', (e: TouchEvent) => {
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) lbStep(dx < 0 ? 1 : -1);
    }, { passive: true });

    // Pastille et vignettes ouvrent la meme visionneuse.
    document.querySelector('.panel-agenda')?.addEventListener('click', e => {
      const hit = (e.target as HTMLElement).closest<HTMLElement>('.c-media, .c-th');
      if (!hit) return;
      const row = hit.closest<HTMLElement>('.gig-row');
      if (!row || !row.dataset.media) return;
      let media: Med[] = [];
      try { media = JSON.parse(row.dataset.media); } catch (_) { return; }
      const title = row.querySelector('.c-title')?.textContent?.trim() ?? '';
      const at = Number(hit.dataset.mi ?? 0) || 0;
      lbOpen(media, row.dataset.mdate ?? '', title, at);
    });
  }

  function initSon() { attachPlayerButtons(); attachMediaHover(); attachWaveforms(); attachTagFilter(); attachLightbox(); }
  initSon();
  document.addEventListener('astro:page-load', initSon);
</script>
