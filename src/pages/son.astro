---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getFacet } from '../data/facets.ts';
import sonJson from '../data/son.json';
import type { SonData } from '../data/types';
const sonData = sonJson as unknown as SonData;

const f = getFacet('son');

const all = await getCollection('gigs', ({ data }) => !data.draft);

const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = all
  .filter(g => g.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = all
  .filter(g => g.data.date < today)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtLong  = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

const fmtShort = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });

const visiblePlaylists = (sonData.spotify_playlists ?? [])
  .filter(p => p.visible && p.id);

const playlistsByCategory = visiblePlaylists.reduce((acc, p) => {
  const cat = p.category || 'Playlists';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(p);
  return acc;
}, {} as Record<string, typeof visiblePlaylists>);
---

<BaseLayout title="Son — hamcat.live" description={f?.teaser}>
  <main class="son">

    <!-- ── HEADER ─────────────────────────────────────────────────── -->
    <header class="son-header">
      <div class="hd-left">
        {sonData.cover_image && (
          <img src={sonData.cover_image} alt={sonData.headline || 'Son'} class="hd-cover" />
        )}
        <div class="hd-info">
          <span class="label">{sonData.label || 'Son'}</span>
          <h1>{sonData.headline || 'DJ & Live'}</h1>
          {sonData.bio && <p class="bio">{sonData.bio}</p>}
          <p class="tags">{sonData.genres?.join(' · ') || 'psytrance · hi-tech · goa'}</p>
        </div>
      </div>
      <a class="home" href="/">← Accueil</a>
    </header>

    <!-- ── COLONNES ───────────────────────────────────────────────── -->
    <div class="panels">

      <!-- ── Agenda ── -->
      <div class="panel panel-agenda">
        <h2 class="col-title">Agenda</h2>

        <div class="gig-group">
          <h3 class="group-label">À venir</h3>
          {upcoming.length === 0 ? (
            <p class="empty">Prochaines dates bientôt annoncées.</p>
          ) : (
            <ul class="gig-list">
              {upcoming.map(g => (
                <li class="gig-row gig-upcoming">
                  <time datetime={g.data.date.toISOString()} class="c-date">{fmtLong(g.data.date)}</time>
                  <span class="c-title">{g.data.title}</span>
                  {g.data.venue !== g.data.title && <span class="c-venue">@ {g.data.venue}</span>}
                  <span class="c-format">{g.data.format}</span>
                </li>
              ))}
            </ul>
          )}
        </div>

        <details class="gig-group" open>
          <summary class="group-label">
            Historique
            <span class="count">{past.length}</span>
            <span class="arrow" aria-hidden="true">▾</span>
          </summary>
          {past.length === 0 ? (
            <p class="empty">Aucun gig enregistré.</p>
          ) : (
            <ul class="gig-list">
              {past.map(g => (
                <li class="gig-row">
                  <time datetime={g.data.date.toISOString()} class="c-date">{fmtShort(g.data.date)}</time>
                  <span class="c-title">{g.data.title}</span>
                  {g.data.venue !== g.data.title && <span class="c-venue">@ {g.data.venue}</span>}
                  <span class="c-format">{g.data.format}</span>
                </li>
              ))}
            </ul>
          )}
        </details>
      </div>

      <!-- ── Sets ── -->
      <div class="panel panel-sets">
        <h2 class="col-title">Sets</h2>

        {(sonData.links?.soundcloud || sonData.links?.mixcloud || sonData.links?.spotify ||
          sonData.links?.instagram || sonData.links?.facebook || sonData.links?.presskit) && (
          <div class="links-streaming">
            {sonData.links.soundcloud && (
              <a href={sonData.links.soundcloud} target="_blank" rel="noopener" class="link-btn">SoundCloud</a>
            )}
            {sonData.links.mixcloud && (
              <a href={sonData.links.mixcloud} target="_blank" rel="noopener" class="link-btn">Mixcloud</a>
            )}
            {sonData.links.spotify && (
              <a href={sonData.links.spotify} target="_blank" rel="noopener" class="link-btn">Spotify</a>
            )}
            {sonData.links.instagram && (
              <a href={sonData.links.instagram} target="_blank" rel="noopener" class="link-btn link-btn--secondary">Instagram</a>
            )}
            {sonData.links.facebook && (
              <a href={sonData.links.facebook} target="_blank" rel="noopener" class="link-btn link-btn--secondary">Facebook</a>
            )}
            {sonData.links.presskit && (
              <a href={sonData.links.presskit} target="_blank" rel="noopener" class="link-btn link-btn--secondary">Presskit</a>
            )}
          </div>
        )}

        {sonData.links?.soundcloud && (
          <div class="sc-profile">
            <button
              class="btn-ecouter"
              data-url={sonData.links.soundcloud}
              data-label="Hamcat — SoundCloud"
            >▶ Écouter sur SoundCloud</button>
            <div class="embed-frame">
              <iframe
                src={`https://w.soundcloud.com/player/?url=${encodeURIComponent(sonData.links.soundcloud)}&color=%23ff5500&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&visual=true`}
                width="100%"
                height="300"
                frameborder="0"
                scrolling="no"
                loading="lazy"
              />
            </div>
          </div>
        )}

        {sonData.mixes && sonData.mixes.length > 0 && (
          <div class="mixes-section">
            <h3 class="sets-subtitle">DJ Sets</h3>
            <ul class="mix-list">
              {sonData.mixes.map(mix => (
                <li class="mix-row">
                  {mix.date && <time class="mix-date">{mix.date.slice(0, 7)}</time>}
                  <span class="mix-title">{mix.title}</span>
                  {mix.duration_min > 0 && <span class="mix-dur">{mix.duration_min}min</span>}
                  {(mix.mixcloud_url || mix.soundcloud_url) && (
                    <span class="mix-links">
                      {mix.mixcloud_url && (
                        <a href={mix.mixcloud_url} target="_blank" rel="noopener" class="link-btn link-btn--sm">Mixcloud</a>
                      )}
                      {mix.soundcloud_url && (
                        <a href={mix.soundcloud_url} target="_blank" rel="noopener" class="link-btn link-btn--sm">SC</a>
                      )}
                      {mix.soundcloud_url && (
                        <button
                          class="btn-ecouter link-btn link-btn--sm"
                          data-url={mix.soundcloud_url}
                          data-label={mix.title}
                        >▶</button>
                      )}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- ── Playlists ── -->
      <div class="panel panel-playlists">
        <h2 class="col-title">Playlists</h2>

        {Object.keys(playlistsByCategory).length === 0 ? (
          <p class="empty">Playlists à venir.</p>
        ) : (
          Object.entries(playlistsByCategory).map(([cat, playlists]) => (
            <div class="playlist-group">
              <span class="embed-label">{cat}</span>
              {playlists.map(p => (
                <div class="playlist-item">
                  {p.description && <p class="playlist-desc">{p.description}</p>}
                  {p.spotify_tracks > 0 && <span class="playlist-tracks">{p.spotify_tracks} titres</span>}
                  <div class="embed-frame">
                    <iframe
                      src={`https://open.spotify.com/embed/playlist/${p.id}?utm_source=generator&theme=0`}
                      width="100%"
                      height="152"
                      frameborder="0"
                      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                      loading="lazy"
                    />
                  </div>
                </div>
              ))}
            </div>
          ))
        )}
      </div>

    </div>
  </main>
</BaseLayout>

<style>
  /* ── Layout racine ── */
  .son {
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ── Header compact ── */
  .son-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-app);
  }
  .hd-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }
  .hd-cover {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }
  .hd-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .label {
    color: var(--facet-son);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bio {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 50ch;
  }
  .tags {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-tertiary);
    letter-spacing: 0.06em;
    margin: 0;
  }
  .home {
    flex-shrink: 0;
    color: var(--facet-son);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--facet-son);
    border-radius: 8px;
    transition: background 0.2s ease;
    white-space: nowrap;
  }
  .home:hover { background: color-mix(in srgb, var(--facet-son) 15%, transparent); }

  /* ── Grille 3 colonnes ── */
  .panels {
    flex: 1;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
  }

  .panel {
    overflow-y: auto;
    padding: 1rem 1.25rem;
    border-right: 1px solid var(--border);
  }
  .panel:last-child { border-right: none; }

  /* ── Titres de colonnes ── */
  .col-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--facet-son);
    font-weight: 600;
    margin: 0 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--facet-son) 25%, var(--border));
  }

  /* ── Labels de groupe (gigs) ── */
  .gig-group { display: flex; flex-direction: column; gap: 0; margin-bottom: 1.5rem; }
  .group-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    font-weight: 500;
    margin: 0 0 0.5rem;
    list-style: none;
    cursor: default;
  }
  details > .group-label { cursor: pointer; user-select: none; }
  .group-label::-webkit-details-marker { display: none; }
  .count { color: var(--text-tertiary); font-size: 0.62rem; }
  .arrow { color: var(--text-tertiary); font-size: 0.72rem; transition: transform 0.18s ease; }
  details[open] .arrow { transform: rotate(180deg); }

  /* ── Lignes gig — 4 colonnes compactes : date | titre | venue | format ── */
  .gig-list { list-style: none; padding: 0; margin: 0; }
  .gig-row {
    display: grid;
    grid-template-columns: 68px 1fr 36px;
    column-gap: 0.5rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--border);
    align-items: center;
  }
  .gig-row:last-child { border-bottom: 1px solid var(--border); }

  .gig-upcoming {
    border-top: none;
    border-left: 2px solid var(--facet-son);
    border-radius: 5px;
    background: color-mix(in srgb, var(--facet-son) 7%, var(--bg-surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--facet-son) 20%, var(--border));
    padding: 0.45rem 0.6rem 0.45rem 0.5rem;
    margin-bottom: 0.35rem;
  }
  .gig-upcoming:last-child { border-bottom: none; margin-bottom: 0; }

  .c-date {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .gig-upcoming .c-date { color: var(--text-secondary); }
  .c-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .c-venue {
    display: none; /* masqué par défaut en colonne étroite */
    color: var(--text-secondary);
    font-size: 0.75rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .c-format {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    text-align: right;
  }

  /* État vide */
  .empty {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin: 0 0 1rem;
  }

  /* ── Sets — liens streaming ── */
  .links-streaming {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .link-btn {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--facet-son);
    border-radius: 7px;
    color: var(--facet-son);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    transition: background 0.2s ease;
  }
  .link-btn:hover { background: color-mix(in srgb, var(--facet-son) 15%, transparent); }
  .link-btn--secondary { border-color: var(--text-tertiary); color: var(--text-secondary); }
  .link-btn--secondary:hover { background: color-mix(in srgb, var(--text-tertiary) 12%, transparent); }
  .link-btn--sm { padding: 0.25rem 0.55rem; font-size: 0.66rem; }

  /* ── Embed SoundCloud ── */
  .embed-frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    width: 100%;
    margin-bottom: 1rem;
  }
  .embed-frame iframe { display: block; width: 100%; border: none; }

  /* ── Mixes ── */
  .mixes-section { margin-top: 0.5rem; }
  .sets-subtitle {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    font-weight: 500;
    margin: 0.75rem 0 0.4rem;
  }
  .mix-list { list-style: none; padding: 0; margin: 0; }
  .mix-row {
    display: grid;
    grid-template-columns: 50px 1fr auto auto;
    column-gap: 0.5rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--border);
    align-items: center;
  }
  .mix-row:last-child { border-bottom: 1px solid var(--border); }
  .mix-date { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-tertiary); white-space: nowrap; }
  .mix-title { font-family: var(--font-display); font-weight: 600; font-size: 0.86rem; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mix-dur { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-tertiary); white-space: nowrap; }
  .mix-links { display: flex; gap: 0.3rem; }

  /* ── Playlists ── */
  .playlist-group { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.25rem; }
  .embed-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--facet-son);
    font-weight: 500;
  }
  .playlist-item { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 0.6rem; }
  .playlist-desc { font-family: var(--font-display); font-size: 0.82rem; color: var(--text-secondary); margin: 0; line-height: 1.4; }
  .playlist-tracks { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-tertiary); letter-spacing: 0.06em; }

  /* ── Mobile : colonnes empilées, scroll global ── */
  @media (max-width: 768px) {
    .son {
      height: auto;
      min-height: 100dvh;
      overflow-y: auto;
    }
    .son-header {
      flex-wrap: wrap;
      gap: 0.75rem;
      padding: 1rem;
    }
    .bio { display: none; }
    .panels {
      grid-template-columns: 1fr;
      overflow: visible;
    }
    .panel {
      overflow-y: visible;
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding: 1.25rem 1rem;
    }
    .panel:last-child { border-bottom: none; }
    .gig-row { grid-template-columns: 64px 1fr 36px; }
    .c-venue { display: none; }
  }

  @media (max-width: 480px) {
    .hd-cover { width: 44px; height: 44px; }
    h1 { font-size: 1rem; }
    .gig-row { grid-template-columns: 1fr 34px; }
    .c-date { display: none; }
  }

  /* ── Bouton Écouter → player persistant ── */
  .sc-profile { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
  .btn-ecouter {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--facet-son);
    border-radius: 7px;
    background: color-mix(in srgb, var(--facet-son) 10%, transparent);
    color: var(--facet-son);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.2s ease;
    align-self: flex-start;
  }
  .btn-ecouter:hover { background: color-mix(in srgb, var(--facet-son) 22%, transparent); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.btn-ecouter').forEach(btn => {
    btn.addEventListener('click', () => {
      const url   = btn.dataset.url   ?? '';
      const label = btn.dataset.label ?? '';
      if (!url) return;
      document.dispatchEvent(new CustomEvent('hamcat:play', { detail: { url, label } }));
    });
  });
</script>
