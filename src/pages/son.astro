  }
  .btn-ecouter:hover { background: color-mix(in srgb, var(--facet-son) 22%, transparent); }
  .btn-ecouter--sm { padding: 0.25rem 0.55rem; font-size: 0.66rem; }

  /* ── Enregistrements rattaches a une date ── */
  .mix-line { display: flex; align-items: baseline; gap: 0.5rem; width: 100%; }
  .rec {
