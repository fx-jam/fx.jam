---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getFacet } from '../data/facets.ts';
import sonJson from '../data/son.json';
import type { SonData } from '../data/types';
const sonData = sonJson as unknown as SonData;

const f = getFacet('son');

const all = await getCollection('gigs', ({ data }) => !data.draft);
// Les dates masquees (draft) ne s'affichent pas mais ont bien eu lieu : elles
// comptent dans le total de l'historique.
const allIncludingHidden = await getCollection('gigs');

const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = all
  .filter(g => g.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = all
  .filter(g => g.data.date < today)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pastCount = allIncludingHidden.filter(g => g.data.date < today).length;

const fmtLong  = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

const p2 = (n: number) => String(n).padStart(2, '0');
const fmtShort = (d: Date) =>
  `${d.getFullYear()}/${p2(d.getMonth() + 1)}/${p2(d.getDate())}`;

const visiblePlaylists = (sonData.spotify_playlists ?? [])
  .filter(p => p.visible && p.id);

// ── Agenda et bibliotheque ──────────────────────────────────────────────────
// Une seule liste chronologique : l'agenda. Chaque gig porte ses enregistrements
// quand ils existent. Les sets qui ne correspondent a aucune date (mixes studio,
// podcasts) forment la bibliotheque, qui se parcourt par tags et non par date —
// c'est ce qui evite deux listes de dates concurrentes dans la meme rubrique.

type Rec = { url: string; label?: string };

const recordingsOf = (d: { recording?: string; recordings?: Rec[] }): Rec[] => [
  ...(d.recording ? [{ url: d.recording }] : []),
  ...(d.recordings ?? []),
];

/** L'URL de la waveform se deduit de celle du set : sets/x.mp3 → waveforms/x.json */
const waveformUrl = (url: string): string | null => {
  const m = url.match(/^(https:\/\/media\.hamcat\.live)\/sets\/(.+)\.[a-z0-9]+$/i);
  if (m) return `${m[1]}/waveforms/${m[2]}.json`;
  // Les sets SoundCloud passent par le Worker, qui va chercher les echantillons
  // chez SoundCloud et les renvoie au meme format : meme rendu que les sets R2.
  if (/^https:\/\/soundcloud\.com\/[\w-]+\/[\w-]+/.test(url)) {
    return `/api/sc/waveform?url=${encodeURIComponent(url.split('?')[0])}`;
  }
  return null;
};

const isDirectAudio = (url: string) => url.startsWith('https://media.hamcat.live/');

/** Racine des medias exportes sur R2. Chaque media existe en trois formes :
 *  -t.webp (vignette), -f.webp (plein cadre), et pour les videos -p.webp
 *  (affiche) + .mp4 (lecture). */
const MEDIA_BASE = 'https://media.hamcat.live/media';

/** Accepte aussi bien une URL Spotify complete qu'un identifiant nu. */
const playlistId = (v?: string): string | null => {
  if (!v) return null;
  const m = v.match(/playlist[/:]([A-Za-z0-9]+)/);
  return m ? m[1] : (/^[A-Za-z0-9]{16,}$/.test(v.trim()) ? v.trim() : null);
};

/** "Rock Psyché" -> "rock-psyche" : meme normalisation que /library.json,
 *  pour que la couleur d'un style soit la meme partout sur le site. */
const styleSlug = (t: string): string =>
  t.normalize('NFD').replace(/[\u0300-\u036f]/g, '')
   .toLowerCase().trim()
   .replace(/[^a-z0-9]+/g, '-')
   .replace(/^-|-$/g, '');

// Le premier style nomme donne sa teinte a la waveform. Un style sans jeton
// de couleur retombe sur la teinte par defaut grace au second argument de var().
const waveColor = (tags: string[] = []) => {
  const hit = tags.map(styleSlug).find(Boolean);
  return hit
    ? `--wave-played: var(--style-${hit}, var(--style-default))`
    : '--wave-played: var(--style-default)';
};

/** Sets deja rattaches a une date : ils s'affichent dans l'agenda, pas dans la bibliotheque. */
const gigRecordingUrls = new Set(all.flatMap(g => recordingsOf(g.data).map(r => r.url)));

const library = (sonData.mixes ?? []).filter(
  m => !(m.audio_url && gigRecordingUrls.has(m.audio_url))
);

const libraryTags = [...new Set(library.flatMap(m => m.tags ?? []))].sort((a, b) =>
  a.localeCompare(b, 'fr')
);

// v1.38 — donnees structurees : l'artiste + ses dates a venir en MusicEvent.
// C'est ce qui permet aux dates de remonter dans Google Events / la recherche locale.
const sonSameAs = Object.values(sonData.links || {}).filter(
  (u): u is string => typeof u === 'string' && u.startsWith('http')
);

const artistLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Hamcat',
  url: 'https://hamcat.live/son',
  genre: sonData.genres?.length ? sonData.genres : ['psytrance', 'hi-tech', 'goa'],
  ...(sonSameAs.length ? { sameAs: sonSameAs } : {}),
};

const eventsLd = upcoming.map(g => ({
  '@context': 'https://schema.org',
  '@type': 'MusicEvent',
  name: g.data.title,
  startDate: g.data.date.toISOString(),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: g.data.venue,
    address: {
      '@type': 'PostalAddress',
      ...(g.data.city ? { addressLocality: g.data.city } : {}),
      addressCountry: g.data.country || 'France',
    },
  },
  performer: { '@type': 'MusicGroup', name: 'Hamcat' },
  ...(g.data.eventUrl ? { url: g.data.eventUrl } : {}),
}));

const sonJsonLd = [artistLd, ...eventsLd];

const playlistsByCategory = visiblePlaylists.reduce((acc, p) => {
  const cat = p.category || 'Playlists';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(p);
  return acc;
}, {} as Record<string, typeof visiblePlaylists>);
---

<BaseLayout
  title="Son — DJ sets, dates & playlists | Hamcat"
  description="Les dates, les sets DJ et les playlists de Hamcat — psytrance, hi-tech, goa. Agenda à venir et historique des gigs."
  jsonLd={sonJsonLd}
>
  <main class="son">

    <!-- ── HEADER ─────────────────────────────────────────────────── -->
    <header class="son-header">
      <div class="hd-left">
        {sonData.cover_image && (
          <img src={sonData.cover_image} alt={sonData.headline || 'Son'} class="hd-cover" />
        )}
        <div class="hd-info">
          <span class="label">{sonData.label || 'Son'}</span>
          <h1>{sonData.headline || 'DJ & Live'}</h1>
          {sonData.bio && <p class="bio">{sonData.bio}</p>}
          <p class="tags">{sonData.genres?.join(' · ') || 'psytrance · hi-tech · goa'}</p>
        </div>
      </div>
      <a class="home" href="/"
         onclick="if(window.top!==window){event.preventDefault();window.top.location.href='/';}">← Accueil</a>
    </header>

    <!-- Une seule section desormais : l'agenda, plein cadre. Les playlists
         Spotify restent accessibles depuis la bibliotheque du player, avec
         toutes les autres sources. -->
    <div class="panels" id="panels">

      <!-- ── Agenda ── -->
      <div class="panel panel-agenda" data-panel="agenda">
        <h2 class="col-title">Agenda</h2>

        <div class="gig-group">
          <h3 class="group-label">À venir</h3>
          {upcoming.length === 0 ? (
            <p class="empty">Prochaines dates bientôt annoncées.</p>
          ) : (
            <ul class="gig-list">
              {upcoming.map(g => (
                <li class="gig-row gig-upcoming">
                  <div class="gig-line">
                    <time datetime={g.data.date.toISOString()} class="c-date">{fmtLong(g.data.date)}</time>
                    <span class="c-title">{g.data.title}</span>
                    {g.data.venue !== g.data.title && <span class="c-venue">@ {g.data.venue}</span>}
                    <span class="c-format">{g.data.format}</span>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>

        <details class="gig-group" open>
          <summary class="group-label">
            Historique
            <span class="count">{pastCount}</span>
            <span class="arrow" aria-hidden="true">▾</span>
          </summary>
          {past.length === 0 ? (
            <p class="empty">Aucun gig enregistré.</p>
          ) : (
            <ul class="gig-list">
              {past.flatMap(g => {
                const recs = recordingsOf(g.data);
                const tags = (g.data.genre ?? []).join(' · ');
                // Un enregistrement par ligne : un evenement a deux scenes donne deux
                // lignes de meme hauteur plutot qu'une ligne deux fois plus haute.
                const rows = recs.length ? recs : [null];
                return rows.map((r, i) => {
                  const wave = r ? waveformUrl(r.url) : null;
                  const lbl  = r?.label ? `${g.data.title} — ${r.label}` : g.data.title;
                  return (
                  <li class="gig-row"
                      data-media={(g.data.media ?? []).length
                        ? JSON.stringify(g.data.media) : undefined}
                      data-mdate={g.data.date.toISOString().slice(0, 10)}>
                    <time datetime={g.data.date.toISOString()} class="c-date">{fmtShort(g.data.date)}</time>
                    <span class="c-title">
                      {g.data.title}
                      {(r?.label || g.data.role) && <span class="c-sub"> · {r?.label ?? g.data.role}</span>}
                    </span>
                    <span class="c-rec">
                      <span class="c-tags">{tags}</span>
                      {i === 0 && (g.data.media ?? []).length > 0 && (
                        <span class="c-mediabox">
                          {/* Desktop : une pastille discrete. Mobile : de vraies
                              vignettes, puisqu'il n'y a pas de projection en fond
                              pour dire qu'il y a quelque chose a voir. */}
                          <button class="c-media" title="Voir les médias de cette date"
                                  aria-label={`${(g.data.media ?? []).length} médias`}
                          >{(g.data.media ?? []).length}</button>
                          <span class="c-thumbs">
                            {(g.data.media ?? []).slice(0, 3).map((m, mi) => (
                              <button class="c-th" data-mi={mi} aria-label={`Média ${mi + 1}`}>
                                <img src={`${MEDIA_BASE}/${g.data.date.toISOString().slice(0, 10)}/${m.id}${m.kind === 'video' ? '-p' : '-t'}.webp`}
                                     alt="" loading="lazy" decoding="async" />
                                {m.kind === 'video' && <span class="c-th-v">▶</span>}
                              </button>
                            ))}
                            {(g.data.media ?? []).length > 3 && (
                              <button class="c-th c-th--more" data-mi="3"
                              >+{(g.data.media ?? []).length - 3}</button>
                            )}
                          </span>
                        </span>
                      )}
                      {r ? (
                        <>
                          <button
                            class="btn-ecouter rec-play"
                            data-type={isDirectAudio(r.url) ? 'audio' : 'soundcloud'}
                            data-url={r.url}
                            data-lbl={lbl}
                          >▶</button>
                          {wave
                            ? <div class="wave" data-wave={wave} data-url={r.url} data-lbl={lbl}
                                   data-type={isDirectAudio(r.url) ? 'audio' : 'soundcloud'}
                                   style={waveColor(g.data.genre ?? [])}></div>
                            : <span class="rec-note rec-note--link">écoute externe</span>}
                          {wave && <span class="wave-time" data-time-for={r.url}></span>}
                          {isDirectAudio(r.url)
                            ? <a class="dl" href={r.url} download title="Télécharger le set"
                                 aria-label="Télécharger le set">↓</a>
                            : <a class="dl" href={r.url} target="_blank" rel="noopener"
                                 title="Ouvrir la page du set" aria-label="Ouvrir la page du set">↗</a>}
                        </>
                      ) : playlistId(g.data.tracklist) ? (
                        <>
                          <button
                            class="btn-ecouter rec-play"
                            data-type="spotify"
                            data-playlist-id={playlistId(g.data.tracklist)}
                            data-lbl={g.data.title}
                          >▶</button>
                          <span class="rec-note rec-note--link">tracklist</span>
                        </>
                      ) : (
                        <span class:list={['rec-note', g.data.recordState === 'soon' && 'rec-note--soon']}>
                          {g.data.recordState === 'soon' ? 'enregistré · bientôt en ligne' : 'set non enregistré'}
                        </span>
                      )}
                    </span>
                    {i === 0 && (g.data.city || g.data.duration || (g.data.lineup ?? []).length || g.data.eventUrl) && (
                      <span class="gig-det">
                        {g.data.city && <span class="det">{g.data.city}</span>}
                        {g.data.duration && <span class="det">{g.data.duration}</span>}
                        {(g.data.lineup ?? []).length > 0 && (
                          <span class="det">avec {(g.data.lineup ?? []).join(', ')}</span>
                        )}
                        {g.data.eventUrl && (
                          <a class="det det--link" href={g.data.eventUrl} target="_blank" rel="noopener">événement ↗</a>
                        )}
                      </span>
                    )}
                  </li>
                );});
              })}
            </ul>
          )}
        </details>
      </div>

    </div>

    {/* Visionneuse : occupe le cadre par-dessus l'agenda. Le markup est unique,
        le contenu est injecte au clic. */}
    <div id="mlb" class="mlb" hidden>
      <div class="mlb-head">
        <span class="mlb-title" id="mlb-title"></span>
        <span class="mlb-count" id="mlb-count"></span>
        <button class="mlb-x" id="mlb-close" aria-label="Fermer">✕</button>
      </div>
      <div class="mlb-stage" id="mlb-stage"></div>
      <button class="mlb-nav mlb-nav--p" id="mlb-prev" aria-label="Média précédent">‹</button>
      <button class="mlb-nav mlb-nav--n" id="mlb-next" aria-label="Média suivant">›</button>
    </div>
  </main>
</BaseLayout>

<style>
  /* ── Layout racine ── */
  .son {
    height: calc(100dvh - var(--player-pad, 0px));
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ── Header compact ── */
  .son-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-app);
  }
  .hd-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }
  .hd-cover {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }
  .hd-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .label {
    color: var(--facet-son);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bio {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 50ch;
  }
  .tags {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-tertiary);
    letter-spacing: 0.06em;
    margin: 0;
  }
  .home {
    flex-shrink: 0;
    color: var(--facet-son);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--facet-son);
    border-radius: 8px;
    transition: background 0.2s ease;
    white-space: nowrap;
  }
  .home:hover { background: color-mix(in srgb, var(--facet-son) 15%, transparent); }

  /* ── Grille 3 colonnes ── */
  .panels { flex: 1; overflow: hidden; display: block; }

  /* ── Onglets de section ── */
  .panel {
    height: 100%;
    overflow-y: auto;
    padding: 1rem 1.25rem;
  }

  /* ── Titres de colonnes ── */
  .col-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--facet-son);
    font-weight: 600;
    margin: 0 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--facet-son) 25%, var(--border));
  }

  /* ── Labels de groupe (gigs) ── */
  .gig-group { display: flex; flex-direction: column; gap: 0; margin-bottom: 1.5rem; }
  .group-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    font-weight: 500;
    margin: 0 0 0.5rem;
    list-style: none;
    cursor: default;
  }
  details > .group-label { cursor: pointer; user-select: none; }
  .group-label::-webkit-details-marker { display: none; }
  .count { color: var(--text-tertiary); font-size: 0.62rem; }
  .arrow { color: var(--text-tertiary); font-size: 0.72rem; transition: transform 0.18s ease; }
  details[open] .arrow { transform: rotate(180deg); }

  /* ── Lignes gig — 4 colonnes compactes : date | titre | venue | format ── */
  .gig-list { list-style: none; padding: 0; margin: 0; }
  /* Une rangee unique, meme hauteur avec ou sans enregistrement : les colonnes
     du bloc lecture restent en place et simplement vides quand il n'y a rien. */
  .gig-row {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr) minmax(380px, 2.6fr);
    align-items: center;
    column-gap: 0.7rem;
    padding: 0.22rem 0;
    border-top: 1px solid var(--border);
    min-height: 30px;
  }
  .gig-row .c-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .c-tags { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .c-sub { color: var(--text-tertiary); font-weight: 400; }
  .c-tags {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
  }
  .c-rec {
    display: grid;
    grid-template-columns: 8.2em 22px 28px minmax(0, 1fr) 7.4em 22px;
    align-items: center;
    column-gap: 0.45rem;
    min-width: 0;
  }
  .c-rec > .c-tags   { grid-column: 1; }
  .c-rec > .c-media  { grid-column: 2; }
  .c-rec > .rec-play { grid-column: 3; }
  .c-rec > .wave     { grid-column: 4; }
  .c-rec > .wave-time { grid-column: 5; }
  .c-rec > .dl       { grid-column: 6; }
  /* Une mention sans lecteur (set non enregistre) occupe toute la zone ;
     une mention qui accompagne un bouton se range dans la colonne waveform. */
  .c-rec > .rec-note { grid-column: 3 / -1; }
  .c-rec > .rec-note--link { grid-column: 4; }
  /* Details complementaires : n'apparaissent que si le CMS les renseigne. */
  .gig-det {
    grid-column: 2 / -1;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    margin-top: 0.1rem;
  }
  .det {
    font-family: var(--font-mono); font-size: 0.56rem;
    letter-spacing: 0.06em; color: var(--text-tertiary);
  }
  .det--link { color: var(--facet-son); text-decoration: none; opacity: 0.8; }
  .det--link:hover { opacity: 1; text-decoration: underline; }

  .rec-note {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    white-space: nowrap;
    opacity: 0.75;
  }
  .rec-note--soon { color: var(--facet-son); opacity: 0.85; }
  .rec-note--link { flex: 1 1 auto; }
  .dl {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1;
    padding: 0.2rem 0.35rem;
    border-radius: 5px;
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .dl:hover { color: var(--facet-son); background: color-mix(in srgb, var(--facet-son) 12%, transparent); }
  /* Pastille du nombre de medias : presente sans peser, elle allume la
     projection au survol et ouvre la visionneuse au clic. */
  .c-media {
    font-family: var(--font-mono); font-size: 0.56rem;
    line-height: 1; padding: 0; width: 18px; height: 18px;
    border-radius: 50%; cursor: pointer;
    background: transparent; color: var(--text-tertiary);
    border: 1px solid var(--border);
    transition: color 0.15s, border-color 0.15s;
  }
  .c-media:hover { color: var(--facet-son); border-color: var(--facet-son); }

  /* Vignettes : cachees en desktop, ou la pastille suffit et ou la projection
     laterale montre deja de quoi il s'agit. */
  .c-thumbs { display: none; gap: 3px; align-items: center; }
  .c-th {
    position: relative;
    width: 34px; height: 34px; padding: 0;
    border: 1px solid var(--border); border-radius: 4px;
    background: var(--bg-surface); overflow: hidden; cursor: pointer;
    flex: 0 0 auto;
  }
  .c-th img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .c-th-v {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.6rem; color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
    background: rgba(0, 0, 0, 0.18);
  }
  .c-th--more {
    font-family: var(--font-mono); font-size: 0.6rem;
    color: var(--text-tertiary);
  }

  /* ── Visionneuse plein cadre ────────────────────────────────────────────
     La facette s'ouvre en iframe : `fixed` epouse donc exactement le cadre
     de 820px, sans deborder sur le reste du site. */
  .mlb {
    position: fixed; inset: 0; z-index: 40;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
