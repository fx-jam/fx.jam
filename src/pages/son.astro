---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getFacet } from '../data/facets.ts';
import sonJson from '../data/son.json';
import type { SonData } from '../data/types';
const sonData = sonJson as unknown as SonData;

const f = getFacet('son');

const all = await getCollection('gigs', ({ data }) => !data.draft);

const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = all
  .filter(g => g.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = all
  .filter(g => g.data.date < today)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtLong  = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

const p2 = (n: number) => String(n).padStart(2, '0');
const fmtShort = (d: Date) =>
  `${d.getFullYear()}/${p2(d.getMonth() + 1)}/${p2(d.getDate())}`;

const visiblePlaylists = (sonData.spotify_playlists ?? [])
  .filter(p => p.visible && p.id);

// ── Agenda et bibliotheque ──────────────────────────────────────────────────
// Une seule liste chronologique : l'agenda. Chaque gig porte ses enregistrements
// quand ils existent. Les sets qui ne correspondent a aucune date (mixes studio,
// podcasts) forment la bibliotheque, qui se parcourt par tags et non par date —
// c'est ce qui evite deux listes de dates concurrentes dans la meme rubrique.

type Rec = { url: string; label?: string };

const recordingsOf = (d: { recording?: string; recordings?: Rec[] }): Rec[] => [
  ...(d.recording ? [{ url: d.recording }] : []),
  ...(d.recordings ?? []),
];

/** L'URL de la waveform se deduit de celle du set : sets/x.mp3 → waveforms/x.json */
const waveformUrl = (url: string): string | null => {
  const m = url.match(/^(https:\/\/media\.hamcat\.live)\/sets\/(.+)\.[a-z0-9]+$/i);
  return m ? `${m[1]}/waveforms/${m[2]}.json` : null;
};

const isDirectAudio = (url: string) => url.startsWith('https://media.hamcat.live/');

/** Accepte aussi bien une URL Spotify complete qu'un identifiant nu. */
const playlistId = (v?: string): string | null => {
  if (!v) return null;
  const m = v.match(/playlist[/:]([A-Za-z0-9]+)/);
  return m ? m[1] : (/^[A-Za-z0-9]{16,}$/.test(v.trim()) ? v.trim() : null);
};

const STYLES = ['psychill','chillgressive','psydub','psyprog','psytrance',
                'full-on','hi-tech','darkpsy','mentalcore','electrad'];

/** Teinte de la waveform : le premier style reconnu du set, sinon la couleur de la facette. */
const waveColor = (tags: string[] = []) => {
  const hit = tags.map(t => t.toLowerCase().trim()).find(t => STYLES.includes(t));
  return `--wave-played: var(--style-${hit ?? 'default'})`;
};

/** Sets deja rattaches a une date : ils s'affichent dans l'agenda, pas dans la bibliotheque. */
const gigRecordingUrls = new Set(all.flatMap(g => recordingsOf(g.data).map(r => r.url)));

const library = (sonData.mixes ?? []).filter(
  m => !(m.audio_url && gigRecordingUrls.has(m.audio_url))
);

const libraryTags = [...new Set(library.flatMap(m => m.tags ?? []))].sort((a, b) =>
  a.localeCompare(b, 'fr')
);

// v1.38 — donnees structurees : l'artiste + ses dates a venir en MusicEvent.
// C'est ce qui permet aux dates de remonter dans Google Events / la recherche locale.
const sonSameAs = Object.values(sonData.links || {}).filter(
  (u): u is string => typeof u === 'string' && u.startsWith('http')
);

const artistLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Hamcat',
  url: 'https://hamcat.live/son',
  genre: sonData.genres?.length ? sonData.genres : ['psytrance', 'hi-tech', 'goa'],
  ...(sonSameAs.length ? { sameAs: sonSameAs } : {}),
};

const eventsLd = upcoming.map(g => ({
  '@context': 'https://schema.org',
  '@type': 'MusicEvent',
  name: g.data.title,
  startDate: g.data.date.toISOString(),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: g.data.venue,
    address: {
      '@type': 'PostalAddress',
      ...(g.data.city ? { addressLocality: g.data.city } : {}),
      addressCountry: g.data.country || 'France',
    },
  },
  performer: { '@type': 'MusicGroup', name: 'Hamcat' },
  ...(g.data.eventUrl ? { url: g.data.eventUrl } : {}),
}));

const sonJsonLd = [artistLd, ...eventsLd];

const playlistsByCategory = visiblePlaylists.reduce((acc, p) => {
  const cat = p.category || 'Playlists';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(p);
  return acc;
}, {} as Record<string, typeof visiblePlaylists>);
---

<BaseLayout
  title="Son — DJ sets, dates & playlists | Hamcat"
  description="Les dates, les sets DJ et les playlists de Hamcat — psytrance, hi-tech, goa. Agenda à venir et historique des gigs."
  jsonLd={sonJsonLd}
>
  <main class="son">

    <!-- ── HEADER ─────────────────────────────────────────────────── -->
    <header class="son-header">
      <div class="hd-left">
        {sonData.cover_image && (
          <img src={sonData.cover_image} alt={sonData.headline || 'Son'} class="hd-cover" />
        )}
        <div class="hd-info">
          <span class="label">{sonData.label || 'Son'}</span>
          <h1>{sonData.headline || 'DJ & Live'}</h1>
          {sonData.bio && <p class="bio">{sonData.bio}</p>}
          <p class="tags">{sonData.genres?.join(' · ') || 'psytrance · hi-tech · goa'}</p>
        {(sonData.links?.soundcloud || sonData.links?.mixcloud || sonData.links?.spotify ||
          sonData.links?.instagram || sonData.links?.facebook || sonData.links?.presskit) && (
          <div class="links-streaming">
            {sonData.links.soundcloud && (
              <a href={sonData.links.soundcloud} target="_blank" rel="noopener" class="link-btn">SoundCloud</a>
            )}
            {sonData.links.mixcloud && (
              <a href={sonData.links.mixcloud} target="_blank" rel="noopener" class="link-btn">Mixcloud</a>
            )}
            {sonData.links.spotify && (
              <a href={sonData.links.spotify} target="_blank" rel="noopener" class="link-btn">Spotify</a>
            )}
            {sonData.links.instagram && (
              <a href={sonData.links.instagram} target="_blank" rel="noopener" class="link-btn link-btn--secondary">Instagram</a>
            )}
            {sonData.links.facebook && (
              <a href={sonData.links.facebook} target="_blank" rel="noopener" class="link-btn link-btn--secondary">Facebook</a>
            )}
            {sonData.links.presskit && (
              <a href={sonData.links.presskit} target="_blank" rel="noopener" class="link-btn link-btn--secondary">Presskit</a>
            )}
          </div>
        )}

        {sonData.links?.soundcloud && (
          <button
            class="btn-ecouter"
            data-type="soundcloud"
            data-url={sonData.links.soundcloud}
            data-lbl="SoundCloud"
          >▶ Écouter</button>
        )}
        </div>
      </div>
      <a class="home" href="/"
         onclick="if(window.top!==window){event.preventDefault();window.top.location.href='/';}">← Accueil</a>
    </header>

    <!-- ── SECTIONS ───────────────────────────────────────────────── -->
    <!-- L'agenda et la bibliotheque ne cohabitent plus en colonnes : a trois
         colonnes dans une fenetre, chacune tombait sous 250 px et les titres
         d'evenements etaient tronques a deux caracteres. Une section a la fois,
         sur toute la largeur. -->
    <nav class="facet-tabs" id="facet-tabs">
      <button class="facet-tab is-on" data-panel="agenda">Agenda</button>
      <button class="facet-tab" data-panel="playlists">Playlists</button>
    </nav>

    <div class="panels" id="panels">

      <!-- ── Agenda ── -->
      <div class="panel panel-agenda" data-panel="agenda">
        <h2 class="col-title">Agenda</h2>

        <div class="gig-group">
          <h3 class="group-label">À venir</h3>
          {upcoming.length === 0 ? (
            <p class="empty">Prochaines dates bientôt annoncées.</p>
          ) : (
            <ul class="gig-list">
              {upcoming.map(g => (
                <li class="gig-row gig-upcoming">
                  <div class="gig-line">
                    <time datetime={g.data.date.toISOString()} class="c-date">{fmtLong(g.data.date)}</time>
                    <span class="c-title">{g.data.title}</span>
                    {g.data.venue !== g.data.title && <span class="c-venue">@ {g.data.venue}</span>}
                    <span class="c-format">{g.data.format}</span>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>

        <details class="gig-group" open>
          <summary class="group-label">
            Historique
            <span class="count">{past.length}</span>
            <span class="arrow" aria-hidden="true">▾</span>
          </summary>
          {past.length === 0 ? (
            <p class="empty">Aucun gig enregistré.</p>
          ) : (
            <ul class="gig-list">
              {past.flatMap(g => {
                const recs = recordingsOf(g.data);
                const tags = (g.data.genre ?? []).join(' · ');
                // Un enregistrement par ligne : un evenement a deux scenes donne deux
                // lignes de meme hauteur plutot qu'une ligne deux fois plus haute.
                const rows = recs.length ? recs : [null];
                return rows.map((r, i) => {
                  const wave = r ? waveformUrl(r.url) : null;
                  const lbl  = r?.label ? `${g.data.title} — ${r.label}` : g.data.title;
                  return (
                  <li class="gig-row">
                    <time datetime={g.data.date.toISOString()} class="c-date">{fmtShort(g.data.date)}</time>
                    <span class="c-title">
                      {g.data.title}
                      {(r?.label || g.data.role) && <span class="c-sub"> · {r?.label ?? g.data.role}</span>}
                    </span>
                    <span class="c-rec">
                      <span class="c-tags">{tags}</span>
                      {r ? (
                        <>
                          <button
                            class="btn-ecouter rec-play"
                            data-type={isDirectAudio(r.url) ? 'audio' : 'soundcloud'}
                            data-url={r.url}
                            data-lbl={lbl}
                          >▶</button>
                          {wave
                            ? <div class="wave" data-wave={wave} data-url={r.url} data-lbl={lbl}
                                   style={waveColor(g.data.genre ?? [])}></div>
                            : <span class="rec-note rec-note--link">écoute externe</span>}
                          {wave && <span class="wave-time" data-time-for={r.url}></span>}
                          {isDirectAudio(r.url)
                            ? <a class="dl" href={r.url} download title="Télécharger le set"
                                 aria-label="Télécharger le set">↓</a>
                            : <a class="dl" href={r.url} target="_blank" rel="noopener"
                                 title="Ouvrir la page du set" aria-label="Ouvrir la page du set">↗</a>}
                        </>
                      ) : playlistId(g.data.tracklist) ? (
                        <>
                          <button
                            class="btn-ecouter rec-play"
                            data-type="spotify"
                            data-playlist-id={playlistId(g.data.tracklist)}
                            data-lbl={g.data.title}
                          >▶</button>
                          <span class="rec-note rec-note--link">tracklist</span>
                        </>
                      ) : (
                        <span class:list={['rec-note', g.data.recordState === 'soon' && 'rec-note--soon']}>
                          {g.data.recordState === 'soon' ? 'enregistré · bientôt en ligne' : 'set non enregistré'}
                        </span>
                      )}
                    </span>
                    {i === 0 && (g.data.city || g.data.duration || (g.data.lineup ?? []).length || g.data.eventUrl) && (
                      <span class="gig-det">
                        {g.data.city && <span class="det">{g.data.city}</span>}
                        {g.data.duration && <span class="det">{g.data.duration}</span>}
                        {(g.data.lineup ?? []).length > 0 && (
                          <span class="det">avec {(g.data.lineup ?? []).join(', ')}</span>
                        )}
                        {g.data.eventUrl && (
                          <a class="det det--link" href={g.data.eventUrl} target="_blank" rel="noopener">événement ↗</a>
                        )}
                      </span>
                    )}
                  </li>
                );});
              })}
            </ul>
          )}
        </details>
      </div>

      <!-- ── Sets ── -->
      <!-- ── Playlists ── -->
      <div class="panel panel-playlists" data-panel="playlists">
        <h2 class="col-title">Playlists</h2>

        {Object.keys(playlistsByCategory).length === 0 ? (
          <p class="empty">Playlists à venir.</p>
        ) : (
          Object.entries(playlistsByCategory).map(([cat, playlists]) => (
            <div class="playlist-group">
              <span class="embed-label">{cat}</span>
              {playlists.map(p => (
                <div class="playlist-item">
                  {p.description && <p class="playlist-desc">{p.description}</p>}
                  <div class="playlist-meta">
                    {p.spotify_tracks > 0 && <span class="playlist-tracks">{p.spotify_tracks} titres</span>}
                    <button
                      class="btn-ecouter btn-ecouter--sm"
                      data-type="spotify"
                      data-playlist-id={p.id}
                      data-lbl={p.spotify_title}
                    >▶ Écouter</button>
                  </div>
                </div>
              ))}
            </div>
          ))
        )}
      </div>

    </div>
  </main>
</BaseLayout>

<style>
  /* ── Layout racine ── */
  .son {
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ── Header compact ── */
  .son-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-app);
  }
  .hd-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }
  .hd-cover {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }
  .hd-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .label {
    color: var(--facet-son);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bio {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 50ch;
  }
  .tags {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-tertiary);
    letter-spacing: 0.06em;
    margin: 0;
  }
  .home {
    flex-shrink: 0;
    color: var(--facet-son);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--facet-son);
    border-radius: 8px;
    transition: background 0.2s ease;
    white-space: nowrap;
  }
  .home:hover { background: color-mix(in srgb, var(--facet-son) 15%, transparent); }

  /* ── Grille 3 colonnes ── */
  .panels { flex: 1; overflow: hidden; display: block; }
  .panels > .panel { display: none; }
  .panels > .panel.is-on { display: block; }

  /* ── Onglets de section ── */
  .facet-tabs {
    display: flex;
    gap: 0.4rem;
    padding: 0 1.25rem 0.6rem;
    flex: 0 0 auto;
  }
  .facet-tab {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: transparent;
    color: var(--text-tertiary);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .facet-tab:hover { border-color: var(--facet-son); color: var(--text-secondary); }
  .facet-tab.is-on {
    border-color: var(--facet-son);
    color: var(--facet-son);
    background: color-mix(in srgb, var(--facet-son) 14%, transparent);
  }

  .panel {
    height: 100%;
    overflow-y: auto;
    padding: 1rem 1.25rem;
  }

  /* ── Titres de colonnes ── */
  .col-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--facet-son);
    font-weight: 600;
    margin: 0 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--facet-son) 25%, var(--border));
  }

  /* ── Labels de groupe (gigs) ── */
  .gig-group { display: flex; flex-direction: column; gap: 0; margin-bottom: 1.5rem; }
  .group-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    font-weight: 500;
    margin: 0 0 0.5rem;
    list-style: none;
    cursor: default;
  }
  details > .group-label { cursor: pointer; user-select: none; }
  .group-label::-webkit-details-marker { display: none; }
  .count { color: var(--text-tertiary); font-size: 0.62rem; }
  .arrow { color: var(--text-tertiary); font-size: 0.72rem; transition: transform 0.18s ease; }
  details[open] .arrow { transform: rotate(180deg); }

  /* ── Lignes gig — 4 colonnes compactes : date | titre | venue | format ── */
  .gig-list { list-style: none; padding: 0; margin: 0; }
  /* Une rangee unique, meme hauteur avec ou sans enregistrement : les colonnes
     du bloc lecture restent en place et simplement vides quand il n'y a rien. */
  .gig-row {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr) minmax(300px, 1.8fr);
    align-items: center;
    column-gap: 0.7rem;
    padding: 0.22rem 0;
    border-top: 1px solid var(--border);
    min-height: 30px;
  }
  .gig-row .c-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .c-tags { flex: 0 1 auto; min-width: 0; max-width: 11em;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .c-sub { color: var(--text-tertiary); font-weight: 400; }
  .c-tags {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
  }
  .c-rec { display: flex; align-items: center; gap: 0.45rem; min-width: 0; }
  /* Details complementaires : n'apparaissent que si le CMS les renseigne. */
  .gig-det {
    grid-column: 2 / -1;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    margin-top: 0.1rem;
  }
  .det {
    font-family: var(--font-mono); font-size: 0.56rem;
    letter-spacing: 0.06em; color: var(--text-tertiary);
  }
  .det--link { color: var(--facet-son); text-decoration: none; opacity: 0.8; }
  .det--link:hover { opacity: 1; text-decoration: underline; }

  .rec-note {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    white-space: nowrap;
    opacity: 0.75;
  }
  .rec-note--soon { color: var(--facet-son); opacity: 0.85; }
  .rec-note--link { flex: 1 1 auto; }
  .dl {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1;
    padding: 0.2rem 0.35rem;
    border-radius: 5px;
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .dl:hover { color: var(--facet-son); background: color-mix(in srgb, var(--facet-son) 12%, transparent); }
  .wave-time {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    flex: 0 0 9.2em;
    width: 9.2em;
    text-align: right;
  }
  .gig-line { display: flex; align-items: baseline; gap: 0.6rem; min-width: 0; }
  .gig-row:last-child { border-bottom: 1px solid var(--border); }

  .gig-upcoming {
    border-top: none;
    border-left: 2px solid var(--facet-son);
    border-radius: 5px;
    background: color-mix(in srgb, var(--facet-son) 7%, var(--bg-surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--facet-son) 20%, var(--border));
    padding: 0.45rem 0.6rem 0.45rem 0.5rem;
    margin-bottom: 0.35rem;
  }
  .gig-upcoming:last-child { border-bottom: none; margin-bottom: 0; }

  .c-date {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .gig-upcoming .c-date { color: var(--text-secondary); }
  .c-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .c-venue {
    display: none; /* masqué par défaut en colonne étroite */
    color: var(--text-secondary);
    font-size: 0.75rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .c-format {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    text-align: right;
  }

  /* État vide */
  .empty {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin: 0 0 1rem;
  }

  /* ── Sets — liens streaming ── */
  .links-streaming {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .link-btn {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--facet-son);
    border-radius: 7px;
    color: var(--facet-son);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    transition: background 0.2s ease;
  }
  .link-btn:hover { background: color-mix(in srgb, var(--facet-son) 15%, transparent); }
  .link-btn--secondary { border-color: var(--text-tertiary); color: var(--text-secondary); }
  .link-btn--secondary:hover { background: color-mix(in srgb, var(--text-tertiary) 12%, transparent); }
  .link-btn--sm { padding: 0.25rem 0.55rem; font-size: 0.66rem; }

  /* ── Embed SoundCloud ── */
  .embed-frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    width: 100%;
    margin-bottom: 1rem;
  }
  .embed-frame iframe { display: block; width: 100%; border: none; }

  /* ── Mixes ── */
  .mixes-section { margin-top: 0.5rem; }
  .sets-subtitle {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    font-weight: 500;
    margin: 0.75rem 0 0.4rem;
  }
  .mix-list { list-style: none; padding: 0; margin: 0; }
  .mix-row {
    display: grid;
    grid-template-columns: 50px 1fr auto auto;
    column-gap: 0.5rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--border);
    align-items: center;
  }
  .mix-row:last-child { border-bottom: 1px solid var(--border); }
  .mix-date { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-tertiary); white-space: nowrap; }
  .mix-title { font-family: var(--font-display); font-weight: 600; font-size: 0.86rem; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mix-dur { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-tertiary); white-space: nowrap; }
  .mix-links { display: flex; gap: 0.3rem; }

  /* ── Playlists ── */
  .playlist-group { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.25rem; }
  .embed-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--facet-son);
    font-weight: 500;
  }
  .playlist-item { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 0.6rem; }
  .playlist-desc { font-family: var(--font-display); font-size: 0.82rem; color: var(--text-secondary); margin: 0; line-height: 1.4; }
  .playlist-tracks { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-tertiary); letter-spacing: 0.06em; }

  /* ── Mobile : colonnes empilées, scroll global ── */
  @media (max-width: 768px) {
    .son {
      height: auto;
      min-height: 100dvh;
      overflow-y: auto;
    }
    .son-header {
      flex-wrap: wrap;
      gap: 0.75rem;
      padding: 1rem;
    }
    .bio { display: none; }
    .gig-row {
      grid-template-columns: 78px minmax(0, 1fr);
      row-gap: 0.15rem;
    }
    .c-rec { grid-column: 1 / -1; flex-wrap: wrap; }
    .c-tags { max-width: none; flex: 1 1 100%; }
    .gig-det { grid-column: 1 / -1; }
    .wave-time { flex: 0 0 auto; width: auto; }
    .panels { overflow: visible; }
    .panel { height: auto; overflow-y: visible; padding: 1.25rem 1rem; }
    .facet-tabs { flex-wrap: wrap; padding: 0 1rem 0.6rem; }
    .c-venue { display: none; }
  }

  @media (max-width: 480px) {
    .hd-cover { width: 44px; height: 44px; }
    h1 { font-size: 1rem; }
    .gig-row { grid-template-columns: 1fr 34px; }
    .c-date { display: none; }
  }

  /* ── Bouton Écouter → player persistant ── */
  .playlist-meta { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.25rem; }
  .btn-ecouter {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--facet-son);
    border-radius: 7px;
    background: color-mix(in srgb, var(--facet-son) 10%, transparent);
    color: var(--facet-son);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.2s ease;
    align-self: flex-start;
  }
  .btn-ecouter:hover { background: color-mix(in srgb, var(--facet-son) 22%, transparent); }
  .btn-ecouter--sm { padding: 0.25rem 0.55rem; font-size: 0.66rem; }

  /* ── Enregistrements rattaches a une date ── */
  .mix-line { display: flex; align-items: baseline; gap: 0.5rem; width: 100%; }
  .rec {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.35rem;
    padding-left: 0.2rem;
  }
  .rec-play { flex: 0 0 auto; }
  .rec-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  /* ── Waveform cliquable ── */
  .wave {
    flex: 1 1 auto;
    min-width: 0;
    height: 22px;
    cursor: pointer;
    touch-action: manipulation;
  }
  .wave :global(svg) { width: 100%; height: 100%; display: block; }
  .wave :global(.wave-bg) { fill: color-mix(in srgb, var(--wave-played, var(--style-default)) 30%, transparent); }
  .wave :global(.wave-fg) { fill: var(--wave-played, var(--style-default)); }
  .wave:hover :global(.wave-bg) { fill: color-mix(in srgb, var(--wave-played, var(--style-default)) 50%, transparent); }

  /* ── Bibliotheque : filtrage par tags ── */
  .tag-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
  }
  .tag-chip {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-tertiary);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .tag-chip:hover { border-color: var(--facet-son); color: var(--text-secondary); }
  .tag-chip.is-on {
    border-color: var(--facet-son);
    color: var(--facet-son);
    background: color-mix(in srgb, var(--facet-son) 14%, transparent);
  }
  .mix-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.25rem; }
  .mix-tag {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    background: none;
    border: none;
    padding: 0 0.15rem;
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .mix-tag:hover { color: var(--facet-son); text-decoration: underline; }
  .mix-row { flex-wrap: wrap; }
</style>

<script>
  function attachPlayerButtons() {
    document.querySelectorAll<HTMLButtonElement>('.btn-ecouter').forEach(btn => {
      if (btn.dataset.listenerAttached) return;
      btn.dataset.listenerAttached = '1';
      btn.addEventListener('click', () => {
        const type = btn.dataset.type ?? '';
        const lbl  = btn.dataset.lbl  ?? '';
        if (type === 'audio' || type === 'soundcloud') {
          const url = btn.dataset.url ?? '';
          const art = btn.dataset.art ?? '';
          if (!url) return;
          // `toggle` : si c'est deja ce set qui joue, le player met en pause au lieu
          // de le relancer. La decision lui revient — cette page peut etre en iframe.
          document.dispatchEvent(new CustomEvent('hamcat:play',
            { detail: { type, url, lbl, art, toggle: true } }));
        } else if (type === 'spotify') {
          const playlistId = btn.dataset.playlistId ?? '';
          if (playlistId) document.dispatchEvent(new CustomEvent('hamcat:play', { detail: { type, playlistId, lbl } }));
        }
      });
    });
  }
  // ── Waveforms ─────────────────────────────────────────────────────────────
  // Les pics sont calcules une fois a l'upload (ffmpeg) et servis en JSON de
  // quelques kilo-octets : decoder un MP3 de 300 Mo dans le navigateur juste
  // pour dessiner un trace serait absurde. On ne charge le JSON que lorsque la
  // ligne entre dans le champ de vision.
  /** Une barre toutes les ~2,2 px de large reelle — meme densite partout. */
  const barCount = (el: HTMLElement, peaks: number) =>
    Math.max(40, Math.min(peaks, Math.round((el.clientWidth || 300) / 2.2)));

  const fmtTime = (sec: number) => {
    const s = Math.max(0, Math.floor(sec));
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), r = s % 60;
    return h ? `${h}:${String(m).padStart(2,'0')}:${String(r).padStart(2,'0')}`
             : `${m}:${String(r).padStart(2,'0')}`;
  };

  /** Le libelle de duree vit a cote de sa waveform : on le retrouve par l'URL du set. */
  const timeElFor = (url?: string) =>
    url ? document.querySelector<HTMLElement>(`.wave-time[data-time-for="${CSS.escape(url)}"]`) : null;

  function drawWave(el: HTMLElement, peaks: number[]) {
    const step = Math.max(1, Math.floor(peaks.length / barCount(el, peaks.length)));
    const bars: string[] = [];
    for (let i = 0, x = 0; i < peaks.length; i += step, x++) {
      const v = Math.max(...peaks.slice(i, i + step)) / 255;
      const h = Math.max(2, Math.round(v * 100));
      bars.push(`<rect x="${x * 2}" y="${(100 - h) / 2}" width="1.1" height="${h}" rx="0.5"/>`);
    }
    el.innerHTML =
      `<svg viewBox="0 0 ${bars.length * 2} 100" preserveAspectRatio="none" aria-hidden="true"` +
      ` style="width:100%;height:100%;display:block">` +
      `<g class="wave-bg">${bars.join('')}</g>` +
      `<g class="wave-fg" clip-path="url(#clip-${el.dataset.waveId})">${bars.join('')}</g>` +
      `<clipPath id="clip-${el.dataset.waveId}"><rect x="0" y="0" width="0" height="100"/></clipPath>` +
      `</svg>`;
  }

  function setWaveProgress(el: HTMLElement, ratio: number) {
    const r = el.querySelector('clipPath rect') as SVGRectElement | null;
    const svg = el.querySelector('svg') as SVGSVGElement | null;
    if (!r || !svg) return;
    const w = svg.viewBox.baseVal.width;
    r.setAttribute('width', String(Math.max(0, Math.min(1, ratio)) * w));
  }

  let waveSeq = 0;

  function attachWaveforms() {
    const els = document.querySelectorAll<HTMLElement>('.wave:not([data-wave-ready])');
    if (!els.length) return;

    const load = (el: HTMLElement) => {
      el.dataset.waveReady = '1';
      el.dataset.waveId = String(++waveSeq);
      fetch(el.dataset.wave!)
        .then(r => (r.ok ? r.json() : Promise.reject(r.status)))
        .then(d => {
          el.dataset.duration = String(d.duration || 0);
          drawWave(el, d.peaks || []);
          const t = timeElFor(el.dataset.url);
          if (t && d.duration) t.textContent = fmtTime(d.duration);
        })
        .catch(() => { el.remove(); }); // pas de waveform generee : on n'affiche rien
    };

    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach(e => {
        if (e.isIntersecting) { obs.unobserve(e.target); load(e.target as HTMLElement); }
      });
    }, { rootMargin: '200px' });

    els.forEach(el => {
      io.observe(el);
      el.addEventListener('click', ev => {
        const rect  = el.getBoundingClientRect();
        const ratio = Math.max(0, Math.min(1, (ev.clientX - rect.left) / rect.width));
        const dur   = parseFloat(el.dataset.duration || '0');
        setWaveProgress(el, ratio);
        document.dispatchEvent(new CustomEvent('hamcat:play', {
          detail: { type: 'audio', url: el.dataset.url, lbl: el.dataset.lbl,
                    startAt: dur ? ratio * dur : 0 },
        }));
      });
    });
  }

  // Le player emet sa position : on ne met a jour que la waveform du set en cours.
  document.addEventListener('hamcat:progress', (e: any) => {
    const { url, position, duration } = e.detail;
    if (!duration) return;
    document.querySelectorAll<HTMLElement>('.wave[data-wave-ready]').forEach(el => {
      const mine = !!(url && el.dataset.url && url.indexOf(el.dataset.url) === 0);
      setWaveProgress(el, mine ? position / duration : 0);
      el.classList.toggle('is-playing', mine);
      const t = timeElFor(el.dataset.url);
      if (!t) return;
      const total = parseFloat(el.dataset.duration || '0') || duration;
      // Pendant la lecture on affiche position / total, comme la barre du player ;
      // au repos, la duree seule.
      t.textContent = mine ? `${fmtTime(position)} / ${fmtTime(total)}` : fmtTime(total);
    });
  });

  // ── Filtrage de la bibliotheque par tags ──────────────────────────────────
  function attachTagFilter() {
    const bar = document.getElementById('tag-bar');
    const list = document.getElementById('library-list');
    const empty = document.getElementById('library-empty');
    if (!bar || !list || bar.dataset.ready) return;
    bar.dataset.ready = '1';

    const applyTag = (tag: string) => {
      bar.querySelectorAll<HTMLElement>('.tag-chip')
         .forEach(c => c.classList.toggle('is-on', (c.dataset.tag || '') === tag));
      let shown = 0;
      list.querySelectorAll<HTMLElement>('.mix-row').forEach(row => {
        const tags = (row.dataset.tags || '').split('|').filter(Boolean);
        const ok = !tag || tags.includes(tag);
        row.hidden = !ok;
        if (ok) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    };

    bar.addEventListener('click', e => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('.tag-chip');
      if (chip) applyTag(chip.dataset.tag || '');
    });

    // Cliquer un style sur une ligne revient a activer la pastille correspondante.
    list.addEventListener('click', e => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('.mix-tag');
      if (t?.dataset.jumpTag) applyTag(t.dataset.jumpTag);
    });
  }

  function attachTabs() {
    const tabs = document.getElementById('facet-tabs');
    const panels = document.getElementById('panels');
    if (!tabs || !panels || tabs.dataset.ready) return;
    tabs.dataset.ready = '1';
    const show = (key: string) => {
      tabs.querySelectorAll<HTMLElement>('.facet-tab')
          .forEach(t => t.classList.toggle('is-on', t.dataset.panel === key));
      panels.querySelectorAll<HTMLElement>('.panel')
            .forEach(p => p.classList.toggle('is-on', p.dataset.panel === key));
      // Les waveforms de la section qui vient d'apparaitre n'ont jamais croise
      // l'observateur tant qu'elles etaient masquees.
      attachWaveforms();
    };
    tabs.addEventListener('click', e => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('.facet-tab');
      if (t?.dataset.panel) show(t.dataset.panel);
    });
    show('agenda');
  }

  function initSon() { attachTabs(); attachPlayerButtons(); attachWaveforms(); attachTagFilter(); }
  initSon();
  document.addEventListener('astro:page-load', initSon);
</script>
