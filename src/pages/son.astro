---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getFacet } from '../data/facets.ts';
import sonJson from '../data/son.json';
import type { SonData } from '../data/types';
const sonData = sonJson as unknown as SonData;

const f = getFacet('son');

const all = await getCollection('gigs', ({ data }) => !data.draft);

const today = new Date();
today.setHours(0, 0, 0, 0);

const upcoming = all
  .filter(g => g.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = all
  .filter(g => g.data.date < today)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtLong  = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

const fmtShort = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });

function extractSpotifyPlaylistId(url: string): string | null {
  const match = url.match(/spotify\.com\/playlist\/([^/?]+)/);
  return match ? match[1] : null;
}

const visiblePlaylists = (sonData.spotify_playlists ?? [])
  .filter(p => p.visible)
  .map(p => ({ ...p, id: extractSpotifyPlaylistId(p.url) }))
  .filter((p): p is typeof p & { id: string } => p.id !== null);

const playlistsByCategory = visiblePlaylists.reduce((acc, p) => {
  const cat = p.category || 'Playlists';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(p);
  return acc;
}, {} as Record<string, typeof visiblePlaylists>);
---

<BaseLayout title="Son — hamcat.live" description={f?.teaser}>
  <main class="son">

    <!-- ── COVER IMAGE ──────────────────────────────────────────── -->
    {sonData.cover_image && (
      <div class="cover-hero">
        <img src={sonData.cover_image} alt={sonData.headline || 'Son'} class="cover-img" />
      </div>
    )}

    <!-- ── HEADER ───────────────────────────────────────────────── -->
    <header class="hd">
      <span class="label">{sonData.label || 'Son'}</span>
      <h1>{sonData.headline || 'DJ & Live'}</h1>
      {sonData.bio && <p class="bio">{sonData.bio}</p>}
      <p class="teaser">{sonData.genres?.join(' · ') || sonData.teaser || 'psytrance · hi-tech · goa'}</p>
    </header>

    <!-- ── GIGS ─────────────────────────────────────────────────── -->
    <section class="section gigs">

      <!-- À venir -->
      <div class="gig-group">
        <h2 class="group-label">À venir</h2>

        {upcoming.length === 0 ? (
          <p class="empty">Prochaines dates bientôt annoncées.</p>
        ) : (
          <ul class="gig-list">
            {upcoming.map(g => (
              <li class="gig-row gig-upcoming">
                <time datetime={g.data.date.toISOString()} class="c-date">
                  {fmtLong(g.data.date)}
                </time>
                <span class="c-title">{g.data.title}</span>
                <span class="c-venue">{g.data.venue !== g.data.title ? `@ ${g.data.venue}` : ''}</span>
                <span class="c-genres">{g.data.genre.join(' · ')}</span>
                <span class="c-format">{g.data.format}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Historique (foldable) -->
      <details class="gig-group" open>
        <summary class="group-label">
          Historique
          <span class="count">{past.length}</span>
          <span class="arrow" aria-hidden="true">▾</span>
        </summary>

        {past.length === 0 ? (
          <p class="empty">Aucun gig enregistré.</p>
        ) : (
          <ul class="gig-list">
            {past.map(g => (
              <li class="gig-row">
                <time datetime={g.data.date.toISOString()} class="c-date">
                  {fmtShort(g.data.date)}
                </time>
                <span class="c-title">{g.data.title}</span>
                <span class="c-venue">{g.data.venue !== g.data.title ? `@ ${g.data.venue}` : ''}</span>
                <span class="c-genres">{g.data.genre.join(' · ')}</span>
                <span class="c-format">{g.data.format}</span>
              </li>
            ))}
          </ul>
        )}
      </details>

    </section>

    <!-- ── ÉCOUTE / STREAMING ────────────────────────────────────── -->
    <section class="section ecoute">
      <h2 class="section-title">Écoute</h2>

      {(sonData.links?.soundcloud || sonData.links?.mixcloud || sonData.links?.spotify ||
         sonData.links?.instagram  || sonData.links?.facebook) ? (
        <div class="links-streaming">
          {sonData.links.soundcloud && (
            <a href={sonData.links.soundcloud} target="_blank" rel="noopener" class="link-btn">
              SoundCloud
            </a>
          )}
          {sonData.links.mixcloud && (
            <a href={sonData.links.mixcloud} target="_blank" rel="noopener" class="link-btn">
              Mixcloud
            </a>
          )}
          {sonData.links.spotify && (
            <a href={sonData.links.spotify} target="_blank" rel="noopener" class="link-btn">
              Spotify
            </a>
          )}
          {sonData.links.instagram && (
            <a href={sonData.links.instagram} target="_blank" rel="noopener" class="link-btn link-btn--secondary">
              Instagram
            </a>
          )}
          {sonData.links.facebook && (
            <a href={sonData.links.facebook} target="_blank" rel="noopener" class="link-btn link-btn--secondary">
              Facebook
            </a>
          )}
          {sonData.links.presskit && (
            <a href={sonData.links.presskit} target="_blank" rel="noopener" class="link-btn link-btn--secondary">
              Presskit
            </a>
          )}
        </div>
      ) : (
        <p class="empty">Liens à venir.</p>
      )}

      {(Object.keys(playlistsByCategory).length > 0 || sonData.links?.soundcloud) && (
        <div class="embeds">

          {Object.keys(playlistsByCategory).length > 0 && (
            <div class="embed-block">
              {Object.entries(playlistsByCategory).map(([cat, playlists]) => (
                <div class="playlist-group">
                  <span class="embed-label">{cat}</span>
                  {playlists.map(p => (
                    <div class="embed-frame" style="margin-bottom: 0.75rem;">
                      <iframe
                        src={`https://open.spotify.com/embed/playlist/${p.id}?utm_source=generator&theme=0`}
                        width="100%"
                        height="152"
                        frameborder="0"
                        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                        loading="lazy"
                      />
                    </div>
                  ))}
                </div>
              ))}
            </div>
          )}

          {sonData.links?.soundcloud && (
            <div class="embed-block">
              <span class="embed-label">SoundCloud</span>
              <div class="embed-frame">
                <iframe
                  src={`https://w.soundcloud.com/player/?url=${encodeURIComponent(sonData.links.soundcloud)}&color=%23ff5500&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&visual=true`}
                  width="100%"
                  height="300"
                  frameborder="0"
                  scrolling="no"
                  loading="lazy"
                />
              </div>
            </div>
          )}

        </div>
      )}
    </section>

    <!-- ── MIXES ─────────────────────────────────────────────────── -->
    {sonData.mixes && sonData.mixes.length > 0 && (
      <section class="section mixes">
        <h2 class="section-title">Mixes</h2>
        <ul class="mix-list">
          {sonData.mixes.map(mix => (
            <li class="mix-row">
              {mix.date && <time class="mix-date">{mix.date.slice(0, 7)}</time>}
              <span class="mix-title">{mix.title}</span>
              {mix.genre && <span class="mix-genre">{mix.genre}</span>}
              {mix.duration_min > 0 && <span class="mix-dur">{mix.duration_min}min</span>}
              {(mix.mixcloud_url || mix.soundcloud_url) && (
                <span class="mix-links">
                  {mix.mixcloud_url && (
                    <a href={mix.mixcloud_url} target="_blank" rel="noopener" class="link-btn link-btn--sm">
                      Mixcloud
                    </a>
                  )}
                  {mix.soundcloud_url && (
                    <a href={mix.soundcloud_url} target="_blank" rel="noopener" class="link-btn link-btn--sm">
                      SoundCloud
                    </a>
                  )}
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- ── VISUELS ───────────────────────────────────────────────── -->
    <!-- TODO: galerie photos, vidéos de sets -->
    <section class="section placeholder">
      <h2 class="section-title">Visuels</h2>
    </section>

    <!-- ── PRESSKIT ──────────────────────────────────────────────── -->
    <!-- TODO: bio longue, rider technique, contact booking -->
    <section class="section placeholder">
      <h2 class="section-title">Presskit</h2>
    </section>

    <a class="home" href="/">← Accueil</a>

  </main>
</BaseLayout>

<style>
  /* ── Cover hero ── */
  .cover-hero {
    width: 100%;
    max-width: 420px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .cover-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  /* ── Conteneur principal ── */
  .son {
    height: 100dvh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    align-items: center;       /* symétrie horizontale */
    padding: 4rem 2rem 3rem;   /* padding symétrique gauche/droite */
    gap: 3rem;
  }

  /* ── Header ── */
  .hd {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
  }

  .label {
    color: var(--facet-son);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--text-primary);
  }

  .teaser {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 38ch;
    margin: 0.5rem 0 0;
    text-align: center;
  }

  /* ── Sections génériques ── */
  .section {
    width: 100%;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
  }

  /* ── GIGS ── */
  .gigs {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: stretch;
  }

  /* Groupe (À venir / Historique) */
  .gig-group { display: flex; flex-direction: column; gap: 0; }

  /* Label de groupe — aussi utilisé comme <summary> */
  .group-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--facet-son);
    font-weight: 500;
    margin: 0 0 0.6rem;
    list-style: none;   /* masque le triangle natif */
    cursor: default;
  }
  details > .group-label { cursor: pointer; user-select: none; }

  /* Supprime le marqueur natif sur tous navigateurs */
  .group-label::-webkit-details-marker { display: none; }

  .count {
    color: var(--text-tertiary);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .arrow {
    color: var(--text-tertiary);
    font-size: 0.8rem;
    transition: transform 0.18s ease;
  }
  details[open] .arrow { transform: rotate(180deg); }

  /* ── Table gigs ──
     5 colonnes identiques sur toutes les lignes → alignement parfait.
     Colonnes : date | titre | venue | genres | format
  ── */
  .gig-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .gig-row {
    display: grid;
    grid-template-columns: 100px 1fr 140px 130px 48px;
    column-gap: 0.75rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
    align-items: center;
  }
  .gig-row:last-child { border-bottom: 1px solid var(--border); }

  /* ── Responsive mobile ── */
  @media (max-width: 640px) {
    .gig-row {
      grid-template-columns: 80px 1fr 44px;
    }
    .c-venue,
    .c-genres {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .gig-row {
      grid-template-columns: 1fr 44px;
    }
    .c-date {
      display: none;
    }
  }

  /* Ligne "à venir" : card accentuée */
  .gig-upcoming {
    border-top: none;
    border-left: 3px solid var(--facet-son);
    border-radius: 6px;
    background: color-mix(in srgb, var(--facet-son) 7%, var(--bg-surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--facet-son) 22%, var(--border));
    padding: 0.7rem 0.9rem 0.7rem 0.6rem;
    margin-bottom: 0.5rem;
  }
  .gig-upcoming:last-child { border-bottom: none; margin-bottom: 0; }

  /* Cellules communes */
  .c-date {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .gig-upcoming .c-date { color: var(--text-secondary); font-size: 0.8rem; }

  .c-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.96rem;
    color: var(--text-primary);
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gig-upcoming .c-title { font-size: 1.08rem; }

  .c-venue {
    color: var(--text-secondary);
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .c-genres {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .c-format {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-tertiary);
    text-align: right;
  }
  .gig-upcoming .c-format {
    color: color-mix(in srgb, var(--facet-son) 65%, var(--text-tertiary));
  }

  /* État vide */
  .empty {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin: 0;
  }

  /* ── Écoute / Streaming ── */
  .ecoute {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .links-streaming {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .link-btn {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--facet-son);
    border-radius: 8px;
    color: var(--facet-son);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    transition: background 0.2s ease;
  }
  .link-btn:hover {
    background: color-mix(in srgb, var(--facet-son) 15%, transparent);
  }
  .link-btn--secondary {
    border-color: var(--text-tertiary);
    color: var(--text-secondary);
  }
  .link-btn--secondary:hover {
    background: color-mix(in srgb, var(--text-tertiary) 12%, transparent);
  }
  .link-btn--sm {
    padding: 0.3rem 0.7rem;
    font-size: 0.72rem;
    border-color: var(--facet-son);
    color: var(--facet-son);
  }

  /* ── Embeds audio ── */
  .embeds {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    max-width: 680px;
    margin-top: 1rem;
  }
  .embed-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .embed-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--facet-son);
    font-weight: 500;
  }
  .embed-frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    width: 100%;
  }
  .embed-frame iframe {
    display: block;
    width: 100%;
    border: none;
  }

  /* ── Mixes ── */
  .mixes { align-items: stretch; }

  .mix-list {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
  }

  .mix-row {
    display: grid;
    grid-template-columns: 56px 1fr auto auto auto;
    column-gap: 0.7rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
    align-items: center;
  }
  .mix-row:last-child { border-bottom: 1px solid var(--border); }

  .mix-date {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .mix-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mix-genre {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .mix-dur {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .mix-links {
    display: flex;
    gap: 0.35rem;
  }

  @media (max-width: 520px) {
    .mix-row {
      grid-template-columns: 1fr auto;
      row-gap: 0.2rem;
    }
    .mix-date, .mix-genre, .mix-dur { display: none; }
    .mix-links { grid-column: 1 / -1; }
  }

  /* ── Playlists ── */
  .playlist-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  /* ── Placeholders ── */
  .placeholder {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    opacity: 0.45;
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    font-weight: 500;
    margin: 0;
  }

  /* ── Retour accueil ── */
  .home {
    align-self: center;
    color: var(--facet-son);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--facet-son);
    border-radius: 8px;
    transition: background 0.2s ease;
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }
  .home:hover {
    background: color-mix(in srgb, var(--facet-son) 15%, transparent);
  }
</style>
