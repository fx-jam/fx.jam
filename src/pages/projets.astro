---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFacet } from '../data/facets.ts';
import projetsJson from '../data/projets.json';
import type { ProjetsData } from '../data/types';
const projetsData = projetsJson as unknown as ProjetsData;

const f = getFacet('projets');
---

<BaseLayout
  title="Projets MAO & techniques du son — Ableton, DJing, prod | Hamcat"
  description={projetsData.teaser || "Projets de MAO et de techniques du son à Grenoble : Ableton Live, production, DJing, sonorisation et enregistrement."}
>
  <main class="projets">

    <!-- ── COVER HERO ──────────────────────────────────────────────── -->
    {projetsData.cover_image && (
      <div class="cover-hero">
        <img src={projetsData.cover_image} alt={projetsData.headline || 'Projets'} class="cover-img" />
      </div>
    )}

    <!-- ── HEADER ─────────────────────────────────────────────────── -->
    <header class="hd">
      <span class="label">{projetsData.label || 'Projets'}</span>
      <h1>{projetsData.headline || 'Projets MAO'}</h1>
      {projetsData.intro && <p class="intro">{projetsData.intro}</p>}
      {!projetsData.intro && <p class="teaser">{projetsData.teaser}</p>}
    </header>

    <!-- ── PROJETS PROPOSÉS ─────────────────────────────────────────── -->
    {projetsData.projetses && projetsData.projetses.length > 0 && (
      <section class="section projets-list-section">
        <h2 class="section-title">Projets proposés</h2>
        <ul class="projets-list">
          {projetsData.projetses.map(c => (
            <li class="projets-card">
              <div class="projets-card-head">
                <span class="projets-title">{c.title}</span>
                <span class="projets-meta-row">
                  {c.level    && <span class="tag">{c.level}</span>}
                  {c.duration && <span class="tag tag--dim">{c.duration}</span>}
                  {c.price    && <span class="tag tag--price">{c.price}</span>}
                </span>
              </div>
              {c.description && <p class="projets-desc">{c.description}</p>}
              {c.tools       && <p class="projets-tools">{c.tools}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- ── INFOS PRATIQUES ────────────────────────────────────────── -->
    {projetsData.schedule_info && (
      <section class="section infos">
        <h2 class="section-title">Infos pratiques</h2>
        <p class="schedule-text">{projetsData.schedule_info}</p>
      </section>
    )}

    <!-- ── INSCRIPTION ────────────────────────────────────────────── -->
    {projetsData.registration_link && (
      <section class="section inscription">
        <a href={projetsData.registration_link} target="_blank" rel="noopener" class="cta-btn">
          S'inscrire →
        </a>
      </section>
    )}

    <a class="home" href="/"
       onclick="if(window.top!==window){event.preventDefault();window.top.location.href='/';}">← Accueil</a>

  </main>
</BaseLayout>

<style>
  /* Le contenu etait colle en haut : 64 px au-dessus, plus de 500 en dessous.
     `justify-content: center` seul rogne le haut quand ca deborde ; les marges
     automatiques centrent quand il y a de la place et s'effacent sinon.
     Le rembourrage redevient symetrique — 4 rem en haut et 3 en bas etait deja
     un decentrage en soi. */
  .projets {
    height: calc(100dvh - var(--player-pad, 0px));
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 2rem;
    gap: 3rem;
  }
  .projets > :first-child { margin-block-start: auto; }
  .projets > :last-child  { margin-block-end: auto; }

  .cover-hero {
    width: 100%;
    max-width: 420px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .cover-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .hd {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
  }
  .label {
    color: var(--facet-projets);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--text-primary);
  }
  .intro, .teaser {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 44ch;
    margin: 0.5rem 0 0;
    text-align: center;
    line-height: 1.5;
  }

  .section {
    width: 100%;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0 auto;
  }
  .section-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--facet-projets);
    font-weight: 500;
    margin: 0;
  }

  /* ── Cards projets ── */
  .projets-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }

  .projets-card {
    border: 1px solid color-mix(in srgb, var(--facet-projets) 30%, var(--border));
    border-left: 3px solid var(--facet-projets);
    border-radius: 8px;
    background: color-mix(in srgb, var(--facet-projets) 5%, var(--bg-surface));
    padding: 0.9rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .projets-card-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .projets-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-primary);
    flex: 1;
  }
  .projets-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--facet-projets);
    color: var(--facet-projets);
    white-space: nowrap;
  }
  .tag--dim { border-color: var(--border); color: var(--text-tertiary); }
  .tag--price { border-color: color-mix(in srgb, var(--facet-projets) 50%, transparent); color: var(--text-secondary); }

  .projets-desc {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }
  .projets-tools {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-tertiary);
    letter-spacing: 0.05em;
    margin: 0;
  }

  /* ── Infos pratiques ── */
  .schedule-text {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Inscription ── */
  .inscription { align-items: center; }
  .cta-btn {
    display: inline-block;
    padding: 0.7rem 1.8rem;
    border: 1px solid var(--facet-projets);
    border-radius: 8px;
    color: var(--facet-projets);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    letter-spacing: 0.1em;
    transition: background 0.2s ease;
  }
  .cta-btn:hover { background: color-mix(in srgb, var(--facet-projets) 15%, transparent); }

  .home {
    align-self: center;
    color: var(--facet-projets);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--facet-projets);
    border-radius: 8px;
    transition: background 0.2s ease;
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }
  .home:hover { background: color-mix(in srgb, var(--facet-projets) 15%, transparent); }

  @media (max-width: 640px) {
    .projets-card-head { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 420px) {
    .projets { padding: 3rem 1.25rem 2rem; }
  }
</style>
