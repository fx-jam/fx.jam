---
// ─────────────────────────────────────────────────────────────────────────────
//  /atelier — la file de questions.
//
//  Une question a la fois, plein cadre, repondable au pouce. Les reponses sont
//  gardees dans le navigateur et reprises telles quelles a la session suivante :
//  on peut en faire dix et fermer.
//
//  ENVOI EN DIRECT (v1.75). Chaque reponse part seule : le serveur valide le
//  frontmatter et commite sans construire (0,4 s mesure, contre 89 s pour un
//  build propre). La publication est differee de 20 s apres la derniere
//  reponse — une seule execution CI par salve. La file d'envoi survit a la
//  fermeture de l'onglet, donc on peut s'arreter n'importe quand.
//
//  Page volontairement absente du sitemap et des liens publics : ce n'est pas
//  un secret, mais ca n'a rien a faire dans les resultats de recherche.
// ─────────────────────────────────────────────────────────────────────────────
import BaseLayout from '../layouts/BaseLayout.astro';
import { TRACKS } from '../lib/atelier';
---

<BaseLayout title="Atelier — hamcat.live" description="File de questions interne." noindex={true}>
  <main class="at">

    <header class="at-head">
      <div class="hd-info">
        <span class="label">Atelier</span>
        <h1 id="at-title">Questions</h1>
        <p class="sub" id="at-sub">chargement…</p>
      </div>
      <a class="home" href="/son">← Agenda</a>
    </header>

    <!-- Session Access expiree : le navigateur ne peut pas la renouveler tout
         seul depuis un fetch (la redirection part vers un autre domaine). On
         dit quoi faire, en un lien. -->
    <p class="auth" id="auth" hidden>
      <span id="auth-t">Session expirée — les réponses restent en attente.</span>
      <a class="auth-a" id="auth-go" href="/api/atelier/whoami" target="_blank" rel="noopener">Se reconnecter</a>
      <button class="auth-b" id="auth-retry">Reprendre l’envoi</button>
    </p>

    <!-- Une seule division, en deux : repondre aux trous, ou ouvrir une fiche
         et la corriger de bout en bout. -->
    <nav class="modes">
      <button class="md" id="md-q" aria-current="true">Questions</button>
      <button class="md" id="md-f" aria-current="false">Fiches</button>
      <button class="md" id="md-j" aria-current="false">Facettes</button>
    </nav>

    <div id="mode-q">

    <!-- Choix du parcours : on repond selon le temps qu'on a, pas selon un
         ordre impose. -->
    <nav class="tracks" id="tracks">
      {TRACKS.map(t => (
        <button class="tr" data-track={t.key}>
          <span class="tr-l">{t.label}</span>
          <span class="tr-n" data-count={t.key}>–</span>
          <span class="tr-b">{t.blurb}</span>
        </button>
      ))}
    </nav>

    <section class="card" id="card" hidden>
      <p class="q-meta"><span id="q-date"></span> · <span id="q-title"></span></p>
      <h2 class="q-prompt" id="q-prompt"></h2>
      <p class="q-why" id="q-why" hidden></p>

      <div class="q-input" id="q-input"></div>

      <div class="q-actions">
        <button class="btn" id="q-undo" hidden>Annuler</button>
        <button class="btn" id="q-never">Je ne sais plus</button>
        <button class="btn btn--skip" id="q-skip">Passer</button>
        <button class="btn btn--ok"   id="q-ok">Valider</button>
      </div>
      <p class="q-pos" id="q-pos"></p>
      <p class="milestone" id="milestone" hidden></p>
    </section>

    <section class="done" id="done" hidden>
      <p class="done-t" id="done-t"></p>
      <div class="q-actions">
        <button class="btn btn--ok" id="send">Publier maintenant</button>
        <button class="btn" id="copy">Copier</button>
      </div>
      <p class="done-state" id="done-state"></p>
      <p class="done-h">Chaque réponse part déjà toute seule ; publier n’attend pas les 20 s. Copier sert de repli.</p>
    </section>

    </div><!-- /mode-q -->

    <section class="fiches" id="mode-j" hidden>
      <p class="f-state" id="j-state">chargement…</p>
      <div class="f-list" id="j-list"></div>
      <div class="f-edit" id="j-edit" hidden></div>
    </section>

    <section class="fiches" id="mode-f" hidden>
      <div class="f-bar">
        <input class="f-search" id="f-search" type="search"
               placeholder="Chercher une date, un lieu, un style…" autocomplete="off" />
        <button class="btn btn--ok" id="f-new">Nouvelle date</button>
      </div>
      <p class="f-state" id="f-state">chargement…</p>
      <div class="f-list" id="f-list"></div>
      <div class="f-edit" id="f-edit" hidden></div>
    </section>

  </main>
</BaseLayout>

<style>
  .at {
    /* Le site est en viewport fixe : sans conteneur de defilement propre, une
       question a huit vignettes pousse les boutons hors de l'ecran sans aucun
       moyen d'y acceder. */
    height: calc(100dvh - var(--player-pad, 0px));
    overflow-y: auto;
    display: flex; flex-direction: column;
  }
  .at-head {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.85rem 1.5rem; border-bottom: 1px solid var(--border);
  }
  .hd-info { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .label {
    color: var(--facet-outils); font-family: var(--font-mono);
    font-size: 0.65rem; letter-spacing: 0.22em; text-transform: uppercase;
  }
  h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem); margin: 0; color: var(--text-primary);
  }
  .sub {
    margin: 0; font-family: var(--font-mono);
    font-size: 0.62rem; letter-spacing: 0.06em; color: var(--text-tertiary);
  }
  .home {
    font-family: var(--font-mono); font-size: 0.68rem;
    color: var(--text-secondary); text-decoration: none;
  }
  .home:hover { color: var(--facet-outils); }

  .auth {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem;
    max-width: 760px; margin: 0 auto; width: 100%;
    padding: 0.6rem 1.5rem;
    font-family: var(--font-mono); font-size: 0.72rem;
    color: var(--facet-cours);
  }
  .auth[hidden] { display: none; }
  .auth-a, .auth-b {
    font: inherit; cursor: pointer;
    color: var(--bg-app); background: var(--facet-cours);
    border: 0; border-radius: 3px; padding: 0.25rem 0.6rem;
    text-decoration: none;
  }
  .auth-b { background: transparent; color: var(--facet-cours); border: 1px solid currentColor; }

  .modes {
    display: flex; gap: 0.5rem;
    padding: 0.8rem 1.5rem 0; max-width: 760px; margin: 0 auto; width: 100%;
  }
  .md {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em;
    text-transform: uppercase; cursor: pointer;
    padding: 0.35rem 0.9rem; border-radius: 999px;
    border: 1px solid var(--border); background: transparent;
    color: var(--text-secondary);
  }
  .md[aria-current="true"] {
    border-color: var(--facet-outils); color: var(--facet-outils);
    background: color-mix(in srgb, var(--facet-outils) 10%, transparent);
  }

  /* ── Mode Fiches ────────────────────────────────────────────────────────
     Tout ce qui suit est cree en JavaScript. Les regles scopees d'Astro sont
     eliminees du bundle quand aucun element du gabarit ne les porte : sans
     :global, ces styles n'arriveraient jamais dans la page. C'est la panne
     qu'on a mis trois essais a comprendre le 22/09. */
  .fiches {
    display: flex; flex-direction: column; gap: 0.8rem;
    max-width: 760px; margin: 0 auto; width: 100%; padding: 1rem 1.5rem 2rem;
  }
  .fiches[hidden] { display: none; }
  .f-bar { display: flex; gap: 0.5rem; }
  .f-search {
    flex: 1; font: inherit; font-size: 0.85rem;
    padding: 0.5rem 0.7rem; border-radius: 6px;
    border: 1px solid var(--border); background: var(--bg-elevated, transparent);
    color: var(--text-primary);
  }
  .f-state {
    margin: 0; font-family: var(--font-mono); font-size: 0.7rem;
    color: var(--facet-outils); min-height: 1rem;
  }
  .f-list { display: flex; flex-direction: column; gap: 0.3rem; }
  .f-list[hidden] { display: none; }
  :global(.f-row) {
    display: grid; grid-template-columns: 6.2rem 1fr auto; gap: 0.6rem;
    align-items: baseline; text-align: left; cursor: pointer;
    padding: 0.45rem 0.6rem; border-radius: 6px;
    border: 1px solid transparent; background: transparent;
  }
  :global(.f-row:hover) { border-color: var(--facet-outils); }
  :global(.f-d) { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-tertiary); }
  :global(.f-t) { font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; color: var(--text-primary); }
  :global(.f-v) { font-size: 0.7rem; color: var(--text-secondary); }
  :global(.f-gap) { font-family: var(--font-mono); font-size: 0.62rem; color: var(--facet-cours); }
  :global(.f-draft) { color: var(--text-tertiary); font-style: italic; }

  .f-edit { display: flex; flex-direction: column; gap: 0.7rem; }
  .f-edit[hidden] { display: none; }
  :global(.fe-head) {
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem;
    border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;
  }
  :global(.fe-id) { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-tertiary); }
  :global(.fe-f) { display: flex; flex-direction: column; gap: 0.2rem; }
  :global(.fe-l) {
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--text-tertiary);
  }
  :global(.fe-i), :global(.fe-ta), :global(.fe-sel) {
    font: inherit; font-size: 0.85rem; width: 100%;
    padding: 0.45rem 0.6rem; border-radius: 6px;
    border: 1px solid var(--border); background: transparent; color: var(--text-primary);
  }
  :global(.fe-ta) { min-height: 5rem; resize: vertical; font-family: inherit; }
  :global(.fe-ch) { display: flex; align-items: center; gap: 0.45rem; font-size: 0.82rem; color: var(--text-secondary); }
  :global(.fe-med) { display: flex; flex-direction: column; gap: 0.35rem; }
  :global(.fe-m) {
    display: grid; grid-template-columns: 44px 1fr auto auto auto auto auto; gap: 0.4rem;
    align-items: center;
  }
  :global(.fe-th) { width: 44px; height: 44px; object-fit: cover; border-radius: 4px; background: var(--border); }
  :global(.fe-mid) { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-tertiary); overflow: hidden; text-overflow: ellipsis; }
  :global(.fe-b) {
    font-family: var(--font-mono); font-size: 0.68rem; cursor: pointer;
    padding: 0.25rem 0.55rem; border-radius: 4px;
    border: 1px solid var(--border); background: transparent; color: var(--text-secondary);
  }
  :global(.fe-b[aria-pressed="true"]) { border-color: var(--facet-son); color: var(--facet-son); }
  :global(.fe-b[disabled]) { opacity: 0.3; pointer-events: none; }
  :global(.fe-b--danger) { color: var(--facet-son); border-color: color-mix(in srgb, var(--facet-son) 40%, transparent); }
  :global(.fe-actions) {
    display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;
    padding-top: 0.6rem; border-top: 1px solid var(--border);
  }
  :global(.fe-note) { margin: 0.4rem 0 0; font-size: 0.66rem; color: var(--text-tertiary); }
  /* Compteur de signes : il ne tronque pas, il previent — et il ferme le bouton
     d'enregistrement tant que ca deborde. Un recto qui deborde n'est plus une
     jaquette, c'est une page. */
  :global(.fe-cpt) {
    font-family: var(--font-mono); font-size: 0.58rem;
    color: var(--text-tertiary); letter-spacing: 0;
  }
  :global(.fe-cpt[data-trop="1"]) { color: var(--facet-son); font-weight: 700; }
  :global(.fe-chips) { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  :global(.fe-e) {
    display: grid; grid-template-columns: 1fr 1.4fr 1fr auto; gap: 0.35rem;
    margin-bottom: 0.3rem;
  }
  :global(.btn[disabled]) { opacity: 0.35; pointer-events: none; }

  .tracks {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem;
    padding: 1rem 1.5rem 0; max-width: 760px; margin: 0 auto; width: 100%;
  }
  .tr {
    display: grid; grid-template-columns: 1fr auto; gap: 0.15rem 0.5rem;
    text-align: left; padding: 0.6rem 0.7rem;
    border: 1px solid var(--border); border-radius: 8px;
    background: transparent; cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .tr[aria-current="true"] {
    border-color: var(--facet-outils);
    background: color-mix(in srgb, var(--facet-outils) 10%, transparent);
  }
  .tr:hover { border-color: var(--facet-outils); }
  .tr-l {
    font-family: var(--font-display); font-weight: 600;
    font-size: 0.88rem; color: var(--text-primary);
  }
  .tr-n {
    font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-secondary);
  }
  .tr-b {
    grid-column: 1 / -1;
    font-size: 0.66rem; line-height: 1.3; color: var(--text-tertiary);
  }

  .card, .done {
    display: flex; flex-direction: column;
    gap: 0.7rem; max-width: 760px; margin: 0 auto; width: 100%;
    padding: 1.25rem 1.5rem 0;
  }
  .card[hidden], .done[hidden] { display: none; }

  .q-meta {
    margin: 0; font-family: var(--font-mono);
    font-size: 0.62rem; letter-spacing: 0.06em; color: var(--text-tertiary);
  }
  .q-prompt {
    margin: 0; font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.2rem, 4vw, 1.8rem); line-height: 1.2;
    color: var(--text-primary);
  }
  .q-why { margin: 0; font-size: 0.75rem; color: var(--text-secondary); }

  .q-input { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.4rem 0; width: 100%; }
  :global(.opt) {
    padding: 0.4rem 0.8rem; border-radius: 8px;
    border: 1px solid var(--border); background: transparent;
    font-family: var(--font-mono); font-size: 0.78rem;
    color: var(--text-secondary); cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  :global(.opt:hover), :global(.opt[aria-pressed="true"]) {
    color: var(--facet-outils); border-color: var(--facet-outils);
    background: color-mix(in srgb, var(--facet-outils) 10%, transparent);
  }
  :global(.fld) {
    flex: 1 1 100%; padding: 0.55rem 0.7rem;
    border: 1px solid var(--border); border-radius: 8px;
    background: var(--bg-surface); color: var(--text-primary);
    font-family: var(--font-mono); font-size: 0.85rem;
  }
  :global(.fld:focus) { outline: none; border-color: var(--facet-outils); }
  :global(textarea.fld) { min-height: 5.5rem; resize: vertical; line-height: 1.45; }

  /* Choix de cover : les vignettes sont la reponse, on ne lit rien. */
  /* Grille : en flex les vignettes s'empilaient en colonne des qu'elles
     depassaient la largeur du conteneur. */
  /* Colonnes de largeur FIXE : en `1fr` les vignettes s'etiraient a toute la
     largeur disponible — une seule image occupait l'ecran. Hauteur bornee pour
     que les boutons restent visibles quel que soit le nombre de medias. */
  /* Pas de defilement ici : le conteneur rognait le liseré de selection, et
     obligeait a faire defiler pour voir les dernieres images. Les vignettes
     retrecissent plutot que de deborder — `auto-fit` + `minmax` les repartit
     sur la largeur, et la variable --thumb, posee en JS selon leur nombre,
     borne leur taille pour que tout tienne d'un coup d'oeil. */
  :global(.thumbs) {
    flex: 1 1 100%; min-width: 0;
    display: grid; gap: 0.45rem;
    grid-template-columns: repeat(auto-fit, minmax(var(--thumb, 84px), 1fr));
    justify-content: start;
  }
  :global(.th) {
    width: 100%; aspect-ratio: 1; padding: 0; overflow: hidden;
    /* Bordure et non box-shadow : une ombre se fait rogner par le moindre
       conteneur, une bordure fait partie de la boite. */
    border: 3px solid transparent;
    outline: 1px solid var(--border); outline-offset: -3px;
    border-radius: 7px;
    background: var(--bg-surface); cursor: pointer;
  }
  :global(.th img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    opacity: 0.55; transition: opacity 0.12s ease;
  }
  :global(.th:hover img) { opacity: 1; }
  /* Selection franche : un liseré fin sur fond sombre ne se voyait pas. */
  :global(.th[aria-pressed="true"]) {
    border-color: var(--facet-outils);
    outline-color: var(--facet-outils);
  }
  :global(.th[aria-pressed="true"] img) { opacity: 1; }


  /* Collees en bas : toujours atteignables, quel que soit le nombre de
     vignettes au-dessus. */
  .q-actions {
    position: sticky; bottom: 0; z-index: 2;
    display: flex; gap: 0.5rem;
    padding: 0.7rem 0 0.5rem;
    background: var(--bg-app);
    box-shadow: 0 -8px 12px -8px var(--bg-app);
  }
  .btn {
    padding: 0.5rem 1rem; border-radius: 8px; cursor: pointer;
    font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.06em;
    border: 1px solid var(--border); background: transparent; color: var(--text-secondary);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .btn--ok {
    color: var(--facet-outils); border-color: var(--facet-outils);
    background: color-mix(in srgb, var(--facet-outils) 12%, transparent);
  }
  .btn:hover { border-color: var(--facet-outils); color: var(--facet-outils); }
  .q-pos {
    margin: 0; font-family: var(--font-mono);
    font-size: 0.6rem; color: var(--text-tertiary);
  }
  /* Jalon : marque l'avancee sans couper l'elan — pas de fin imposee. */
  .milestone {
    margin: 0; font-family: var(--font-mono);
    font-size: 0.68rem; letter-spacing: 0.06em;
    color: var(--facet-outils);
  }
  .milestone[hidden] { display: none; }
  .q-same {
    font-family: var(--font-mono); font-size: 0.6rem;
    color: var(--facet-outils); margin-left: 0.4rem;
  }

  .done-t {
    margin: 0; font-family: var(--font-display); font-weight: 700;
    font-size: 1.3rem; color: var(--text-primary);
  }
  .done-h { margin: 0; font-size: 0.72rem; color: var(--text-tertiary); }
  .done-state {
    margin: 0; min-height: 1.1rem;
    font-family: var(--font-mono); font-size: 0.78rem;
    color: var(--facet-outils);
  }

  @media (max-width: 640px) {
    .at-head { padding: 0.85rem 1rem; }
    .tracks { grid-template-columns: 1fr; padding: 0.8rem 1rem 0; }
    .card, .done { padding: 1rem; }
  }
</style>

<script>
  type Q = {
    id: string; track: string; gig: string; title: string; date: string;
    field: string; prompt: string; input: 'choice' | 'text' | 'media';
    options?: string[]; suggestion?: string; why?: string;
    media?: { id: string; kind: string }[]; targets?: string[];
  };

  declare const __COMMIT__: string;
  const MEDIA_BASE = 'https://media.hamcat.live/media';
  const KEY  = 'hamcat-atelier';
  const KEYD = 'hamcat-atelier-ecartees';

  let all: Q[] = [];
  let track = 'rapide';
  let queue: Q[] = [];
  let at = 0;
  let value = '';

  // Les reponses survivent a la fermeture de l'onglet : c'est la condition pour
  // pouvoir en faire trois dans le tram et reprendre plus tard.
  const load = (): Record<string, string> => {
    try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; }
  };
  const save = (a: Record<string, string>) => {
    try { localStorage.setItem(KEY, JSON.stringify(a)); } catch { /* navigation privee */ }
  };
  let answers = load();

  // Questions sans reponse possible (« je ne sais plus ») : ecartees pour de
  // bon, sinon elles remontent a chaque session et polluent la file.
  const loadD = (): string[] => {
    try { return JSON.parse(localStorage.getItem(KEYD) || '[]'); } catch { return []; }
  };
  let dismissed = new Set<string>(loadD());
  const saveD = () => {
    try { localStorage.setItem(KEYD, JSON.stringify([...dismissed])); } catch {}
  };

  // Pile d'annulation : un choix ferme valide au premier tap, il faut pouvoir
  // revenir sur un tap malheureux.
  let undoStack: Q[] = [];
  let sessionDone = 0;

  // ── Envoi en direct ──────────────────────────────────────────────────────
  //  Chaque reponse part seule (0,4 s cote serveur : validation + commit, sans
  //  build). La publication est differee de 20 s apres la derniere reponse :
  //  une seule execution CI par salve au lieu d'une par reponse.
  //  `enAttente` survit a la fermeture : couper le reseau ne perd rien.
  const KEYQ = 'hamcat-atelier-envoi';
  type Env = { gig: string; field: string; value: string; id: string };
  const loadQ = (): Env[] => {
    try { return JSON.parse(localStorage.getItem(KEYQ) || '[]'); } catch { return []; }
  };
  let enAttente: Env[] = loadQ();
  const saveQ = () => { try { localStorage.setItem(KEYQ, JSON.stringify(enAttente)); } catch {} };

  let envoiEnCours = false;
  let pushTimer: number | null = null;
  let etat = '';

  //  L'etat s'ecrit sous le titre, tout en haut. Quand on est en bas du
  //  parcours, sur le bouton, on ne le voit pas : il s'ecrit donc aux deux
  //  endroits. Une action sans retour visible la ou on regarde est une action
  //  qu'on croit cassee.
  function dire(s: string) {
    etat = s;
    const e = document.getElementById('done-state');
    if (e) e.textContent = s;
    counts();
  }

  //  La page et l'API sont deux applications Access distinctes : voir la page
  //  ne garantit pas que l'API soit ouverte. Quand elle ne l'est pas, Access
  //  repond 302 vers cloudflareaccess.com — un autre domaine, donc un fetch
  //  qui suit la redirection echoue sans rien dire d'utile ("Failed to fetch"
  //  = ce qu'on affichait comme « hors ligne », alors que le reseau va bien).
  //  `redirect: 'manual'` rend la redirection visible : status 0 / type
  //  'opaqueredirect'. On la traite pour ce qu'elle est — une reconnexion a
  //  faire — au lieu de la confondre avec une panne reseau.
  type Rep = { ok: true; d: any } | { ok: false; auth: boolean; msg: string };

  async function poste(url: string, body?: unknown): Promise<Rep> {
    let r: Response;
    try {
      r = await fetch(url, {
        method: 'POST', redirect: 'manual', credentials: 'same-origin',
        ...(body === undefined ? {} : {
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        }),
      });
    } catch {
      return { ok: false, auth: false, msg: 'hors ligne — reprise auto' };
    }
    if (r.type === 'opaqueredirect' || r.status === 0 || (r.status >= 300 && r.status < 400)) {
      return { ok: false, auth: true, msg: 'reconnexion nécessaire' };
    }
    const d = await r.json().catch(() => ({}));
    if (r.status === 401 || r.status === 403) return { ok: false, auth: true, msg: 'reconnexion nécessaire' };
    if (!r.ok || !d.ok) return { ok: false, auth: false, msg: `échec : ${d.error || r.status}` };
    return { ok: true, d };
  }

  let besoinAuth = false;
  function authBanner(on: boolean) {
    besoinAuth = on;
    const el = document.getElementById('auth');
    if (el) el.hidden = !on;
  }

  async function vider() {
    if (envoiEnCours || besoinAuth || !enAttente.length) return;
    envoiEnCours = true;
    const lot = enAttente.slice(0, 20);
    try {
      const rep = await poste('/api/atelier/quick', {
        answers: lot.map(({ gig, field, value }) => ({ gig, field, value })),
      });
      if (rep.ok) {
        authBanner(false);
        const d = rep.d;
        const envoyes = new Set(lot.map(x => `${x.gig}:${x.field}`));
        enAttente = enAttente.filter(x => !envoyes.has(`${x.gig}:${x.field}`));
        saveQ();
        // Les reponses acquises n'ont plus a etre gardees comme « en attente ».
        for (const x of lot) { delete answers[x.id]; }
        save(answers);
        aPublier = true;
        dire(enAttente.length ? `${enAttente.length} en cours…` : 'enregistré');
        planifierPush();
      } else {
        // Une reconnexion demande un geste humain : on arrete de reessayer en
        // boucle, « Reprendre l'envoi » relance.
        authBanner(rep.auth);
        dire(rep.msg);
      }
    } finally {
      envoiEnCours = false;
      if (enAttente.length && !besoinAuth) setTimeout(vider, 1500);
    }
  }

  function planifierPush(delai = 20000) {
    if (pushTimer) clearTimeout(pushTimer);
    pushTimer = window.setTimeout(async () => {
      if (enAttente.length || besoinAuth) return planifierPush();
      dire('publication…');
      const rep = await poste('/api/atelier/push');
      if (rep.ok) { aPublier = false; dire(rep.d.pushed ? `publié (${rep.d.pushed}) — en ligne dans ~90 s` : 'à jour'); }
      else { authBanner(rep.auth); dire(rep.msg); }
    }, delai);
  }

  //  Publication : un commit sans push est du travail perdu de vue. Trois
  //  filets, parce que la panne observee le 24/09 — « les changements n'ont pas
  //  suivi » — venait d'un commit reste local quand l'onglet s'est ferme avant
  //  la fin du delai de 20 s.
  let aPublier = false;

  /** Filet 2 : l'onglet se ferme ou passe en arriere-plan. `sendBeacon` est fait
   *  pour ca — la requete part meme si la page disparait dans la milliseconde,
   *  ce qu'un `fetch` ordinaire ne garantit pas. */
  function publierAuDepart() {
    if (!aPublier) return;
    try { navigator.sendBeacon('/api/atelier/push'); aPublier = false; } catch { /* rien a faire */ }
  }
  addEventListener('pagehide', publierAuDepart);
  addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') publierAuDepart();
  });

  //  Sonde au chargement : mieux vaut apprendre que la session est fermee
  //  avant d'avoir repondu a trente questions qu'apres.
  (async () => {
    const r = await poste('/api/atelier/whoami').catch(() => null);
    if (r && !r.ok && r.auth) { authBanner(true); return; }
    if (enAttente.length) vider();
    // Filet 3 : solder a l'ouverture ce qu'une session precedente aurait laisse
    // commite sans etre publie. Gratuit quand il n'y a rien (0,3 s).
    const p = await poste('/api/atelier/push').catch(() => null);
    if (p && p.ok && p.d?.pushed) dire(`${p.d.pushed} publication(s) en retard rattrapée(s)`);
  })();

  const $ = (id: string) => document.getElementById(id)!;

  function counts() {
    for (const t of ['rapide', 'lineup', 'recits']) {
      const n = all.filter(q => q.track === t && !(q.id in answers) && !dismissed.has(q.id)).length;
      const el = document.querySelector(`[data-count="${t}"]`);
      if (el) el.textContent = String(n);
    }
    const done = Object.keys(answers).length;
    const q = all.length - done;
    $('at-sub').textContent = `${q} question${q > 1 ? 's' : ''}`
      + (etat ? ` · ${etat}` : '')
      + ` · build ${typeof __COMMIT__ !== 'undefined' ? __COMMIT__ : '?'}`;
  }

  function pick(t: string) {
    track = t;
    document.querySelectorAll('.tr').forEach(b =>
      b.setAttribute('aria-current', String((b as HTMLElement).dataset.track === t)));
    // Regroupees par date : se rappeler une soiree coute plus cher que
    // repondre. Une fois qu'on y est, on traite ses trous d'affilee. L'ordre
    // entre dates suit la priorite de leur question la plus urgente.
    const left = all.filter(q => q.track === t && !(q.id in answers) && !dismissed.has(q.id));
    const rank = new Map<string, number>();
    left.forEach((q, i) => { if (!rank.has(q.gig)) rank.set(q.gig, i); });
    queue = left.sort((a, b) =>
      (rank.get(a.gig)! - rank.get(b.gig)!) || 0);
    at = 0;
    render();
  }

  function render() {
    const q = queue[at];
    if (!q) {
      $('card').hidden = true;
      $('done').hidden = false;
      const reste = enAttente.length;
      $('done-t').textContent = reste
        ? `${reste} réponse${reste > 1 ? 's' : ''} en cours d’envoi.`
        : sessionDone
          ? `${sessionDone} réponses envoyées. Le reste du parcours est fait.`
          : 'Rien à faire ici.';
      counts();
      return;
    }
    $('done').hidden = true;
    $('card').hidden = false;
    $('q-date').textContent  = q.date;
    $('q-title').textContent = q.title;
    $('q-prompt').textContent = q.prompt;
    $('q-why').textContent = q.why ?? '';
    $('q-why').hidden = !q.why;
    const sameDate = queue.filter(x => x.gig === q.gig).length;
    $('q-pos').innerHTML = `${at + 1} / ${queue.length}`
      + (sameDate > 1 ? `<span class="q-same">${sameDate - 1} autre${sameDate > 2 ? 's' : ''} sur cette date</span>` : '');
    ($('q-undo') as HTMLElement).hidden = undoStack.length === 0;

    value = q.suggestion ?? '';
    const box = $('q-input');
    box.innerHTML = '';

    if (q.input === 'media') {
      const wrap = document.createElement('div');
      wrap.className = 'thumbs';
      // Taille bornee selon le nombre : peu de medias -> grandes vignettes ;
      // beaucoup -> plus petites, mais tout reste visible sans defiler.
      const n = (q.media ?? []).length;
      wrap.style.setProperty('--thumb', n <= 4 ? '118px' : n <= 9 ? '92px' : n <= 16 ? '74px' : '58px');
      (q.media ?? []).forEach(m => {
        const b = document.createElement('button');
        b.className = 'th';
        b.setAttribute('aria-pressed', 'false');
        const img = document.createElement('img');
        img.src = `${MEDIA_BASE}/${q.date}/${m.id}${m.kind === 'video' ? '-p' : '-t'}.webp`;
        img.alt = ''; img.loading = 'lazy';
        b.appendChild(img);
        b.onclick = () => {
          value = m.id;
          wrap.querySelectorAll('.th').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
        };
        wrap.appendChild(b);
      });
      box.appendChild(wrap);

      // Sortie du choix ferme : la presélection ne montre que les medias deja
      // rattaches a la date. Un identifiant colle a la main permet d'en
      // designer un autre — rattacher un media inedit reste le travail de
      // l'outil local, qui a acces a la bibliotheque.
      const other = document.createElement('input') as HTMLInputElement;
      other.className = 'fld';
      other.placeholder = 'Autre média : coller son identifiant';
      other.oninput = () => {
        value = other.value.trim();
        wrap.querySelectorAll('.th').forEach(x => x.setAttribute('aria-pressed', 'false'));
      };
      box.appendChild(other);
      return;
    }

    if (q.input === 'choice') {
      (q.options ?? []).forEach(o => {
        const b = document.createElement('button');
        b.className = 'opt'; b.textContent = o;
        b.setAttribute('aria-pressed', String(o === value));
        // Un choix propose vaut validation : pas de second geste pour confirmer.
        b.onclick = () => { value = o; commit(); };
        box.appendChild(b);
      });
      // Aucun vocabulaire n'est complet : les propositions viennent de ce qui a
      // deja ete saisi, pas d'une liste fermee decidee a l'avance. Entree =
      // valider, et la valeur inedite servira de proposition aux suivantes.
      const libre = document.createElement('input') as HTMLInputElement;
      libre.className = 'fld';
      libre.placeholder = 'Autre valeur…';
      libre.oninput = () => {
        value = libre.value;
        box.querySelectorAll('.opt').forEach(x => x.setAttribute('aria-pressed', 'false'));
      };
      libre.onkeydown = (e: KeyboardEvent) => {
        if (e.key === 'Enter') { e.preventDefault(); commit(); }
      };
      box.appendChild(libre);
      return;
    }

    // Texte. La suggestion est pre-remplie quand elle existe : repondre devient
    // valider. Les valeurs deja employees ailleurs sont proposees a cote.
    const long = q.field === 'description' || q.field === 'lineup';
    const f = document.createElement(long ? 'textarea' : 'input') as HTMLInputElement;
    f.className = 'fld';
    f.value = value;
    if (q.field === 'lineup') f.placeholder = 'Un nom par ligne';
    f.oninput = () => { value = f.value; };
    f.onkeydown = (e: KeyboardEvent) => {
      if (e.key === 'Enter' && !long) { e.preventDefault(); commit(); }
    };
    box.appendChild(f);
    (q.options ?? []).slice(0, 8).forEach(o => {
      const b = document.createElement('button');
      b.className = 'opt'; b.textContent = o;
      b.onclick = () => { value = o; f.value = o; };
      box.appendChild(b);
    });
    setTimeout(() => f.focus(), 30);
  }

  function commit() {
    const q = queue[at];
    if (!q || !value.trim()) return;
    const val = value.trim();
    answers[q.id] = val;
    save(answers);
    // Mise en file d'envoi : une entree par fiche visee.
    for (const gig of (q.targets ?? [q.gig])) {
      enAttente = enAttente.filter(x => !(x.gig === gig && x.field === q.field));
      enAttente.push({ gig, field: q.field, value: val, id: q.id });
    }
    saveQ();
    vider();
    undoStack.push(q);
    queue.splice(at, 1);
    if (at >= queue.length) at = Math.max(0, queue.length - 1);
    sessionDone += 1;
    const ms = $('milestone');
    if (sessionDone % 10 === 0) {
      ms.textContent = `${sessionDone} de plus.`;
      ms.hidden = false;
    } else if (sessionDone % 10 === 1) {
      ms.hidden = true;
    }
    counts();
    render();
  }

  function skip() {
    if (!queue.length) return;
    at = (at + 1) % queue.length;
    render();
  }

  $('q-ok').onclick = commit;
  $('q-skip').onclick = skip;

  $('q-never').onclick = () => {
    const q = queue[at];
    if (!q) return;
    dismissed.add(q.id); saveD();
    queue.splice(at, 1);
    if (at >= queue.length) at = Math.max(0, queue.length - 1);
    counts(); render();
  };

  $('q-undo').onclick = () => {
    const q = undoStack.pop();
    if (!q) return;
    delete answers[q.id];
    save(answers);
    queue.splice(at, 0, q);
    sessionDone = Math.max(0, sessionDone - 1);
    $('milestone').hidden = true;
    counts(); render();
  };

  //  Il n'y a plus qu'un chemin d'ecriture : la file. Chaque reponse part deja
  //  seule ; ce bouton ne fait qu'en avancer la fin — vider ce qui traine et
  //  publier sans attendre les 20 s. Deux chemins d'ecriture, c'etait deux
  //  facons de se tromper.
  $('send').onclick = async () => {
    const btn = $('send') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Publication…';
    dire('publication…');
    if (enAttente.length) await vider();
    if (besoinAuth) { btn.disabled = false; btn.textContent = 'Publier maintenant'; return; }
    if (pushTimer) { clearTimeout(pushTimer); pushTimer = null; }
    const rep = await poste('/api/atelier/push');
    if (rep.ok) dire(rep.d.pushed ? `publié (${rep.d.pushed})` : 'déjà à jour');
    else { authBanner(rep.auth); dire(rep.msg); }
    btn.disabled = false; btn.textContent = 'Publier maintenant';
  };

  $('auth-retry').onclick = async () => {
    authBanner(false);
    dire('reprise…');
    const r = await poste('/api/atelier/whoami');
    if (!r.ok && r.auth) { authBanner(true); dire('toujours déconnecté'); return; }
    if (enAttente.length) vider(); else dire('reconnecté');
  };

  $('copy').onclick = async () => {
    // Le format porte le champ et la fiche : lisible par un humain comme par
    // l'architecte, sans table de correspondance.
    const lines = Object.entries(answers).flatMap(([id, v]) => {
      const q = all.find(x => x.id === id);
      const gigs = q ? (q.targets ?? [q.gig]) : [id.slice(0, id.lastIndexOf(':'))];
      const field = q ? q.field : id.slice(id.lastIndexOf(':') + 1);
      return gigs.map(g => `${g}\t${field}\t${v.replace(/\n/g, ' | ')}`);
    });
    const txt = lines.join('\n');
    try {
      await navigator.clipboard.writeText(txt);
      ($('copy') as HTMLButtonElement).textContent = 'Copié';
    } catch {
      // Le presse-papier est refuse hors contexte sur.
      const ta = document.createElement('textarea');
      ta.className = 'fld'; ta.value = txt; ta.rows = 10;
      $('done').appendChild(ta); ta.select();
    }
  };

  document.querySelectorAll('.tr').forEach(b =>
    b.addEventListener('click', () => pick((b as HTMLElement).dataset.track!)));

  fetch('/atelier.json')
    .then(r => r.json())
    .then(d => { all = d.questions ?? []; counts(); pick('rapide'); })
    .catch(() => { $('at-sub').textContent = 'file indisponible'; });
  // ── Mode Fiches ────────────────────────────────────────────────────────────
  //  La file de questions ne sait que remplir un trou. Ici on ouvre une date et
  //  on la corrige de bout en bout — y compris ce qui etait deja rempli, ce que
  //  la file ne proposera jamais.
  //
  //  Le serveur ne reserialise pas le frontmatter entier : il remplace le bloc
  //  des seuls champs envoyes. On n'envoie donc QUE ce qui a change, et les
  //  champs qu'on n'affiche pas ici (`recordings`, listes de plusieurs
  //  enregistrements) ressortent du fichier octet pour octet.
  type Fiche = Record<string, any> & { id: string };
  type Champ = { k: string; l: string; t: string; o?: string[] };

  const CHAMPS: Champ[] = [
    { k: 'title',       l: 'Titre',                t: 'str'  },
    { k: 'date',        l: 'Date',                 t: 'date' },
    { k: 'format',      l: 'Format',               t: 'enum', o: ['dj', 'live', 'hybride'] },
    { k: 'role',        l: 'Type de set',          t: 'str',
      o: ['DJ set', 'warm-up', 'closing', 'peak-time', 'dancefloor', 'live', 'concept set', 'B2B'] },
    { k: 'organizer',   l: 'Organisateur',         t: 'str'  },
    { k: 'formation',   l: 'Formation',            t: 'str',
      o: ['solo', 'b2b', 'b3b', 'live band', 'collectif'] },
    { k: 'venue',       l: 'Lieu',                 t: 'str'  },
    { k: 'city',        l: 'Ville',                t: 'str'  },
    { k: 'country',     l: 'Pays',                 t: 'str'  },
    { k: 'genre',       l: 'Styles',               t: 'list' },
    { k: 'duration',    l: 'Durée',                t: 'str',
      o: ['45min', '1h', '1h30', '2h', '3h', '4h'] },
    { k: 'lineup',      l: 'Line-up',              t: 'list' },
    { k: 'description', l: 'Description',          t: 'text' },
    { k: 'media',       l: 'Médias',               t: 'media' },
    { k: 'recordState', l: 'État enregistrement',  t: 'enum', o: ['none', 'soon', 'tracklist'] },
    { k: 'recording',   l: 'URL enregistrement',   t: 'str'  },
    { k: 'tracklist',   l: 'Tracklist / playlist', t: 'str'  },
    { k: 'eventUrl',    l: 'Lien événement',       t: 'str'  },
    { k: 'notes',       l: 'Notes privées',        t: 'text' },
    { k: 'featured',    l: 'Mise en avant',        t: 'bool' },
    { k: 'draft',       l: 'Brouillon',            t: 'bool' },
  ];

  let fiches: Fiche[] = [];
  let fichesChargees = false;
  let ouverte: Fiche | null = null;
  let brouillon: Record<string, any> = {};   // uniquement les champs modifies
  let creation = false;

  const fdire = (s: string) => { const e = $('f-state'); if (e) e.textContent = s; };
  const txt = (v: any) => (v === undefined || v === null ? '' : String(v));
  const arr = (v: any) => (Array.isArray(v) ? v : []);

  async function chargerFiches(force = false) {
    if (fichesChargees && !force) return;
    fdire('chargement…');
    const rep = await poste('/api/atelier/fiches');
    if (!rep.ok) { authBanner(rep.auth); fdire(rep.msg); return; }
    fiches = rep.d.fiches || [];
    fichesChargees = true;
    fdire(`${fiches.length} fiches`);
    listeFiches();
  }

  /** Ce qui manque a une fiche, dit en un mot — c'est ce qui rend la liste
   *  utile : on voit ou aller sans ouvrir. */
  function trous(f: Fiche): string {
    const m: string[] = [];
    if (!txt(f.city)) m.push('ville');
    if (!txt(f.role)) m.push('rôle');
    if (!txt(f.duration)) m.push('durée');
    if (!arr(f.lineup).length) m.push('line-up');
    if (!txt(f.description)) m.push('récit');
    if (!arr(f.media).length) m.push('média');
    return m.length ? m.join(' · ') : '';
  }

  function listeFiches() {
    const q = (($('f-search') as HTMLInputElement).value || '').trim().toLowerCase();
    const el = $('f-list');
    el.textContent = '';
    const vus = fiches
      .filter(f => !q || [f.id, f.title, f.venue, f.city, ...arr(f.genre), ...arr(f.lineup)]
        .some(x => txt(x).toLowerCase().includes(q)))
      .sort((a, b) => txt(b.date).localeCompare(txt(a.date)));
    for (const f of vus) {
      const b = document.createElement('button');
      b.className = 'f-row';
      const d = document.createElement('span'); d.className = 'f-d'; d.textContent = txt(f.date);
      const t = document.createElement('span');
      t.className = 'f-t' + (f.draft ? ' f-draft' : '');
      t.textContent = txt(f.title) + (f.draft ? ' — brouillon' : '');
      const v = document.createElement('span'); v.className = 'f-v'; v.textContent = txt(f.venue);
      const g = document.createElement('span'); g.className = 'f-gap'; g.textContent = trous(f);
      const mid = document.createElement('span'); mid.append(t, document.createTextNode(' '), v);
      b.append(d, mid, g);
      b.onclick = () => ouvrir(f);
      el.appendChild(b);
    }
    if (!vus.length) fdire(q ? 'aucune fiche ne correspond' : `${fiches.length} fiches`);
    else fdire(`${vus.length} fiche${vus.length > 1 ? 's' : ''}`);
  }

  function ouvrir(f: Fiche) {
    ouverte = JSON.parse(JSON.stringify(f));
    brouillon = {};
    creation = false;
    rendreEditeur();
  }

  function nouvelle() {
    const today = new Date().toISOString().slice(0, 10);
    ouverte = { id: '', title: '', date: today, format: 'dj', venue: '', country: 'France', draft: true };
    brouillon = { ...ouverte };
    delete brouillon.id;
    creation = true;
    rendreEditeur();
  }

  /** Identifiant derive de la date et du titre, comme les 81 fiches existantes. */
  function idPropose(): string {
    const d = txt(ouverte?.date).slice(0, 10);
    const t = txt(ouverte?.title).toLowerCase()
      .normalize('NFD').replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    return [d, t].filter(Boolean).join('-');
  }

  function set(k: string, v: any) {
    if (!ouverte) return;
    ouverte[k] = v;
    brouillon[k] = v;
    const s = $('fe-save') as HTMLButtonElement | null;
    if (s) s.textContent = `Enregistrer (${Object.keys(brouillon).length})`;
  }

  function champEl(c: Champ): HTMLElement {
    const wrap = document.createElement('div'); wrap.className = 'fe-f';
    const lab = document.createElement('span'); lab.className = 'fe-l'; lab.textContent = c.l;
    const v = ouverte ? ouverte[c.k] : undefined;

    if (c.t === 'bool') {
      const l = document.createElement('label'); l.className = 'fe-ch';
      const i = document.createElement('input'); i.type = 'checkbox'; i.checked = v === true;
      i.onchange = () => set(c.k, i.checked);
      l.append(i, document.createTextNode(c.l));
      wrap.appendChild(l);
      return wrap;
    }
    if (c.t === 'media') { wrap.append(lab, mediaEl()); return wrap; }

    let inp: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    if (c.t === 'enum') {
      const sel = document.createElement('select'); sel.className = 'fe-sel';
      for (const o of c.o!) {
        const op = document.createElement('option'); op.value = o; op.textContent = o;
        if (txt(v) === o) op.selected = true;
        sel.appendChild(op);
      }
      sel.onchange = () => set(c.k, sel.value);
      inp = sel;
    } else if (c.t === 'text') {
      const ta = document.createElement('textarea'); ta.className = 'fe-ta';
      ta.value = txt(v);
      ta.oninput = () => set(c.k, ta.value);
      inp = ta;
    } else {
      const i = document.createElement('input'); i.className = 'fe-i';
      i.type = c.t === 'date' ? 'date' : 'text';
      i.value = c.t === 'list' ? arr(v).join(', ') : txt(v);
      if (c.o) {
        const lid = 'dl-' + c.k;
        let dl = document.getElementById(lid) as HTMLDataListElement | null;
        if (!dl) {
          dl = document.createElement('datalist'); dl.id = lid;
          for (const o of c.o) { const op = document.createElement('option'); op.value = o; dl.appendChild(op); }
          document.body.appendChild(dl);
        }
        i.setAttribute('list', lid);
      }
      i.oninput = () => set(c.k, c.t === 'list'
        ? i.value.split(',').map(x => x.trim()).filter(Boolean)
        : i.value);
      inp = i;
    }
    wrap.append(lab, inp);
    return wrap;
  }

  /** Les medias sont le champ le plus penible a corriger a la main : une liste
   *  d'identifiants opaques dont on ne voit pas ce qu'ils representent. */
  function mediaEl(): HTMLElement {
    const box = document.createElement('div'); box.className = 'fe-med';
    const liste = arr(ouverte?.media) as { id: string; kind: string }[];
    const permuter = (a: number, b: number) => {
      const l = liste.slice();
      if (b < 0 || b >= l.length) return;
      [l[a], l[b]] = [l[b], l[a]];
      set('media', l); rendreEditeur();
    };
    liste.forEach((m, i) => {
      const row = document.createElement('div'); row.className = 'fe-m';
      const th = document.createElement('img'); th.className = 'fe-th'; th.loading = 'lazy';
      th.src = `${MEDIA_BASE}/${m.id}${m.kind === 'video' ? '/thumb' : ''}`;
      th.alt = '';
      const id = document.createElement('span'); id.className = 'fe-mid';
      // L'ordre de cette liste EST l'ordre de la projection : un media sur deux
      // part a gauche, l'autre a droite. Le dire ici evite d'avoir a le deviner.
      id.textContent = (i % 2 === 0 ? '← gauche  ' : '→ droite  ') + m.id.slice(0, 8);
      const haut = document.createElement('button'); haut.className = 'fe-b';
      haut.textContent = '↑'; haut.disabled = i === 0;
      haut.onclick = () => { permuter(i, i - 1); };
      const bas = document.createElement('button'); bas.className = 'fe-b';
      bas.textContent = '↓'; bas.disabled = i === liste.length - 1;
      bas.onclick = () => { permuter(i, i + 1); };
      const kind = document.createElement('button'); kind.className = 'fe-b';
      kind.textContent = m.kind;
      kind.onclick = () => {
        const l = arr(ouverte?.media).slice();
        l[i] = { ...l[i], kind: l[i].kind === 'video' ? 'image' : 'video' };
        set('media', l); rendreEditeur();
      };
      const cov = document.createElement('button'); cov.className = 'fe-b';
      cov.textContent = 'cover';
      cov.setAttribute('aria-pressed', String(txt(ouverte?.cover) === m.id));
      cov.onclick = () => { set('cover', txt(ouverte?.cover) === m.id ? '' : m.id); rendreEditeur(); };
      const del = document.createElement('button'); del.className = 'fe-b fe-b--danger';
      del.textContent = 'retirer';
      del.onclick = () => {
        const l = arr(ouverte?.media).filter((_, j) => j !== i);
        set('media', l);
        if (txt(ouverte?.cover) === m.id) set('cover', '');
        rendreEditeur();
      };
      row.append(th, id, haut, bas, kind, cov, del);
      box.appendChild(row);
    });
    const add = document.createElement('div'); add.className = 'fe-m';
    const sp = document.createElement('span');
    const inp = document.createElement('input'); inp.className = 'fe-i';
    inp.placeholder = 'identifiant du média à ajouter';
    const go = document.createElement('button'); go.className = 'fe-b'; go.textContent = 'ajouter';
    go.onclick = () => {
      const v = inp.value.trim();
      if (!v) return;
      set('media', [...arr(ouverte?.media), { id: v, kind: 'image' }]);
      rendreEditeur();
    };
    add.append(sp, inp, go, document.createElement('span'), document.createElement('span'),
               document.createElement('span'), document.createElement('span'));
    box.appendChild(add);
    return box;
  }

  function rendreEditeur() {
    const el = $('f-edit');
    el.textContent = '';
    el.hidden = false;
    $('f-list').hidden = true;
    if (!ouverte) return;

    const head = document.createElement('div'); head.className = 'fe-head';
    const h = document.createElement('strong');
    h.textContent = creation ? 'Nouvelle date' : txt(ouverte.title);
    const idl = document.createElement('span'); idl.className = 'fe-id';
    idl.textContent = creation ? idPropose() || '…' : ouverte.id;
    head.append(h, idl);
    el.appendChild(head);

    for (const c of CHAMPS) el.appendChild(champEl(c));

    const act = document.createElement('div'); act.className = 'fe-actions';
    const save = document.createElement('button');
    save.className = 'btn btn--ok'; save.id = 'fe-save';
    save.textContent = creation ? 'Créer la fiche' : 'Enregistrer';
    save.onclick = enregistrer;
    const back = document.createElement('button');
    back.className = 'btn'; back.textContent = 'Retour';
    back.onclick = () => { ouverte = null; brouillon = {}; el.hidden = true; $('f-list').hidden = false; listeFiches(); };
    act.append(save, back);
    if (!creation) {
      const sup = document.createElement('button');
      sup.className = 'btn'; sup.textContent = 'Supprimer';
      sup.onclick = supprimer;
      act.appendChild(sup);
    }
    el.appendChild(act);

    const note = document.createElement('p'); note.className = 'fe-note';
    note.textContent = 'Seuls les champs modifiés sont envoyés. Les enregistrements multiples '
      + '(recordings) ne sont pas éditables ici et restent intacts.';
    el.appendChild(note);
  }

  async function enregistrer() {
    if (!ouverte) return;
    const gig = creation ? idPropose() : ouverte.id;
    if (!gig) { fdire('il faut une date et un titre'); return; }
    if (!creation && !Object.keys(brouillon).length) { fdire('rien à enregistrer'); return; }
    fdire(creation ? 'création…' : 'enregistrement…');
    const rep = await poste('/api/atelier/save', { gig, champs: brouillon, creer: creation });
    if (!rep.ok) { authBanner(rep.auth); fdire(rep.msg); return; }
    if (rep.d.error) { fdire(rep.d.error); return; }
    aPublier = true;
    fdire(creation ? `fiche ${gig} créée` : `${gig} enregistrée`);
    planifierPush();
    await chargerFiches(true);
    const maj = fiches.find(f => f.id === gig);
    if (maj) ouvrir(maj); else { ouverte = null; $('f-edit').hidden = true; $('f-list').hidden = false; }
  }

  async function supprimer() {
    if (!ouverte || creation) return;
    const gig = ouverte.id;
    // Deux temps : le premier clic previent, le second agit. Une confirmation
    // native bloquerait la page dans certains contextes.
    const b = $('f-edit').querySelectorAll('.btn');
    const sup = b[b.length - 1] as HTMLButtonElement;
    if (sup.dataset.sur !== '1') {
      sup.dataset.sur = '1';
      sup.textContent = 'Confirmer la suppression';
      fdire('la fiche restera dans l’historique git — « Brouillon » suffit souvent');
      return;
    }
    fdire('suppression…');
    const rep = await poste('/api/atelier/delete', { gig });
    if (!rep.ok) { authBanner(rep.auth); fdire(rep.msg); return; }
    if (rep.d.error) { fdire(rep.d.error); return; }
    fdire(`${gig} supprimée`);
    planifierPush();
    ouverte = null; $('f-edit').hidden = true; $('f-list').hidden = false;
    await chargerFiches(true);
  }

  function mode(f: boolean) {
    $('md-q').setAttribute('aria-current', String(!f));
    $('md-f').setAttribute('aria-current', String(f));
    $('md-j').setAttribute('aria-current', 'false');
    $('mode-q').hidden = f;
    $('mode-f').hidden = !f;
    $('mode-j').hidden = true;
    $('at-title').textContent = f ? 'Fiches' : 'Questions';
    if (f) chargerFiches();
  }
  $('md-q').onclick = () => mode(false);
  $('md-f').onclick = () => mode(true);
  $('f-new').onclick = () => { mode(true); nouvelle(); };
  ($('f-search') as HTMLInputElement).oninput = () => { if (fichesChargees) listeFiches(); };

  // ── Mode Facettes ──────────────────────────────────────────────────────────
  //  Les deux faces de chaque facette. Voir claude/architecture-jaquettes.md :
  //  le recto porte l'identite et ne deborde jamais, le verso porte l'index.
  //  Les limites ci-dessous ne sont pas decoratives — une jaquette existe pour
  //  etre lue a deux metres, et l'editeur doit le dire A LA SAISIE plutot que
  //  de laisser decouvrir le degat en ligne.
  const MAXR = { titre: 18, phrase: 42, chiffres: 3 };
  const MAXV = { intro: 180, entrees: 6 };
  const CHIFFRES: { cle: string; l: string }[] = [
    { cle: 'dates',   l: 'dates' },
    { cle: 'apres',   l: 'à venir' },
    { cle: 'sets',    l: 'sets à écouter' },
    { cle: 'styles',  l: 'styles' },
    { cle: 'lieux',   l: 'lieux' },
    { cle: 'medias',  l: 'médias' },
    { cle: 'billets', l: 'articles' },
  ];

  type Facette = {
    cle: string; label: string; teaser?: string;
    recto: any; verso: any; chantier: string | null;
  };
  let facettes: Facette[] = [];
  let jChargees = false;
  let jOuverte: Facette | null = null;

  const jdire = (t: string) => { const e = $('j-state'); if (e) e.textContent = t; };

  async function chargerFacettes(force = false) {
    if (jChargees && !force) return;
    jdire('chargement…');
    const rep = await poste('/api/atelier/facettes');
    if (!rep.ok) { authBanner(rep.auth); jdire(rep.msg); return; }
    facettes = rep.d.facettes || [];
    jChargees = true;
    listeFacettes();
  }

  /** Ce qui manque à une facette, dit en un mot — comme pour les fiches. */
  function jTrous(f: Facette): string {
    const m: string[] = [];
    if (!txt(f.recto?.phrase)) m.push('phrase');
    if (!arr(f.recto?.chiffres).length) m.push('chiffres');
    if (!txt(f.verso?.intro)) m.push('intro');
    if (!arr(f.verso?.entrees).length) m.push('index');
    return m.join(' · ');
  }

  function listeFacettes() {
    const el = $('j-list'); el.textContent = ''; el.hidden = false;
    $('j-edit').hidden = true;
    for (const f of facettes) {
      const b = document.createElement('button'); b.className = 'f-row';
      const d = document.createElement('span'); d.className = 'f-d'; d.textContent = f.cle;
      const t = document.createElement('span'); t.className = 'f-t'; t.textContent = f.label;
      const v = document.createElement('span'); v.className = 'f-v';
      v.textContent = f.chantier ? 'en chantier' : txt(f.recto?.phrase);
      const g = document.createElement('span'); g.className = 'f-gap'; g.textContent = jTrous(f);
      const mid = document.createElement('span'); mid.append(t, document.createTextNode(' '), v);
      b.append(d, mid, g);
      b.onclick = () => { jOuverte = JSON.parse(JSON.stringify(f)); rendreFacette(); };
      el.appendChild(b);
    }
    jdire(`${facettes.length} facettes`);
  }

  /** Champ texte avec compteur : le nombre restant vire au rouge quand on passe
   *  la limite, et le bouton d'enregistrement se ferme. Mieux vaut empecher que
   *  tronquer. */
  function champLimite(lab: string, val: string, max: number, multi: boolean,
                       onChange: (v: string) => void): HTMLElement {
    const w = document.createElement('div'); w.className = 'fe-f';
    const l = document.createElement('span'); l.className = 'fe-l';
    const c = document.createElement('span'); c.className = 'fe-cpt';
    const maj = (v: string) => {
      c.textContent = `${v.length}/${max}`;
      c.dataset.trop = v.length > max ? '1' : '0';
    };
    l.append(document.createTextNode(lab + '  '), c);
    const i = multi ? document.createElement('textarea') : document.createElement('input');
    i.className = multi ? 'fe-ta' : 'fe-i';
    (i as HTMLInputElement).value = val;
    i.oninput = () => { maj((i as HTMLInputElement).value); onChange((i as HTMLInputElement).value); jMaj(); };
    maj(val);
    w.append(l, i);
    return w;
  }

  function jMaj() {
    const b = $('j-save') as HTMLButtonElement | null;
    if (!b || !jOuverte) return;
    const p = jProblemes();
    b.disabled = p.length > 0;
    jdire(p.length ? p.join(' · ') : 'prêt à enregistrer');
  }

  function jProblemes(): string[] {
    if (!jOuverte) return [];
    const p: string[] = [];
    const r = jOuverte.recto || {}, v = jOuverte.verso || {};
    if (txt(r.titre).length  > MAXR.titre)  p.push('titre trop long');
    if (txt(r.phrase).length > MAXR.phrase) p.push('phrase trop longue — passe-la au verso');
    if (arr(r.chiffres).length > MAXR.chiffres) p.push('trois chiffres au maximum');
    if (txt(v.intro).length  > MAXV.intro)  p.push('intro trop longue');
    if (arr(v.entrees).length > MAXV.entrees) p.push('six entrées au maximum');
    return p;
  }

  function rendreFacette() {
    const el = $('j-edit'); el.textContent = ''; el.hidden = false;
    $('j-list').hidden = true;
    if (!jOuverte) return;
    const f = jOuverte;
    f.recto = f.recto || {}; f.verso = f.verso || {};

    const head = document.createElement('div'); head.className = 'fe-head';
    const h = document.createElement('strong'); h.textContent = f.label;
    const idl = document.createElement('span'); idl.className = 'fe-id'; idl.textContent = 'recto · verso';
    head.append(h, idl);
    el.appendChild(head);

    // ── Recto ────────────────────────────────────────────────────────────
    const tr = document.createElement('p'); tr.className = 'fe-note';
    tr.textContent = 'RECTO — l’identité, lue à deux mètres. Ce qui ne tient pas ici va au verso.';
    el.appendChild(tr);
    el.appendChild(champLimite('Titre', txt(f.recto.titre) || f.label, MAXR.titre, false,
      v => { f.recto.titre = v; }));
    el.appendChild(champLimite('Phrase', txt(f.recto.phrase), MAXR.phrase, false,
      v => { f.recto.phrase = v; }));
    el.appendChild(champLimite('Image (identifiant ou chemin)', txt(f.recto.image), 200, false,
      v => { f.recto.image = v; }));

    const wc = document.createElement('div'); wc.className = 'fe-f';
    const lc = document.createElement('span'); lc.className = 'fe-l';
    lc.textContent = 'Chiffres — comptés automatiquement, jamais saisis (3 max)';
    const box = document.createElement('div'); box.className = 'fe-chips';
    for (const c of CHIFFRES) {
      const on = arr(f.recto.chiffres).some((x: any) => x.cle === c.cle);
      const b = document.createElement('button'); b.className = 'fe-b';
      b.textContent = c.l; b.setAttribute('aria-pressed', String(on));
      b.onclick = () => {
        const l = arr(f.recto.chiffres).slice();
        const i = l.findIndex((x: any) => x.cle === c.cle);
        if (i >= 0) l.splice(i, 1); else l.push({ cle: c.cle });
        f.recto.chiffres = l; rendreFacette(); jMaj();
      };
      box.appendChild(b);
    }
    wc.append(lc, box);
    el.appendChild(wc);

    // ── Verso ────────────────────────────────────────────────────────────
    const tv = document.createElement('p'); tv.className = 'fe-note';
    tv.textContent = 'VERSO — l’index : ce qu’on trouve à l’intérieur.';
    el.appendChild(tv);
    el.appendChild(champLimite('Intro', txt(f.verso.intro), MAXV.intro, true,
      v => { f.verso.intro = v; }));

    const we = document.createElement('div'); we.className = 'fe-f';
    const le = document.createElement('span'); le.className = 'fe-l';
    le.textContent = `Entrées (${arr(f.verso.entrees).length}/${MAXV.entrees})`;
    we.appendChild(le);
    arr(f.verso.entrees).forEach((e: any, i: number) => {
      const row = document.createElement('div'); row.className = 'fe-e';
      const mk = (ph: string, k: string, cl: string) => {
        const inp = document.createElement('input'); inp.className = cl;
        inp.placeholder = ph; inp.value = txt(e[k]);
        inp.oninput = () => { e[k] = inp.value; };
        return inp;
      };
      const del = document.createElement('button'); del.className = 'fe-b fe-b--danger';
      del.textContent = '×';
      del.onclick = () => { f.verso.entrees = arr(f.verso.entrees).filter((_: any, j: number) => j !== i);
                            rendreFacette(); jMaj(); };
      row.append(mk('Titre', 'titre', 'fe-i'), mk('Texte court', 'texte', 'fe-i'),
                 mk('Lien', 'href', 'fe-i'), del);
      we.appendChild(row);
    });
    if (arr(f.verso.entrees).length < MAXV.entrees) {
      const add = document.createElement('button'); add.className = 'fe-b';
      add.textContent = '+ entrée';
      add.onclick = () => { f.verso.entrees = [...arr(f.verso.entrees), { titre: '' }];
                            rendreFacette(); jMaj(); };
      we.appendChild(add);
    }
    el.appendChild(we);

    // ── Cône de chantier ─────────────────────────────────────────────────
    el.appendChild(champLimite('En chantier — vide si la facette est prête', txt(f.chantier), 120, false,
      v => { f.chantier = v; }));

    const act = document.createElement('div'); act.className = 'fe-actions';
    const save = document.createElement('button');
    save.className = 'btn btn--ok'; save.id = 'j-save'; save.textContent = 'Enregistrer';
    save.onclick = enregistrerFacette;
    const back = document.createElement('button');
    back.className = 'btn'; back.textContent = 'Retour';
    back.onclick = () => { jOuverte = null; listeFacettes(); };
    act.append(save, back);
    el.appendChild(act);
    jMaj();
  }

  async function enregistrerFacette() {
    if (!jOuverte) return;
    if (jProblemes().length) return;
    jdire('enregistrement…');
    const rep = await poste('/api/atelier/facette-save', {
      cle: jOuverte.cle,
      champs: { recto: jOuverte.recto, verso: jOuverte.verso, chantier: jOuverte.chantier || '' },
    });
    if (!rep.ok) { authBanner(rep.auth); jdire(rep.msg); return; }
    if (rep.d.error) { jdire(rep.d.error); return; }
    aPublier = true;
    jdire(`${jOuverte.cle} enregistrée`);
    planifierPush();
    await chargerFacettes(true);
    const maj = facettes.find(x => x.cle === jOuverte!.cle);
    if (maj) { jOuverte = JSON.parse(JSON.stringify(maj)); rendreFacette(); }
  }

  function modeJ() {
    for (const [b, m] of [['md-q', 'mode-q'], ['md-f', 'mode-f'], ['md-j', 'mode-j']] as const) {
      const actif = b === 'md-j';
      $(b).setAttribute('aria-current', String(actif));
      $(m).hidden = !actif;
    }
    $('at-title').textContent = 'Facettes';
    chargerFacettes();
  }
  $('md-j').onclick = modeJ;

</script>
