---
import { visibleFacets } from '../data/facets';
import siteData from '../data/site.json';
import { getCollection } from 'astro:content';
import sonJson    from '../data/son.json';
import regieJson  from '../data/regie.json';
import coursJson  from '../data/cours.json';
import blogJson   from '../data/blog.json';
import outilsJson from '../data/outils.json';
import contactJson from '../data/contact.json';

const facets = visibleFacets();
const N = facets.length;

// ── Labels en arc : calcul dynamique (zéro hardcode) ──────────────────────
const longestLen = Math.max(...facets.map(f => [...f.label].length));
const COND_RATIO = 0.62;
const CAP_RATIO  = 0.72;
const R_CAP      = 92;
const ARC_DEG    = 360 / N - 4;
const ARC_RAD    = ARC_DEG * Math.PI / 180;
const fontSize   = R_CAP / (longestLen * COND_RATIO / ARC_RAD + CAP_RATIO);
const rBaseline  = R_CAP - CAP_RATIO * fontSize;

function arcPath(angleDeg: number, rUpper: number, rLower: number): string {
  const upper = angleDeg <= 90 || angleDeg >= 270;
  const r = upper ? rUpper : rLower;
  const toRad = (d: number) => (d - 90) * Math.PI / 180;
  const half = ARC_DEG / 2;
  const s = toRad(angleDeg - half);
  const e = toRad(angleDeg + half);
  const sx = r * Math.cos(s), sy = r * Math.sin(s);
  const ex = r * Math.cos(e), ey = r * Math.sin(e);
  return upper
    ? `M ${sx.toFixed(3)},${sy.toFixed(3)} A ${r},${r} 0 0 1 ${ex.toFixed(3)},${ey.toFixed(3)}`
    : `M ${ex.toFixed(3)},${ey.toFixed(3)} A ${r},${r} 0 0 0 ${sx.toFixed(3)},${sy.toFixed(3)}`;
}

// ── Données overlay par facette ───────────────────────────────────────────
const OVERLAY_GIGS_COUNT = 3;
const facetJsonMap: Record<string, Record<string, unknown>> = {
  son: sonJson as Record<string, unknown>,
  regie: regieJson as Record<string, unknown>,
  cours: coursJson as Record<string, unknown>,
  blog: blogJson as Record<string, unknown>,
  outils: outilsJson as Record<string, unknown>,
  contact: contactJson as Record<string, unknown>,
};

const allGigs = await getCollection('gigs', ({ data }) => !data.draft);
const today = new Date(); today.setHours(0, 0, 0, 0);
const upcomingGigs = allGigs
  .filter(g => g.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, OVERLAY_GIGS_COUNT);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });

const STREAM_KEYS = ['soundcloud', 'mixcloud', 'spotify'] as const;

interface GigItem {
  date: string;
  title: string;
  format: string;
}

interface OverlayData {
  key: string;
  label: string;
  teaser: string;
  href: string;
  headline: string;
  streamLinks: { key: string; url: string; label: string }[];
  otherLinks:  { key: string; url: string }[];
  photos: string[];
  isSon: boolean;
  gigs: GigItem[];
}

const labelItems = facets.map((facet, i) => ({
  key:      facet.key,
  label:    facet.label,
  teaser:   facet.teaser,
  href:     facet.href,
  angleDeg: i * 360 / N,
  arcD:     arcPath(i * 360 / N, rBaseline, R_CAP),
}));

const overlayItems: OverlayData[] = labelItems.map(item => {
  const d = facetJsonMap[item.key] || {};
  const links = (d.links || {}) as Record<string, string>;
  const streamLinks = STREAM_KEYS
    .filter(k => links[k])
    .map(k => ({
      key: k,
      url: links[k],
      label: k === 'soundcloud' ? 'SoundCloud' : k === 'mixcloud' ? 'Mixcloud' : 'Spotify',
    }));
  const otherLinks = Object.entries(links)
    .filter(([k, v]) => !(STREAM_KEYS as readonly string[]).includes(k) && v)
    .map(([k, v]) => ({ key: k, url: v }));
  const isSon = item.key === 'son';
  return {
    key:         item.key,
    label:       item.label,
    teaser:      item.teaser,
    href:        item.href,
    headline:    String(d.headline || item.label),
    streamLinks,
    otherLinks,
    photos:      Array.isArray(d.photos) ? (d.photos as string[]) : [],
    isSon,
    gigs:        isSon
      ? upcomingGigs.map(g => ({
          date:   fmtDate(g.data.date),
          title:  g.data.title,
          format: String(g.data.format || ''),
        }))
      : [],
  };
});
---

<div class="scene" data-state="0" data-n-facets={N} data-r-baseline={rBaseline.toFixed(3)} data-r-cap={R_CAP.toFixed(3)}>

  <div class="bg-stage" aria-hidden="true"></div>

  <!-- Flèches carrousel (état 2) -->
  <button class="carousel-arrow carousel-arrow--prev" type="button" aria-label="Facette précédente">&#8592;</button>
  <button class="carousel-arrow carousel-arrow--next" type="button" aria-label="Facette suivante">&#8594;</button>

  <!-- Panel gauche (landscape) / haut (portrait) -->
  <div class="panel-start" aria-hidden="true">
    <div class="panel-content">
      <span class="facet-chip" id="panel-chip"></span>
      <h2 class="panel-headline" id="panel-headline"></h2>
      <p class="panel-teaser-txt" id="panel-teaser-txt"></p>
    </div>
  </div>

  <!-- Platine (wrapper pour placement en grid état 2) -->
  <div class="turntable-wrap">
    <div class="turntable">

      <div class="disk-indicator" aria-hidden="true"></div>

      <div class="disk"></div>

      <svg
        class="disk-labels"
        viewBox="-100 -100 200 200"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <radialGradient id="tt-cd-grad" cx="50%" cy="50%" r="50%">
            <stop offset="25%" stop-color="black"/>
            <stop offset="100%" stop-color="white"/>
          </radialGradient>
          <mask id="tt-cd-mask">
            <rect x="-100" y="-100" width="200" height="200" fill="url(#tt-cd-grad)"/>
          </mask>

          <filter id="tt-glow-l" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="4"   result="b1"/>
            <feGaussianBlur in="SourceGraphic" stdDeviation="1.5" result="b2"/>
            <feMerge>
              <feMergeNode in="b1"/>
              <feMergeNode in="b2"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>

          <filter id="tt-glow-s" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="1.2" result="b"/>
            <feMerge>
              <feMergeNode in="b"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>

          {labelItems.map(item => (
            <path id={`tt-arc-${item.key}`} d="" fill="none"/>
          ))}
        </defs>

        {labelItems.map(item => (
          <text
            class={`disk-label disk-label--${item.key}`}
            font-family="Barlow Condensed, Arial Narrow, sans-serif"
            font-weight="800"
            font-size={fontSize.toFixed(2)}
            fill={`var(--facet-${item.key})`}
            stroke="var(--bg-app)"
            stroke-width="2"
            paint-order="stroke fill"
          >
            <textPath href={`#tt-arc-${item.key}`} startOffset="50%" text-anchor="middle">
              {item.label}
            </textPath>
          </text>
        ))}
      </svg>

      <div class="disk-track"></div>

      <div class="disk-center" id="disk-center">
        {siteData.logo_url && (
          <img src={siteData.logo_url} alt={siteData.displayName} class="center-logo-bg"/>
        )}

        <div class="center-s0">
          {!siteData.logo_url && (
            <span class="center-name">{siteData.displayName}</span>
          )}
        </div>

        <div class="center-s1">
          <span class="preview-label" id="preview-label"></span>
          <span class="preview-teaser" id="preview-teaser"></span>
          <span class="preview-cta">ouvrir →</span>
        </div>
      </div>

      {labelItems.map(item => (
        <button
          class="pastille"
          data-facet={item.key}
          data-label={item.label}
          data-teaser={item.teaser}
          data-href={item.href}
          style="--x: 0px; --y: 0px"
          type="button"
          aria-label={item.label}
        />
      ))}

    </div>
  </div>

  <!-- Panel droite (landscape) / bas (portrait) -->
  <div class="panel-end" aria-hidden="true">
    <div class="panel-content">
      <div id="panel-gigs" class="panel-gigs"></div>
      <div id="panel-streams" class="panel-streams"></div>
      <button class="cta-explorer" id="cta-explorer" type="button">Explorer →</button>
    </div>
  </div>

  <!-- Modal état 3 -->
  <div class="modal-overlay" id="tt-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-headline">
    <div class="modal-inner">
      <button class="modal-close" aria-label="Fermer">×</button>
      <header class="modal-hd">
        <span class="modal-chip" id="modal-chip"></span>
        <h2 class="modal-headline" id="modal-headline"></h2>
        <p class="modal-teaser" id="modal-teaser"></p>
      </header>
      <div class="modal-body" id="modal-body"></div>
      <a class="modal-explore" id="modal-explore" href="#">Voir la page complète →</a>
    </div>
  </div>

  <!-- Données SSR pour JS -->
  <div id="tt-data" style="display:none" aria-hidden="true" data-items={JSON.stringify(overlayItems)}></div>

  <!-- Lightbox photos -->
  <div id="tt-lightbox" class="tt-lightbox" aria-hidden="true" role="dialog" aria-modal="true">
    <button class="tt-lb-close" aria-label="Fermer">×</button>
    <img id="tt-lb-img" src="" alt="" class="tt-lb-img"/>
  </div>

</div>

<style>
  /* ─── Scène : flex états 0/1, grid état 2 ───────────────────── */
  .scene {
    position: relative;
    width: 100%;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
  }

  /* ─── État 2 : grid responsive ───────────────────────────────── */
  @media (orientation: landscape) {
    .scene[data-state="2"] {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      grid-template-rows: 1fr;
      align-items: center;
      justify-items: center;
    }
    .scene[data-state="2"] .panel-start  { grid-column: 1; grid-row: 1; }
    .scene[data-state="2"] .turntable-wrap { grid-column: 2; grid-row: 1; }
    .scene[data-state="2"] .panel-end    { grid-column: 3; grid-row: 1; }
  }

  @media (orientation: portrait) {
    .scene[data-state="2"] {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto 1fr;
      align-items: center;
      justify-items: center;
    }
    .scene[data-state="2"] .panel-start  { grid-row: 1; grid-column: 1; }
    .scene[data-state="2"] .turntable-wrap { grid-row: 2; grid-column: 1; }
    .scene[data-state="2"] .panel-end    { grid-row: 3; grid-column: 1; }

    /* Empêche le texte de déplacer la platine : overflow contenu dans la cellule */
    .scene[data-state="2"] .panel-start,
    .scene[data-state="2"] .panel-end {
      align-self: stretch;
      justify-self: stretch;
      overflow: hidden;
      padding: 0.6rem 1rem;
    }
    .scene[data-state="2"] .panel-content {
      height: 100%;
      overflow: hidden;
    }
    .scene[data-state="2"] .panel-headline {
      font-size: clamp(0.8rem, 4vw, 1.3rem);
    }
    .scene[data-state="2"] .panel-teaser-txt {
      font-size: clamp(0.55rem, 2.5vw, 0.78rem);
      max-height: 2.4em;
    }
    .scene[data-state="2"] .cta-explorer {
      font-size: clamp(0.6rem, 2.5vw, 0.78rem);
      padding: 0.4rem 0.8rem;
    }
  }

  /* ─── Fond coloré (états 1 + 2) ─────────────────────────────── */
  .bg-stage {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 80% 80% at center,
      color-mix(in srgb, var(--stage-c, transparent) 10%, var(--bg-app)) 0%,
      var(--bg-app) 70%
    );
    opacity: 0;
    transition: opacity 0.5s ease, background 0.4s ease;
    pointer-events: none;
    z-index: 0;
  }
  .scene[data-state="1"] .bg-stage,
  .scene[data-state="2"] .bg-stage { opacity: 1; }

  /* ─── Wrapper platine (grid cell en état 2) ──────────────────── */
  .turntable-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 1;
  }

  /* ─── Conteneur platine ──────────────────────────────────────── */
  .turntable {
    position: relative;
    width:  var(--disk-size, 560px);
    height: var(--disk-size, 560px);
    flex-shrink: 0;
    z-index: 1;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .scene[data-state="2"] .turntable {
    transform: scale(0.55);
  }
  .turntable::after {
    content: '';
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      transparent 60%,
      color-mix(in srgb, var(--active-facet-color, transparent) 10%, transparent) 100%
    );
    pointer-events: none;
    transition: background 0.7s ease;
    z-index: 0;
  }

  /* ─── Disque ─────────────────────────────────────────────────── */
  .disk {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--border);
    transform: rotate(var(--disk-rotation, 0deg));
    will-change: transform;
    background:
      radial-gradient(circle at 50% 50%,
        oklch(0.95 0.00 0 / 0.25) 0%,
        oklch(0.80 0.00 0 / 0.12) 20%,
        transparent 55%
      ),
      conic-gradient(
        from 0deg,
        oklch(0.50 0.28   0),
        oklch(0.55 0.24  60),
        oklch(0.52 0.24 120),
        oklch(0.50 0.20 180),
        oklch(0.50 0.24 240),
        oklch(0.52 0.26 300),
        oklch(0.50 0.28 360)
      );
    transition: box-shadow 0.4s ease;
  }
  .scene[data-state="1"] .disk,
  .scene[data-state="2"] .disk {
    box-shadow: 0 0 80px -20px rgba(0, 0, 0, 0.7);
  }

  /* ─── SVG labels en arc ──────────────────────────────────────── */
  .disk-labels {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    overflow: visible;
    pointer-events: none;
  }
  .disk-label {
    opacity: 0.65;
    filter: url('#tt-glow-s');
    transition: opacity 0.25s ease;
  }
  .disk-label.is-active {
    opacity: 1;
    filter: url('#tt-glow-l');
    mask: url('#tt-cd-mask');
  }

  /* ─── Anneau de track ────────────────────────────────────────── */
  .disk-track {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 500px;
    height: 500px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: transparent;
    border: none;
    pointer-events: none;
  }

  /* ─── Centre ─────────────────────────────────────────────────── */
  .disk-center {
    position: absolute;
    top: 50%;
    left: 50%;
    width:  var(--center-size, 180px);
    height: var(--center-size, 180px);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--bg-app);
    border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    overflow: hidden;
    z-index: 2;
    cursor: pointer;
  }
  .center-logo-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    opacity: 0.85;
    z-index: 0;
    transition: opacity 0.3s ease;
  }
  .scene[data-state="1"] .center-logo-bg,
  .scene[data-state="2"] .center-logo-bg { opacity: var(--logo-dim); }
  .center-s0,
  .center-s1 {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 1rem;
    text-align: center;
    z-index: 1;
    transition: opacity 0.2s ease;
  }
  .center-s0 { opacity: 1; }
  .center-s1 { opacity: 0; pointer-events: none; }
  .scene[data-state="1"] .center-s0,
  .scene[data-state="2"] .center-s0 { opacity: 0; pointer-events: none; }
  .scene[data-state="1"] .center-s1,
  .scene[data-state="2"] .center-s1 { opacity: 1; }

  .center-name {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .preview-label {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--preview-c, var(--text-primary));
    line-height: 1;
  }
  .preview-teaser {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--text-secondary);
    line-height: 1.3;
    max-width: 14ch;
  }
  .preview-cta {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--preview-c, var(--text-tertiary));
    opacity: 0.6;
    margin-top: 0.15rem;
  }

  /* ─── Indicateur fixe 12h ────────────────────────────────────── */
  .disk-indicator {
    position: absolute;
    top: calc(50% - var(--disk-size, 560px) / 2 - 14px);
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    border-top: 11px solid var(--text-secondary);
    pointer-events: none;
    z-index: 10;
    transition: border-top-color 0.3s ease;
  }

  /* ─── Zones de clic invisibles ───────────────────────────────── */
  .pastille {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 160px;
    height: 80px;
    transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y)));
    border-radius: 40px;
    background: transparent;
    border: none;
    cursor: pointer;
    appearance: none;
    padding: 0;
  }
  .pastille:focus-visible {
    outline: 2px solid var(--border);
    outline-offset: 3px;
  }

  /* ─── Flèches carrousel ──────────────────────────────────────── */
  .carousel-arrow {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 1.2rem;
    cursor: pointer;
    z-index: 110; /* au-dessus de la modal (100) */
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, background 0.2s ease;
  }
  .carousel-arrow--prev { left: 1rem; }
  .carousel-arrow--next { right: 1rem; }
  .carousel-arrow:hover { background: var(--bg-surface); }
  .scene[data-state="2"] .carousel-arrow {
    opacity: 1;
    pointer-events: auto;
  }

  /* ─── Panels gauche / droite ─────────────────────────────────── */
  .panel-start,
  .panel-end {
    display: none;
    width: 100%;
    max-width: var(--panel-max-w);
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .panel-start { transform: translateX(-24px); }
  .panel-end   { transform: translateX(24px); }

  @media (orientation: portrait) {
    .panel-start { transform: translateY(-24px); }
    .panel-end   { transform: translateY(24px); }
  }

  .scene[data-state="2"] .panel-start,
  .scene[data-state="2"] .panel-end {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .scene[data-state="2"] .panel-start.is-visible,
  .scene[data-state="2"] .panel-end.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translate(0);
  }

  .panel-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  .facet-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    padding: 0.2rem 0.65rem;
    border-radius: 99px;
    border: 1px solid currentColor;
    align-self: flex-start;
  }

  .panel-headline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 3vw, 2rem);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .panel-teaser-txt {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
    max-height: 2.8em;
    overflow: hidden;
  }

  /* Panel end : gigs, streams, CTA */
  .panel-gigs {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .panel-gig-row {
    display: grid;
    grid-template-columns: 72px 1fr 40px;
    gap: 0.5rem;
    align-items: center;
    border-top: 1px solid var(--border);
    padding-top: 0.35rem;
  }
  .pg-date {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-tertiary);
    white-space: nowrap;
  }
  .pg-title {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pg-format {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    color: var(--text-tertiary);
    text-align: right;
  }

  .panel-streams {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .panel-stream-btn {
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    border: 1px solid currentColor;
