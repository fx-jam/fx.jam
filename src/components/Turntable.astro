    top: 1rem;
    right: 1.5rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    border: none;
    color: white;
    font-size: 1.3rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  interface TtItem {
    key: string;
    label: string;
    teaser: string;
    href: string;
    headline: string;
    streamLinks: { key: string; url: string; label: string }[];
    otherLinks:  { key: string; url: string }[];
    photos: string[];
    isSon: boolean;
    gigs: { date: string; title: string; format: string }[];
  }

  let N_FACETS   = 6;
  let STEP       = 60;
  let BASE_ANGLES: number[] = [];
  const FRICTION    = 0.97;
  const VEL_THRESH  = 0.5;
  const BASE_STEP   = 2.5;
  const MAX_STEP    = 12;

  let targetAngle  = 0;
  let currentAngle = 0;
  let velAngle     = 0;
  let RING_R_0     = 250;
  let RING_R_1     = 310;
  let targetRingR  = RING_R_0;
  let currentRingR = RING_R_0;
  let appState     = 0;
  let activeFacetIdx  = -1;
  let activeFacetHref = '';
  let rafId: number | null = null;
  let ctrl: AbortController | null = null;

  let keyHeldFrames = 0;
  let keyHeldDir    = 0;

  document.addEventListener('astro:page-load', () => {
    if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
    ctrl?.abort();

    const scene = document.querySelector<HTMLElement>('.scene');
    if (!scene) return;

    N_FACETS = Number(scene.dataset.nFacets) || 6;
    STEP = 360 / N_FACETS;
    BASE_ANGLES = Array.from({ length: N_FACETS }, (_, i) => (i * STEP) - 90);

    const R_BASELINE  = Number(scene.dataset.rBaseline) || 74;
    const R_CAP_JS    = Number(scene.dataset.rCap) || 92;
    const ARC_DEG_JS  = 360 / N_FACETS - 4;

    // Charger les données SSR
    const ttDataEl = document.getElementById('tt-data');
    const ttItems: TtItem[] = ttDataEl
      ? JSON.parse(ttDataEl.dataset.items || '[]')
      : [];

    function arcPathJS(angleDeg: number, rUpper: number, rLower: number): string {
      const normAngle = ((angleDeg % 360) + 360) % 360;
      const upper = normAngle <= 90 || normAngle >= 270;
      const r = upper ? rUpper : rLower;
      const toRad = (d: number) => (d - 90) * Math.PI / 180;
      const half = ARC_DEG_JS / 2;
      const s = toRad(angleDeg - half), e = toRad(angleDeg + half);
      const sx = r * Math.cos(s), sy = r * Math.sin(s);
      const ex = r * Math.cos(e), ey = r * Math.sin(e);
      return upper
        ? `M ${sx.toFixed(3)},${sy.toFixed(3)} A ${r},${r} 0 0 1 ${ex.toFixed(3)},${ey.toFixed(3)}`
        : `M ${ex.toFixed(3)},${ey.toFixed(3)} A ${r},${r} 0 0 0 ${sx.toFixed(3)},${sy.toFixed(3)}`;
    }

    ctrl = new AbortController();
    const sig = ctrl.signal;

    appState = 0;
    activeFacetIdx  = -1;
    activeFacetHref = '';
    targetAngle  = 0;
    currentAngle = 0;
    velAngle     = 0;
    scene.dataset.state = '0';

    function calcDiskSize(): number {
      return Math.min(
        document.documentElement.clientWidth  * 0.90,
        document.documentElement.clientHeight * 0.85,
        560
      );
    }

    function applyDiskSize(): void {
      const size = calcDiskSize();
      scene.style.setProperty('--disk-size',   size + 'px');
      scene.style.setProperty('--center-size', Math.round(size * 0.29) + 'px');
      RING_R_0 = size / 2 * 0.80;
      RING_R_1 = size / 2 * 0.99;
      targetRingR  = (appState === 1) ? RING_R_1 : RING_R_0;
      currentRingR = targetRingR;
    }

    applyDiskSize();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { applyDiskSize(); update(); }, 100);
    }, { signal: sig });

    const diskTrack     = document.querySelector<HTMLElement>('.disk-track')!;
    const centerEl      = document.querySelector<HTMLElement>('#disk-center')!;
    const indicator     = scene.querySelector<HTMLElement>('.disk-indicator')!;
    const bgStage       = document.querySelector<HTMLElement>('.bg-stage')!;
    const previewLabel  = document.querySelector<HTMLElement>('#preview-label');
    const previewTeaser = document.querySelector<HTMLElement>('#preview-teaser');
    const pastilles     = [...document.querySelectorAll<HTMLElement>('.pastille')];
    const labelEls      = [...document.querySelectorAll<Element>('.disk-label')];
    const arcPathEls    = Array.from({ length: N_FACETS }, (_, i) =>
      document.getElementById(`tt-arc-${pastilles[i]?.dataset.facet}`) as SVGPathElement | null
    );

    // Panels
    const panelStart   = document.querySelector<HTMLElement>('.panel-start')!;
    const panelEnd     = document.querySelector<HTMLElement>('.panel-end')!;
    const panelChip    = document.getElementById('panel-chip')!;
    const panelHeadline = document.getElementById('panel-headline')!;
    const panelTeaserTxt = document.getElementById('panel-teaser-txt')!;
    const panelGigs    = document.getElementById('panel-gigs')!;
    const panelStreams  = document.getElementById('panel-streams')!;
    const ctaExplorer  = document.getElementById('cta-explorer') as HTMLButtonElement;

    // Modal
    const modalOverlay  = document.getElementById('tt-modal')!;
    const modalChip     = document.getElementById('modal-chip')!;
    const modalHeadline = document.getElementById('modal-headline')!;
    const modalTeaser   = document.getElementById('modal-teaser')!;
    const modalBody     = document.getElementById('modal-body')!;
    const modalExplore  = document.getElementById('modal-explore') as HTMLAnchorElement;

    // Carousel arrows
    const arrowPrev = document.querySelector<HTMLButtonElement>('.carousel-arrow--prev')!;
    const arrowNext = document.querySelector<HTMLButtonElement>('.carousel-arrow--next')!;

    // Lightbox
    const lightbox    = document.getElementById('tt-lightbox')!;
    const lightboxImg = document.getElementById('tt-lb-img') as HTMLImageElement;

    // ── Rendu ──────────────────────────────────────────────────────
    function update(): void {
      scene.style.setProperty('--disk-rotation', `${currentAngle.toFixed(2)}deg`);

      for (let i = 0; i < N_FACETS; i++) {
        const absAngleDeg = BASE_ANGLES[i] + currentAngle;
        arcPathEls[i]?.setAttribute('d', arcPathJS(absAngleDeg + 90, R_BASELINE, R_CAP_JS));
      }

      let activeIdx = 0;
      let minDist   = Infinity;

      for (let i = 0; i < N_FACETS; i++) {
        const deg = BASE_ANGLES[i] + currentAngle;
        const rad = (deg * Math.PI) / 180;
        pastilles[i].style.setProperty('--x', `${(Math.cos(rad) * currentRingR).toFixed(2)}px`);
        pastilles[i].style.setProperty('--y', `${(Math.sin(rad) * currentRingR).toFixed(2)}px`);

        const norm = ((deg + 90) % 360 + 360) % 360;
        const dist = Math.min(norm, 360 - norm);
        if (dist < minDist) { minDist = dist; activeIdx = i; }
      }

      for (let i = 0; i < N_FACETS; i++) {
        const active = i === activeIdx;
        pastilles[i].classList.toggle('is-active', active);
        if (labelEls[i]) {
          labelEls[i].classList.toggle('is-active', active);
          labelEls[i].setAttribute('filter', active ? 'url(#tt-glow-l)' : 'url(#tt-glow-s)');
        }
      }

      indicator.style.setProperty(
        'border-top-color',
        `var(--facet-${pastilles[activeIdx].dataset.facet})`
      );

      if (appState === 1 && activeIdx !== activeFacetIdx) {
        setActiveFacetInfo(activeIdx);
      }

      const d = `${(currentRingR * 2).toFixed(1)}px`;
      diskTrack.style.width = d;
      diskTrack.style.height = d;
    }

    function animate(): void {
      const rDiff = targetRingR - currentRingR;

      if (Math.abs(velAngle) > VEL_THRESH) {
        currentAngle += velAngle;
        velAngle     *= FRICTION;
        targetAngle   = currentAngle;
      } else {
        velAngle = 0;
        const aDiff = targetAngle - currentAngle;
        if (Math.abs(aDiff) < 0.02 && Math.abs(rDiff) < 0.05) {
          currentAngle = targetAngle;
          currentRingR = targetRingR;
          update();
          rafId = null;
          return;
        }
        currentAngle += aDiff * 0.12;
      }

      currentRingR += rDiff * 0.08;
      update();
      rafId = requestAnimationFrame(animate);
    }

    function schedule(): void {
      if (rafId === null) rafId = requestAnimationFrame(animate);
    }

    function getActiveIdx(): number {
      let idx = 0, minDist = Infinity;
      for (let i = 0; i < N_FACETS; i++) {
        const deg  = BASE_ANGLES[i] + currentAngle;
        const norm = ((deg + 90) % 360 + 360) % 360;
        const dist = Math.min(norm, 360 - norm);
        if (dist < minDist) { minDist = dist; idx = i; }
      }
      return idx;
    }

    function getTargetIdx(): number {
      let idx = 0, minDist = Infinity;
      for (let i = 0; i < N_FACETS; i++) {
        const deg  = BASE_ANGLES[i] + targetAngle;
        const norm = ((deg + 90) % 360 + 360) % 360;
        const dist = Math.min(norm, 360 - norm);
        if (dist < minDist) { minDist = dist; idx = i; }
      }
      return idx;
    }

    function snapToFacet(idx: number): void {
      const desired = -90 - BASE_ANGLES[idx];
      const raw     = desired - targetAngle;
      const norm    = ((raw % 360) + 360) % 360;
      targetAngle  += (norm > 180 ? norm - 360 : norm);
      velAngle = 0;
      schedule();
    }

    // ── Gestion de l'info facette active ──────────────────────────
    function setActiveFacetInfo(idx: number): void {
      activeFacetIdx  = idx;
      activeFacetHref = pastilles[idx].dataset.href!;
      const key = pastilles[idx].dataset.facet!;
      const color = `var(--facet-${key})`;
      if (previewLabel)  previewLabel.textContent  = pastilles[idx].dataset.label!;
      if (previewTeaser) previewTeaser.textContent = pastilles[idx].dataset.teaser!;
      centerEl.style.setProperty('--preview-c', color);
      bgStage.style.setProperty('--stage-c', color);
      document.documentElement.style.setProperty('--active-facet-color', color);
    }

    // ── Machine d'états ───────────────────────────────────────────
    // Note : scene.dataset.state ne prend jamais la valeur "3".
    // La modal s'ouvre par-dessus l'état 2 (arrière-plan reste visible + flouté).
    function setState(newState: number, facetIdx = -1): void {
      appState = newState;
      scene.dataset.state = String(newState); // "0", "1" ou "2" uniquement

      if (newState === 0) {
        document.documentElement.style.setProperty('--active-facet-color', 'transparent');
        activeFacetIdx  = -1;
        activeFacetHref = '';
        targetRingR = RING_R_0;
        panelStart.classList.remove('is-visible');
        panelEnd.classList.remove('is-visible');
        panelStart.setAttribute('aria-hidden', 'true');
        panelEnd.setAttribute('aria-hidden', 'true');
        closeModal();

      } else if (newState === 1 && facetIdx >= 0) {
        setActiveFacetInfo(facetIdx);
        targetRingR = RING_R_1;

      } else if (newState === 2 && facetIdx >= 0) {
        setActiveFacetInfo(facetIdx);
        targetRingR = RING_R_0;
        updatePanels(facetIdx);
        panelStart.classList.remove('is-visible');
        panelEnd.classList.remove('is-visible');
        panelStart.setAttribute('aria-hidden', 'false');
        panelEnd.setAttribute('aria-hidden', 'false');
        void panelStart.offsetWidth;
        panelStart.classList.add('is-visible');
        panelEnd.classList.add('is-visible');
      }

      schedule();
    }

    function goToFacet(idx: number): void {
      const modalWasOpen = modalOverlay.classList.contains('is-open');
      snapToFacet(idx);
      setState(2, idx); // met appState = 2, met à jour panels
      if (modalWasOpen) {
        // Mise à jour du contenu modal sans fermer/rouvrir
        populateModal(idx);
        appState = 3; // remettre à 3 (setState l'a repassé à 2)
      }
    }

    // ── Panels : mise à jour du contenu ───────────────────────────
    function updatePanels(idx: number): void {
      const d = ttItems[idx];
      if (!d) return;
      const color = `var(--facet-${d.key})`;

      // Panel start
      panelChip.textContent = d.label;
      panelChip.style.color = color;
      (panelChip as HTMLElement).style.borderColor = color;
      panelHeadline.textContent = d.headline;
      panelTeaserTxt.textContent = d.teaser;

      // CTA color
      ctaExplorer.style.color = color;

      // Gigs (son only)
      panelGigs.innerHTML = '';
      if (d.gigs && d.gigs.length > 0) {
        const ul = document.createElement('ul');
        ul.className = 'panel-gig-list';
        ul.style.cssText = 'list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0';
        d.gigs.forEach(g => {
          const li = document.createElement('li');
          li.className = 'panel-gig-row';
          const date = document.createElement('time');
          date.className = 'pg-date';
          date.textContent = g.date;
          const title = document.createElement('span');
          title.className = 'pg-title';
          title.textContent = g.title;
          const fmt = document.createElement('span');
          fmt.className = 'pg-format';
          fmt.textContent = g.format;
          li.append(date, title, fmt);
          ul.appendChild(li);
        });
        panelGigs.appendChild(ul);
      }

      // Streams
      panelStreams.innerHTML = '';
      d.streamLinks.forEach(sl => {
        const a = document.createElement('a');
        a.href = sl.url;
        a.target = '_blank';
        a.rel = 'noopener';
        a.className = 'panel-stream-btn';
        a.style.color = color;
        a.textContent = sl.label;
        panelStreams.appendChild(a);
      });
    }

    // ── Modal ─────────────────────────────────────────────────────
    // Remplit le contenu sans toucher à la visibilité
    function populateModal(idx: number): void {
      const d = ttItems[idx];
      if (!d) return;
      const color = `var(--facet-${d.key})`;

      modalChip.textContent = d.label;
      modalChip.style.color = color;
      (modalChip as HTMLElement).style.borderColor = color;
      modalHeadline.textContent = d.headline;
      modalTeaser.textContent = d.teaser;
      modalExplore.href = d.href;
      modalExplore.style.color = color;

      modalBody.innerHTML = '';

      if (d.isSon) {
        const block = document.createElement('details');
        block.className = 'modal-block';
        block.open = true;
        const summary = document.createElement('summary');
        summary.className = 'modal-block-title';
        summary.textContent = 'Gigs';
        block.appendChild(summary);
        if (d.gigs.length > 0) {
          const ul = document.createElement('ul');
          ul.className = 'modal-gig-list';
          d.gigs.forEach(g => {
            const li = document.createElement('li');
            li.className = 'modal-gig-row';
            const date = document.createElement('time');
            date.className = 'mg-date';
            date.textContent = g.date;
            const title = document.createElement('span');
            title.className = 'mg-title';
            title.textContent = g.title;
            const fmt = document.createElement('span');
            fmt.className = 'mg-format';
            fmt.textContent = g.format;
            li.append(date, title, fmt);
            ul.appendChild(li);
          });
          block.appendChild(ul);
          const more = document.createElement('a');
          more.href = '/son';
          more.className = 'modal-gig-more';
          more.style.color = color;
          more.textContent = 'Voir tous →';
          block.appendChild(more);
        } else {
          const p = document.createElement('p');
          p.className = 'modal-empty';
          p.textContent = 'Prochaines dates bientôt annoncées.';
          block.appendChild(p);
        }
        modalBody.appendChild(block);
      }

      if (d.streamLinks.length > 0) {
        const block = document.createElement('details');
        block.className = 'modal-block';
        const summary = document.createElement('summary');
        summary.className = 'modal-block-title';
        summary.textContent = 'Écoute';
        block.appendChild(summary);
        const btns = document.createElement('div');
        btns.className = 'modal-stream-btns';
        d.streamLinks.forEach(sl => {
          const a = document.createElement('a');
          a.href = sl.url;
          a.target = '_blank';
          a.rel = 'noopener';
          a.className = 'modal-stream-btn';
          a.style.color = color;
          a.textContent = sl.label;
          btns.appendChild(a);
        });
        block.appendChild(btns);
        modalBody.appendChild(block);
      }

      if (d.otherLinks.length > 0) {
        const block = document.createElement('details');
        block.className = 'modal-block';
        const summary = document.createElement('summary');
        summary.className = 'modal-block-title';
        summary.textContent = 'Liens';
        block.appendChild(summary);
        const ul = document.createElement('ul');
        ul.className = 'modal-links-list';
        d.otherLinks.forEach(ol => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = ol.url;
          a.target = '_blank';
          a.rel = 'noopener';
          a.className = 'modal-link';
          a.textContent = ol.key;
          li.appendChild(a);
          ul.appendChild(li);
        });
        block.appendChild(ul);
        modalBody.appendChild(block);
      }

    }

    // Ouvre la modal par-dessus l'état 2 (scene.dataset.state reste "2")
    function openModal(idx: number): void {
      populateModal(idx);
      modalOverlay.classList.add('is-open');
      modalOverlay.setAttribute('aria-hidden', 'false');
      appState = 3;
      // scene.dataset.state reste "2" intentionnellement
    }

    function closeModal(): void {
      if (!modalOverlay.classList.contains('is-open')) return;
      modalOverlay.classList.remove('is-open');
      modalOverlay.setAttribute('aria-hidden', 'true');
      if (appState === 3) {
        appState = 2;
        // scene.dataset.state est déjà "2"
      }
    }

    // ── Gestionnaires d'événements ────────────────────────────────

    // Pastille → état 2 direct
    pastilles.forEach((el, idx) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        snapToFacet(idx);
        setState(2, idx);
      }, { signal: sig });
    });

    // Centre → état 2 (si état 1)
    centerEl.addEventListener('click', () => {
      if (appState === 1 && activeFacetIdx >= 0) {
        setState(2, activeFacetIdx);
      }
    }, { signal: sig });

    // CTA Explorer → modal directement (pas d'étape intermédiaire)
    ctaExplorer.addEventListener('click', () => {
      if (appState === 2 && activeFacetIdx >= 0) openModal(activeFacetIdx);
    }, { signal: sig });

    // Fermer modal (× ou clic hors modal-inner)
    modalOverlay.querySelector('.modal-close')?.addEventListener('click', () => {
      closeModal();
    }, { signal: sig });
    modalOverlay.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.modal-inner')) closeModal();
    }, { signal: sig });

    // Swipe horizontal sur la modal → carrousel
    let modalSwipeStartX = 0;
    modalOverlay.addEventListener('touchstart', (e) => {
      modalSwipeStartX = (e as TouchEvent).touches[0]?.clientX ?? 0;
    }, { passive: true, signal: sig } as AddEventListenerOptions);
    modalOverlay.addEventListener('touchend', (e) => {
      if (appState !== 3) return;
      const dx = ((e as TouchEvent).changedTouches[0]?.clientX ?? 0) - modalSwipeStartX;
      if (Math.abs(dx) > 50) {
        goToFacet((activeFacetIdx + (dx < 0 ? 1 : -1) + N_FACETS) % N_FACETS);
      }
    }, { passive: true, signal: sig } as AddEventListenerOptions);

    // Carrousel : flèches (états 2 et 3)
    arrowPrev.addEventListener('click', () => {
      if (appState === 2 || appState === 3) goToFacet((activeFacetIdx - 1 + N_FACETS) % N_FACETS);
    }, { signal: sig });
    arrowNext.addEventListener('click', () => {
      if (appState === 2 || appState === 3) goToFacet((activeFacetIdx + 1) % N_FACETS);
    }, { signal: sig });

    // Lightbox
    document.querySelectorAll<HTMLElement>('.overlay-photo-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const src = btn.dataset.src || '';
        if (!src) return;
        lightboxImg.src = src;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
      }, { signal: sig });
    });
    lightbox.querySelector('.tt-lb-close')?.addEventListener('click', () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
    }, { signal: sig });
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
      }
    }, { signal: sig });

    // Swipe horizontal en état 2 → navigation carrousel
    let swipeTouchStartX = 0;
    let swipeTouchStartY = 0;
    scene.addEventListener('touchstart', (e) => {
      const te = e as TouchEvent;
      if (te.touches.length !== 1) return;
      swipeTouchStartX = te.touches[0].clientX;
      swipeTouchStartY = te.touches[0].clientY;
    }, { passive: true, signal: sig } as AddEventListenerOptions);

    scene.addEventListener('touchend', (e) => {
      if (appState !== 2 && appState !== 3) return;
      const te = e as TouchEvent;
      const touch = te.changedTouches[0];
      if (!touch) return;
      const dx = touch.clientX - swipeTouchStartX;
      const dy = touch.clientY - swipeTouchStartY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
        goToFacet(dx < 0
          ? (activeFacetIdx + 1) % N_FACETS
          : (activeFacetIdx - 1 + N_FACETS) % N_FACETS
        );
      }
    }, { passive: true, signal: sig } as AddEventListenerOptions);

    // Clavier
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        keyHeldDir = 0; keyHeldFrames = 0;
        if (modalOverlay.classList.contains('is-open')) { closeModal(); return; }
        if (appState >= 1) setState(0);
        return;
      }

      if (e.key === 'Enter') {
        if (appState === 2 && activeFacetIdx >= 0) { openModal(activeFacetIdx); return; }
        if (appState === 1 && activeFacetHref) navigate(activeFacetHref);
        return;
      }

      const isRight = e.key === 'ArrowRight' || e.key === 'ArrowDown';
      const isLeft  = e.key === 'ArrowLeft'  || e.key === 'ArrowUp';
      if (!isRight && !isLeft) return;
      e.preventDefault();

      const dir = isRight ? 1 : -1;

      // Carrousel en états 2 et 3
      if (appState === 2 || appState === 3) {
        goToFacet((activeFacetIdx + dir + N_FACETS) % N_FACETS);
        return;
      }

      // Rotation libre en états 0/1
      if (dir !== keyHeldDir) { keyHeldDir = dir; keyHeldFrames = 0; }
      keyHeldFrames++;
      const step  = Math.min(BASE_STEP + keyHeldFrames * 0.15, MAX_STEP);
      velAngle = dir * step * 0.35;
      const idx = (getTargetIdx() + dir + N_FACETS) % N_FACETS;
      snapToFacet(idx);
      setState(1, idx);
    }, { signal: sig });

    window.addEventListener('keyup', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown' ||
          e.key === 'ArrowLeft'  || e.key === 'ArrowUp') {
        keyHeldDir = 0; keyHeldFrames = 0;
      }
    }, { signal: sig });

    // Clic sur le fond de scène → état 0 (la modal capture ses propres clics)
    scene.addEventListener('click', (e) => {
      if (appState === 0 || appState === 3) return;
      const t = e.target as Element;
      if (t === scene || t === bgStage) setState(0);
    }, { signal: sig });

    // Molette
    scene.addEventListener('wheel', (e) => {
      if (appState === 2 || appState === 3) return; // pas de rotation en état 2/3
      e.preventDefault();
      velAngle = 0;
      const raw = (e as WheelEvent).deltaY;
      const capped = Math.sign(raw) * Math.min(Math.abs(raw), 80);
      targetAngle -= capped * 0.25;
      schedule();
    }, { passive: false, signal: sig } as AddEventListenerOptions);

    // Drag souris
    let mouseDown = false;
    let mouseDragStartAngle = 0;
    let mouseDragStartRotation = 0;
    let mouseDragDist = 0;
    let mouseDragStartX = 0;
    let mouseDragStartY = 0;
    let mouseSamples: Array<{ angle: number; t: number }> = [];

    scene.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      if (appState === 2 || appState === 3) return;
      e.preventDefault();
      mouseDown = true;
      mouseDragStartX = e.clientX; mouseDragStartY = e.clientY; mouseDragDist = 0;
      const rect = scene.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      mouseDragStartAngle = Math.atan2(e.clientY - cy, e.clientX - cx) * (180 / Math.PI);
      mouseDragStartRotation = currentAngle;
      velAngle = 0; mouseSamples = [];
    }, { signal: sig });

    window.addEventListener('mousemove', (e) => {
      if (!mouseDown) return;
      mouseDragDist = Math.hypot(e.clientX - mouseDragStartX, e.clientY - mouseDragStartY);
      const rect = scene.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const angle = Math.atan2(e.clientY - cy, e.clientX - cx) * (180 / Math.PI);
      currentAngle = mouseDragStartRotation + (angle - mouseDragStartAngle);
      targetAngle = currentAngle;
      const now = performance.now();
      mouseSamples.push({ angle: currentAngle, t: now });
      if (mouseSamples.length > 4) mouseSamples.shift();
      update();
    }, { signal: sig });

    window.addEventListener('mouseup', (e) => {
      if (!mouseDown) return;
      mouseDown = false;
      if (mouseSamples.length >= 2) {
        const first = mouseSamples[0];
        const last  = mouseSamples[mouseSamples.length - 1];
        const dt = last.t - first.t;
        if (dt > 0) velAngle = (last.angle - first.angle) / dt * 16;
      }
      if (mouseDragDist < 5 && !(e.target as Element).closest('.disk-center')) setState(0);
      schedule();
    }, { signal: sig });

    // Touch rotatif (états 0/1 uniquement)
    const VEL_SAMPLES = 4;
    let touchLastDeg = 0;
    let touchLastMs  = 0;
    let velBuf: number[] = [];
    let touchRotStartX = 0;
    let touchRotStartY = 0;
    let touchIsRotating = false;

    function fingerAngle(t: Touch): number {
      const cx = window.innerWidth  / 2;
      const cy = window.innerHeight / 2;
      return Math.atan2(t.clientY - cy, t.clientX - cx) * (180 / Math.PI);
    }
    function wrapDelta(d: number): number {
      while (d >  180) d -= 360;
      while (d < -180) d += 360;
      return d;
    }

    scene.addEventListener('touchstart', (e) => {
      if (appState === 2 || appState === 3) return; // swipe handler prend le relais
      const te = e as TouchEvent;
      if (te.touches.length !== 1) return;
      touchIsRotating = true;
      touchLastDeg = fingerAngle(te.touches[0]);
      touchLastMs  = performance.now();
      touchRotStartX = te.touches[0].clientX;
      touchRotStartY = te.touches[0].clientY;
      velAngle = 0; velBuf = [];
      targetAngle = currentAngle;
    }, { passive: true, signal: sig } as AddEventListenerOptions);

    scene.addEventListener('touchmove', (e) => {
      if (!touchIsRotating) return;
      const te = e as TouchEvent;
      if (te.touches.length !== 1) return;
      e.preventDefault();
      const newDeg = fingerAngle(te.touches[0]);
      const now    = performance.now();
      const dt     = Math.max(now - touchLastMs, 1);
      const delta  = wrapDelta(newDeg - touchLastDeg);
      currentAngle += delta;
      targetAngle   = currentAngle;
      velBuf.push(delta / dt * (1000 / 60));
      if (velBuf.length > VEL_SAMPLES) velBuf.shift();
      touchLastDeg = newDeg;
      touchLastMs  = now;
      schedule();
    }, { passive: false, signal: sig } as AddEventListenerOptions);

    scene.addEventListener('touchend', (e) => {
      if (!touchIsRotating) return;
      touchIsRotating = false;
      if (velBuf.length > 0)
        velAngle = velBuf.reduce((a, b) => a + b, 0) / velBuf.length;
      velBuf = [];
      const te = e as TouchEvent;
      const touch = te.changedTouches[0];
      if (touch) {
        const dist = Math.hypot(touch.clientX - touchRotStartX, touch.clientY - touchRotStartY);
        if (dist < 5 && !(e.target as Element).closest('.disk-center')) setState(0);
      }
      schedule();
    }, { passive: true, signal: sig } as AddEventListenerOptions);

    update();
  });
</script>
