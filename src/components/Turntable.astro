  }
  .modal-block-title::-webkit-details-marker { display: none; }
  .modal-block-title::after {
    content: '▾';
    margin-left: auto;
    transition: transform 0.18s ease;
  }
  .modal-block[open] .modal-block-title::after { transform: rotate(180deg); }
  .modal-block[open] .modal-block-title { color: var(--text-secondary); }

  .modal-gig-list {
