  .modal-explore:hover { background: color-mix(in srgb, currentColor 12%, transparent); }

  /* ─── Lightbox photos ────────────────────────────────────────── */
  .tt-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 200;
    display: flex;
